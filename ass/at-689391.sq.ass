Dialogue: 0,0:12:54.13,0:12:55.51,Flashback,Crowd,0,0,0,,Oh, atje je.
Dialogue: 0,0:12:55.51,0:12:58.55,Flashback,Rei,0,0,0,,Të gjithë këtu janë në industrinë e mangës?
Dialogue: 0,0:12:58.55,0:12:59.85,Flashback,Nana,0,0,0,,Epo?
Dialogue: 0,0:13:01.55,0:13:06.74,Flashback Italics,Rei\Italic,0,0,0,,Magma ime shteroi\Npas dy kapitujve të serializuar.
Dialogue: 0,0:13:07.55,0:13:11.87,Flashback Italics,Rei\Italic,0,0,0,,Por të gjithë mangistët këtu ia dalin\Nnë baza javore ose mujore.
Dialogue: 0,0:13:15.60,0:13:16.84,Flashback,Hana,0,0,0,,Teshima-san!
Dialogue: 0,0:13:23.27,0:13:25.50,Flashback,Hana,0,0,0,,Serializimi yt i ri është më i miri.
Dialogue: 0,0:13:27.58,0:13:29.66,Flashback,Miya,0,0,0,,Kapitulli i dytë ishte gjithashtu fantastik.
Dialogue: 0,0:13:30.11,0:13:33.04,Flashback,Miya,0,0,0,,E kam dashur punën tënde\Nqë nga çmimi yt.
Dialogue: 0,0:13:35.80,0:13:37.23,Flashback,Rei,0,0,0,,Hebichika-sensei!
Dialogue: 0,0:13:38.68,0:13:41.49,Flashback,Hebichika,0,0,0,,Kush jeni ju?
Dialogue: 0,0:13:42.88,0:13:45.48,Flashback,Hebichika,0,0,0,,Oh, Rei-chan.
Dialogue: 0,0:13:45.48,0:13:47.47,Flashback,Hebichika,0,0,0,,Lexova serializimin tënd të ri.
Dialogue: 0,0:13:49.03,0:13:50.75,Flashback,Hebichika,0,0,0,,Ende ke rrugë për të bërë.
Dialogue: 0,0:13:52.19,0:13:54.42,Flashback,Miya,0,0,0,,Ky është Tonden Minoru-sensei.
Dialogue: 0,0:13:56.07,0:13:58.54,Flashback,Minoru,0,0,0,,Më fal që humba atë afat.
Dialogue: 0,0:13:58.54,0:14:00.65,Flashback,Rei,0,0,0,,Pra{\i1}ky{\i0}është ai?
Dialogue: 0,0:14:50.79,0:14:54.12,Flashback Italics,Rei,0,0,0,,Gëzohem që u bëra mangiste.
Dialogue: 0,0:15:02.39,0:15:05.07,Default,Nana,0,0,0,,Kjo sjell shumë kujtime.
Dialogue: 0,0:15:07.84,0:15:10.35,Default,Sign,0,0,0,,{\an8\fnArial\bord0\shad0\blur0.2\fs16\b1\fax-0.1\fay0.01\c&HF2DDC3&\frz10\pos(460,178)\frx4\fry350}Jimbocho
Dialogue: 0,0:15:09.29,0:15:11.31,Default,Kokoro,0,0,0,,Ishte e gjitha kaq e mahnitshme.
Dialogue: 0,0:15:11.31,0:15:12.43,Default,Ai,0,0,0,,Po.
Dialogue: 0,0:15:13.82,0:15:16.65,Default,Ai,0,0,0,,Kaq shumë libra.
Dialogue: 0,0:15:16.65,0:15:18.96,Default,Ai,0,0,0,,Dhe gjetëm librin e Sensei-t.
Dialogue: 0,0:15:19.98,0:15:21.32,Default,Sign,0,0,0,,{\fad(480,0)\an8\fnGeorgia\b1\blur0.2\bord0\fs18\fax0.2\shad0\c&H555759&\frz357\pos(175,92)}Libër i Përdorur në Shitje
Dialogue: 0,0:15:19.98,0:15:21.32,Default,Sign,0,0,0,,{\fad(480,0)\an8\fnGeorgia\b1\blur0.2\bord0\fs18\fax0.2\shad0\c&H555759&\frz357\pos(387,103)}Libra Jimbo
