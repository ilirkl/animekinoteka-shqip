Dialogue: 0,0:18:33.38,0:18:36.69,Default,Ai,0,0,0,,Këto janë nga një sërë botuesish.
Dialogue: 1,0:18:40.28,0:18:42.60,Default,Hikaru,0,0,0,,Nuk jam e interesuar për momentin.
Dialogue: 0,0:18:42.60,0:18:44.15,Default,Ai,0,0,0,,Çfarë?
Dialogue: 0,0:18:44.15,0:18:46.98,Default,Hikaru,0,0,0,,Ai-chan, do të të falënderoj për këtë më vonë.
Dialogue: 0,0:18:48.54,0:18:50.86,Default,Pokota,0,0,0,,Hikaru-chan vërtet është e mahnitshme.
Dialogue: 0,0:18:50.86,0:18:54.51,Default,Ai,0,0,0,,Sikur të isha unë, do të kërceja nga gëzimi.
Dialogue: 0,0:18:56.48,0:18:58.27,Default,Pokota,0,0,0,,Yasumi, shiko.
Dialogue: 0,0:19:00.42,0:19:04.39,Default,Sign,0,0,0,,{\fad(1000,250)\fnArial Black\fs20\fscx90\fax-0.08\shad0\blur0.2\3c&HECF3F5&\c&H6C7A81&\frz3.656\move(312.5,17,312.5,39)}Zyra Editoriale e Mangës në Vend
Dialogue: 0,0:19:00.42,0:19:04.39,Default,Sign,0,0,0,,{\fad(1000,250)\fnArial Black\fs20\fscx90\fax-0.08\shad0\blur0.2\3c&HECF3F5&\c&H6C7A81&\frz3.656\move(313,31,313,53)}Sporteli i Pranimit të Dorëzimeve
Dialogue: 0,0:19:00.89,0:19:04.24,Default,Ai,0,0,0,,"Zyra Editoriale e Mangës në Vend"?
Dialogue: 0,0:19:04.18,0:19:06.88,Default,Sign,0,0,0,,{\fad(450,0)\i1\bord1.2\shad0\an8\fnImpact\3c&H7169D9&\c&H3D32A0&\frz359\pos(430,80)}Gessan
Dialogue: 0,0:19:04.24,0:19:06.88,Default,Ai,0,0,0,,Oh, është ai redaktori nga hera e kaluar.
Dialogue: 0,0:19:06.88,0:19:09.34,Default,Pokota,0,0,0,,Do ta provosh fatin përsëri me të?
Dialogue: 0,0:19:09.34,0:19:11.37,Default,Ai,0,0,0,,Kjo është tepër e frikshme.
Dialogue: 0,0:19:11.37,0:19:14.88,Default,Ai,0,0,0,,Përveç kësaj, duhet të kthehem në stendën tonë\Ndhe të ndihmoj të shes librat.
Dialogue: 0,0:19:14.88,0:19:14.92,Default,Sign,0,0,0,,{\an8\bord0\shad0\b1\blur0.2\fs38\fay0.045\fnComic Sans MS\pos(326,268)\c&H32313E&}Të shitura
Dialogue: 0,0:19:14.92,0:19:15.01,Default,Sign,0,0,0,,{\an8\bord0\shad0\b1\blur0.2\fs26\t(\fs24.5)\fay0.045\fnComic Sans MS\c&H32313E&\move(342,246,352,240)}Të shitura
Dialogue: 0,0:19:15.01,0:19:15.18,Default,Sign,0,0,0,,{\an8\bord0\shad0\b1\blur0.2\fs24.5\t(\fs23)\fay0.045\fnComic Sans MS\c&H32313E&\move(352,240,353,237)}Të shitura
Dialogue: 0,0:19:15.18,0:19:15.47,Default,Sign,0,0,0,,{\an8\bord0\shad0\b1\blur0.2\fs23\t(\fs22)\fay0.045\fnComic Sans MS\c&H32313E&\move(353,237,353,237)}Të shitura
Dialogue: 0,0:19:15.47,0:19:16.38,Default,Sign,0,0,0,,{\an8\bord0\shad0\b1\blur0.2\fs22\t(\fs21.5)\fay0.045\fnComic Sans MS\c&H32313E&\move(353,237,354,236)}Të shitura
Dialogue: 0,0:19:15.27,0:19:17.66,Default,Ai,0,0,0,,Çfarë?! I shitët të gjitha?
Dialogue: 0,0:19:17.66,0:19:21.65,Default,Kokoro,0,0,0,,Duket se Hikaru-chan na reklamoi\Nnë llogarinë e saj sociale.
Dialogue: 0,0:19:21.65,0:19:24.45,Default,Kokoro,0,0,0,,Akafuku-san tashmë ka shkuar\Ntë eksplorojë ambientin.
Dialogue: 0,0:19:22.78,0:19:27.40,Default,Sign,0,0,0,,{\fad(500,0)\an7\bord0\shad0\b1\fscx90\fs15\pos(334,116)\fax-0.02\frz352.2\c&HBAB8B9&\frx2\fry354}Kjo manga është më e mira\NStenda Fu-16B\NKlubi i Mangës i Shkollës\NSouth Oshima\N{\i1}Kënga e Planetit{\i0}\N@ Comitia
Dialogue: 0,0:19:24.83,0:19:27.40,Default,Ai,0,0,0,,Kjo është ajo që ajo quajti "falënderim"?
Dialogue: 0,0:19:27.40,0:19:31.68,Default,Kokoro,0,0,0,,Oh, por disa njerëz na njihnin\Nedhe nga postimet tona.
Dialogue: 0,0:19:31.68,0:19:32.99,Default,Ai,0,0,0,,Vërtet?
Dialogue: 0,0:19:32.99,0:19:35.77,Default,Kokoro,0,0,0,,Ndonëse asnjë prej tyre nuk bleu një kopje.
Dialogue: 0,0:19:38.78,0:19:41.24,Default,Ai,0,0,0,,Mendoj se është mirë që shitëm gjithçka.
Dialogue: 0,0:19:43.54,0:19:47.26,Default,Ai,0,0,0,,Por doja të dija si do të kishim dalë\Nvetëm ne.
Dialogue: 0,0:19:47.75,0:19:49.69,Default,Urara,0,0,0,,T-Të shitura?!
Dialogue: 0,0:19:50.17,0:19:52.03,Default,Ai,0,0,0,,Oh, Loup Garou-san.
Dialogue: 0,0:19:52.72,0:19:55.14,Default,Urara,0,0,0,,T-Të shitura. T-T-Të shitura...
Dialogue: 0,0:19:58.82,0:20:00.73,Default,Urara,0,0,0,,Mos mendo se ke fituar ende!
Dialogue: 0,0:20:04.91,0:20:06.60,Default,Sign,0,0,0,,{\i1\bord1.2\shad0\an8\fnImpact\c&HFFFFFF&\3c&HFFFFFF&\t(30,290,0.6,\3c&H7169D9&\c&H3D32A0&)\frz359\pos(430,80)}Gessan
Dialogue: 0,0:20:11.14,0:20:15.17,Default,Pokota,0,0,0,,Yasumi, çfarë do të bënte\Nnjë protagonist mange këtu?
Dialogue: 0,0:20:18.88,0:20:22.24,Default,Pokota,0,0,0,,Hej, Yasumi. Po dëgjon?
Dialogue: 0,0:20:25.66,0:20:26.92,Default,Ai,0,0,0,,Kokoro-chan.
Dialogue: 0,0:20:28.46,0:20:31.83,Default,Ai,0,0,0,,Çfarë do të bënte një protagonist mange këtu?
Dialogue: 0,0:20:31.83,0:20:32.85,Default,Kokoro,0,0,0,,Çfarë?
Dialogue: 0,0:20:33.42,0:20:34.92,Default,Sign,0,0,0,,{\fnArial Black\fs25\fscx90\fax-0.08\shad0\blur0.2\3c&HEFF4F4&\c&H616769&\frz3.656\pos(312.5,68.5)}Zyra Editoriale e Mangës në Vend
Dialogue: 0,0:20:33.42,0:20:34.92,Default,Sign,0,0,0,,{\fnArial Black\fs25\fscx90\fax-0.08\shad0\blur0.2\3c&HEFF4F4&\c&H616769&\frz3.656\pos(313,84.5)}Sporteli i Pranimit të Dorëzimeve
Dialogue: 0,0:20:39.55,0:20:42.24,Top,Editor,0,0,0,,Oh, ke një sens të mrekullueshëm për këtë.
Dialogue: 0,0:20:42.24,0:20:43.60,Top,Manga Artist,0,0,0,,Vërtet e mendon?
Dialogue: 0,0:20:45.23,0:20:46.01,Default,Ai,0,0,0,,Më falni.
Dialogue: 0,0:20:46.01,0:20:50.17,Top,Editor,0,0,0,,E gjeta novatore dhe e lexova me kënaqësi.
Dialogue: 0,0:20:56.51,0:21:00.05,Default,Ai,0,0,0,,A mund të lexoni mangën tonë, ju lutem?
Dialogue: 0,0:21:01.66,0:21:03.77,Default,Tanba,0,0,0,,Prit, unë jam përgjegjës për dorëzimet e...
Dialogue: 0,0:21:04.08,0:21:05.07,Default,Hana,0,0,0,,Tanba-kun.
Dialogue: 0,0:21:05.07,0:21:05.64,Default,Tanba,0,0,0,,Hë?
Dialogue: 0,0:21:05.64,0:21:06.33,Default,Hana,0,0,0,,Është në rregull.
Dialogue: 0,0:21:20.44,0:21:21.90,Default,Hana,0,0,0,,Do të kënaqem t'i hedh një sy.
Dialogue: 0,0:21:22.80,0:21:24.26,Default,Sign,0,0,0,,{\fnArial\b1\bord0\shad0\an8\blur0.2\fs16\move(324,220,324,404)\c&HE6ECED&}Akafuku Sou\NKlubi i Mangës i Shkollës South Oshima 03
