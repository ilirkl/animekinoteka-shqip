Dialogue: 0,0:00:11.68,0:00:14.97,On Top,,0,0,0,,{\i1}kakero todoku made{\i0}
Dialogue: 0,0:00:15.02,0:00:19.31,On Top,,0,0,0,,{\i1}kimi ni todoku made{\i0}
Dialogue: 0,0:00:24.40,0:00:27.57,On Top,,0,0,0,,{\i1}aoku sunda unabara{\i0}
Dialogue: 0,0:00:28.11,0:00:30.91,On Top,,0,0,0,,{\i1}kiseki no kakera{\i0}
Dialogue: 0,0:00:31.70,0:00:37.20,On Top,,0,0,0,,{\i1}kazoekirenai hodo deaeta ne{\i0}
Dialogue: 0,0:00:37.75,0:00:40.37,On Top,,0,0,0,,{\i1}susumu tabi susumu tabi{\i0}
Dialogue: 0,0:00:40.42,0:00:44.21,On Top,,0,0,0,,{\i1}goru wa mada mienai mama{\i0}
Dialogue: 0,0:00:44.25,0:00:47.76,On Top,,0,0,0,,{\i1}demo nandatte koerareru yo{\i0}
Dialogue: 0,0:00:47.80,0:00:51.18,On Top,,0,0,0,,{\i1}sono egao mitai kara{\i0}
Dialogue: 0,0:00:51.22,0:00:55.39,On Top,,0,0,0,,{\i1}mayoeba hikari ni nareya shinakatta{\i0}
Dialogue: 0,0:00:55.43,0:00:58.98,On Top,,0,0,0,,{\i1}yowasa mo chanto tagayashita{\i0}
Dialogue: 0,0:00:59.02,0:01:04.56,On Top,,0,0,0,,{\i1}hontou honki de ita bokura mada{\i0}
Dialogue: 0,0:01:04.61,0:01:08.49,On Top,,0,0,0,,{\i1}kawaranai yo{\i0}
Dialogue: 0,0:01:08.53,0:01:09.61,On Top,,0,0,0,,{\i1}kakero{\i0}
Dialogue: 0,0:01:09.65,0:01:17.16,On Top,,0,0,0,,{\i1}todoku made kimi ni todoku made nee{\i0}
Dialogue: 0,0:01:17.20,0:01:23.83,On Top,,0,0,0,,{\i1}densetsu miman datte joutou joutou{\i0}
Dialogue: 0,0:01:23.88,0:01:30.30,On Top,,0,0,0,,{\i1}kirameku chizu itsuka waraeru hi made{\i0}
Dialogue: 0,0:01:30.34,0:01:36.51,On Top,,0,0,0,,{\i1}mou mayoi wa nainda Fighter daijoubu{\i0}
Dialogue: 0,0:21:34.13,0:21:37.80,On Top,,0,0,0,,{\i1}kenmei ni me wo korashite{\i0}
Dialogue: 0,0:21:39.55,0:21:43.30,On Top,,0,0,0,,{\i1}genzaichi wo tashikameteiru{\i0}
Dialogue: 0,0:21:44.76,0:21:49.31,On Top,,0,0,0,,{\i1}mousou to zetsubou ni nareta noumiso dewa{\i0}
Dialogue: 0,0:21:49.35,0:21:52.60,On Top,,0,0,0,,{\i1}doushitatte chotto zurechimau ya{\i0}
Dialogue: 0,0:21:53.23,0:21:57.02,On Top,,0,0,0,,{\i1}senmei ni ukandekuru no wa{\i0}
Dialogue: 0,0:21:58.40,0:22:02.07,On Top,,0,0,0,,{\i1}itsudatte hidoi omoide de{\i0}
Dialogue: 0,0:22:03.78,0:22:08.20,On Top,,0,0,0,,{\i1}kantan na taikutsu wo hiroiatsumete wa{\i0}
Dialogue: 0,0:22:08.24,0:22:11.79,On Top,,0,0,0,,{\i1}dareka mitai ni nacchimaisou{\i0}
Dialogue: 0,0:22:13.37,0:22:16.46,On Top,,0,0,0,,{\i1}ore ni niau mirai wa doredarou{\i0}
Dialogue: 0,0:22:16.50,0:22:20.38,On Top,,0,0,0,,{\i1}koko kara jaa ikura me wo korashitemo{\i0}
Dialogue: 0,0:22:20.42,0:22:22.84,On Top,,0,0,0,,{\i1}nanimo mie wa shinai sa{\i0}
Dialogue: 0,0:22:22.88,0:22:26.30,On Top,,0,0,0,,{\i1}gyakufuu ni nokkatte{\i0}
Dialogue: 0,0:22:26.35,0:22:29.18,On Top,,0,0,0,,{\i1}machigatta kuusou wo{\i0}
Dialogue: 0,0:22:29.22,0:22:33.64,On Top,,0,0,0,,{\i1}kirisaita unmei no sakeme ni nagashikomu{\i0}
Dialogue: 0,0:22:33.69,0:22:37.19,On Top,,0,0,0,,{\i1}daremo ga sou yatte{\i0}
Dialogue: 0,0:22:37.23,0:22:41.74,On Top,,0,0,0,,{\i1}inochigake no genjitsu wo kasaneteirunda{\i0}
Dialogue: 0,0:22:41.78,0:22:44.32,On Top,,0,0,0,,{\i1}negau hima mo nai hodo{\i0}
Dialogue: 0,0:22:44.36,0:22:48.87,On Top,,0,0,0,,{\i1}sawagashii ashita ga kuru{\i0}
Dialogue: 0,0:22:48.91,0:22:53.71,On Top,,0,0,0,,{\i1}sono mirai wa hora{\i0}
Dialogue: 0,0:22:53.75,0:22:57.88,On Top,,0,0,0,,{\i1}ore no mon da yo{\i0}
Dialogue: 0,0:00:08.68,0:00:11.68,Default,,0,0,0,,
Dialogue: 0,0:00:11.68,0:00:14.97,Default,,0,0,0,,{\i1}Vrapo, derisa t'arrijmë{\i0}
Dialogue: 0,0:00:15.02,0:00:19.31,Default,,0,0,0,,{\i1}Derisa të arrijmë te ti{\i0}
Dialogue: 0,0:00:24.40,0:00:27.57,Default,,0,0,0,,{\i1}Deti i hapur, blu e kthjellët{\i0}
Dialogue: 0,0:00:28.11,0:00:30.91,Default,,0,0,0,,{\i1}Një thërrime mrekullie{\i0}
Dialogue: 0,0:00:31.70,0:00:37.20,Default,,0,0,0,,{\i1}Kemi hasur më shumë\Nse sa mund të imagjinonim{\i0}
Dialogue: 0,0:00:37.75,0:00:40.37,Default,,0,0,0,,{\i1}Me çdo hap që hedhim në këtë udhëtim{\i0}
Dialogue: 0,0:00:40.42,0:00:44.21,Default,,0,0,0,,{\i1}Qëllimi është ende jashtë pamjes{\i0}
Dialogue: 0,0:00:44.25,0:00:47.76,Default,,0,0,0,,{\i1}Por mund të kapërcejmë çdo gjë{\i0}
Dialogue: 0,0:00:47.80,0:00:51.18,Default,,0,0,0,,{\i1}Vetëm për të parë buzëqeshjen tënde{\i0}
Dialogue: 0,0:00:51.22,0:00:55.39,Default,,0,0,0,,{\i1}Sikur të lëkundeshim, nuk mund të shndritnim{\i0}
Dialogue: 0,0:00:55.43,0:00:58.98,Default,,0,0,0,,{\i1}Përpiqeshim edhe të mundnim dobësitë tona{\i0}
Dialogue: 0,0:00:59.02,0:01:04.56,Default,,0,0,0,,{\i1}Ne, që ishim vërtet të përkushtuar{\i0}
Dialogue: 0,0:01:04.61,0:01:08.49,Default,,0,0,0,,{\i1}Kemi qenë gjithmonë të njëjtë{\i0}
Dialogue: 0,0:01:08.53,0:01:09.61,Default,,0,0,0,,{\i1}Vrapo{\i0}
Dialogue: 0,0:01:09.65,0:01:17.16,Default,,0,0,0,,{\i1}Derisa të arrijmë\NDerisa të arrijmë te ti, hej{\i0}
Dialogue: 0,0:01:17.20,0:01:23.83,Default,,0,0,0,,{\i1}Më pak se legjendar?\NAsnjë problem! Gjithçka në rregull!{\i0}
Dialogue: 0,0:01:23.88,0:01:30.30,Default,,0,0,0,,{\i1}Deri në ditën që mund të qeshim\NNdiqe hartën e shndritshme{\i0}
Dialogue: 0,0:01:30.34,0:01:36.51,Default,,0,0,0,,{\i1}Pra, pa hezitim, luftëtar\NDo të jetë në rregull{\i0}
Dialogue: 0,0:01:45.36,0:01:46.90,Default,,0,0,0,,{\i1}Kryetar Jarul!{\i0}
Dialogue: 0,0:01:47.98,0:01:50.36,Default,,0,0,0,,Mos u shqetëso për mua!
Dialogue: 0,0:01:51.95,0:01:53.20,Default,,0,0,0,,Unë...
Dialogue: 0,0:01:55.32,0:01:57.41,Default,,0,0,0,,...gjithmonë kam pasur fat, ndaj...
Dialogue: 0,0:01:59.49,0:02:02.16,Default,,0,0,0,,Do të jem mirë!
Dialogue: 0,0:02:18.56,0:02:20.68,Default,,0,0,0,,{\i1}Digje...{\i0}
Dialogue: 0,0:02:21.22,0:02:24.14,Default,,0,0,0,,{\i1}...bibliotekën.{\i0}
Dialogue: 0,0:02:32.86,0:02:33.78,Default,,0,0,0,,Ti je...
Dialogue: 0,0:02:34.24,0:02:36.16,Default,,0,0,0,,...Scopper Gaban!
Dialogue: 0,0:03:04.48,0:03:10.57,Default,,0,0,0,,{\i1}"Një sekondë vendimtare -\NGaban kundër Kalorësve të Zotit"{\i0}
Dialogue: 0,0:03:34.42,0:03:35.13,Default,,0,0,0,,Kush...
Dialogue: 0,0:03:37.63,0:03:39.34,Default,,0,0,0,,Kush është ai?!
Dialogue: 0,0:03:41.93,0:03:43.52,Default,,0,0,0,,Jam bërë i ndryshkur...
Dialogue: 0,0:03:49.40,0:03:51.11,Default,,0,0,0,,Sulmi funksionoi?!
Dialogue: 0,0:04:02.20,0:04:03.37,Default,,0,0,0,,Dreqin!
Dialogue: 0,0:04:26.93,0:04:27.93,Default,,0,0,0,,Thorn Sulation!
Dialogue: 0,0:04:37.90,0:04:39.32,Default,,0,0,0,,Gllabëruesi i Maleve...
Dialogue: 0,0:04:40.11,0:04:42.20,Default,,0,0,0,,Pse je këtu në Elbaph?!
Dialogue: 0,0:04:42.66,0:04:45.29,Default,,0,0,0,,Le të lëmë bisedat serioze.
Dialogue: 0,0:05:03.93,0:05:05.85,Default,,0,0,0,,E takove në kështjellë?!
Dialogue: 0,0:05:05.97,0:05:07.77,Default,,0,0,0,,Po, më herët, rastësisht.
Dialogue: 0,0:05:08.35,0:05:10.64,Default,,0,0,0,,Luffy dhe Zoro\Nu mposhtën plotësisht prej tij.
Dialogue: 0,0:05:10.77,0:05:12.23,Default,,0,0,0,,Prej atij plakut?!
Dialogue: 0,0:05:12.69,0:05:15.86,Default,,0,0,0,,Nëse dëgjova mirë,\Ntha Scopper Gaban.
Dialogue: 0,0:05:15.98,0:05:19.99,Default,,0,0,0,,E drejtë! Ishte Krahu i Majtë i Mbretit të Piratëve,\Nkundërparti i Rayleigh!
Dialogue: 0,0:05:20.11,0:05:22.57,Default,,0,0,0,,Pse është këtu në tokën e Gjigantëve?
Dialogue: 0,0:05:24.07,0:05:26.74,Default,,0,0,0,,Ndoshta jam i palëvizshëm,\Npor mund ta mbështes me fuqinë time!
Dialogue: 0,0:05:30.25,0:05:32.04,Default,,0,0,0,,Jo, Robin!
Dialogue: 0,0:05:32.08,0:05:33.92,Default,,0,0,0,,Kundër gjembave të tij prej hekuri,
Dialogue: 0,0:05:33.96,0:05:37.46,Default,,0,0,0,,stili yt i luftimit nga afër\Ntë lë në disavantazh!
Dialogue: 0,0:05:37.59,0:05:39.92,Default,,0,0,0,,Është ai për të cilin Oimo dhe të tjerët\Npo flisnin.
Dialogue: 0,0:05:39.97,0:05:41.68,Default,,0,0,0,,S'është çudi që është i fortë.
Dialogue: 0,0:05:59.65,0:06:02.99,Default,,0,0,0,,{\i1}Dora e tij e djathtë ende nuk është rigjeneruar...{\i0}
Dialogue: 0,0:06:05.12,0:06:09.16,Default,,0,0,0,,{\i1}Saul tha se Kalorësit e Zotit\Nishin të pavdekshëm...{\i0}
Dialogue: 0,0:06:09.20,0:06:10.29,Default,,0,0,0,,{\i1}Atëherë pse?{\i0}
Dialogue: 0,0:06:10.66,0:06:12.54,Default,,0,0,0,,{\i1}Pse funksionoi sulmi i tij?!{\i0}
Dialogue: 0,0:06:12.58,0:06:15.00,Default,,0,0,0,,{\i1}Nuk mund të jetë thjesht sepse është i fortë.{\i0}
Dialogue: 0,0:06:22.22,0:06:23.97,Default,,0,0,0,,O bastard!
Dialogue: 0,0:06:34.81,0:06:36.98,Default,,0,0,0,,Çfarë dreqin ke?!
Dialogue: 0,0:06:39.48,0:06:41.53,Default,,0,0,0,,Mjaft tashmë!
Dialogue: 0,0:06:41.99,0:06:44.36,Default,,0,0,0,,Thorn Hunt!
Dialogue: 0,0:06:57.13,0:06:59.25,Default,,0,0,0,,Edhe një Thorn Hunt!
Dialogue: 0,0:07:07.34,0:07:08.85,Default,,0,0,0,,Thorn Hunt!
Dialogue: 0,0:07:11.06,0:07:12.60,Default,,0,0,0,,Dhe...
Dialogue: 0,0:07:19.86,0:07:21.78,Default,,0,0,0,,...Ferra e Lotosit të Kuq!
Dialogue: 0,0:07:21.82,0:07:25.15,Default,,0,0,0,,Kjo është ajo që thonë\N"as dyshemenë nuk e shikon"!
Dialogue: 0,0:07:25.28,0:07:26.53,Default,,0,0,0,,Po?
Dialogue: 0,0:07:26.99,0:07:29.78,Default,,0,0,0,,Nuk ka vend për të ikur,\Nas në ajër e as në tokë!
Dialogue: 0,0:07:29.82,0:07:31.79,Default,,0,0,0,,Do të të shpoj!
Dialogue: 0,0:07:40.17,0:07:41.71,Default,,0,0,0,,Kjo mbaroi në një çast!
Dialogue: 0,0:07:43.67,0:07:45.42,Default,,0,0,0,,Më vjen keq, por...
Dialogue: 0,0:07:53.89,0:07:55.56,Default,,0,0,0,,...jam me nxitim!
Dialogue: 0,0:08:09.49,0:08:10.37,Default,,0,0,0,,Silleni!
Dialogue: 0,0:08:25.71,0:08:27.22,Default,,0,0,0,,Simfonia e Sëpatës.
Dialogue: 0,0:08:29.59,0:08:31.51,Default,,0,0,0,,Dreqin...
Dialogue: 0,0:08:57.16,0:09:00.58,Default,,0,0,0,,{\i1}Më prit, Collun, fëmijë.{\i0}
Dialogue: 0,0:09:01.83,0:09:03.79,Default,,0,0,0,,{\i1}Do të jem atje menjëherë.{\i0}
Dialogue: 0,0:09:25.32,0:09:26.40,Default,,0,0,0,,Uau!
Dialogue: 0,0:09:26.44,0:09:27.73,Default,,0,0,0,,O Zot!
Dialogue: 0,0:09:32.24,0:09:34.24,Default,,0,0,0,,Çfarë?!
Dialogue: 0,0:09:34.37,0:09:36.33,Default,,0,0,0,,Ai e rrëzoi...
Dialogue: 0,0:09:45.59,0:09:47.55,Default,,0,0,0,,Çfarë?! Chopper-san?!
Dialogue: 0,0:09:47.67,0:09:49.38,Default,,0,0,0,,Edhe ti ishe këtu?!
Dialogue: 0,0:09:49.84,0:09:51.34,Default,,0,0,0,,Ku po shkon?!
Dialogue: 0,0:09:54.72,0:09:58.01,Default,,0,0,0,,{\i1}Vetëm ai mundi të plagoste\Nnjë prej të pavdekshmëve...{\i0}
Dialogue: 0,0:09:58.06,0:10:00.14,Default,,0,0,0,,{\i1}Kjo është ndoshta e rëndësishme!{\i0}
Dialogue: 0,0:10:00.18,0:10:01.48,Default,,0,0,0,,{\i1}Duhet të zbuloj pse!{\i0}
Dialogue: 0,0:10:07.98,0:10:10.07,Default,,0,0,0,,Mjafton.
Dialogue: 0,0:10:13.15,0:10:15.24,Default,,0,0,0,,Punë e mirë.
Dialogue: 0,0:10:18.33,0:10:21.96,Default,,0,0,0,,Të dish se je i gatshëm është e mjaftueshme.
Dialogue: 0,0:10:22.96,0:10:25.21,Default,,0,0,0,,Do të merrem unë me atë.
Dialogue: 0,0:10:36.76,0:10:38.26,Default,,0,0,0,,Ai digjet vërtet mirë!
Dialogue: 0,0:10:48.02,0:10:50.98,Default,,0,0,0,,Fjalët e të lashtëve...
Dialogue: 0,0:10:51.90,0:10:54.11,Default,,0,0,0,,Gjithë ajo histori...
Dialogue: 0,0:10:59.37,0:11:00.70,Default,,0,0,0,,Biblioteka është...
Dialogue: 0,0:11:07.08,0:11:10.38,Default,,0,0,0,,{\i1}Flet Killingham. Objektivat në flakë.{\i0}
Dialogue: 0,0:11:11.46,0:11:13.17,Default,,0,0,0,,Kthehu, i vogli.
Dialogue: 0,0:11:24.60,0:11:26.98,Default,,0,0,0,,Pse nuk tregon pak entuziazëm?
Dialogue: 0,0:11:34.86,0:11:35.99,Default,,0,0,0,,Më fal!
Dialogue: 0,0:11:38.95,0:11:39.99,Default,,0,0,0,,Më fal...
Dialogue: 0,0:11:40.78,0:11:42.37,Default,,0,0,0,,...që jam gjallë!
Dialogue: 0,0:11:44.95,0:11:47.92,Default,,0,0,0,,Për shkakun tim, gjithçka është në flakë!
Dialogue: 0,0:11:48.42,0:11:50.71,Default,,0,0,0,,Ronja! Nuk është faji yt!
Dialogue: 0,0:11:50.84,0:11:52.30,Default,,0,0,0,,Mos e thuaj atë, Ronja!
Dialogue: 0,0:11:52.84,0:11:56.51,Default,,0,0,0,,Më fal që jam gjallë!
Dialogue: 0,0:11:57.80,0:11:59.22,Default,,0,0,0,,{\i1}Më fal!{\i0}
Dialogue: 0,0:12:00.26,0:12:02.06,Default,,0,0,0,,Më fal!
Dialogue: 0,0:12:05.56,0:12:07.60,Default,,0,0,0,,Më fal!
Dialogue: 0,0:12:07.73,0:12:10.77,Default,,0,0,0,,Askush nuk të fajëson!
Dialogue: 0,0:12:17.40,0:12:19.36,Default,,0,0,0,,Kulturë, histori...
Dialogue: 0,0:12:19.82,0:12:20.95,Default,,0,0,0,,Fëmijë!
Dialogue: 0,0:12:21.49,0:12:22.95,Default,,0,0,0,,Forcë ushtarake!
Dialogue: 0,0:12:22.99,0:12:26.50,Default,,0,0,0,,Ju njerëz nuk keni të drejtë të vidhni asgjë!
Dialogue: 0,0:12:30.38,0:12:32.54,Default,,0,0,0,,Anëtari i ekuipazhit të Mbretit të Piratëve...
Dialogue: 0,0:12:32.59,0:12:34.46,Default,,0,0,0,,A do të na kundërshtosh?
Dialogue: 0,0:12:34.50,0:12:37.13,Default,,0,0,0,,Çdo rezistencë do t'u kushtojë\Njetën pengjeve.
Dialogue: 0,0:12:39.09,0:12:40.43,Default,,0,0,0,,Është Z. Ya!
Dialogue: 0,0:12:40.84,0:12:41.51,Default,,0,0,0,,Çfarë?!
Dialogue: 0,0:12:43.64,0:12:45.39,Default,,0,0,0,,A erdhi të na ndihmojë?
Dialogue: 0,0:12:45.52,0:12:47.02,Default,,0,0,0,,Çfarë? Ku?
Dialogue: 0,0:12:47.14,0:12:49.44,Default,,0,0,0,,Collun! Z. Ya është këtu!
Dialogue: 0,0:12:49.81,0:12:50.48,Default,,0,0,0,,Çfarë?
Dialogue: 0,0:12:50.85,0:12:53.69,Default,,0,0,0,,{\i1}Mos më thërrit, Collun.{\i0}
Dialogue: 0,0:13:06.16,0:13:08.83,Default,,0,0,0,,Jeee!
Dialogue: 0,0:13:24.55,0:13:28.18,Default,,0,0,0,,Babi!
Dialogue: 0,0:13:35.19,0:13:37.32,Default,,0,0,0,,Djema, do të jemi mirë!
Dialogue: 0,0:13:37.36,0:13:40.28,Default,,0,0,0,,Babai im është më i forti se kushdo!
Dialogue: 0,0:14:05.55,0:14:06.26,Default,,0,0,0,,Hë?
Dialogue: 0,0:14:06.64,0:14:09.56,Default,,0,0,0,,Pra, nuk të prish punë nëse e vras, apo jo?
Dialogue: 0,0:14:09.60,0:14:12.39,Default,,0,0,0,,Prandaj po më sfidon.
Dialogue: 0,0:14:14.27,0:14:16.40,Default,,0,0,0,,{\i1}Kjo është shansi im i fundit.{\i0}
Dialogue: 0,0:14:17.23,0:14:18.36,Default,,0,0,0,,{\i1}Ka ende kohë...{\i0}
Dialogue: 0,0:14:18.73,0:14:20.82,Default,,0,0,0,,{\i1}...për të shuar zjarrin në bibliotekë.{\i0}
Dialogue: 0,0:14:21.61,0:14:23.28,Default,,0,0,0,,{\i1}Dhe mund t'i shpëtoj fëmijët{\i0}
Dialogue: 0,0:14:23.65,0:14:26.28,Default,,0,0,0,,{\i1}dhe kështu Elbaphin...{\i0}
Dialogue: 0,0:14:28.95,0:14:30.45,Default,,0,0,0,,{\i1}Nëse arrij ta rrëzoj menjëherë.{\i0}
Dialogue: 0,0:14:32.58,0:14:35.54,Default,,0,0,0,,Jo!
Dialogue: 0,0:14:36.63,0:14:38.75,Default,,0,0,0,,Collun! Më jep një sekondë!
Dialogue: 0,0:14:39.50,0:14:42.76,Default,,0,0,0,,Mundo të durosh! Je fëmijë i fortë!
Dialogue: 0,0:14:42.80,0:14:45.09,Default,,0,0,0,,Të premtoj se do ta shpëtoj jetën tënde!
Dialogue: 0,0:14:48.35,0:14:50.47,Default,,0,0,0,,Në rregull, babi!
Dialogue: 0,0:14:50.52,0:14:54.31,Default,,0,0,0,,Jam luftëtar!\NPlagët nuk janë gjë për mua!
Dialogue: 0,0:14:55.06,0:14:59.61,Default,,0,0,0,,Pra rrëzoje!
Dialogue: 0,0:15:02.44,0:15:05.49,Default,,0,0,0,,E di se një jetë e humbur\Nnuk mund të kthehet kurrë.
Dialogue: 0,0:15:09.91,0:15:11.12,Default,,0,0,0,,Collun-kun!
Dialogue: 0,0:15:39.23,0:15:41.57,Default,,0,0,0,,Ky është fëmija ynë, Z. Ya.
Dialogue: 0,0:15:52.99,0:15:54.25,Default,,0,0,0,,Oops...
Dialogue: 0,0:15:54.91,0:15:57.25,Default,,0,0,0,,Është kaq i madh e i lezetshëm...
Dialogue: 0,0:15:57.71,0:16:00.46,Default,,0,0,0,,Faleminderit që e solle në botë,\NRipley.
Dialogue: 0,0:16:50.51,0:16:53.47,Default,,0,0,0,,{\i1}Nëse nuk e ndal tani,\Ngjërat do të keqësohen!{\i0}
Dialogue: 0,0:16:55.35,0:16:57.68,Default,,0,0,0,,Qofsh i sigurt, Collun!
Dialogue: 0,0:17:43.94,0:17:44.65,Default,,0,0,0,,Collun!
Dialogue: 0,0:18:42.46,0:18:43.91,Default,,0,0,0,,Mos e bëj...
Dialogue: 0,0:18:56.89,0:18:58.30,Default,,0,0,0,,Dorëzohem.
Dialogue: 0,0:19:07.48,0:19:09.44,Default,,0,0,0,,{\i1}Më fal, Elbaph.{\i0}
Dialogue: 0,0:19:09.57,0:19:11.61,Default,,0,0,0,,Sa i dobët.
Dialogue: 0,0:19:14.15,0:19:15.86,Default,,0,0,0,,{\i1}Më fal, Collun.{\i0}
Dialogue: 0,0:19:16.49,0:19:18.12,Default,,0,0,0,,{\i1}Të dhembi, apo jo?{\i0}
Dialogue: 0,0:19:18.24,0:19:19.12,Default,,0,0,0,,Çfarë?
Dialogue: 0,0:19:29.13,0:19:33.09,Default,,0,0,0,,Babi!
Dialogue: 0,0:19:35.84,0:19:38.09,Default,,0,0,0,,Babi!
Dialogue: 0,0:19:38.14,0:19:40.76,Default,,0,0,0,,Babi! Babi!
Dialogue: 0,0:19:41.14,0:19:42.64,Default,,0,0,0,,Babi!
Dialogue: 0,0:19:43.77,0:19:47.48,Default,,0,0,0,,Babi!
Dialogue: 0,0:19:49.52,0:19:50.65,Default,,0,0,0,,{\i1}...ti...{\i0}
Dialogue: 0,0:19:51.19,0:19:52.53,Default,,0,0,0,,Atë!
Dialogue: 0,0:19:54.57,0:19:56.28,Default,,0,0,0,,Çfarë është ky kujtim?
Dialogue: 0,0:19:58.66,0:20:01.74,Default,,0,0,0,,{\i1}Ëndrra ime është të bëhem pirat.{\i0}
Dialogue: 0,0:20:06.33,0:20:10.33,Default,,0,0,0,,Duhet ta them, duken kaq të ngjashëm...
Dialogue: 0,0:20:10.46,0:20:13.67,Default,,0,0,0,,Për çfarë po mërmëritje?
Dialogue: 0,0:20:13.80,0:20:16.01,Default,,0,0,0,,Mendo një mënyrë të na nxjerrësh nga kjo!
Dialogue: 0,0:20:16.13,0:20:17.59,Default,,0,0,0,,Oh, më fal.
Dialogue: 0,0:20:19.14,0:20:20.39,Default,,0,0,0,,Brook?!
Dialogue: 0,0:20:27.73,0:20:29.15,Default,,0,0,0,,Ti je, Brook?!
Dialogue: 0,0:20:38.53,0:20:41.53,Default,,0,0,0,,Au, au, au... Nuk mund të lëviz.
Dialogue: 0,0:20:41.66,0:20:44.08,Default,,0,0,0,,{\i1}Çfarë po të vonon kaq shumë?{\i0}
Dialogue: 0,0:20:45.20,0:20:48.75,Default,,0,0,0,,{\i1}Toka e Shenjtë është në flakë tani.{\i0}
Dialogue: 0,0:20:48.87,0:20:49.79,Default,,0,0,0,,{\i1}Imu i Madh!{\i0}
Dialogue: 0,0:20:50.29,0:20:53.63,Default,,0,0,0,,{\i1}Do të na duhen patjetër\Npërforcime.{\i0}
Dialogue: 0,0:20:58.80,0:21:01.76,Default,,0,0,0,,Çfarë i ndodhi asaj?!\NFytyra i duket e tmerrshme tani.
Dialogue: 0,0:21:19.32,0:21:21.53,Default,,0,0,0,,Do t'ju tregoj...
Dialogue: 0,0:21:22.03,0:21:23.95,Default,,0,0,0,,...dominimin e zotit!
Dialogue: 0,0:21:34.13,0:21:37.80,Default,,0,0,0,,{\i1}Ja ku po i tendos të dy sytë{\i0}
Dialogue: 0,0:21:39.55,0:21:43.30,Default,,0,0,0,,{\i1}Dhe po kontrolloj se ku ndodhem tani{\i0}
Dialogue: 0,0:21:44.76,0:21:49.31,Default,,0,0,0,,{\i1}Me trurin tim të konsumuar\NNga gjithë iluzioni e dëshpërimi{\i0}
Dialogue: 0,0:21:49.35,0:21:52.60,Default,,0,0,0,,{\i1}Gjithmonë jam disi i prirur të jem pak larg{\i0}
Dialogue: 0,0:21:53.23,0:21:57.02,Default,,0,0,0,,{\i1}Gjërat që shfaqen qartë{\i0}
Dialogue: 0,0:21:58.40,0:22:02.07,Default,,0,0,0,,{\i1}Janë gjithmonë kujtimet mizore{\i0}
Dialogue: 0,0:22:03.78,0:22:08.20,Default,,0,0,0,,{\i1}Mbledh copëzat\NE mërzisë së thjeshtë të jetës sime{\i0}
Dialogue: 0,0:22:08.24,0:22:11.79,Default,,0,0,0,,{\i1}Mund të shndërrohem në dikë tjetër veç meje{\i0}
Dialogue: 0,0:22:13.37,0:22:16.46,Default,,0,0,0,,{\i1}Pyes veten se cila e ardhme\Ndo t'i shkonte dikujt si unë tani{\i0}
Dialogue: 0,0:22:16.50,0:22:20.38,Default,,0,0,0,,{\i1}Që tani e tutje\NSado të tendosem sytë{\i0}
Dialogue: 0,0:22:20.42,0:22:22.84,Default,,0,0,0,,{\i1}Gjithsesi nuk do të shoh asgjë{\i0}
Dialogue: 0,0:22:22.88,0:22:26.30,Default,,0,0,0,,{\i1}Po hipi mbi erën e kundërt{\i0}
Dialogue: 0,0:22:26.35,0:22:29.18,Default,,0,0,0,,{\i1}E derdh në lotin e fatit{\i0}
Dialogue: 0,0:22:29.22,0:22:33.64,Default,,0,0,0,,{\i1}Ndërsa i copëtoj të gjitha fantazitë e rreme{\i0}
Dialogue: 0,0:22:33.69,0:22:37.19,Default,,0,0,0,,{\i1}Dhe të gjithë{\i0}
Dialogue: 0,0:22:37.23,0:22:41.74,Default,,0,0,0,,{\i1}Grumbullojnë realitetin e tyre të jetës ose vdekjes\NGjithë kohën, pikërisht kështu{\i0}
Dialogue: 0,0:22:41.78,0:22:44.32,Default,,0,0,0,,{\i1}Pastaj e nesërmja vjen shumë e zhurmshme{\i0}
Dialogue: 0,0:22:44.36,0:22:48.87,Default,,0,0,0,,{\i1}Pa lënë kohë as për t'u lutur{\i0}
Dialogue: 0,0:22:48.91,0:22:53.71,Default,,0,0,0,,{\i1}Dhe ajo e ardhme që shohim{\i0}
Dialogue: 0,0:22:53.75,0:22:57.88,Default,,0,0,0,,{\i1}E gjitha më përket mua{\i0}
Dialogue: 0,0:23:04.63,0:23:07.14,Default,,0,0,0,,{\i1}Gunko shndërrohet në një figurë djallëzore.{\i0}
Dialogue: 0,0:23:07.80,0:23:10.72,Default,,0,0,0,,{\i1}Monstrat vazhdojnë të shumohen.\NUsopp dhe të tjerët janë ende të zënë rob.{\i0}
Dialogue: 0,0:23:11.18,0:23:15.23,Default,,0,0,0,,{\i1}Ekuipazhi i Gjigantëve Piratë i tërbuar\Nsulmon Kalorësit e Zotit.{\i0}
Dialogue: 0,0:23:15.73,0:23:19.65,Default,,0,0,0,,{\i1}Hija e dominimit\Nbie mbi Elbaphin e rrezikuar.{\i0}
Dialogue: 0,0:23:19.77,0:23:21.40,Default,,0,0,0,,Në episodin e radhës të ONE PIECE!
Dialogue: 0,0:23:21.44,0:23:25.07,Default,,0,0,0,,"Elbaph në dëshpërim -\NBesëlidhja djallëzore, 'Domi Reversi'"
Dialogue: 0,0:23:25.57,0:23:30.62,Default,,0,0,0,,Do të bëhem Mbret i Piratëve!

