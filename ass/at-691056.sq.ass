Dialogue: 0,0:00:03.40,0:00:04.29,Flashback,LAURA,0,0,0,,Lara...
Dialogue: 0,0:00:08.24,0:00:08.99,Flashback,LUNA,0,0,0,,Lara...
Dialogue: 0,0:00:09.86,0:00:10.74,Flashback,LISA,0,0,0,,Lara...
Dialogue: 0,0:00:11.37,0:00:12.24,Flashback,ROSA,0,0,0,,Lara...
Dialogue: 0,0:00:12.83,0:00:13.80,Flashback,LEAH,0,0,0,,Lara...
Dialogue: 0,0:00:15.35,0:00:16.39,Flashback,YOSHIYA,0,0,0,,Lara-chan.
Dialogue: 0,0:00:17.04,0:00:17.75,Flashback,SETA,0,0,0,,Lara-san.
Dialogue: 0,0:00:18.17,0:00:19.14,Flashback,HIMEKA,0,0,0,,Lara-chan.
Dialogue: 0,0:00:19.82,0:00:20.88,Flashback,LUCA,0,0,0,,Lara.
Dialogue: 0,0:00:22.99,0:00:23.93,Flashback,RIGMOR,0,0,0,,Lara...
Dialogue: 0,0:00:24.62,0:00:27.63,Flashback,RIGMOR,0,0,0,,Çfarë doje vërtet?
Dialogue: 0,0:00:37.05,0:00:38.54,Default,ROWAN,0,0,0,,E bukur.
Dialogue: 0,0:00:40.36,0:00:43.66,Default,ROWAN,0,0,0,,Kështu duhet të jesh.
Dialogue: 0,0:00:44.72,0:00:45.78,Default,LISA,0,0,0,,Baba!
Dialogue: 0,0:00:46.76,0:00:47.87,Default,LISA,0,0,0,,Baba...
Dialogue: 0,0:00:48.57,0:00:49.53,Default,LISA,0,0,0,,Baba!
Dialogue: 0,0:00:58.12,0:01:04.05,Default,ROWAN,0,0,0,,E prisha mallkimin e ilaçit me\Nfuqinë e shtizës së Familjes sonë Mbretërore.
Dialogue: 0,0:01:05.93,0:01:12.54,Default,ROWAN,0,0,0,,Këmbët e njerëzve të ulët e ndotin\Ndritën dhe t'i mjegullojnë sytë.
Dialogue: 0,0:01:13.16,0:01:13.99,Default,LARA,0,0,0,,Çfarë...?
Dialogue: 0,0:01:13.99,0:01:17.22,Default,ROWAN,0,0,0,,Tani është koha të përmbushësh\Ndetyrën tënde si princeshë.
Dialogue: 0,0:01:17.88,0:01:21.98,Default,ROWAN,0,0,0,,Përdore tehun tënd për të shpuar\Natë që do,
Dialogue: 0,0:01:22.41,0:01:24.24,Default,ROWAN,0,0,0,,pastaj dritën,
Dialogue: 0,0:01:24.24,0:01:26.86,Default,ROWAN,0,0,0,,dhe jepu atyre njerëzve të ulët atë që...
Dialogue: 0,0:01:25.18,0:01:26.86,Default Top,LARA,0,0,0,,N-Nuk kuptoj!
Dialogue: 0,0:01:28.62,0:01:30.36,Default,ROWAN,0,0,0,,Nuk ka nevojë...
Dialogue: 0,0:01:35.38,0:01:36.24,Default,LISA,0,0,0,,Jo!
Dialogue: 0,0:01:36.51,0:01:38.03,Default,LISA,0,0,0,,Ky vend është gati të rrëzohet.
Dialogue: 0,0:01:38.56,0:01:40.69,Default,LISA,0,0,0,,Lara! Ndihmoji babait!
Dialogue: 0,0:01:44.56,0:01:45.55,Default,MARI,0,0,0,,Çfarë është ajo?
Dialogue: 0,0:01:50.86,0:01:52.92,Italics,ANNOUNCER,0,0,0,,Në Liqenin Biwa, Prefektura Shiga,
Dialogue: 0,0:01:52.92,0:01:55.95,Italics,ANNOUNCER,0,0,0,,ndërsa këtë muaj u konfirmua një\Nlloj i ri bime ujore,
Dialogue: 0,0:01:55.95,0:01:58.22,Italics,ANNOUNCER,0,0,0,,u zbuluan edhe mikroorganizma\Ntë paidentifikuar më parë,
Dialogue: 0,0:01:52.90,0:01:55.34,Default,SIGN,0,0,0,,{\p1\bord0\an8\shad0\c&HF7F7F9&\frz359.9\pos(105,118)\fscx34\fscy8\fad(1380,1)}m 0 0 l 230 0 l 230 215 l 0 215
