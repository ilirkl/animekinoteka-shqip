Dialogue: 0,0:00:00.00,0:00:04.98,Signs,SIGN,0,0,0,,{\an9\bord5\fs15\fnGeorgia}Kjo është një vepër artistike.\NKonsumimi i alkoolit nga të miturit\Nndalohet rreptësisht dhe është i paligjshëm.\NGjithashtu, nuk nxisim pirjen me detyrim\Napo teprimin me alkoolin,\Nas nuk miratojmë veprimet\Ne shthurura e të turpshme që shfaqen\Nnë skenat e dehjes. Ju lutemi\Nta shihni këtë anime vetëm\Nsi komedi. Për më tepër,\Ntë gjithë personazhet që pinë alkool\Njanë në moshë ligjore. Në përputhje me\Nklimën e fundit shoqërore, rrathët e zinj\Njanë zmadhuar me 5% nga ky sezon.
Dialogue: 0,0:00:17.29,0:00:25.34,Signs,TITLECARD,0,0,0,,{\fnGeorgia\fs25\fad(1200,1)\bord4\blur3\3c&HFFFFFF&\c&HC7AB06&\pos(324.444,221.778)}G{\c&H29EBF4&}r{\c&HDCB128&}a{\c&H29EBF4&}n{\c&HDCB128&}d {\c&H29EBF4&}B{\c&HDCB128&}l{\c&H29EBF4&}u{\c&HDCB128&}e Dr{\c&H29EBF4&}ea{\c&HDCB128&}m{\c&H29EBF4&}in{\c&HDCB128&}g {\fs16\c&HDCB128&}Sezo{\c&H29EBF4&}ni {\fs45\b0}3
Dialogue: 0,0:01:41.31,0:01:42.50,Default,AINA,0,0,0,,Kohei...
Dialogue: 0,0:01:43.25,0:01:46.25,Default,AINA,0,0,0,,Më ndihmooo!
Dialogue: 0,0:01:46.99,0:01:49.78,Default,KOHEI,0,0,0,,Ç'kemi kështu? Më thirre\Nqë të më qurravitesh?
Dialogue: 0,0:01:49.78,0:01:53.21,Default,AINA,0,0,0,,S'po gjej dot zgjidhje,\Nsado që e vras mendjen!
Dialogue: 0,0:01:53.86,0:01:57.74,Default,AINA,0,0,0,,Po ti i di të gjitha\Nmarifetet e ndyra, apo jo?
Dialogue: 0,0:01:57.74,0:01:59.85,Default,KOHEI,0,0,0,,Uau. Ç'më bëre qejfin!
Dialogue: 0,0:01:59.85,0:02:00.78,Default,AINA,0,0,0,,E kam gabim?
Dialogue: 0,0:02:00.78,0:02:01.89,Default,KOHEI,0,0,0,,Fatkeqësisht, jo.
Dialogue: 0,0:02:02.22,0:02:05.03,Default,AINA,0,0,0,,Të lutem! Ta gjejmë një ide bashkë!
Dialogue: 0,0:02:05.03,0:02:07.27,Default,KOHEI,0,0,0,,Jo. Jam njeri i zënë.
Dialogue: 0,0:02:07.27,0:02:11.03,Signs,SIGN,0,0,0,,{\fs20\c&HA312BA&\4c&HFFFFFF&\3c&HFFFFFF&\frz324.4\frx10\fry0\move(269,243,264,254,23,3735)}Dashuria e parë
Dialogue: 0,0:02:07.27,0:02:11.03,Default,AINA,0,0,0,,Do të të jap këtë lojën me vajza të bukura\Nqë ma la Kikko!
Dialogue: 0,0:02:11.03,0:02:12.70,Default,KOHEI,0,0,0,,Atëherë s'kam ç'bëj.
Dialogue: 0,0:02:13.03,0:02:15.37,Default,KOHEI,0,0,0,,Hë, për çfarë na duhet ideja?
Dialogue: 0,0:02:15.37,0:02:16.66,Default,AINA,0,0,0,,Po ja...
Dialogue: 0,0:02:17.03,0:02:20.16,Default,AINA,0,0,0,,Dua t'i ndaloj këta të dy\Ntë shkojnë në udhëtim bashkë.
Dialogue: 0,0:02:20.16,0:02:21.70,Default,KOHEI,0,0,0,,Si the?
Dialogue: 0,0:02:21.70,0:02:25.42,Default,AINA,0,0,0,,Po flas për një shoqen time, dakord?
Dialogue: 0,0:02:25.42,0:02:29.54,Default,AINA,0,0,0,,Djali që i pëlqen asaj\Nka fituar ca para së fundmi.
Dialogue: 0,0:02:29.54,0:02:29.98,Default,KOHEI,0,0,0,,Ashtu?
Dialogue: 0,0:02:29.98,0:02:33.85,Default,AINA,0,0,0,,Dhe do t'i shpenzojë\Npër një udhëtim me një vajzë tjetër.
Dialogue: 0,0:02:33.85,0:02:34.57,Default,KOHEI,0,0,0,,Ashtu, hë?
Dialogue: 0,0:02:34.57,0:02:38.18,Default,AINA,0,0,0,,Ajo do t'ua prishë udhëtimin,\Nse ka frikë mos afrohen shumë.
Dialogue: 0,0:02:38.18,0:02:41.56,Default,KOHEI,0,0,0,,E kuptoj. Kitahara dhe Kotegawa\Ndo të shkojnë në udhëtim?
Dialogue: 0,0:02:41.56,0:02:44.06,Default,AINA,0,0,0,,Të thashë, bëhet fjalë për një shoqe!
Dialogue: 0,0:02:44.40,0:02:46.86,Default,AINA,0,0,0,,Atëherë, ç'duhet të bëjë ajo?
Dialogue: 0,0:02:46.86,0:02:48.56,Default,KOHEI,0,0,0,,Pse s'tregohet e sinqertë...
Dialogue: 0,0:02:48.56,0:02:50.37,Default,AINA,0,0,0,,Të lutem, mos shko.
Dialogue: 0,0:02:50.78,0:02:52.69,Default,KOHEI,0,0,0,,dhe thjesht t'i lutet?
Dialogue: 0,0:02:52.69,0:02:55.15,Default,AINA,0,0,0,,Kjo s'bëhet!
Dialogue: 0,0:02:55.15,0:02:55.95,Default,KOHEI,0,0,0,,Pse jo?
Dialogue: 0,0:02:55.95,0:03:01.95,Default,AINA,0,0,0,,P-Po ja, do të ishte e çuditshme\Nt'i ndaloja kur s'jemi çift.
Dialogue: 0,0:03:02.26,0:03:05.96,Default,KOHEI,0,0,0,,E drejtë. Atëherë t'i shprehë\Nndjenjat dhe ta ndalojë.
Dialogue: 0,0:03:05.96,0:03:06.90,Default,AINA,0,0,0,,T'i shprehë...?!
Dialogue: 0,0:03:07.46,0:03:09.14,Default,KOHEI,0,0,0,,As kjo s'bëhet?
Dialogue: 0,0:03:09.14,0:03:10.96,Default,AINA,0,0,0,,Po, ëh...
Dialogue: 0,0:03:11.39,0:03:15.07,Default,AINA,0,0,0,,Po sikur të shkojë keq\Ndhe të na prishet marrëdhënia që kemi?
Dialogue: 0,0:03:15.99,0:03:17.47,Default,AINA,0,0,0,,Kam frikë.
Dialogue: 0,0:03:20.47,0:03:24.02,Default,AINA,0,0,0,,Kështu tha ajo, dakord?\NEnde po flasim për shoqen time.
Dialogue: 0,0:03:24.48,0:03:25.94,Default,IORI,0,0,0,,U këputa.
Dialogue: 0,0:03:26.48,0:03:28.60,Default,KOHEI,0,0,0,,Sapo dole nga puna?
Dialogue: 0,0:03:28.60,0:03:30.48,Default,IORI,0,0,0,,Shkova t'i ndihmoja në drekë.
Dialogue: 0,0:03:30.83,0:03:33.61,Default,IORI,0,0,0,,Kemi mungesë kamerierësh kohët e fundit.
Dialogue: 0,0:03:34.24,0:03:35.96,Default,IORI,0,0,0,,Sa mirë për ju që s'keni ç'bëni.
Dialogue: 0,0:03:35.96,0:03:37.66,Default,KOHEI,0,0,0,,Hej, ajo më thirri këtu...
Dialogue: 0,0:03:37.66,0:03:40.24,Default,AINA,0,0,0,,Thjesht po i kërkoja një këshillë!
Dialogue: 0,0:03:41.22,0:03:42.24,Default,IORI,0,0,0,,Këshillë për çfarë?
Dialogue: 0,0:03:42.24,0:03:46.71,Default,AINA,0,0,0,,Asgjë të madhe. Ca punë shoqërie.
Dialogue: 0,0:03:46.71,0:03:49.00,Default,AINA,0,0,0,,Nejse, ende s'e kemi mbaruar muhabetin.
Dialogue: 0,0:03:49.00,0:03:50.32,Default,AINA,0,0,0,,Shihemi!
Dialogue: 0,0:03:51.00,0:03:53.55,Default,IORI,0,0,0,,Hë? Ç'ishte gjithë kjo?
Dialogue: 0,0:03:54.00,0:03:55.77,Default,KOHEI,0,0,0,,Ende s'kemi mbaruar?
Dialogue: 0,0:03:55.77,0:03:57.76,Default,AINA,0,0,0,,Po ja, as që jemi afër një zgjidhjeje.
Dialogue: 0,0:03:57.76,0:04:00.35,Default,KOHEI,0,0,0,,Po vërtet do të flasim këtu jashtë?
Dialogue: 0,0:04:00.35,0:04:02.91,Default,AINA,0,0,0,,Ke të drejtë. Të shkojmë diku tjetër.
Dialogue: 0,0:04:02.91,0:04:03.95,Default,AINA,0,0,0,,Eja pas meje.
Dialogue: 0,0:04:03.95,0:04:05.52,Default,KOHEI,0,0,0,,Ku po më çon?
Dialogue: 0,0:04:05.52,0:04:08.54,Default,AINA,0,0,0,,Meqë ra fjala, ç'i ke\Nkëto syze? Po kapelën?
Dialogue: 0,0:04:08.54,0:04:11.94,Default,KOHEI,0,0,0,,Kohët e fundit më ngatërrojnë\Nvazhdimisht me Ikegoshi-n.
Dialogue: 0,0:04:11.94,0:04:13.16,Default,AINA,0,0,0,,Hë...
Dialogue: 0,0:04:13.86,0:04:17.12,Default,KANAKO,0,0,0,,Mos ishte Aina... me një djalë?
Dialogue: 0,0:04:17.53,0:04:21.53,Signs,SIGN,0,0,0,,{\bord0\c&H3C3C3C&\frz9.957\frx12\fry338\pos(314,201)}Yoshiwara
Dialogue: 0,0:04:18.87,0:04:20.43,Default,KOHEI,0,0,0,,Prit, kjo është...
Dialogue: 0,0:04:20.43,0:04:21.53,Default,AINA,0,0,0,,Po. Shtëpia ime.
Dialogue: 0,0:04:21.82,0:04:22.85,Default,KOHEI,0,0,0,,Unë ika.
Dialogue: 0,0:04:22.85,0:04:23.53,Default,AINA,0,0,0,,Pse?
Dialogue: 0,0:04:23.53,0:04:25.36,Default,KOHEI,0,0,0,,Kam arsyet e mia.
Dialogue: 0,0:04:25.36,0:04:27.54,Default,AINA,0,0,0,,Gjithsesi, vetëm anime do të shohësh.
Dialogue: 0,0:04:27.79,0:04:28.82,Default,AINA,0,0,0,,Hajt, futu.
Dialogue: 0,0:04:28.82,0:04:31.88,Default,KOHEI,0,0,0,,H-Hej, s'ka shans! Nuk hyj aty!
Dialogue: 0,0:04:31.88,0:04:32.88,Default,AINA,0,0,0,,Pse jo?
Dialogue: 0,0:04:32.88,0:04:34.87,Default,KOHEI,0,0,0,,S'jam gati shpirtërisht!
Dialogue: 0,0:04:34.87,0:04:36.05,Default,AINA,0,0,0,,Mos bëj budallallëqe!
Dialogue: 0,0:04:37.22,0:04:40.05,Italic,KANAKO,0,0,0,,Aina po fut një djalë me zor në shtëpi?
Dialogue: 0,0:04:40.79,0:04:43.01,Default,AINA,0,0,0,,Ulu ku të duash.
Dialogue: 0,0:04:43.01,0:04:43.90,Default,KOHEI,0,0,0,,Mirë.
Dialogue: 0,0:04:43.90,0:04:44.81,Default,AINA,0,0,0,,Çfarë ke?
Dialogue: 0,0:04:44.81,0:04:49.45,Default,KOHEI,0,0,0,,Është hera ime e parë në dhomën e një vajze,\Ndhe duhej të ishte pikërisht e jotja.
Dialogue: 0,0:04:49.81,0:04:54.44,Default,AINA,0,0,0,,Tani që ma kujtove, as unë\Ns'kam sjellë ndonjë djalë më parë.
Dialogue: 0,0:04:54.86,0:04:56.90,Default,AINA,0,0,0,,Kohei është i pari për mua...
Dialogue: 0,0:04:56.90,0:04:59.45,Default,KOHEI,0,0,0,,Cakey është e para për mua...
Dialogue: 0,0:04:59.45,0:05:01.84,Italic,KANAKO,0,0,0,,Kjo s'do të thotë se po e bëjnë.
Dialogue: 0,0:05:01.84,0:05:03.58,Default,AINA,0,0,0,,I pari për mua...
Dialogue: 0,0:05:03.58,0:05:05.63,Default,KOHEI,0,0,0,,E para për mua...
Dialogue: 0,0:05:06.26,0:05:09.96,Italic,KANAKO,0,0,0,,Hera e tyre e parë?\NOh, këtu po ndodh diçka!
Dialogue: 0,0:05:09.96,0:05:12.62,Italic,KANAKO,0,0,0,,Dhe s'pritën as dy minuta!
Dialogue: 0,0:05:12.62,0:05:14.15,Italic,KANAKO,0,0,0,,Kafshët!
Dialogue: 0,0:05:14.15,0:05:16.38,Default,AINA,0,0,0,,Eh, tani që jemi këtu,\Nle t'ia nisim.
Dialogue: 0,0:05:16.38,0:05:20.09,Default,KOHEI,0,0,0,,Po. S'më pëlqen,\Npor ta bëjmë atë për të cilën erdhëm.
Dialogue: 0,0:05:20.09,0:05:22.78,Default,AINA,0,0,0,,Hë, ke ndonjë ide ç'të provojmë?
Dialogue: 0,0:05:22.78,0:05:23.67,Default,KOHEI,0,0,0,,Po ja...
Dialogue: 0,0:05:23.67,0:05:24.66,Italic,KANAKO,0,0,0,,Ç'të provojnë?
Dialogue: 0,0:05:24.66,0:05:26.10,Default,KOHEI,0,0,0,,Po sikur të ftojmë një shoqe?
Dialogue: 0,0:05:26.10,0:05:27.60,Italic,KANAKO,0,0,0,,Çfarë dreqin po thotë?!
Dialogue: 0,0:05:27.97,0:05:30.05,Default,AINA,0,0,0,,Hëm, s'e di...
Dialogue: 0,0:05:30.05,0:05:32.46,Italic,KANAKO,0,0,0,,Ah! Pse s'e kundërshton?!
Dialogue: 0,0:05:32.46,0:05:34.48,Italic,KANAKO,0,0,0,,Mos do të më fusin edhe mua në këtë?!
Dialogue: 0,0:05:34.48,0:05:38.23,Default,KOHEI,0,0,0,,Po s'funksionoi ajo,\Nmund t'u bësh shantazh.
Dialogue: 0,0:05:38.23,0:05:40.74,Default,KANAKO,0,0,0,,Largohu nga ai djalë!
Dialogue: 0,0:05:41.12,0:05:42.24,Default,AINAKOHEI,0,0,0,,Hë?
Dialogue: 0,0:05:42.91,0:05:44.30,Default,KANAKO,0,0,0,,Hapi sytë, Aina!
Dialogue: 0,0:05:44.30,0:05:47.46,Default,KANAKO,0,0,0,,Ti vlen shumë më tepër\Nsesa t'i dorëzohesh këtij të shpifuri!
Dialogue: 0,0:05:47.46,0:05:50.25,Default,KOHEI,0,0,0,,Prit, ti s'je\Nmotra e vogël e zonjushës Kaya?
Dialogue: 0,0:05:50.25,0:05:51.78,Default,KANAKO,0,0,0,,Hë? Kohei?
Dialogue: 0,0:05:51.78,0:05:53.75,Default,KOHEI,0,0,0,,Ç'kemi.
Dialogue: 0,0:05:54.67,0:05:57.00,Default,KANAKO,0,0,0,,Ah, kjo paska qenë puna?
Dialogue: 0,0:05:57.35,0:05:58.99,Default,AINA,0,0,0,,Ç'mendove se po bënim?
Dialogue: 0,0:06:00.53,0:06:04.09,Default,KOHEI,0,0,0,,Meqë ra fjala, ku e ke atë\Nqë më premtove? Shpejt, pa humbur kohë.
Dialogue: 0,0:06:04.09,0:06:05.64,Default,KANAKA,0,0,0,,Çfarë i premtove?
Dialogue: 0,0:06:05.64,0:06:07.30,Default,AINA,0,0,0,,Ah, për pak harrova.
Dialogue: 0,0:06:07.30,0:06:11.04,Default,AINA,0,0,0,,I premtova lojën\Nqë mora nga Kikko.
Dialogue: 0,0:06:11.04,0:06:13.89,Default,KANAKO,0,0,0,,Ah, atë që s'e donte askush tjetër?
Dialogue: 0,0:06:13.89,0:06:15.31,Default,AINA,0,0,0,,Ja ku e ke.
Dialogue: 0,0:06:14.04,0:06:14.16,Signs,SIGN,0,0,0,,{\c&HA312BA&\3c&HFFFFFF&\frz340.6\pos(439,78)}Dashuria e parë
Dialogue: 0,0:06:14.16,0:06:14.29,Signs,SIGN,0,0,0,,{\c&HA312BA&\3c&HFFFFFF&\frz340.6\pos(394,154)}Dashuria e parë
Dialogue: 0,0:06:14.29,0:06:16.90,Signs,SIGN,0,0,0,,{\c&HA312BA&\3c&HFFFFFF&\frz340.6\pos(362,209)}Dashuria e parë
Dialogue: 0,0:06:15.31,0:06:16.90,Default,KOHEI,0,0,0,,Bukur. Hëm?
Dialogue: 0,0:06:16.90,0:06:18.90,Default,KOHEI,0,0,0,,Prit pak...
Dialogue: 0,0:06:19.61,0:06:21.14,Default,KOHEI,0,0,0,,E ke tashmë këtë?
Dialogue: 0,0:06:21.14,0:06:22.90,Default,KOHEI,0,0,0,,Jo, por...
Dialogue: 0,0:06:22.90,0:06:24.97,Default,KOHEI,0,0,0,,Shikojeni vetë.
Dialogue: 0,0:06:26.41,0:06:28.35,Default,KIKKO,0,0,0,,Ç'kemi, Keiko.
Dialogue: 0,0:06:28.35,0:06:29.66,Default,KEIKO,0,0,0,,Përshëndetje.
Dialogue: 0,0:06:29.66,0:06:32.35,Default,KIKKO,0,0,0,,Ç'të dojë Aina vallë?
Dialogue: 0,0:06:32.35,0:06:35.17,Default,KEIKO,0,0,0,,Tha se ishte një lloj urgjence.
Dialogue: 0,0:06:35.17,0:06:38.79,Default,KIKKO,0,0,0,,Vë bast se thjesht e ka ftuar\Nprapë në kinema...
Dialogue: 0,0:06:37.78,0:06:38.79,Top,VOICE,0,0,0,,Ah!
Dialogue: 0,0:06:40.03,0:06:41.80,Default,VOICE,0,0,0,,Jo aty! Prit!
Dialogue: 0,0:06:41.80,0:06:44.20,Default,KIKKO,0,0,0,,Më duket se paska kapërcyer ca hapa.
Dialogue: 0,0:06:44.20,0:06:46.93,Default,KEIKO,0,0,0,,Më mirë thuaj gjithë procesin.
Dialogue: 0,0:06:46.93,0:06:49.56,Default,KIKKO,0,0,0,,Po është studente. Normale është.
Dialogue: 0,0:06:49.56,0:06:50.95,Default,KEIKO,0,0,0,,E vërtetë.
Dialogue: 0,0:06:50.95,0:06:53.42,Default,KANAKO,0,0,0,,Hë? Edhe unë do ta bëj këtë?
Dialogue: 0,0:06:53.42,0:06:55.56,Default,AINA,0,0,0,,Po. Mësohu, Kanako.
Dialogue: 0,0:06:55.56,0:06:57.56,Default,KIKKOKEIKO,0,0,0,,S'je gati për treshe!
Dialogue: 0,0:06:57.56,0:06:58.81,Default,KANAKO,0,0,0,,Çfarë?!
Dialogue: 0,0:06:58.81,0:07:01.32,Default,KIKKO,0,0,0,,Ah, vetëm ajo loja porno?
Dialogue: 0,0:07:01.32,0:07:04.52,Default,KEIKO,0,0,0,,Menduam se Aina ishte tërbuar prapë.
Dialogue: 0,0:07:04.52,0:07:05.82,Default,AINA,0,0,0,,Çfarë menduat?
Dialogue: 0,0:07:05.82,0:07:08.59,Default,AINA,0,0,0,,Edhe ti, Kikko! Pse më dhe\Nnjë lojë porno?!
Dialogue: 0,0:07:08.59,0:07:10.20,Default,KIKKO,0,0,0,,Çfarë? S'ishte e mirë?
Dialogue: 0,0:07:10.20,0:07:12.08,Default,KANAKO,0,0,0,,S'është aty problemi.
Dialogue: 0,0:07:12.08,0:07:14.83,Default,KIKKO,0,0,0,,E ç'të keqe ka? Je mjaftueshëm e rritur.
Dialogue: 0,0:07:14.83,0:07:19.02,Default,KANAKO,0,0,0,,Po, por duhej ta kishe paralajmëruar!
Dialogue: 0,0:07:19.33,0:07:22.12,Default,KOHEI,0,0,0,,Mirë, unë po iki.
Dialogue: 0,0:07:22.56,0:07:25.59,Default,KANAKO,0,0,0,,Ah, po. Po flisnim\Npër jetën dashurore të Aina-s.
Dialogue: 0,0:07:25.59,0:07:26.74,Default,KIKKO,0,0,0,,Ashtu?
Dialogue: 0,0:07:26.74,0:07:30.45,Default,KEIKO,0,0,0,,Si përfunduat pastaj\Nduke luajtur porno, moj budallaçkë?
Dialogue: 0,0:07:30.45,0:07:32.35,Default,AINA,0,0,0,,Unë thjesht s'e dija!
Dialogue: 0,0:07:32.62,0:07:36.10,Default,KOHEI,0,0,0,,Po deshe të mësosh për dashurinë,\Nluaj lojën.
Dialogue: 0,0:07:36.10,0:07:38.60,Default,AINA,0,0,0,,Sikur do të më mësonte gjë.
Dialogue: 0,0:07:38.60,0:07:41.74,Italic,KOUTA,0,0,0,,Më fal. Duhet ta anuloj udhëtimin tonë.
Dialogue: 0,0:07:41.74,0:07:42.86,Italic,MITSUHA,0,0,0,,Pse?
Dialogue: 0,0:07:42.86,0:07:46.12,Italic,KOUTA,0,0,0,,Për ndonjë arsye,\Nmë kanë vënë në punë çdo ditë.
Dialogue: 0,0:07:46.57,0:07:49.11,Default,AINA,0,0,0,,Në punë?
Dialogue: 0,0:07:49.11,0:07:51.16,Flashback,IORI,0,0,0,,Shkova t'i ndihmoja në drekë.
Dialogue: 0,0:07:51.16,0:07:53.87,Flashback,IORI,0,0,0,,Kemi mungesë kamerierësh kohët e fundit.
Dialogue: 0,0:07:54.23,0:07:55.19,Default,AINA,0,0,0,,Ah...
Dialogue: 0,0:07:59.04,0:08:01.78,Default,KOHEI,0,0,0,,Të thashë që do të të hynte në punë, apo jo?
Dialogue: 0,0:08:01.78,0:08:04.05,Default,AINA,0,0,0,,Hiqe atë shprehje. Po më acaron.
Dialogue: 0,0:08:04.42,0:08:07.14,Default,AINA,0,0,0,,Rastësisht, edhe ai\Npunon me kohë të pjesshme.
Dialogue: 0,0:08:07.14,0:08:09.69,Default,KOHEI,0,0,0,,Po, djali që i pëlqen shoqes sate.
Dialogue: 0,0:08:09.69,0:08:13.47,Default,AINA,0,0,0,,Mendova se mund ta bëjmë\Ntë punojë sa më shumë turne.
Dialogue: 0,0:08:13.47,0:08:17.43,Default,KOHEI,0,0,0,,Mos u shqetëso.\NI kam menduar të gjitha.
Dialogue: 0,0:08:17.43,0:08:19.86,Default,AINA,0,0,0,,Vërtet? Bravo, Kohei!
Dialogue: 0,0:08:19.86,0:08:23.44,Default,AINA,0,0,0,,Atëherë, pse po takohemi këtu?
Dialogue: 0,0:08:23.44,0:08:25.16,Default,KOHEI,0,0,0,,Mos e vrit mendjen.
Dialogue: 0,0:08:25.16,0:08:26.44,Default,OTOYA,0,0,0,,Mirë se erdhët.
Dialogue: 0,0:08:26.44,0:08:30.05,Default,AINA,0,0,0,,Hë? Kujtoja se punoje\Nnë kuzhinë, Otoya.
Dialogue: 0,0:08:30.05,0:08:32.95,Default,OTOYA,0,0,0,,Kemi mungesë kamerierësh, ndaj ja ku jam.
Dialogue: 0,0:08:33.27,0:08:35.08,Default,OTOYA,0,0,0,,E dini çfarë do të merrni?
Dialogue: 0,0:08:35.08,0:08:36.85,Default,AINA,0,0,0,,Ah, më jep një çast.
Dialogue: 0,0:08:36.85,0:08:38.58,Default,KOHEI,0,0,0,,Do të marr këtë menunë.
Dialogue: 0,0:08:38.58,0:08:40.50,Default,AINA,0,0,0,,Kurse unë, ëh...
Dialogue: 0,0:08:40.50,0:08:42.38,Default,KOHEI,0,0,0,,Meqë ra fjala, Otoya.
Dialogue: 0,0:08:42.38,0:08:43.09,Default,OTOYA,0,0,0,,Po?
Dialogue: 0,0:08:43.09,0:08:46.34,Default,KOHEI,0,0,0,,Të ka qerasur Kitahara\Nme ndonjë gjë së fundmi?
Dialogue: 0,0:08:46.34,0:08:48.71,Default,OTOYA,0,0,0,,Hë? Jo, jo tamam.
Dialogue: 0,0:08:48.71,0:08:50.07,Default,KOHEI,0,0,0,,Ashtu?
Dialogue: 0,0:08:50.07,0:08:51.34,Default,OTOYA,0,0,0,,Pse pyet?
Dialogue: 0,0:08:51.34,0:08:55.54,Default,KOHEI,0,0,0,,Po ja, ai maskarai\Nfitoi llotarinë para ca ditësh.
Dialogue: 0,0:08:55.54,0:08:57.35,Default,OTOYA,0,0,0,,Uau, sa mirë për të!
Dialogue: 0,0:08:57.35,0:09:00.59,Default,KOHEI,0,0,0,,Po, në fillim edhe unë u gëzova shumë,
Dialogue: 0,0:09:00.59,0:09:03.23,Default,KOHEI,0,0,0,,por s'më pëlqen si do t'i shpenzojë.
Dialogue: 0,0:09:03.23,0:09:04.36,Default,OTOYA,0,0,0,,Si domethënë?
Dialogue: 0,0:09:04.36,0:09:07.66,Default,KOHEI,0,0,0,,Ai budallai do t'i harxhojë\Ntë gjitha për një vajzë.
Dialogue: 0,0:09:08.86,0:09:12.61,Default,IORI,0,0,0,,Tufa me para...
Dialogue: 0,0:09:09.50,0:09:12.61,Top,OTOYA,0,0,0,,Kitahara s'do të përpiqej kurrë\Nta blinte dikë me para!
Dialogue: 0,0:09:12.61,0:09:19.12,Default,KOHEI,0,0,0,,Jo, s'ka rënë aq poshtë. Ai fundërrina\Npo çon një femër në udhëtim!
Dialogue: 0,0:09:19.12,0:09:22.26,Default,OTOYA,0,0,0,,Kitahara do të shkojë\Nnë udhëtim me një vajzë?
Dialogue: 0,0:09:22.26,0:09:23.38,Default,OTOYA,0,0,0,,Vetëm ata të dy?
Dialogue: 0,0:09:23.38,0:09:24.60,Default,KOHEI,0,0,0,,Vetëm ata të dy.
Dialogue: 0,0:09:25.79,0:09:27.78,Default,OTOYA,0,0,0,,Kjo s'më duket mirë...
Dialogue: 0,0:09:27.78,0:09:30.79,Default,KOHEI,0,0,0,,Paska goxha guxim, hë?
Dialogue: 0,0:09:30.79,0:09:33.86,Default,KOHEI,0,0,0,,Ah, sikur të kishte aq shumë punë\Nsa të detyrohej ta anulonte!
Dialogue: 0,0:09:33.86,0:09:35.42,Default,OTOYA,0,0,0,,S'është mirë të flasësh kështu.
Dialogue: 0,0:09:35.42,0:09:37.76,Default,AINA,0,0,0,,Mirë, unë do të marr peperoncino!
Dialogue: 0,0:09:37.76,0:09:42.15,Default,KOHEI,0,0,0,,Sikur, për ndonjë arsye,\Nt'i vinin turne çdo ditë.
Dialogue: 0,0:09:43.13,0:09:44.52,Default,AINA,0,0,0,,Ç'është ky muhabet?
Dialogue: 0,0:09:45.39,0:09:50.53,Default,SAKURAKO,0,0,0,,Hë... Ai idioti po shkon\Nnë udhëtim me një vajzë?
Dialogue: 0,0:09:55.81,0:09:57.82,Default,NANAKA,0,0,0,,Je mirë, Iori?
Dialogue: 0,0:09:57.82,0:10:00.22,Default,IORI,0,0,0,,Puna po më merr shpirtin.
Dialogue: 0,0:10:00.22,0:10:01.79,Default,AINA,0,0,0,,Po të ngacmojnë?
Dialogue: 0,0:10:01.79,0:10:04.15,Default,IORI,0,0,0,,Jo, me atë jam mësuar.
Dialogue: 0,0:10:04.15,0:10:05.79,Default,AINA,0,0,0,,Pra, vazhdojnë ende.
Dialogue: 0,0:10:06.10,0:10:09.92,Default,IORI,0,0,0,,Për ndonjë arsye,\Nmë kanë ngjeshur një mal me turne.
Dialogue: 0,0:10:10.23,0:10:11.93,Default,IORI,0,0,0,,Sidomos gjatë fundjavës.
Dialogue: 0,0:10:11.93,0:10:13.68,Default,AINA,0,0,0,,Prit, vërtet?
Dialogue: 0,0:10:14.04,0:10:15.70,Default,IORI,0,0,0,,Pse dukesh e lumtur për këtë?
Dialogue: 0,0:10:15.70,0:10:17.68,Default,AINA,0,0,0,,S'jam...
Dialogue: 0,0:10:17.68,0:10:21.43,Italic,AINA,0,0,0,,Po! S'e di pse, por po funksionon!
Dialogue: 0,0:10:21.43,0:10:24.69,Default,NANAKA,0,0,0,,Duhet të jetë e lodhshme shkolla\Ndhe puna pa asnjë ditë pushimi.
Dialogue: 0,0:10:24.97,0:10:28.42,Default,IORI,0,0,0,,Po restoranti mbyllet\Npër rinovim javën tjetër.
Dialogue: 0,0:10:28.42,0:10:30.87,Default,IORI,0,0,0,,Vetëm deri atëherë duhet të duroj.
Dialogue: 0,0:10:33.68,0:10:35.71,Default,NANAKA,0,0,0,,Më bëhet qejfi për ty, Iori.
Dialogue: 0,0:10:35.71,0:10:36.78,Default,IORI,0,0,0,,Faleminderit.
Dialogue: 0,0:10:37.59,0:10:40.01,Default,AINA,0,0,0,,Kështu që plani im dështoi.
Dialogue: 0,0:10:40.01,0:10:41.95,Default,KIKKO,0,0,0,,Ah, e kuptoj.
Dialogue: 0,0:10:41.95,0:10:44.59,Default,AINA,0,0,0,,Dhe tani s'kam më ide.
Dialogue: 0,0:10:44.59,0:10:45.96,Default,KIKKO,0,0,0,,Sa keq.
Dialogue: 0,0:10:46.42,0:10:50.05,Default,KIKKO,0,0,0,,Pse s'shkon edhe ti\Nnë një udhëtim për zhytje?
Dialogue: 0,0:10:50.05,0:10:50.85,Default,AINA,0,0,0,,Hë?
Dialogue: 0,0:10:50.85,0:10:54.04,Default,KIKKO,0,0,0,,S'ka asgjë të dyshimtë\Ntë shkosh në Okinawa për zhytje,
Dialogue: 0,0:10:54.04,0:10:56.53,Default,KIKKO,0,0,0,,dhe mund t'i takosh rastësisht atje.
Dialogue: 0,0:10:56.53,0:10:58.47,Default,KIKKO,0,0,0,,Ke kursyer ca para, apo jo?
Dialogue: 0,0:10:58.47,0:10:59.85,Default,AINA,0,0,0,,Kjo është!
Dialogue: 0,0:10:59.85,0:11:01.99,Default,AINA,0,0,0,,Ide e shkëlqyer! Faleminderit!
Dialogue: 0,0:11:02.52,0:11:03.85,Default,KIKKO,0,0,0,,Paç fat.
Dialogue: 0,0:11:04.42,0:11:06.22,Default,KIKKO,0,0,0,,Do të shkosh vetëm, apo si?
Dialogue: 0,0:11:06.22,0:11:07.85,Default,AINA,0,0,0,,Jo, nëse do të bëj zhytje.
Dialogue: 0,0:11:07.85,0:11:09.66,Default,AINA,0,0,0,,Do të marr Kohei-n me vete me zor.
Dialogue: 0,0:11:10.61,0:11:13.57,Default,AINA,0,0,0,,Mirë, duhet të bëj planet. Paçim!
Dialogue: 0,0:11:13.57,0:11:15.45,Default,KIKKO,0,0,0,,P-Paçim.
Dialogue: 0,0:11:16.67,0:11:21.87,Italic,KIKKO,0,0,0,,Pra, edhe Aina po shkon me një djalë?
Dialogue: 0,0:11:26.00,0:11:33.26,Signs,SIGN,0,0,0,,{\c&H000000&\3c&HFFFFFF&\pos(542,266)}Dita 1
Dialogue: 0,0:11:26.00,0:11:29.45,Default,IORI,0,0,0,,Mbërritëm! Okinawa, hera e dytë!
Dialogue: 0,0:11:29.45,0:11:32.30,Default,IORI,0,0,0,,Sa mirë që na qëlloi\Nmot i përsosur, hë, Chisa?
Dialogue: 0,0:11:32.30,0:11:33.26,Default,CHISA,0,0,0,,Po.
Dialogue: 0,0:11:33.26,0:11:35.76,Default,IORI,0,0,0,,Pse dukesh kaq pa qejf?
Dialogue: 0,0:11:35.76,0:11:37.01,Default,CHISA,0,0,0,,Jam si gjithmonë.
Dialogue: 0,0:11:37.01,0:11:40.89,Default,IORI,0,0,0,,Mos u mërzit kaq se s'do të bëjmë\Nzhytje që ditën e parë...
Dialogue: 0,0:11:42.51,0:11:43.39,Default,CHISA,0,0,0,,Çfarë?
Dialogue: 0,0:11:43.39,0:11:46.21,Default,IORI,0,0,0,,Je në ankth, apo çfarë?
Dialogue: 0,0:11:46.21,0:11:48.58,Default,CHISA,0,0,0,,Hë? Pse duhet të jem?
Dialogue: 0,0:11:49.52,0:11:51.15,Default,IORI,0,0,0,,Mirë, si të thuash ti.
Dialogue: 0,0:11:51.88,0:11:54.09,Default,CHISA,0,0,0,,Do të marrim makinë me qira\Ndhe të shëtisim ishullin?
Dialogue: 0,0:11:54.09,0:11:55.90,Default,IORI,0,0,0,,Po. Faleminderit që do të ngasësh.
Dialogue: 0,0:11:56.28,0:11:59.66,Default,CHISA,0,0,0,,Ndërsa ti do të dehesh? S'e kam problem.
Dialogue: 0,0:11:59.66,0:12:02.30,Default,IORI,0,0,0,,Po je i sigurt që s'doje\Ntë shkoje në Miyakojima?
Dialogue: 0,0:12:02.30,0:12:05.13,Default,CHISA,0,0,0,,Po. Më pëlqen edhe ishulli kryesor i Okinawa-s.
Dialogue: 0,0:12:05.13,0:12:06.04,Default,IORI,0,0,0,,Ashtu?
Dialogue: 0,0:12:08.54,0:12:10.50,Default,CHISA,0,0,0,,Ku shkojmë së pari?
Dialogue: 0,0:12:10.50,0:12:13.04,Default,IORI,0,0,0,,Le të bëjmë një xhiro përgjatë bregut.
Dialogue: 0,0:12:13.46,0:12:17.55,Default,IORI,0,0,0,,Mund të ndalemi në ndonjë plazh të bukur\Nqë gjejmë dhe të futemi në ujë.
Dialogue: 0,0:12:19.05,0:12:20.62,Default,CHISA,0,0,0,,Më duket mirë.
Dialogue: 0,0:12:20.62,0:12:22.05,Default,IORI,0,0,0,,Qejf, apo jo?
Dialogue: 0,0:12:22.50,0:12:25.00,Default,IORI,0,0,0,,Mirë, nisemi!
Dialogue: 0,0:12:28.38,0:12:31.90,Default,IORI,0,0,0,,Gjeta një recetë për një kerri\Nqë dukej fantastik.
Dialogue: 0,0:12:31.90,0:12:34.32,Default,CHISA,0,0,0,,Atë me tri lloje baze për salcën?
Dialogue: 0,0:12:34.32,0:12:36.27,Default,IORI,0,0,0,,Po, atë!
Dialogue: 0,0:12:36.27,0:12:38.20,Default,CHISA,0,0,0,,Edhe unë kam dashur ta provoj.
Dialogue: 0,0:12:38.20,0:12:40.47,Default,IORI,0,0,0,,Ta bëjmë fundjavën tjetër?
Dialogue: 0,0:12:42.65,0:12:45.47,Default,IORI,0,0,0,,Ah, kthehu djathtas në kthesën tjetër.
Dialogue: 0,0:12:45.47,0:12:47.23,Default,CHISA,0,0,0,,Pse? Do të ndalosh diku?
Dialogue: 0,0:12:47.70,0:12:49.71,Signs,SIGN,0,0,0,,{\fs20\bord1\frx8\fry340\frz8.377\fnComic Sans MS\pos(304,74)\3c&H727272&\c&HB6DEEB&}Nmya-chi Burger
Dialogue: 0,0:12:49.92,0:12:51.71,Signs,SIGN,0,0,0,,{\fad(600,000)\fs16\frx8\fry340\fnComic Sans MS\3c&H396371&\c&H74BCD4&\frz0.3516\move(488,194.889,479.111,192.222,15,1767)}Nmya-chi Burger
Dialogue: 0,0:12:51.99,0:12:54.10,Default,IORI,0,0,0,,Udhëtimi me makinë do ushqim të shpejtë.
Dialogue: 0,0:12:54.10,0:12:57.59,Default,CHISA,0,0,0,,Ah. Po s'është pak herët\Npër drekë?
Dialogue: 0,0:12:57.59,0:12:59.97,Default,IORI,0,0,0,,Kjo është vetëm sa për të kafshuar diçka.
Dialogue: 0,0:12:59.97,0:13:00.99,Default,CHISA,0,0,0,,Ah.
Dialogue: 0,0:13:00.99,0:13:01.88,Default,IORI,0,0,0,,Çfarë ka?
Dialogue: 0,0:13:01.88,0:13:03.85,Default,CHISA,0,0,0,,S'e kisha rregulluar pasqyrën e pasme.
Dialogue: 0,0:13:03.85,0:13:06.09,Default,IORI,0,0,0,,S'e kontrollove kur hipëm?
Dialogue: 0,0:13:06.09,0:13:07.52,Default,CHISA,0,0,0,,Harrova.
Dialogue: 0,0:13:10.85,0:13:14.36,Default,IORI,0,0,0,,Ah, sikur të kisha oreks\Ntë pafund gjatë pushimeve.
Dialogue: 0,0:13:14.36,0:13:16.17,Default,CHISA,0,0,0,,Të kuptoj.
Dialogue: 0,0:13:16.17,0:13:16.86,Default,IORI,0,0,0,,Ja.
Dialogue: 0,0:13:17.79,0:13:18.74,Default,IORI,0,0,0,,Do të pish?
Dialogue: 0,0:13:18.74,0:13:19.62,Default,CHISA,0,0,0,,Po, të lutem.
Dialogue: 0,0:13:19.62,0:13:20.86,Default,IORI,0,0,0,,Patjetër.
Dialogue: 0,0:13:23.10,0:13:25.12,Default,CHISA,0,0,0,,Mos kanë problem me sorrat këtu?
Dialogue: 0,0:13:25.12,0:13:27.50,Default,IORI,0,0,0,,Pe ndonjë tabelë paralajmëruese?
Dialogue: 0,0:13:27.50,0:13:29.62,Default,CHISA,0,0,0,,Jo, shiko përpara.
Dialogue: 0,0:13:29.62,0:13:32.73,Default,IORI,0,0,0,,Balona me sy trembës?\NKam kohë pa parë nga këto.
Dialogue: 0,0:13:32.73,0:13:34.63,Default,CHISA,0,0,0,,Në Izu s'i përdor askush.
Dialogue: 0,0:13:34.63,0:13:37.76,Default,IORI,0,0,0,,Dhe nga shtëpia ime s'bëjnë punë.
Dialogue: 0,0:13:37.76,0:13:39.80,Default,CHISA,0,0,0,,Po, ti je mes maleve.
Dialogue: 0,0:13:41.59,0:13:43.16,Default,IORI,0,0,0,,Ah, është telefoni im.
Dialogue: 0,0:13:43.85,0:13:44.64,Default,CHISA,0,0,0,,Ç'ka?
Dialogue: 0,0:13:44.64,0:13:48.66,Default,IORI,0,0,0,,S'e di pse, por duket\Nse dikush mund të vdesë prej meje.
Dialogue: 0,0:13:48.66,0:13:50.39,Default,CHISA,0,0,0,,Ç'do të thotë kjo tani?
Dialogue: 0,0:13:53.84,0:13:54.90,Default,IORI,0,0,0,,Uau!
Dialogue: 0,0:13:59.18,0:14:01.30,Default,IORI,0,0,0,,Gjithmonë kaq bukur!
Dialogue: 0,0:14:01.30,0:14:02.06,Default,CHISA,0,0,0,,Po.
Dialogue: 0,0:14:02.68,0:14:06.24,Default,IORI,0,0,0,,Tani po më merr malli\Npër atë kamionçinën që morëm herën e fundit.
Dialogue: 0,0:14:06.24,0:14:08.16,Default,CHISA,0,0,0,,E ke fjalën për atë me karroceri?
Dialogue: 0,0:14:08.45,0:14:11.16,Default,IORI,0,0,0,,Vetëm se ai tipi i agjencisë\Nishte goxha i dyshimtë.
Dialogue: 0,0:14:11.16,0:14:15.42,Default,SHOPDUDE,0,0,0,,Të gjitha rrugët këtej\Njanë pronë private, dakord?
Dialogue: 0,0:14:15.42,0:14:18.67,Default,CHISA,0,0,0,,Si e mban fare hapur biznesin?
Dialogue: 0,0:14:18.67,0:14:21.67,Default,CHISA,0,0,0,,Po do të doja vërtet një karroceri të hapur.
Dialogue: 0,0:14:21.67,0:14:24.18,Default,IORI,0,0,0,,Ta ndërrojmë nesër me një kamionçinë?
Dialogue: 0,0:14:24.18,0:14:25.89,Default,CHISA,0,0,0,,Në fakt, lëre fare.
Dialogue: 0,0:14:25.89,0:14:27.68,Default,IORI,0,0,0,,Mirë, Chisa, andej!
Dialogue: 0,0:14:34.02,0:14:36.92,Default,IORI,0,0,0,,Së pari, në plazh!
Dialogue: 0,0:14:38.69,0:14:41.40,Default,CHISA,0,0,0,,Do t'i veshësh rrobat e banjës, dakord?
Dialogue: 0,0:14:41.40,0:14:42.77,Default,IORI,0,0,0,,Do të përpiqem.
Dialogue: 0,0:14:42.77,0:14:44.70,Default,CHISA,0,0,0,,Jo, do t'i veshësh.
Dialogue: 0,0:14:44.70,0:14:46.76,Default,CHISA,0,0,0,,Unë do të ndërrohem në tualet.
Dialogue: 0,0:14:46.76,0:14:49.27,Default,IORI,0,0,0,,Unë në makinë. Mos përgjo.
Dialogue: 0,0:14:49.27,0:14:51.29,Default,CHISA,0,0,0,,As të më paguaje.
Dialogue: 0,0:14:56.04,0:14:57.21,Default,IORI,0,0,0,,Ah!
Dialogue: 0,0:14:57.21,0:15:01.49,Default,CHISA,0,0,0,,Aman, sa herë të kam parë lakuriq?\NDhe mbulo pjesën e poshtme.
Dialogue: 0,0:15:01.49,0:15:03.79,Default,IORI,0,0,0,,Mjaft! Thjesht më trembe!
Dialogue: 0,0:15:04.09,0:15:06.24,Default,CHISA,0,0,0,,Ma jep pak kutinë e ndihmës së parë?
Dialogue: 0,0:15:06.74,0:15:08.09,Default,IORI,0,0,0,,U vrave?
Dialogue: 0,0:15:08.09,0:15:09.82,Default,CHISA,0,0,0,,Jo unë.
Dialogue: 0,0:15:09.82,0:15:11.62,Default,IORI,0,0,0,,Të vij me ty?
Dialogue: 0,0:15:12.54,0:15:14.85,Default,CHISA,0,0,0,,I veshur kështu? Kurrsesi.
Dialogue: 0,0:15:16.25,0:15:18.93,Default,IORI,0,0,0,,S'ka më mirë se kaq!
Dialogue: 0,0:15:19.86,0:15:21.90,Default,CHISA,0,0,0,,Uji s'të ngjitet pas lëkurës.
Dialogue: 0,0:15:21.90,0:15:25.36,Default,IORI,0,0,0,,Po. Uji i detit ndryshon\Nnga njëri vend në tjetrin, hë?
Dialogue: 0,0:15:25.95,0:15:28.24,Default,IORI,0,0,0,,Shiko sa peshq ka edhe\Nnë këtë ujë të cekët.
Dialogue: 0,0:15:28.74,0:15:30.81,Default,CHISA,0,0,0,,Bëjmë pak zhytje me maskë e tub?
Dialogue: 0,0:15:30.81,0:15:32.12,Default,IORI,0,0,0,,Jam gati!
Dialogue: 0,0:15:32.50,0:15:33.68,Default,IORI,0,0,0,,Gati me lopata!
Dialogue: 0,0:15:34.12,0:15:36.26,Default,CHISA,0,0,0,,Kur i bleve lopatat e notit?
Dialogue: 0,0:15:36.26,0:15:38.50,Default,IORI,0,0,0,,Të mirat e fitimit të llotarisë.
Dialogue: 0,0:15:39.92,0:15:40.75,Default,CHISA,0,0,0,,S'është e drejtë.
Dialogue: 0,0:15:40.75,0:15:43.51,Default,IORI,0,0,0,,Hej, ti ke shumë më tepër pajisje se unë.
Dialogue: 0,0:15:43.78,0:15:46.43,Default,IORI,0,0,0,,Edhe këto rroba banje\Ns't'i kam parë më parë.
Dialogue: 0,0:15:47.90,0:15:49.26,Default,CHISA,0,0,0,,Ka ndonjë problem?
Dialogue: 0,0:15:49.26,0:15:51.55,Default,IORI,0,0,0,,Jo. Rrobat e bukura të banjës i dua.
Dialogue: 0,0:15:51.55,0:15:53.39,Default,CHISA,0,0,0,,Po, po, mirë.
Dialogue: 0,0:15:53.95,0:15:56.18,Default,CHISA,0,0,0,,Tani s'e ke më problem ujin?
Dialogue: 0,0:15:56.18,0:15:58.40,Default,IORI,0,0,0,,Po. Frika thuajse më ka ikur.
Dialogue: 0,0:15:58.75,0:16:01.31,Default,IORI,0,0,0,,Tani më mbetet vetëm të mësoj notin.
Dialogue: 0,0:16:01.31,0:16:02.15,Default,CHISA,0,0,0,,Ashtu?
Dialogue: 0,0:16:02.83,0:16:05.90,Default,CHISA,0,0,0,,Je i zoti në sport,\Nkështu që do ta mësosh shpejt.
Dialogue: 0,0:16:06.83,0:16:08.07,Default,CHISA,0,0,0,,Pse po më sheh ashtu?
Dialogue: 0,0:16:09.26,0:16:11.85,Default,IORI,0,0,0,,Mbase është hera e parë\Nqë më bën një kompliment.
Dialogue: 0,0:16:11.85,0:16:15.16,Default,CHISA,0,0,0,,Po, sepse vazhdimisht\Nmë jep arsye të mos të bëj.
Dialogue: 0,0:16:15.16,0:16:17.95,Default,CHISA,0,0,0,,Për më tepër, s'është as hera e parë...
Dialogue: 0,0:16:19.21,0:16:22.26,Flashback,CHISA,0,0,0,,Jam vërtet e lumtur që je këtu me mua.
Dialogue: 0,0:16:25.80,0:16:27.15,Default,IORI,0,0,0,,Çfarë?
Dialogue: 0,0:16:27.15,0:16:28.30,Default,CHISA,0,0,0,,Asgjë.
Dialogue: 0,0:16:28.68,0:16:29.80,Default,CHISA,0,0,0,,Nejse...
Dialogue: 0,0:16:30.21,0:16:32.24,Default,CHISA,0,0,0,,Do të të mësoj të notosh?
Dialogue: 0,0:16:32.24,0:16:33.30,Default,IORI,0,0,0,,Do ta bëje këtë?
Dialogue: 0,0:16:33.94,0:16:35.93,Default,CHISA,0,0,0,,Nëse s'e ke problem të të mësoj unë.
Dialogue: 0,0:16:36.91,0:16:38.44,Default,IORI,0,0,0,,Pse ta kem?
Dialogue: 0,0:17:12.25,0:17:14.29,Default,IORI,0,0,0,,Ah, sa qejf ishte.
Dialogue: 0,0:17:14.29,0:17:15.14,Default,CHISA,0,0,0,,Po.
Dialogue: 0,0:17:15.54,0:17:17.82,Default,IORI,0,0,0,,Më paskan ardhur plot mesazhe.
Dialogue: 0,0:17:17.82,0:17:19.89,Default,CHISA,0,0,0,,Mbase është urgjente.
Dialogue: 0,0:17:19.89,0:17:23.90,Default,IORI,0,0,0,,Hëm... S'e them dot me siguri,\Npor s'besoj të jetë gjë e madhe.
Dialogue: 0,0:17:23.90,0:17:27.90,Default,CHISA,0,0,0,,Mirë, atëherë. Shkojmë me makinë për darkë?
Dialogue: 0,0:17:27.90,0:17:32.02,Default,IORI,0,0,0,,Po. Rezervova në një izakaya\Nme muzikë sanshin drejtpërdrejt.
Dialogue: 0,0:17:32.02,0:17:33.91,Default,CHISA,0,0,0,,Hej, tingëllon bukur.
Dialogue: 0,0:17:33.91,0:17:37.77,Default,IORI,0,0,0,,Do të pimë atje, pastaj një shofer\Ndo të na çojë në hotel.
Dialogue: 0,0:17:37.77,0:17:38.91,Default,CHISA,0,0,0,,U mor vesh.
Dialogue: 0,0:17:38.91,0:17:40.91,Signs,SIGN,0,0,0,,{\frx12\fry38\frz351.1\fscx82\fscy90\pos(399,164)\3c&H4E2318&}Dete të kaltra e të thella
Dialogue: 0,0:17:41.42,0:17:42.92,Default,IORI,0,0,0,,Gëzuar!
Dialogue: 0,0:17:41.42,0:17:42.48,Default,CHISA,0,0,0,,Gëzuar.
Dialogue: 0,0:17:43.22,0:17:45.69,Default,IORI,0,0,0,,Në Okinawa duhet patjetër birra Onion!
Dialogue: 0,0:17:45.69,0:17:47.30,Default,CHISA,0,0,0,,Qenka e këndshme dhe e lehtë.
Dialogue: 0,0:17:49.04,0:17:51.55,Default,IORI,0,0,0,,S'ka si ajo shija freskuese tropikale.
Dialogue: 0,0:17:51.55,0:17:55.64,Default,WAITRESS,0,0,0,,Rrushi juaj i detit, tofu Jimami\Nme kikirikë dhe somen champuru.
Dialogue: 0,0:17:56.55,0:17:57.82,Default,IORI,0,0,0,,Uau.
Dialogue: 0,0:17:57.82,0:17:59.06,Default,CHISA,0,0,0,,Duket shumë mirë.
Dialogue: 0,0:17:59.34,0:18:03.25,Default,IORI,0,0,0,,Salca djegëse koregusu\Nshkon për mrekulli me këto.
Dialogue: 0,0:18:03.56,0:18:05.59,Default,CHISA,0,0,0,,Mbase ta provoj edhe unë.
Dialogue: 0,0:18:05.59,0:18:07.52,Default,IORI,0,0,0,,Patjetër, por mos e tepro.
Dialogue: 0,0:18:07.94,0:18:12.45,Signs,SIGN,0,0,0,,{\frz349.2\3c&HC8E2EB&\c&H050505&\move(321.333,161.333,321.333,152,21,4484)}Koregusu
Dialogue: 0,0:18:07.94,0:18:11.58,Default,IORI,0,0,0,,Është spec djegës i lënë\Nnë alkool orizi awamori.
Dialogue: 0,0:18:11.58,0:18:12.45,Default,IORI,0,0,0,,Të deh.
Dialogue: 0,0:18:12.45,0:18:15.50,Italic,CHISA,0,0,0,,Një salcë që PAB-i do ta adhurojë.
Dialogue: 0,0:18:17.03,0:18:19.95,Default,PA,0,0,0,,Tani fillon shfaqja me sanshin.
Dialogue: 0,0:18:24.96,0:18:26.36,Default,CHISA,0,0,0,,Ky vend qenka i shkëlqyer.
Dialogue: 0,0:18:26.36,0:18:30.21,Default,IORI,0,0,0,,Apo jo? Kam dëgjuar se yjet\Nvijnë këtu pa rënë në sy.
Dialogue: 0,0:18:30.51,0:18:31.68,Default,CHISA,0,0,0,,Hë...
Dialogue: 0,0:18:32.03,0:18:33.72,Default,ALL,0,0,0,,Koncert i bukur sot!
Dialogue: 0,0:18:32.34,0:18:33.72,Default,CHISA,0,0,0,,Po, po e shoh.
Dialogue: 0,0:18:33.72,0:18:37.22,Default,KURO,0,0,0,,Sonte festojmë! Pini sa të doni!
Dialogue: 0,0:18:36.61,0:18:37.46,Default,ALL,0,0,0,,Po na qeras ti?
Dialogue: 0,0:18:37.22,0:18:38.72,Default,KURO,0,0,0,,Jo, do ta ndajmë faturën.
Dialogue: 0,0:18:38.72,0:18:40.65,Default,IORI,0,0,0,,Çfarë po sheh?
Dialogue: 0,0:18:40.65,0:18:41.85,Default,CHISA,0,0,0,,Asgjë. Lëre fare.
Dialogue: 0,0:18:43.32,0:18:47.23,Default,PA,0,0,0,,Mirë, të gjithë.\NËshtë koha të kërcejmë kachashi!
Dialogue: 0,0:18:47.23,0:18:49.29,Default,IORI,0,0,0,,Po! Hajde kërcejmë, Chisa!
Dialogue: 0,0:18:49.29,0:18:50.48,Default,CHISA,0,0,0,,As që bëhet fjalë.
Dialogue: 0,0:18:50.48,0:18:53.26,Default,IORI,0,0,0,,Çfarë, s'ia thua fare kërcimit?
Dialogue: 0,0:18:53.26,0:18:55.30,Default,IORI,0,0,0,,Mund të të mësoj, në këmbim\Ntë mësimit të notit.
Dialogue: 0,0:18:55.30,0:18:57.49,Default,CHISA,0,0,0,,S'është ai problemi.
Dialogue: 0,0:18:57.49,0:19:01.24,Default,PA,0,0,0,,Ngrini duart dhe tundini!
Dialogue: 0,0:19:01.24,0:19:02.50,Default,IORI,0,0,0,,Po, po!
Dialogue: 0,0:19:02.50,0:19:03.84,Default,IORI,0,0,0,,Po, po!
Dialogue: 0,0:19:13.01,0:19:16.28,Signs,SIGN,0,0,0,,{\fad(000,900)\frx12\fry38\frz351.1\3c&H4E2318&\fscx100\fscy107\move(372.524,141.333,397.667,165.333,16,2978)}Dete të kaltra e të thella
Dialogue: 0,0:19:18.58,0:19:21.17,Default,IORI,0,0,0,,Është gjithmonë bukur të provosh\Ngjëra të reja me pushime.
Dialogue: 0,0:19:21.17,0:19:22.52,Default,CHISA,0,0,0,,Ashtu mendon?
Dialogue: 0,0:19:22.52,0:19:25.71,Default,IORI,0,0,0,,Edhe po pate halle,\Ni mbyt të gjitha me alkool.
Dialogue: 0,0:19:25.71,0:19:28.52,Default,CHISA,0,0,0,,S'jam fort dakord me këtë.
Dialogue: 0,0:19:28.93,0:19:31.77,Default,IORI,0,0,0,,Dhe nesër e nisim me zhytje.
Dialogue: 0,0:19:31.77,0:19:35.28,Default,CHISA,0,0,0,,Po. Duhet të flesh herët.
Dialogue: 0,0:19:35.28,0:19:37.72,Default,IORI,0,0,0,,Mbase nga padurimi s'më zë gjumi.
Dialogue: 0,0:19:37.72,0:19:39.44,Default,CHISA,0,0,0,,Dëgjoje pak veten.
Dialogue: 0,0:19:45.36,0:19:46.78,Default,CHISA,0,0,0,,Iori, mos më thuaj!
Dialogue: 0,0:19:46.78,0:19:50.17,Default,IORI,0,0,0,,Jo, jo. Rezervova me dy krevate.
Dialogue: 0,0:19:50.55,0:19:53.92,Default,IORI,0,0,0,,Më falni. Na keni dhënë krevat dopio.
Dialogue: 0,0:19:53.92,0:19:56.13,Default,IORI,0,0,0,,Na kaloni në një dhomë dyshe me krevate veç?
Dialogue: 0,0:19:56.13,0:19:56.93,Default,HOTELDUDE,0,0,0,,Hë?
Dialogue: 0,0:19:57.21,0:19:58.68,Default,HOTELDUDE,0,0,0,,Dhomë dyshe?
Dialogue: 0,0:19:58.68,0:20:01.34,Default,HOTELDUDE,0,0,0,,Ne s'kemi dhoma të tilla.
Dialogue: 0,0:20:01.34,0:20:02.93,Default,IORI,0,0,0,,Kjo fytyrë më duket e njohur!
Dialogue: 0,0:20:03.28,0:20:05.02,Default,IORI,0,0,0,,Prit, s'është koha tani!
Dialogue: 0,0:20:05.02,0:20:07.94,Default,CHISA,0,0,0,,Keni ndonjë dhomë me dy krevate?
Dialogue: 0,0:20:07.94,0:20:10.36,Default,HOTELDUDE,0,0,0,,Ah, këtë doje të thoshe?
Dialogue: 0,0:20:10.36,0:20:12.61,Default,IORI,0,0,0,,Po s'patët, marrim edhe\Nnjë nga dhomat më të lira.
Dialogue: 0,0:20:12.61,0:20:14.19,Default,HOTELDUDE,0,0,0,,Ah, për çmimin mos u shqetësoni.
Dialogue: 0,0:20:14.54,0:20:17.15,Default,HOTELDUDE,0,0,0,,I kemi të gjitha të zëna,\Nndaj s'ju jap dot tjetër.
Dialogue: 0,0:20:17.15,0:20:18.95,Default,IORI,0,0,0,,O burrë!
Dialogue: 0,0:20:18.95,0:20:22.52,Default,HOTELDUDE,0,0,0,,Ç'të keqe ka që një çift të ndajë krevatin?
Dialogue: 0,0:20:23.20,0:20:25.71,Default,CHISA,0,0,0,,Tërhiqe atë që the.\NPo më njollos emrin.
Dialogue: 0,0:20:25.71,0:20:27.78,Default,IORI,0,0,0,,Ne s'jemi ashtu.
Dialogue: 0,0:20:27.78,0:20:29.08,Default,HOTELDUDE,0,0,0,,Ah, e kuptoj.
Dialogue: 0,0:20:29.08,0:20:31.08,Default,HOTELDUDE,0,0,0,,Thjesht miq për seks.
Dialogue: 0,0:20:32.33,0:20:34.09,Default,IORI,0,0,0,,Ç'problem ka ai tipi?
Dialogue: 0,0:20:34.09,0:20:38.09,Default,CHISA,0,0,0,,Është çudi që drejton\Ndisa biznese kështu.
Dialogue: 0,0:20:38.09,0:20:40.24,Default,IORI,0,0,0,,Eh, kështu qenka puna.
Dialogue: 0,0:20:40.24,0:20:40.84,Default,CHISA,0,0,0,,Po.
Dialogue: 0,0:20:41.19,0:20:43.80,Default,CHISA,0,0,0,,Sa keq që duhet\Ntë flesh përjashta.
Dialogue: 0,0:20:43.80,0:20:45.97,Default,IORI,0,0,0,,Hë? Kur e vendosëm këtë?
Dialogue: 0,0:20:46.45,0:20:49.48,Default,CHISA,0,0,0,,Po deshe, mund të flesh\Nnë vaskë.
Dialogue: 0,0:20:49.48,0:20:51.78,Default,IORI,0,0,0,,Pse s'flemë secili në një cep të krevatit?
Dialogue: 0,0:20:51.78,0:20:54.36,Default,IORI,0,0,0,,Kemi fjetur edhe mbi njëri-tjetrin\Nmë parë, të kujtohet?
Dialogue: 0,0:20:55.04,0:20:57.54,Default,CHISA,0,0,0,,Ajo ishte pa dashje.
Dialogue: 0,0:20:57.54,0:21:01.36,Default,IORI,0,0,0,,Na pa Nanaka\Ndhe deshi të na martonte.
Dialogue: 0,0:21:01.75,0:21:03.93,Default,CHISA,0,0,0,,Më dhembi trupi për ditë të tëra pastaj.
Dialogue: 0,0:21:03.93,0:21:05.37,Default,IORI,0,0,0,,Faji im.
Dialogue: 0,0:21:05.77,0:21:08.75,Default,IORI,0,0,0,,Të premtoj se sonte\Ns'do të të dhembë gjë.
Dialogue: 0,0:21:09.16,0:21:10.74,Default,IORI,0,0,0,,Kemi gjithë këtë hapësirë.
Dialogue: 0,0:21:10.74,0:21:12.83,Default,CHISA,0,0,0,,Uf. Vetëm për sonte, dakord?
Dialogue: 0,0:21:12.83,0:21:13.75,Default,IORI,0,0,0,,Në rregull!
Dialogue: 0,0:21:14.16,0:21:16.20,Default,IORI,0,0,0,,Mirë, ti mund të lahesh e para.
Dialogue: 0,0:21:16.20,0:21:18.01,Default,CHISA,0,0,0,,Mos e thuaj ashtu.
Dialogue: 0,0:21:25.84,0:21:26.89,Default,IORI,0,0,0,,E hap unë.
Dialogue: 0,0:21:29.15,0:21:30.39,Default,CHISA,0,0,0,,Çfarë ishte?
Dialogue: 0,0:21:30.39,0:21:32.90,Default,IORI,0,0,0,,Me sa duket, u lirua një dhomë tjetër.
Dialogue: 0,0:21:33.18,0:21:35.65,Default,IORI,0,0,0,,Do të kaloj atje.
Dialogue: 0,0:21:35.65,0:21:36.76,Default,CHISA,0,0,0,,Ah, në rregull.
Dialogue: 0,0:21:37.42,0:21:38.65,Default,IORI,0,0,0,,Do të të marrë malli për mua?
Dialogue: 0,0:21:38.65,0:21:40.65,Default,CHISA,0,0,0,,Aspak. Budalla.
Dialogue: 0,0:21:40.65,0:21:42.66,Signs,SIGN,0,0,0,,{\pos(538.286,77.143)\c&H000000&\3c&HFFFFFF&}Dita 2
Dialogue: 0,0:21:42.66,0:21:44.11,Default,IORI,0,0,0,,Mirëmëngjes.
Dialogue: 0,0:21:44.11,0:21:46.66,Default,CHISA,0,0,0,,Mirëmëngjes. Do të na marrë njeri?
Dialogue: 0,0:21:46.66,0:21:49.41,Default,IORI,0,0,0,,S'u kërkova,\Nndaj do të shkojmë me makinë te qendra.
Dialogue: 0,0:21:51.01,0:21:53.42,Default,IORI,0,0,0,,Mbrëmë isha tepër i dehur për ta kuptuar,
Dialogue: 0,0:21:53.98,0:21:55.90,Default,IORI,0,0,0,,po kjo qenka lagjja e hoteleve të dashurisë, hë?
Dialogue: 0,0:21:55.90,0:21:57.92,Default,CHISA,0,0,0,,Ah, ke të drejtë. Shiko gjithë ato tabela.
Dialogue: 0,0:21:57.92,0:22:01.92,Default,IORI,0,0,0,,Të ngacmon pak mendimi se të gjithë\Nqë dalin sapo kanë mbaruar së qiri.
Dialogue: 0,0:22:01.92,0:22:03.29,Default,CHISA,0,0,0,,Mjaft.
Dialogue: 0,0:22:03.29,0:22:04.55,Default,IORI,0,0,0,,Më fal, më fal.
