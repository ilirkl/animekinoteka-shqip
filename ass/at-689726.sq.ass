Dialogue: 0,0:16:14.73,0:16:16.21,Default,HANA,0,0,0,,Oh, dreq.
Dialogue: 0,0:16:16.21,0:16:17.48,Default,DERA,0,0,0,,Uf.
Dialogue: 0,0:16:17.48,0:16:19.48,sign_generic,SIGN,0,0,0,,{\fnComic Sans MS\bord0\fs35\b1\c&H000200&\pos(341,232)}Danno
Dialogue: 0,0:16:18.68,0:16:21.97,Default,DERA,0,0,0,,Agjentët e Fshatit Higashi\Njanë thirrur.
Dialogue: 0,0:16:21.97,0:16:25.00,Default,HANA,0,0,0,,Po thërrasin të gjithë\Nme rol zyrtar.
Dialogue: 0,0:16:25.34,0:16:28.06,Default,HANA,0,0,0,,Ky mesazh është nga banditët.
Dialogue: 0,0:16:28.06,0:16:29.49,Default,YURU,0,0,0,,Çfarë? Ata?
Dialogue: 0,0:16:29.85,0:16:32.54,Default,HANA,0,0,0,,Me siguri po planifikojnë\Ntë të vënë në provë
Dialogue: 0,0:16:32.54,0:16:36.10,Default,HANA,0,0,0,,për incidentin e magazinës së Fujimurayama\Ndhe të kërkojnë dorëzimin e Yuru-kun.
Dialogue: 0,0:16:36.33,0:16:38.10,Default,DERA,0,0,0,,Po.
Dialogue: 0,0:16:38.40,0:16:41.37,Default,YURU,0,0,0,,Duhet të shkoj t'u jap një\Nmësim të gjithëve?
Dialogue: 0,0:16:41.37,0:16:42.71,Default,LEFT,0,0,0,,Nuk mundesh.
Dialogue: 0,0:16:42.71,0:16:45.68,Default,KEN,0,0,0,,Po, dëgjo Left.
Dialogue: 0,0:16:45.98,0:16:49.15,Default,RIGHT,0,0,0,,Nuk jemi shëruar plotësisht,\Nprandaj nuk mund të shkojmë.
Dialogue: 0,0:16:49.15,0:16:52.45,Default,LEFT,0,0,0,,Nuk është e drejtë që ti\Ntë shkosh vetëm për gjueti.
Dialogue: 0,0:16:52.69,0:16:53.95,Default,YURU,0,0,0,,E kuptoj.
Dialogue: 0,0:16:54.40,0:16:58.21,Default,YURU,0,0,0,,Atëherë do t'u japim të gjithëve një\Nmësim sa të jesh më mirë.
Dialogue: 0,0:16:58.21,0:17:00.20,italics,KEN/ID,0,0,0,,Mos e bëj të tingëllojë si\Nnjë shëtitje argëtuese!
Dialogue: 0,0:17:00.57,0:17:04.95,Default,DERA,0,0,0,,Mos. Shumë agjentë të Fshatit Higashi\Nme rol zyrtar janë Zotërues Daemonësh.
Dialogue: 0,0:17:05.21,0:17:07.66,Default,DERA,0,0,0,,Prandaj nuk do të marr pjesë.
Dialogue: 0,0:17:07.66,0:17:09.25,Default,HANA,0,0,0,,E padrejtë, Dera-san!
Dialogue: 0,0:17:09.25,0:17:13.52,Default,HANA,0,0,0,,Edhe nëse mungoj unë, do të dyshojnë!
Dialogue: 0,0:17:18.61,0:17:22.18,Default,HANA,0,0,0,,Hej. Si po shkon?
Dialogue: 0,0:17:22.45,0:17:24.19,Default,GLASSES BANDIT,0,0,0,,Hej, varrmihës.
Dialogue: 0,0:17:24.19,0:17:25.96,Default,OFFICIAL A,0,0,0,,Mirë të shoh, Hana-chan.
Dialogue: 0,0:17:25.96,0:17:27.18,Default,OFFICIAL B,0,0,0,,Je ende gjallë, hë?
Dialogue: 0,0:17:27.56,0:17:30.13,Default,GLASSES BANDIT,0,0,0,,Ke dëgjuar nga Tadera?
Dialogue: 0,0:17:30.13,0:17:33.10,Default,HANA,0,0,0,,Jo. Nuk është këtu?
Dialogue: 0,0:17:33.10,0:17:36.85,Default,GLASSES BANDIT,0,0,0,,Jo. As mesazheve nuk\Npërgjigjet. Është zhdukur.
Dialogue: 0,0:17:36.85,0:17:40.53,Default,HANA,0,0,0,,Vërtet? Pyes veten nëse\Nka diçka për të fshehur.
Dialogue: 0,0:17:40.53,0:17:42.78,Default,GLASSES BANDIT,0,0,0,,E hasur në magazinën\Ne Fujimurayama.
Dialogue: 0,0:17:42.78,0:17:48.03,Default,GLASSES BANDIT,0,0,0,,Tha se nuk do ta dorëzonte\NYurun as nuk do të ndihmonte Fshatin Higashi.
Dialogue: 0,0:17:48.03,0:17:50.37,Default,HANA,0,0,0,,Pra tradhtoi Fshatin Higashi?
Dialogue: 0,0:17:50.37,0:17:54.54,Default,HANA,0,0,0,,Bast se po planifikon ta përdorë\Nfëmijën Seal për vete.
Dialogue: 0,0:17:54.54,0:17:56.18,Default,HANA,0,0,0,,Uf, ai është i neveritshëm.
Dialogue: 0,0:17:56.18,0:17:59.39,Default,HANA,0,0,0,,Më mirë t'i japim atij\Nbudallait një mësim nëse e gjejmë.
Dialogue: 0,0:17:59.68,0:18:02.13,italics,GLASSES BANDIT/ID,0,0,0,,Ajo vërtet e urren atë.
Dialogue: 0,0:18:05.93,0:18:07.64,Default,OFFICIAL C,0,0,0,,Presidenti është këtu.
Dialogue: 0,0:18:22.29,0:18:24.58,Default,PRESIDENT,0,0,0,,A është të gjithë këtu?
Dialogue: 0,0:18:24.86,0:18:26.35,Default,GLASSES BANDIT,0,0,0,,Tadera mungon.
Dialogue: 0,0:18:27.01,0:18:28.49,Default,PRESIDENT,0,0,0,,S'është çudi.
Dialogue: 0,0:18:28.91,0:18:30.29,Default,SHIZUKU,0,0,0,,Mirëmbrëma.
Dialogue: 0,0:18:30.72,0:18:32.17,Default,KAGARI,0,0,0,,Mirë të të shoh përsëri.
Dialogue: 0,0:18:32.76,0:18:35.30,Default,DERA,0,0,0,,Hej, është një mesazh nga Jiro.
Dialogue: 0,0:18:34.09,0:18:36.58,sign_generic,SIGN,0,0,0,,{\an7\pos(86,95)\3c&HF0EDE9&\c&H5D5C5B&}daemonët e presidentit mirë
Dialogue: 0,0:18:35.30,0:18:36.57,Default,YURU,0,0,0,,President?
Dialogue: 0,0:18:36.95,0:18:40.41,Default,DERA,0,0,0,,Ai është lideri i agjentëve të Fshatit\NHigashi këtu poshtë.
Dialogue: 0,0:18:40.41,0:18:44.70,Default,DERA,0,0,0,,Ai është ai që na cakton punën,\Nprandaj preferoj të mos luftoj me të,
Dialogue: 0,0:18:44.70,0:18:47.35,Default,DERA,0,0,0,,por ai gjithashtu dëshiron të\Nmarrë Break dhe Seal
Dialogue: 0,0:18:47.35,0:18:50.23,Default,DERA,0,0,0,,që Fshati Higashi të\Nmarrë kontrollin e botës.
Dialogue: 0,0:18:51.34,0:18:58.12,Default,PRESIDENT,0,0,0,,Dëgjova se Tadera Ryu ka marrë Yurun\Ndhe është fshehur, varrmihës.
Dialogue: 0,0:18:58.12,0:19:00.29,Default,HANA,0,0,0,,Po, me sa duket.
Dialogue: 0,0:19:00.63,0:19:03.06,Default,PRESIDENT,0,0,0,,Nuk ke dëgjuar nga ai?
Dialogue: 0,0:19:03.06,0:19:05.51,Default,HANA,0,0,0,,Siç u thashë banditëve,
Dialogue: 0,0:19:05.51,0:19:07.51,Default,HANA,0,0,0,,sapo solla Yuru-kun nga mali
Dialogue: 0,0:19:07.51,0:19:09.87,Default,HANA,0,0,0,,dhe i lashë\Nafër vendit të Dera-san.
Dialogue: 0,0:19:09.87,0:19:11.54,Default,HANA,0,0,0,,Nuk kam dëgjuar nga ata që atëherë.
Dialogue: 0,0:19:11.82,0:19:17.44,Default,OFFICIAL D,0,0,0,,Pse nuk na tregove që nxore\NYurun nga fshati?
Dialogue: 0,0:19:17.44,0:19:20.67,Default,OFFICIAL D,0,0,0,,Është mirë që mësuam\Npër këtë përmes shamanit.
Dialogue: 0,0:19:20.67,0:19:25.05,Default,OFFICIAL D,0,0,0,,Pothuajse nuk mësuam për\Nsulmin mbi Fshatin Higashi.
Dialogue: 0,0:19:25.05,0:19:26.71,Default,HANA,0,0,0,,Hej, mos më fajëso!
Dialogue: 0,0:19:27.14,0:19:29.88,Default,HANA,0,0,0,,Dera-san nuk më tha asgjë as mua!
Dialogue: 0,0:19:29.88,0:19:31.43,Default,PRESIDENT,0,0,0,,E drejtë.
Dialogue: 0,0:19:31.90,0:19:36.49,Default,PRESIDENT,0,0,0,,Fshati Higashi është në kaos\Npasi sulmuan Kagemorët,
Dialogue: 0,0:19:36.49,0:19:41.51,Default,PRESIDENT,0,0,0,,Asa është me Kagemorët dhe\Nka marrë tashmë Break,
Dialogue: 0,0:19:41.51,0:19:43.98,Default,PRESIDENT,0,0,0,,dhe Yuru është këtu poshtë.
Dialogue: 0,0:19:43.98,0:19:46.31,Default,PRESIDENT,0,0,0,,Banditët pothuajse u fshinë.
Dialogue: 0,0:19:46.31,0:19:48.75,Default,PRESIDENT,0,0,0,,Shamani dhe Tadera janë zhdukur.
Dialogue: 0,0:19:48.75,0:19:54.75,Default,PRESIDENT,0,0,0,,Pothuajse të gjithë ata që dinin rrugën përmes\Nbarrierës së Fshatit Higashi janë zhdukur,
Dialogue: 0,0:19:54.75,0:20:00.75,Default,PRESIDENT,0,0,0,,që do të thotë se pritja e udhëzimeve\Nnga gjyshja Yamaha do të na ngadalësojë.
Dialogue: 0,0:20:02.69,0:20:08.08,Default,PRESIDENT,0,0,0,,Tani e tutje, unë duhet\Ntë marr komandën këtu poshtë.
Dialogue: 0,0:20:08.51,0:20:10.26,sign_generic,SIGN,0,0,0,,{\an7\pos(86,95)\3c&HF0EDE9&\c&H5D5C5B&}qëllime të fshehta të presidentit
Dialogue: 0,0:20:08.76,0:20:10.26,Default,YURU,0,0,0,,Qëllime të fshehta?
Dialogue: 0,0:20:10.26,0:20:13.16,Default,DERA,0,0,0,,Hë? Çfarë? Për Hana-chan?
Dialogue: 0,0:20:13.16,0:20:15.69,Default,DERA,0,0,0,,Ajo do ta vriste atë të shthurur!
Dialogue: 0,0:20:14.26,0:20:16.52,sign_generic,SIGN,0,0,0,,{\an7\pos(86,95)\3c&HF0EDE9&\c&H5D5C5B&}dëshiron të marrë kontrollin e fshatit higashi
Dialogue: 0,0:20:15.69,0:20:20.78,Default,DERA,0,0,0,,Ah, atë lloj qëllimi të fshehtë. Uf.
Dialogue: 0,0:20:20.78,0:20:25.62,Default,PRESIDENT,0,0,0,,Së pari, gjeni Taderën dhe gjurmoni Yurun.
Dialogue: 0,0:20:25.62,0:20:26.77,Default,OFFICIAL A,0,0,0,,Po nëse reziston?
Dialogue: 0,0:20:27.08,0:20:31.16,Default,OFFICIAL D,0,0,0,,Nuk ka Daemonë. Mund\Nt'i hedhim thjesht Daemonë luftarakë.
Dialogue: 0,0:20:32.16,0:20:33.32,Default,HANA,0,0,0,,Jiro?
Dialogue: 0,0:20:33.96,0:20:35.28,Default,HANA,0,0,0,,Çfarë është ajo?
Dialogue: 0,0:20:41.27,0:20:44.18,Default,GLASSES BANDIT,0,0,0,,Ata nuk janë...\Nobjekte potencialisht të rrezikshme.
Dialogue: 0,0:20:44.50,0:20:47.42,Default,GLASSES BANDIT,0,0,0,,A janë këto relike Daemonësh?
Dialogue: 0,0:20:47.42,0:20:48.71,Default,SHIZUKU,0,0,0,,Ata janë Daemonë.
Dialogue: 0,0:20:49.03,0:20:53.41,Default,KAGARI,0,0,0,,Janë aktivë.\NNdjejmë shpirtra brenda tyre.
Dialogue: 0,0:20:53.95,0:20:55.93,Default,HANA,0,0,0,,Daemonët e kujt janë këta?
Dialogue: 0,0:20:55.93,0:20:58.29,Default,PRESIDENT,0,0,0,,Çfarë po bënin këtu?
Dialogue: 0,0:20:58.29,0:20:59.34,Default,HANA,0,0,0,,Kush e di?
Dialogue: 0,0:20:59.34,0:21:01.31,Default,OFFICIAL A,0,0,0,,Dikush të bëjë kontratë me ta.
Dialogue: 0,0:21:22.97,0:21:26.60,sign_generic,,0,0,0,,{\fade(1,387)\fs15\an7\bord1.25\c&H241EAF&\3c&HBEC0E4&\b1}Përktheu:\N{\fs18}Sho Stifler\N\N{\fs15}Kohëmatësi:\N{\fs18}Edgar Cruz\N\N{\fs15}Redaktori:\N{\fs18}Salem Alabanza\N\N{\fs15}Kontrolli i cilësisë:\N{\fs18}Gabriella Alabanza\N\N{\fs15}Kontrolli final i cilësisë:\N{\fs18}Michelle Tymon
Dialogue: 0,0:22:45.75,0:22:52.05,Default,GONZO,0,0,0,,Ka dikush që infekton reliket\Ne Daemonëve dhe i shpërthen?
Dialogue: 0,0:22:52.05,0:22:53.43,Default,FUYUKI,0,0,0,,Dini gjë?
Dialogue: 0,0:22:53.43,0:22:56.82,Default,WHISPER,0,0,0,,Nuk kam informacion\Npër dikë të tillë.
Dialogue: 0,0:22:56.82,0:22:59.64,Default,JIN,0,0,0,,Një Daemon i panjohur për ne?
Dialogue: 0,0:23:00.00,0:23:04.89,Default,JIN,0,0,0,,Le të kontrollojnë të gjithë në rezidencë\Nnëse Daemonët e tyre janë infektuar.
Dialogue: 0,0:23:05.18,0:23:08.39,Default,HARUO,0,0,0,,Bunbun mendon se mund të jetë\Nnjë Daemon nga Perëndimi.
Dialogue: 0,0:23:09.12,0:23:10.51,Default,GONZO,0,0,0,,Perëndimi?
Dialogue: 0,0:23:11.10,0:23:13.90,Default,GONZO,0,0,0,,Perëndimi? Ndoshta...
Dialogue: 0,0:23:13.90,0:23:16.67,Default,GONZO,0,0,0,,Jo, nuk mund të jetë.
Dialogue: 0,0:23:17.27,0:23:22.04,Default,GONZO,0,0,0,,Fshati Nishino u shkatërrua.\NNdodhet në fund të një rezervuari.
Dialogue: 0,0:23:30.93,0:23:36.96,sign_generic,SIGN,0,0,0,,{\c&H090907&\3c&H4A4644&\fnGeorgia\b1\an8\fade(600,1)}Fshati Nishino

