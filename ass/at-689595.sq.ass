Dialogue: 0,0:00:00.80,0:00:02.47,Italics_top,Ferdinand-Narration,0,0,0,,Me shtimin e frutit ruelle,
Dialogue: 0,0:00:02.78,0:00:05.72,Italics_top,Ferdinand-Narration,0,0,0,,Rosemyne mblodhi me sukses\Ntë gjitha materialet.
Dialogue: 0,0:00:06.26,0:00:08.17,Italics_top,Ferdinand-Narration,0,0,0,,Ndërkohë...
Dialogue: 0,0:00:11.03,0:00:12.18,Default,Noble,0,0,0,,Dëgjo me kujdes.
Dialogue: 0,0:00:12.18,0:00:17.99,Default,Noble,0,0,0,,Fto Z. Wilfried të luajë dhe çoje\Nte Kulla e Bardhë thellë në pyll.
Dialogue: 0,0:00:17.99,0:00:22.05,Default,Noble,0,0,0,,Megjithatë, nuk duhet të hysh\Nkurrë brenda. E kuptove?
Dialogue: 0,0:00:22.05,0:00:23.12,Default,Roderick/Child1/Child2,0,0,0,,Po!
Dialogue: 0,0:00:23.37,0:00:26.05,Default,Sylvester,0,0,0,,Tani do të fillojmë\Ngarën e gjuetisë!
Dialogue: 0,0:00:48.45,0:00:54.25,Title,Sign,0,0,0,,{\fad(3000,400)}Ngritja e një Bibliomane:\N{\fs20\c&HB99F4D&}E bija e birësuar e Kryedukës
Dialogue: 0,0:02:05.98,0:02:10.98,Ep Title,Sign,0,0,0,,Episodi 22\NVeprimet e Wilfried
Dialogue: 0,0:02:13.23,0:02:16.48,Default,Kampfer,0,0,0,,Të gjithë ishin të kënaqur që korrja\Nishte më e mirë se vitin e kaluar.
Dialogue: 0,0:02:16.48,0:02:19.23,Default,Rosemyne,0,0,0,,E kuptoj. Faleminderit për punën e mundimshme.
Dialogue: 0,0:02:19.87,0:02:21.53,Italics_top,Rosemyne-Narration,0,0,0,,Priftërinjtë me rroba blu
Dialogue: 0,0:02:21.53,0:02:23.99,Italics_top,Rosemyne-Narration,0,0,0,,që morën pjesë në Festivalin e Korrjes\Nnë tokat e giebëve të ndryshëm
Dialogue: 0,0:02:23.99,0:02:26.25,Italics_top,Rosemyne-Narration,0,0,0,,u kthyen me kupa të vogla të shenjta.
Dialogue: 0,0:02:26.73,0:02:30.12,Italics_top,Rosemyne-Narration,0,0,0,,Pasi përpilova informacionin mbi rendimentin e korrjes\Ndhe situatën e secilit rajon,
Dialogue: 0,0:02:30.12,0:02:32.38,Italics_top,Rosemyne-Narration,0,0,0,,shkova t'i raportoja Aub-it.
Dialogue: 0,0:02:32.66,0:02:34.25,Italics_top,Rosemyne-Narration,0,0,0,,Pas kësaj...
Dialogue: 0,0:02:34.61,0:02:39.04,Flashback,Ferdinand,0,0,0,,Sapo të mbarojmë raportimin mbi Festivalin\Ne Korrjes, do të fillojmë të bëjmë jureve.
Dialogue: 0,0:02:39.55,0:02:41.38,Italics,Rosemyne-Internal,0,0,0,,Jahoo!
Dialogue: 0,0:02:48.39,0:02:49.60,Default,Charlotte,0,0,0,,Ju lutem, vendoseni atë atje.
Dialogue: 0,0:02:49.60,0:02:52.15,Default,Rosemyne,0,0,0,,Kjo është dhoma ngjitur me timen...
Dialogue: 0,0:02:52.15,0:02:54.57,Default,Rihyarda,0,0,0,,Ajo është Princesha Charlotte.
Dialogue: 0,0:02:54.57,0:02:59.37,Default,Rihyarda,0,0,0,,Ajo do të pagëzohet këtë dimër,\Nndaj po e përgatisin dhomën e saj.
Dialogue: 0,0:03:04.33,0:03:07.54,sign_name_card_BG,,0,0,0,,{\fad(450,1)\bord0\p1\pos(40,229)}m 0 0 l 200 0 200 40 0 40
Dialogue: 0,0:03:04.33,0:03:07.54,sign_name_card,,0,0,0,,{\fad(450,1)\pos(138,263)}E bija e dytë e Sylvester\N{\fs17}Charlotte
Dialogue: 0,0:03:05.43,0:03:07.53,Default,Charlotte,0,0,0,,Motra e madhe Rosemyne!
Dialogue: 0,0:03:09.12,0:03:13.42,Italics,Rosemyne-Internal,0,0,0,,"Motra e madhe"?
Dialogue: 0,0:03:15.07,0:03:18.29,Default,Charlotte,0,0,0,,A mund t'ju përshëndes?
Dialogue: 0,0:03:19.95,0:03:22.30,Default,Rosemyne,0,0,0,,Po, sigurisht.
Dialogue: 0,0:03:23.55,0:03:29.95,Default_Top,Charlotte,0,0,0,,Në këtë ditë të frytshme të mbrojtur nga\NSchutzaria, Perëndesha e Erës,
Dialogue: 0,0:03:29.95,0:03:32.96,Default_Top,Charlotte,0,0,0,,a mund të lutem për një bekim mbi\Nkëtë takim të udhëhequr nga perënditë?
Dialogue: 0,0:03:28.38,0:03:31.00,Italics,Rosemyne-Internal,0,0,0,,Meqë Charlotte nuk e ka\Npërfunduar pagëzimin,
Dialogue: 0,0:03:31.00,0:03:34.32,Italics,Rosemyne-Internal,0,0,0,,ajo nuk mund të lutet për bekime të vërteta ende.
Dialogue: 0,0:03:32.96,0:03:34.32,Default_Top,Rosemyne,0,0,0,,Mundesh.
Dialogue: 0,0:03:34.32,0:03:40.83,Default,Charlotte,0,0,0,,Unë jam Charlotte, e bija e Aub\NEhrenfest. Është kënaqësi të të takoj.
Dialogue: 0,0:03:40.83,0:03:43.59,Default,Rosemyne,0,0,0,,Të mirëpres, Charlotte.
Dialogue: 0,0:03:43.59,0:03:45.71,Default,Rosemyne,0,0,0,,Unë jam motra jote e madhe.
Dialogue: 0,0:03:46.06,0:03:50.57,Default,Charlotte,0,0,0,,Jam kaq e lumtur! Gjithmonë\Nkam dashur një motër të madhe!
Dialogue: 0,0:03:52.10,0:03:54.83,Default,Charlotte,0,0,0,,Shpresoj të merremi mirë që tani e tutje.
Dialogue: 0,0:03:55.06,0:03:57.72,Italics,Rosemyne-Internal,0,0,0,,Charlotte është vërtet e lezetshme!
Dialogue: 0,0:03:57.72,0:04:00.36,Italics,Rosemyne-Internal,0,0,0,,Është engjëlli i dytë\Nqë takoj pas Tuulit!
Dialogue: 0,0:04:00.36,0:04:03.85,Default,Charlotte,0,0,0,,Motra Rosemyne, a nuk jeni\Nju gjithashtu kryepeshkopja?
Dialogue: 0,0:04:04.31,0:04:08.35,Default,Charlotte,0,0,0,,A do të jeni ju ajo që jep bekimet\Ngjatë ceremonisë së pagëzimit tim?
Dialogue: 0,0:04:08.35,0:04:11.04,Default,Rosemyne,0,0,0,,Ti je motra ime e vogël\Ne dashur, në fund të fundit.
Dialogue: 0,0:04:11.04,0:04:13.48,Default,Rosemyne,0,0,0,,Unë do të jem ajo që jep\Nbekimet e tua.
Dialogue: 0,0:04:13.74,0:04:16.13,Default,Charlotte,0,0,0,,Pres me padurim!
Dialogue: 0,0:04:16.13,0:04:22.23,Default,Rihyarda,0,0,0,,Princeshat e vogla, pse nuk e vazhdoni\Nbisedën më vonë me një çaj?
Dialogue: 0,0:04:23.46,0:04:24.62,Default,Rosemyne/Charlotte,0,0,0,,Po!
Dialogue: 0,0:04:24.88,0:04:30.11,Default,Rosemyne,0,0,0,,Dhe kështu, i premtova Charlotte se do të\Nkujdesesha për ceremoninë e saj të pagëzimit!
Dialogue: 0,0:04:33.05,0:04:37.87,Default,Ferdinand,0,0,0,,Ti duhet të raportoje\Npër Festivalin e Korrjes, budallacke.
Dialogue: 0,0:04:39.52,0:04:41.01,Default,Rosemyne,0,0,0,,Po...
Dialogue: 0,0:04:41.27,0:04:44.38,Italics_top,Rosemyne-Narration,0,0,0,,Pasi mbarova raportin,\Ntë gjithë u liruan.
Dialogue: 0,0:04:46.90,0:04:49.89,Default,Sylvester,0,0,0,,Rosemyne, në lidhje me metodën tënde\Ne kompresimit të manasë...
Dialogue: 0,0:04:51.52,0:04:55.56,Default,Rosemyne,0,0,0,,Më premtuan se do ta bënim\Njureve pas Festivalit të Korrjes.
Dialogue: 0,0:04:55.56,0:04:58.27,Default,Rosemyne,0,0,0,,Do t'ju mësoj metodën\Npasi ta kemi bërë jureve.
Dialogue: 0,0:04:58.48,0:05:01.90,Default,Ferdinand,0,0,0,,Ta bësh është në rregull, por duhet\Nta përdorësh në një kohë të mëvonshme.
Dialogue: 0,0:05:02.18,0:05:03.53,Default,Rosemyne,0,0,0,,Pse kjo?
Dialogue: 0,0:05:03.73,0:05:08.19,Default,Ferdinand,0,0,0,,Jureve do të shkaktojë që ti\Ntë flesh nga dhjetë ditë deri në një muaj...
Dialogue: 0,0:05:08.19,0:05:11.10,Default,Ferdinand,0,0,0,,madje një stinë të tërë, në varësi\Ntë rrethanave të tua.
Dialogue: 0,0:05:11.10,0:05:13.77,Default,Ferdinand,0,0,0,,Nëse do të\Nkujdesesh për pagëzimin e Charlotte,
Dialogue: 0,0:05:13.77,0:05:15.41,Default,Ferdinand,0,0,0,,do të ishte më mirë ta shtysh për momentin.
Dialogue: 0,0:05:16.92,0:05:20.29,Default,Rosemyne,0,0,0,,E kuptoj. Atëherë, pas pagëzimit...
Dialogue: 0,0:05:20.29,0:05:21.59,Default,Ferdinand,0,0,0,,Jo, prit.
Dialogue: 0,0:05:22.27,0:05:25.19,Default,Ferdinand,0,0,0,,Pas pagëzimit, vjen\Nsezoni shoqëror i dimrit,
Dialogue: 0,0:05:25.19,0:05:27.60,Default,Ferdinand,0,0,0,,Ceremonia e Kushtimit,\Ndhe Lutja e Pranverës.
Dialogue: 0,0:05:27.60,0:05:30.04,Default,Ferdinand,0,0,0,,Përdore jureve pas Lutjes së Pranverës.
Dialogue: 0,0:05:32.17,0:05:33.87,Italics,Rosemyne-Internal,0,0,0,,Jo!
Dialogue: 0,0:05:33.87,0:05:38.06,Italics,Rosemyne-Internal,0,0,0,,Shëndeti im po largohet\Ngjithnjë e më shumë!
Dialogue: 0,0:05:38.40,0:05:42.51,Default,Rosemyne,0,0,0,,Atëherë, nuk do t'u mësoj të tjerëve se si\Ne kompresoj manën deri atëherë.
Dialogue: 0,0:05:43.19,0:05:46.31,Default,Rosemyne,0,0,0,,Do të bëhem një vajzë normale.
Dialogue: 0,0:05:52.59,0:05:57.77,Default,Ferdinand,0,0,0,,Dëshiron t'i tregosh anën tënde të mirë motrës\Ntënde më të vogël si motra e madhe?
Dialogue: 0,0:05:57.77,0:05:58.83,Default,Rosemyne,0,0,0,,Ashtu është.
Dialogue: 0,0:05:59.08,0:06:02.91,Default,Ferdinand,0,0,0,,Atëherë, nëse jo vetëm që jep\Nbekimet gjatë ceremonisë së pagëzimit,
Dialogue: 0,0:06:02.91,0:06:06.22,Default,Ferdinand,0,0,0,,por i tregon Charlotte se si kontribuon\Npër dukatin e Ehrenfest
Dialogue: 0,0:06:06.48,0:06:10.97,Default,Ferdinand,0,0,0,,si e bija e birësuar e zotit në\NCeremoninë e Kushtimit dhe Lutjen e Pranverës,
Dialogue: 0,0:06:10.97,0:06:13.30,Default,Ferdinand,0,0,0,,a nuk do të fitosh\Nedhe më shumë respekt?
Dialogue: 0,0:06:13.30,0:06:14.34,Default,Rosemyne,0,0,0,,Oh...
Dialogue: 0,0:06:14.67,0:06:19.86,Default,Ferdinand,0,0,0,,A nuk mendon se kjo i shkon\Nmotrës së madhe të familjes së Kryedukës?
Dialogue: 0,0:06:19.86,0:06:21.24,Default,Rosemyne,0,0,0,,Mendoj po!
Dialogue: 0,0:06:21.24,0:06:24.12,Default,Ferdinand,0,0,0,,Atëherë, puno shumë deri në Lutjen e Pranverës.
Dialogue: 0,0:06:24.12,0:06:25.10,Default,Rosemyne,0,0,0,,Po!
Dialogue: 0,0:06:26.68,0:06:27.87,Italics,Rosemyne-Internal,0,0,0,,Hm?
Dialogue: 0,0:06:27.87,0:06:28.99,Italics,Rosemyne-Internal,0,0,0,,Hë?
Dialogue: 0,0:06:29.24,0:06:34.09,Default,Sylvester,0,0,0,,Rosemyne, mund të largohesh.\NKujdesu mirë për Charlotte.
Dialogue: 0,0:06:34.09,0:06:35.71,Default,Rosemyne,0,0,0,,Sigurisht!
Dialogue: 0,0:06:44.99,0:06:49.26,Default,Charlotte,0,0,0,,Ti krijoi karutën dhe librat me figura\Ntë teksteve të shenjta, apo jo?
Dialogue: 0,0:06:49.26,0:06:51.00,Default,Charlotte,0,0,0,,Janë vërtet të mrekullueshëm.
Dialogue: 0,0:06:51.00,0:06:53.44,Default,Rosemyne,0,0,0,,Faleminderit, Charlotte.
Dialogue: 0,0:06:54.00,0:06:58.51,Italics,Rosemyne-Internal,0,0,0,,Çfarë të bëj? Po më lavdëron\Nmotra ime e vogël e lezetshme!
Dialogue: 0,0:07:01.65,0:07:05.27,Default,Charlotte,0,0,0,,A i mendove edhe këto\Nëmbëlsira, motra e madhe?
Dialogue: 0,0:07:05.73,0:07:07.66,Default,Charlotte,0,0,0,,Janë kaq të shijshme!
Dialogue: 0,0:07:09.27,0:07:11.74,Default,Rosemyne,0,0,0,,Ottilie, mbështjelli këto për të.
Dialogue: 0,0:07:11.74,0:07:13.29,Default,Ottilie,0,0,0,,E kuptova.
Dialogue: 0,0:07:13.29,0:07:16.03,Default,Charlotte,0,0,0,,Nuk e kisha me qëllim...
Dialogue: 0,0:07:16.03,0:07:20.54,Default,Rosemyne,0,0,0,,Këto janë ndjenjat e mia.\NTë lutem, pranoji, Charlotte.
Dialogue: 0,0:07:23.26,0:07:24.55,Default,Rosemyne,0,0,0,,Damuel.
Dialogue: 0,0:07:24.55,0:07:28.97,Default,Damuel,0,0,0,,Znj. Rosemyne, Z. Wilfried\Ndëshiron të hyjë në dhomë.
Dialogue: 0,0:07:28.97,0:07:30.24,Default,Damuel,0,0,0,,Dëshiron të flasë me Znj. Charlotte...
Dialogue: 0,0:07:30.24,0:07:31.47,Default,Oswald,0,0,0,,Z. Wilfried!
Dialogue: 0,0:07:32.88,0:07:36.15,Default,Wilfried,0,0,0,,Charlotte! Dil menjëherë nga kjo dhomë!
Dialogue: 0,0:07:36.15,0:07:38.18,Default,Wilfried,0,0,0,,Nuk duhet të mashtrohesh nga Rosemyne!
Dialogue: 0,0:07:38.42,0:07:39.71,Italics,Rosemyne-Internal,0,0,0,,Si, më fal?
Dialogue: 0,0:07:40.04,0:07:43.79,Default,Charlotte,0,0,0,,Vëlla, çfarë po thua kaq papritur?
Dialogue: 0,0:07:43.79,0:07:47.68,Default,Rosemyne,0,0,0,,Vërtet... Ju lutem ndaloni\Nakuzat e rreme.
Dialogue: 0,0:07:47.68,0:07:49.51,Default,Wilfried,0,0,0,,Mos u bëj i pafaj!
Dialogue: 0,0:07:49.51,0:07:51.69,Default,Oswald,0,0,0,,Nuk duhet! Të lutem ndalo!
Dialogue: 0,0:07:50.40,0:07:51.37,Default_Top,Lamprecht,0,0,0,,Kjo është e keqe!
Dialogue: 0,0:07:56.90,0:07:59.37,Default,Wilfried,0,0,0,,Ouch! Çfarë po bën?!
Dialogue: 0,0:07:59.37,0:08:01.13,Default,Angelica,0,0,0,,Ende nuk keni marrë\Nleje për të hyrë në dhomë.
Dialogue: 0,0:08:01.13,0:08:03.92,Default,Angelica,0,0,0,,Ju lutem, mos iu afroni Znj. Rosemyne.
Dialogue: 0,0:08:03.92,0:08:05.29,Default,Wilfried,0,0,0,,Lëshomë!
Dialogue: 0,0:08:05.55,0:08:09.54,Default,Angelica,0,0,0,,Si kalorës roje, nuk mund\Ntë lë të shkojë një person të dyshimtë.
Dialogue: 0,0:08:09.77,0:08:14.16,Default,Wilfried,0,0,0,,Personi i dyshimtë këtu\Nështë Rosemyne! I dëgjova të gjitha!
Dialogue: 0,0:08:14.16,0:08:17.42,Default,Wilfried,0,0,0,,Rosemyne dhe Ferdinand kurdisën të tjerët!
Dialogue: 0,0:08:17.42,0:08:19.49,Default,Wilfried,0,0,0,,Të dy janë zuzarë!
Dialogue: 0,0:08:19.49,0:08:23.44,Default,Rosemyne,0,0,0,,Vëlla Wilfried, nga kush\Ni dëgjove këto?
Dialogue: 0,0:08:23.44,0:08:25.03,Default,Wilfried,0,0,0,,Gjyshja!
Dialogue: 0,0:08:25.03,0:08:27.06,Default,Wilfried,0,0,0,,I dëgjova drejtpërdrejt nga gjyshja!
Dialogue: 0,0:08:30.20,0:08:35.45,Italics,Rosemyne-Internal,0,0,0,,Por a nuk është gjyshja e vëllait\Naktualisht e burgosur?
Dialogue: 0,0:08:35.77,0:08:37.13,Default,Lamprecht,0,0,0,,Kur?!
Dialogue: 0,0:08:37.40,0:08:40.29,Default,Lamprecht,0,0,0,,Kur fole me Znj. Veronica?!
Dialogue: 0,0:08:40.29,0:08:42.65,Default,Oswald,0,0,0,,Të lutem përgjigju, Z. Wilfried!
Dialogue: 0,0:08:42.65,0:08:48.66,Default,Wilfried,0,0,0,,A është takimi me gjyshen time\Nkaq i madh?
Dialogue: 0,0:08:49.23,0:08:50.23,Default,Lamprecht,0,0,0,,Po...
Dialogue: 0,0:08:51.00,0:08:52.66,Default,Charlotte,0,0,0,,Vëlla...
Dialogue: 0,0:08:53.36,0:08:56.60,Default,Rosemyne,0,0,0,,Rihyarda. Të lutem thirr Aub-in.
Dialogue: 0,0:08:56.60,0:08:58.75,Default,Rihyarda,0,0,0,,E kuptova, Princeshë.
Dialogue: 0,0:09:00.94,0:09:04.70,Eyecatch_an4,Sign,0,0,0,,{\fad(1,450)}Ngritja e një\NBibliomane:\N{\fs11\c&HB99F4D&}E bija e birësuar e Kryedukës
Dialogue: 0,0:09:07.24,0:09:10.95,Eyecatch_an6,Sign,0,0,0,,{\fad(450,1)}Ngritja e një\NBibliomane:\N{\fs11\c&HB99F4D&}E bija e birësuar e Kryedukës
Dialogue: 0,0:09:18.74,0:09:21.58,Default,Ferdinand,0,0,0,,Ka mënyra të ndryshme\Npër të shikuar një gjë.
Dialogue: 0,0:09:21.85,0:09:25.97,Default,Ferdinand,0,0,0,,Duhet të zbulojmë gjithçka\Npara se të mund të gjykojmë.
Dialogue: 0,0:09:26.39,0:09:29.83,Default,Ferdinand,0,0,0,,Duhet të kuptosh se gënjeshtra\Ndo të konsiderohet krim.
Dialogue: 0,0:09:30.15,0:09:34.21,Default,Sylvester,0,0,0,,Wilfried, kur u takove me nënën time?
Dialogue: 0,0:09:34.44,0:09:37.21,Default,Wilfried,0,0,0,,Gjatë garës së gjuetisë, baba.
Dialogue: 0,0:09:40.62,0:09:43.22,Default,Rosemyne,0,0,0,,Gara e gjuetisë?
Dialogue: 0,0:09:43.22,0:09:46.36,Default,Ferdinand,0,0,0,,Është një gjueti që zhvillohet\Nnë pyllin e kështjellës
Dialogue: 0,0:09:46.36,0:09:48.97,Default,Ferdinand,0,0,0,,gjatë kohës që zakonisht udhëton\Npër Festivalin e Korrjes.
Dialogue: 0,0:10:05.44,0:10:07.88,Default,Ferdinand,0,0,0,,Gjahu i kapur shërben gjithashtu\Nsi ushqim për dimrin
Dialogue: 0,0:10:08.24,0:10:11.13,Default,Ferdinand,0,0,0,,dhe ka shpërblime për\Nnumrin e kafshëve të gjuajtura,
Dialogue: 0,0:10:11.13,0:10:13.60,Default,Ferdinand,0,0,0,,ndaj është një ngjarje që kalorësit\Ne presin gjithmonë me padurim.
Dialogue: 0,0:10:14.02,0:10:17.75,Default,Sylvester,0,0,0,,A nuk ishe me Florencia gjatë\Ngarës së gjuetisë?
Dialogue: 0,0:10:18.02,0:10:20.34,Default,Wilfried,0,0,0,,Ishte me të deri diku...
Dialogue: 0,0:10:20.63,0:10:24.07,Default,Wilfried,0,0,0,,Ishte kaq i lumtur të shihja miqtë e mi\Nnga dhoma e lojërave përsëri
Dialogue: 0,0:10:24.07,0:10:26.09,Default,Wilfried,0,0,0,,sa u zhytëm në bisedë.
Dialogue: 0,0:10:26.47,0:10:27.71,Default,Wilfried,0,0,0,,Pastaj...
Dialogue: 0,0:10:28.02,0:10:30.42,Flashback,Child 1,0,0,0,,Të luajmë kukafshehti?
Dialogue: 0,0:10:30.42,0:10:33.80,Flashback,Child 2,0,0,0,,Mund të garojmë se kush e kalon
Dialogue: 0,0:10:33.80,0:10:37.52,Flashback,Child 2,0,0,0,,sheshin e çajit më shpejt\Npa u parë nga të rriturit.
Dialogue: 0,0:10:37.81,0:10:39.46,Flashback,Wilfried,0,0,0,,Tingëllon argëtuese.
Dialogue: 0,0:10:39.46,0:10:40.78,Flashback,Wilfried,0,0,0,,Në rregull. Le të garojmë!
Dialogue: 0,0:10:42.44,0:10:47.51,Default,Wilfried,0,0,0,,Po rrëshqisnim nën tavolina\Nqë asnjë i rritur të mos na shihte.
Dialogue: 0,0:10:48.09,0:10:50.14,Default,Wilfried,0,0,0,,Atëherë e dëgjova rastësisht.
Dialogue: 0,0:10:50.95,0:10:55.84,Flashback,Noble Man 1,0,0,0,,Duket se e bija e birësuar e kryedukës\Nishte e përfshirë në kapjen e Znj. Veronica.
Dialogue: 0,0:10:55.84,0:10:57.68,Flashback_Italics,Wilfried-Internal,0,0,0,,A po flasin për Rosemyne?
Dialogue: 0,0:10:57.68,0:11:00.06,Flashback,Noble Man 2,0,0,0,,Edhe Z. Ferdinand, apo jo?
Dialogue: 0,0:11:00.06,0:11:01.23,Flashback,Wilfried,0,0,0,,Gaboheni.
Dialogue: 0,0:11:01.23,0:11:02.80,Flashback,Noble Man 1,0,0,0,,Z. Wilfried!
Dialogue: 0,0:11:03.04,0:11:05.87,Flashback,Wilfried,0,0,0,,Gjyshja u kërkua nga xhaxhai im i madh
Dialogue: 0,0:11:05.87,0:11:08.18,Flashback,Wilfried,0,0,0,,të përdorte vulën e kryedukës\Npa leje.
Dialogue: 0,0:11:08.18,0:11:11.65,Flashback,Wilfried,0,0,0,,Ajo u akuzua dhe u ndëshkua për ftesën\Ne një fisniku nga një dukat tjetër në qytet
Dialogue: 0,0:11:11.65,0:11:13.31,Flashback,Wilfried,0,0,0,,kur kjo ishte e ndaluar.
Dialogue: 0,0:11:13.56,0:11:16.05,Flashback,Wilfried,0,0,0,,Këtë më tha babai.
Dialogue: 0,0:11:16.05,0:11:18.07,Flashback,Noble Man 1,0,0,0,,Ashtu është...
Dialogue: 0,0:11:18.07,0:11:22.22,Flashback,Noble Man 1,0,0,0,,Megjithatë, Znj. Rosemyne ishte arsyeja pse ajo\Nkreu një krim të tillë në radhë të parë
Dialogue: 0,0:11:22.22,0:11:26.05,Flashback,Noble Man 1,0,0,0,,dhe Z. Ferdinand ishte ai që\Ni lëvizte fijet pas skenave.
Dialogue: 0,0:11:26.05,0:11:31.45,Flashback,Noble,0,0,0,,Ata të dy po përpiqen të marrin Ehrenfestin\Npër vete, Z. Wilfried.
Dialogue: 0,0:11:31.75,0:11:32.96,Flashback,Wilfried,0,0,0,,Gënjeshtra!
Dialogue: 0,0:11:33.75,0:11:36.43,Flashback,Noble,0,0,0,,Nëse e pyet drejtpërdrejt Znj. Veronica,
Dialogue: 0,0:11:36.43,0:11:40.09,Flashback,Noble,0,0,0,,ndoshta do të mund të zbulosh\Ntë vërtetën e çështjes?
Dialogue: 0,0:11:40.09,0:11:44.34,Flashback,Noble,0,0,0,,Nëse më kujtohet mirë, Znj. Veronica është\Naktualisht e burgosur në Kullën e Bardhë.
Dialogue: 0,0:11:44.34,0:11:46.13,Flashback,Wilfried,0,0,0,,Kulla e Bardhë?
Dialogue: 0,0:11:46.13,0:11:47.85,Flashback,Roderick,0,0,0,,Dëgjova se është thellë në pyll.
Dialogue: 0,0:11:47.85,0:11:50.36,Flashback,Child 1,0,0,0,,Le të shkojmë ta shohim, Z. Wilfried!
Dialogue: 0,0:11:50.36,0:11:51.98,Flashback,Child 2,0,0,0,,Le të eksplorojmë!
Dialogue: 0,0:11:52.39,0:11:54.34,Flashback,Wilfried,0,0,0,,Eksplorim, hë?
Dialogue: 0,0:11:54.85,0:11:55.85,Flashback,Wilfried,0,0,0,,Në rregull.
Dialogue: 0,0:12:02.57,0:12:05.11,Default,Wilfried,0,0,0,,Hymë në pyll sikur\Ntë ishte një aventurë dhe...
Dialogue: 0,0:12:06.18,0:12:07.85,Flashback,Roderick,0,0,0,,A nuk është ajo?
Dialogue: 0,0:12:09.71,0:12:13.91,Flashback,Wilfried,0,0,0,,Kjo është Kulla e Bardhë...
Dialogue: 0,0:12:15.49,0:12:17.57,Flashback,Child 1,0,0,0,,Është vërtet këtu.
Dialogue: 0,0:12:32.74,0:12:37.16,Flashback,Guard,0,0,0,,Këtë derë mund ta hapë vetëm\Nkryeduka ose pasardhësit e tij.
Dialogue: 0,0:12:37.16,0:12:38.77,Flashback,Guard,0,0,0,,Askush tjetër nuk mund të hyjë.
Dialogue: 0,0:12:52.61,0:12:57.66,Default,Wilfried,0,0,0,,Siç tha ai, dera u hap vërtet\Nkur u përpoqa ta hapja.
Dialogue: 0,0:12:58.98,0:13:01.37,Default,Sylvester,0,0,0,,Pra, përfundove duke hyrë...
Dialogue: 0,0:13:02.60,0:13:05.01,Default,Ferdinand,0,0,0,,Gjërat u bënë të ndërlikuara.
Dialogue: 0,0:13:05.01,0:13:08.01,Default,Ferdinand,0,0,0,,Prandaj të thashë ta shkishëroje atë.
Dialogue: 0,0:13:08.33,0:13:09.88,Italics,Rosemyne-Internal,0,0,0,,Të ndërlikuara?
Dialogue: 0,0:13:10.76,0:13:12.89,Default,Sylvester,0,0,0,,Kush tjetër hyri?
Dialogue: 0,0:13:12.89,0:13:14.33,Default,Wilfried,0,0,0,,Vetëm unë.
Dialogue: 0,0:13:14.33,0:13:20.15,Default,Wilfried,0,0,0,,Gjyshja ishte vërtet e burgosur në\Natë kullë dhe më tha të vërtetën.
Dialogue: 0,0:13:20.38,0:13:25.13,Default,Wilfried,0,0,0,,Arsyeja pse gjyshja ime është e burgosur\Ndhe vuan në një vend të tillë
Dialogue: 0,0:13:25.90,0:13:29.28,Default,Wilfried,0,0,0,,është e gjitha për shkak të Rosemyne dhe Ferdinand!
Dialogue: 0,0:13:32.04,0:13:36.06,Default,Wilfried,0,0,0,,Baba, të lutem.\NNdihmoji gjysh...
Dialogue: 0,0:13:36.61,0:13:37.64,Default,Sylvester,0,0,0,,Mos e thuaj!
Dialogue: 0,0:13:37.64,0:13:39.53,Default,Sylvester,0,0,0,,Nuk duhet ta thuash\Npjesën tjetër të asaj fjalie!
Dialogue: 0,0:13:39.53,0:13:41.79,Default,Sylvester,0,0,0,,Mos kryej më krime!
Dialogue: 0,0:13:43.09,0:13:44.48,Default,Wilfried,0,0,0,,Krime?
Dialogue: 0,0:13:44.48,0:13:46.92,Default,Wilfried,0,0,0,,A kryeva një krim?
Dialogue: 0,0:13:47.17,0:13:48.34,Default,Sylvester,0,0,0,,Ashtu është.
Dialogue: 0,0:13:48.34,0:13:50.55,Default,Sylvester,0,0,0,,Kulla përdoret për të burgosur ata
Dialogue: 0,0:13:50.55,0:13:54.41,Default,Sylvester,0,0,0,,brenda familjes së kryedukës që\Nkanë kryer krime të rënda
Dialogue: 0,0:13:54.41,0:13:59.68,Default,Sylvester,0,0,0,,dhe hyrja pa lejen\Ne Aub-it konsiderohet tradhti!
Dialogue: 0,0:13:59.89,0:14:00.69,Default,Wilfried,0,0,0,,Çfarë?!
Dialogue: 0,0:14:00.98,0:14:01.80,Default,Charlotte/Rosemyne,0,0,0,,Hë?!
Dialogue: 0,0:14:02.68,0:14:05.94,Default,Wilfried,0,0,0,,Askush atje nuk më tha diçka të tillë...
Dialogue: 0,0:14:06.27,0:14:08.45,Default,Ferdinand,0,0,0,,U mashtrove.
Dialogue: 0,0:14:08.45,0:14:09.86,Default,Wilfried,0,0,0,,U mashtrova?
Dialogue: 0,0:14:09.86,0:14:13.61,Default,Ferdinand,0,0,0,,Vetë loja e kukafshehtit\Nishte ndoshta një pretekst për të të tërhequr
Dialogue: 0,0:14:13.61,0:14:16.32,Default,Ferdinand,0,0,0,,në mbledhjen e\Nish-fraksionit Veronica.
Dialogue: 0,0:14:16.66,0:14:18.32,Default,Wilfried,0,0,0,,Nuk mund të jetë...
Dialogue: 0,0:14:18.32,0:14:22.97,Italics,Rosemyne-Internal,0,0,0,,Kujtova atë që më tha njëherë Rihyarda.
Dialogue: 0,0:14:22.97,0:14:28.18,Flashback,Rihyarda,0,0,0,,Mos harro kurrë se ka prindër\Npas të gjithë atyre fëmijëve.
Dialogue: 0,0:14:28.54,0:14:32.51,Default,Wilfried,0,0,0,,P-Por, Rosemyne ishte ajo\Nqë komplotoi...
Dialogue: 0,0:14:32.51,0:14:39.40,Default,Florencia,0,0,0,,Znj. Veronica ishte ajo që komplotoi dhe\Nshkaktoi kaos në dukat, Wilfried.
Dialogue: 0,0:14:40.53,0:14:42.90,Default,Wilfried,0,0,0,,Për çfarë po flet, nëna?
Dialogue: 0,0:14:43.24,0:14:48.28,Default,Sylvester,0,0,0,,Nëna dhe xhaxhai im kryen krime\Ndhe u përpoqën të dëmtonin Rosemyne.
Dialogue: 0,0:14:48.53,0:14:52.77,Default,Sylvester,0,0,0,,E birësova për ta mbrojtur.
Dialogue: 0,0:14:52.77,0:14:53.79,Default,Wilfried,0,0,0,,Hë?
Dialogue: 0,0:14:54.17,0:14:57.71,Default,Ferdinand,0,0,0,,Ka aq të vërteta\Nsa ka njerëz.
Dialogue: 0,0:14:57.71,0:15:00.67,Default,Ferdinand,0,0,0,,Rosemyne, tregoji atij të vërtetën tënde.
Dialogue: 0,0:15:02.97,0:15:04.72,Default,Rosemyne,0,0,0,,Deri atëherë, unë
Dialogue: 0,0:15:04.72,0:15:07.94,Default,Rosemyne,0,0,0,,po bëja libra në katedrale\Nme njerëzit e qytetit të poshtëm.
Dialogue: 0,0:15:08.49,0:15:11.09,Italics_top,Rosemyne-Narration,0,0,0,,Fola sipas\Nhistorisë që krijuam
Dialogue: 0,0:15:11.09,0:15:14.06,Italics_top,Rosemyne-Narration,0,0,0,,kur u bëra\Ne bija e birësuar e kryedukës.
Dialogue: 0,0:15:14.06,0:15:18.70,Default,Rosemyne,0,0,0,,Sapo u vendos që do të bëhesha\Ne bija e birësuar e kryedukës,
Dialogue: 0,0:15:18.70,0:15:22.12,Default,Rosemyne,0,0,0,,më u ndalua të shkoja në qytetin\Ne poshtëm ose të ndërveproja me njerëzit atje.
Dialogue: 0,0:15:22.12,0:15:25.01,Default,Rosemyne,0,0,0,,Kishte edhe gjëra të tjera që\Nm'u morën, por...
Dialogue: 0,0:15:25.01,0:15:27.04,Default,Rosemyne,0,0,0,,Humba lirinë time.
Dialogue: 0,0:15:27.46,0:15:30.07,Default,Rosemyne,0,0,0,,Kjo është ana ime e së vërtetës.
Dialogue: 0,0:15:30.36,0:15:31.61,Default,Wilfried,0,0,0,,Është ndryshe...
Dialogue: 0,0:15:32.13,0:15:35.58,Default,Wilfried,0,0,0,,Është ndryshe nga ajo që\Nmë tha gjyshja!
Dialogue: 0,0:15:35.58,0:15:40.39,Default,Ferdinand,0,0,0,,Megjithatë, ti e besove\Natë histori, fyeve Rosemyne,
Dialogue: 0,0:15:40.39,0:15:42.83,Default,Ferdinand,0,0,0,,dhe hyre në kullën e ndaluar.
Dialogue: 0,0:15:43.18,0:15:46.22,Default,Ferdinand,0,0,0,,A je i përgatitur të përballosh ndëshkimin?
Dialogue: 0,0:15:46.68,0:15:47.97,Default,Wilfried,0,0,0,,Ndëshkimin...
Dialogue: 0,0:15:48.62,0:15:51.25,Default,Ferdinand,0,0,0,,Do të ishte e përshtatshme ta\Nshkishërojmë dhe ta dërgojmë
Dialogue: 0,0:15:51.25,0:15:53.71,Default,Ferdinand,0,0,0,,në katedrale ose ta mbyllim\Nbrenda kullës.
Dialogue: 0,0:16:00.23,0:16:03.47,Default,Florencia,0,0,0,,Sapo të kisha rikthyer\Nnë duart e mia...
Dialogue: 0,0:16:03.94,0:16:06.23,Default,Wilfried,0,0,0,,Shkishërim...
Dialogue: 0,0:16:06.48,0:16:07.99,Default,Charlotte,0,0,0,,Vëlla...
Dialogue: 0,0:16:09.59,0:16:12.73,Italics,Rosemyne-Internal,0,0,0,,Këtu duhet të bëj më të mirën\Nsi motra e madhe...
Dialogue: 0,0:16:13.24,0:16:17.70,Default,Rosemyne,0,0,0,,Baba, vëlla Wilfried u nxit\Nt'i bënte gjëra të tilla!
Dialogue: 0,0:16:17.70,0:16:22.37,Default,Rosemyne,0,0,0,,Po të isha në pozicionin e tij, ndoshta\Ndo të kisha bërë të njëjtën gjë...
Dialogue: 0,0:16:22.62,0:16:27.88,Default,Rosemyne,0,0,0,,Sepse, për vëllain tim, Znj. Veronica\Nështë një anëtare e rëndësishme e familjes së tij.
Dialogue: 0,0:16:28.12,0:16:29.65,Default,Ferdinand,0,0,0,,Familje, hë?
Dialogue: 0,0:16:29.65,0:16:31.75,Default,Ferdinand,0,0,0,,Je vërtet naive.
Dialogue: 0,0:16:32.17,0:16:36.13,Default,Rosemyne,0,0,0,,Baba, ndonëse është e vërtetë që\Nvëllai hyri në kullë,
Dialogue: 0,0:16:36.13,0:16:38.38,Default,Rosemyne,0,0,0,,ishte qartësisht rezultat\Ni manipulimit.
Dialogue: 0,0:16:38.38,0:16:41.01,Default,Rosemyne,0,0,0,,Edhe kështu, a do të\Nakuzohet ende për krim?
Dialogue: 0,0:16:44.87,0:16:49.88,Italics_top,Rosemyne-Narration,0,0,0,,Pas kësaj, diskutuam se çfarë\Ntë bënim me vëllain Wilfried.
Dialogue: 0,0:16:50.62,0:16:52.36,Default,Ferdinand,0,0,0,,Kjo është e vështirë.
Dialogue: 0,0:16:52.36,0:16:54.04,Default,Sylvester,0,0,0,,Pse kështu?
Dialogue: 0,0:16:54.29,0:16:58.78,Default,Ferdinand,0,0,0,,Shumë njerëz ishin të përfshirë dhe ne\Nnuk i dimë qëllimet e armikut.
Dialogue: 0,0:16:59.23,0:17:04.03,Default,Ferdinand,0,0,0,,Dhe, sapo hapen dyert e kullës,\Ntë tjerët mund të hyjnë.
Dialogue: 0,0:17:04.03,0:17:05.58,Default,Wilfried,0,0,0,,Vërtet?!
Dialogue: 0,0:17:05.58,0:17:06.66,Default,Ferdinand,0,0,0,,Po.
Dialogue: 0,0:17:06.66,0:17:11.91,Default,Ferdinand,0,0,0,,Megjithatë, askush nuk erdhi të shpëtonte\Ngjyshen tënde të burgosur.
Dialogue: 0,0:17:14.03,0:17:18.06,Italics,Rosemyne-Internal,0,0,0,,Vetëm një numër i kufizuar njerëzish\Ne dinin se kulla ekzistonte fare.
Dialogue: 0,0:17:18.48,0:17:22.76,Default,Ferdinand,0,0,0,,Kulla mbrohet nga një barrierë,\Nndaj nuk ka roje atje.
Dialogue: 0,0:17:27.07,0:17:28.76,Default,Ferdinand,0,0,0,,Mendoja se
Dialogue: 0,0:17:28.76,0:17:33.68,Default,Ferdinand,0,0,0,,ish-fraksioni Veronica donte ta\Nbënte Wilfriedin figurën e tyre të re.
Dialogue: 0,0:17:33.68,0:17:38.18,Default,Ferdinand,0,0,0,,Nëse do të ishte kështu, t'i tregoje\Natij për gjendjen aktuale
Dialogue: 0,0:17:38.18,0:17:40.89,Default,Ferdinand,0,0,0,,të gjyshes që e përkëdhelte\Ndo të ishte një mjet efektiv
Dialogue: 0,0:17:40.89,0:17:43.61,Default,Ferdinand,0,0,0,,psikologjik për të krijuar një\Nçarje midis tij dhe prindërve të tij.
Dialogue: 0,0:17:45.06,0:17:48.58,Default,Ferdinand,0,0,0,,Megjithatë, me këtë ritëm, ai do të\Nshkishërohej ose ekzekutohej.
Dialogue: 0,0:17:49.04,0:17:52.83,Default,Ferdinand,0,0,0,,Duket se objektivi i vërtetë\Nkëtu është eliminimi i Wilfriedit.
Dialogue: 0,0:17:52.83,0:17:54.04,Default,Sylvester,0,0,0,,Në atë rast,
Dialogue: 0,0:17:54.04,0:17:57.08,Default,Sylvester,0,0,0,,a nuk do të ishte më mirë ta eliminonin\Nnë momentin që u rrëmbye?
Dialogue: 0,0:17:58.77,0:18:05.73,Default,Ferdinand,0,0,0,,Ndoshta rënia e Wilfriedit është vetëm një prelud\Ndhe plani i vërtetë fillon pas kësaj?
Dialogue: 0,0:18:06.13,0:18:07.47,Default,Sylvester,0,0,0,,Hmm...
Dialogue: 0,0:18:07.86,0:18:10.29,Default,Sylvester,0,0,0,,Cili është qëllimi i tyre?
Dialogue: 0,0:18:11.23,0:18:13.68,Default,Rosemyne,0,0,0,,Kjo është qartësisht ngacmim.
Dialogue: 0,0:18:14.43,0:18:15.78,Default,Ferdinand,0,0,0,,Ngacmim?
Dialogue: 0,0:18:15.78,0:18:17.02,Default,Rosemyne,0,0,0,,Ashtu është.
Dialogue: 0,0:18:17.02,0:18:19.50,Default,Rosemyne,0,0,0,,Siç e shihni, ka shkaktuar\Nnjë çarje në familjen tonë
Dialogue: 0,0:18:19.50,0:18:23.74,Default,Rosemyne,0,0,0,,dhe babai im tani po rrah\Nmendjen për atë që duhet bërë me vëllain tim.
Dialogue: 0,0:18:23.74,0:18:28.25,Default,Rosemyne,0,0,0,,Megjithatë, sido që të veprojmë,\Ndo të ketë ankesa nga fisnikëria.
Dialogue: 0,0:18:28.25,0:18:34.14,Default,Rosemyne,0,0,0,,Megjithatë, nuk mund t'i lejojmë vetes\Nhumbjen e manasë duke ndëshkuar të gjithë fisnikët e përfshirë.
Dialogue: 0,0:18:34.14,0:18:36.30,Default,Rosemyne,0,0,0,,Është gjithashtu e rrezikshme\Nt'i lëmë gjërat si janë.
Dialogue: 0,0:18:36.30,0:18:39.76,Default,Rosemyne,0,0,0,,Sido që të ndodhë,\Nnuk do të jetë mirë për Ehrenfestin.
Dialogue: 0,0:18:40.04,0:18:44.01,Default,Rosemyne,0,0,0,,Me fjalë të tjera... Besoj se ky është\Nngacmim nga jashtë dukatit.
Dialogue: 0,0:18:44.01,0:18:45.54,Default,Sylvester,0,0,0,,E kuptoj...
Dialogue: 0,0:18:45.54,0:18:49.67,Default,Sylvester,0,0,0,,Ky nuk është konflikt mes fisnikëve,\Npor ngacmim nga jashtë.
Dialogue: 0,0:18:49.67,0:18:52.52,Default,Sylvester,0,0,0,,Je çuditërisht e zgjuar.
Dialogue: 0,0:18:52.52,0:18:53.70,Italics,Rosemyne-Internal,0,0,0,,Çuditërisht?
Dialogue: 0,0:18:53.70,0:18:58.47,Default,Ferdinand,0,0,0,,Nëse është kështu, a është qëllimi i tyre\Ntë dëmtojnë autoritetin e kryedukës?
Dialogue: 0,0:18:58.47,0:19:02.54,Default,Rosemyne,0,0,0,,Ose ndoshta po përpiqen të dobësojnë\Nnivelin e manasë në Ehrenfest.
Dialogue: 0,0:19:03.13,0:19:06.04,Default,Rosemyne,0,0,0,,Në atë rast, eliminimi i vëllait tim
Dialogue: 0,0:19:06.04,0:19:10.78,Default,Rosemyne,0,0,0,,ose ndëshkimi i fisnikëve të përfshirë\Ndo të shërbente vetëm për të kënaqur palën tjetër.
Dialogue: 0,0:19:11.12,0:19:14.29,Default,Rosemyne,0,0,0,,Për momentin, besoj se duhet\Ntë ruajmë status quo-n
Dialogue: 0,0:19:14.29,0:19:18.80,Default,Rosemyne,0,0,0,,dhe të mbledhim informacion që të mund\Ntë shqyrtojmë se si ta trajtojmë më mirë situatën.
Dialogue: 0,0:19:18.80,0:19:20.54,Default,Charlotte,0,0,0,,Motra...
Dialogue: 0,0:19:20.78,0:19:24.91,Default,Ferdinand,0,0,0,,Jo, nuk mund ta mbyllim këtë çështje\Npa asnjë qortim.
Dialogue: 0,0:19:24.91,0:19:27.99,Default,Ferdinand,0,0,0,,Eliminimi i Wilfriedit\Nështë absolutisht i nevojshëm.
Dialogue: 0,0:19:30.95,0:19:33.93,Italics,Rosemyne-Internal,0,0,0,,Dua të bëj përshtypje te Charlotte!
Dialogue: 0,0:19:33.93,0:19:36.53,Italics,Rosemyne-Internal,0,0,0,,Mendo diçka, unë!
Dialogue: 0,0:19:39.84,0:19:41.69,Italics,Rosemyne-Internal,0,0,0,,Ashtu është! Kjo është!
Dialogue: 0,0:19:42.06,0:19:45.32,Default,Rosemyne,0,0,0,,Atëherë, le të përdorim mjetin magjik që\Nshikon kujtimet e dikujt tjetër.
Dialogue: 0,0:19:45.66,0:19:47.83,Italics_top,Rosemyne-Narration,0,0,0,,Mjeti magjik
Dialogue: 0,0:19:47.83,0:19:51.00,Italics_top,Rosemyne-Narration,0,0,0,,që shikon kujtimet është fillimisht një\Nmjet që përdoret vetëm kundër kriminelëve të rëndë.
Dialogue: 0,0:19:51.41,0:19:55.19,Default,Rosemyne,0,0,0,,Në këtë mënyrë, mund të japim\Npërshtypjen se një ndëshkim
Dialogue: 0,0:19:55.19,0:19:57.59,Default,Rosemyne,0,0,0,,është dhënë dhe gjithashtu\Ntë identifikojmë armiqtë tanë.
Dialogue: 0,0:19:57.88,0:20:00.62,Default,Ferdinand,0,0,0,,Mund të bëjmë gjithashtu që të duket\Nse po i lëmë me qëllim
Dialogue: 0,0:20:00.62,0:20:02.59,Default,Ferdinand,0,0,0,,të lëkunden\Nsi karrem...
Dialogue: 0,0:20:06.20,0:20:09.44,Default,Ferdinand,0,0,0,,Do t'i ndëshkojmë fisnikët\Nqë kemi identifikuar si armiq
Dialogue: 0,0:20:09.44,0:20:12.27,Default,Ferdinand,0,0,0,,dhe Wilfriedi nuk do të jetë më\Ni garantuar si pasardhës.
Dialogue: 0,0:20:12.27,0:20:14.38,Default,Ferdinand,0,0,0,,Si tingëllon kjo, Sylvester?
Dialogue: 0,0:20:15.68,0:20:20.52,Default,Sylvester,0,0,0,,Wilfried, do të të trajtoj si kriminel\Nqë ka kryer një krim të rëndë
Dialogue: 0,0:20:20.52,0:20:22.83,Default,Sylvester,0,0,0,,dhe do të përdor një mjet magjik për\Ntë kërkuar në kujtimet e tua.
Dialogue: 0,0:20:23.19,0:20:26.73,Default,Sylvester,0,0,0,,Në të njëjtën kohë, nominimi yt si\Nkryeduka i ardhshëm do të revokohet.
Dialogue: 0,0:20:26.73,0:20:28.82,Default,Sylvester,0,0,0,,Ky do të jetë ndëshkimi yt.
Dialogue: 0,0:20:29.13,0:20:32.33,Default,Sylvester,0,0,0,,Mos bëj më veprime\Ntë pakujdesshme që tani e tutje.
Dialogue: 0,0:20:32.99,0:20:33.96,Default,Wilfried,0,0,0,,Po...
Dialogue: 0,0:20:33.96,0:20:35.45,Default,Charlotte,0,0,0,,Falë Zotit.
Dialogue: 0,0:20:38.44,0:20:43.45,Default,Florencia,0,0,0,,Wilfried, jam vërtet e lumtur\Nqë mund të vazhdosh
Dialogue: 0,0:20:43.45,0:20:45.60,Default,Florencia,0,0,0,,të qëndrosh pranë meje.
Dialogue: 0,0:20:47.94,0:20:49.16,Default,Wilfried,0,0,0,,Rosemyne...
Dialogue: 0,0:20:49.60,0:20:55.50,Default,Wilfried,0,0,0,,E dua gjyshen time, por tani\Nkuptoj se ajo kishte gabim.
Dialogue: 0,0:20:55.50,0:20:58.47,Default,Wilfried,0,0,0,,Ishte gabim nga ana ime\Ntë dyshoja ty. Më vjen keq.
Dialogue: 0,0:20:58.47,0:21:01.12,Default,Rosemyne,0,0,0,,Tani jam mirë, vëlla.
Dialogue: 0,0:21:01.60,0:21:03.74,Default,Charlotte,0,0,0,,Je e mahnitshme, motra!
Dialogue: 0,0:21:03.74,0:21:07.37,Default,Charlotte,0,0,0,,Të admiroj kaq shumë!
Dialogue: 0,0:21:10.18,0:21:11.41,Italics,Rosemyne-Internal,0,0,0,,Ia dola!
Dialogue: 0,0:21:11.41,0:21:14.98,Italics,Rosemyne-Internal,0,0,0,,U bëra një motër e madhe për t'u admiruar!
Dialogue: 0,0:21:18.62,0:21:22.16,Default,Ferdinand,0,0,0,,Wilfried, si i biri i kryedukës,
Dialogue: 0,0:21:22.16,0:21:24.62,Default,Ferdinand,0,0,0,,të ka mbetur një njollë\Ne pashlyeshme mbi emrin tënd.
Dialogue: 0,0:21:25.21,0:21:29.52,Default,Ferdinand,0,0,0,,Megjithatë, nëse vazhdon të punosh shumë\Npa u dekurajuar, do të rritesh.
Dialogue: 0,0:21:30.18,0:21:33.18,Default,Ferdinand,0,0,0,,Ajo sinqeriteti yt është një virtyt i rrallë.
Dialogue: 0,0:21:35.77,0:21:39.51,Default,Wilfried,0,0,0,,Do të punoj shumë, Ferdi... jo,
Dialogue: 0,0:21:40.65,0:21:41.76,Default,Wilfried,0,0,0,,Xhaxha!
Dialogue: 0,0:21:42.44,0:21:46.27,Italics,Rosemyne-Internal,0,0,0,,Për të shmangur të njëjtat\Ngabime si vëlla Wilfried,
Dialogue: 0,0:21:46.27,0:21:53.17,Italics,Rosemyne-Internal,0,0,0,,vendosa të mësoj përmendsh seriozisht listën\Ne fisnikëve që më bëri nëna.
Dialogue: 0,0:21:57.58,0:22:01.50,Creditsv2,Sign,0,0,0,,Përktheu   Angela Tamae Liu
Dialogue: 0,0:22:01.50,0:22:05.38,Creditsv2,Sign,0,0,0,,Kohëmatja   Edgar Cruz
Dialogue: 0,0:22:05.38,0:22:09.59,Creditsv2,Sign,0,0,0,,Redaktimi   Tara Campbell
Dialogue: 0,0:22:09.59,0:22:13.51,Creditsv2,Sign,0,0,0,,Kontrolli i cilësisë   Alicia Ashby
Dialogue: 0,0:22:13.51,0:22:17.73,Creditsv2,Sign,0,0,0,,Kontrolli final   Michelle Tymon
Dialogue: 0,0:23:26.84,0:23:29.85,Next_Chapter,Sign,0,0,0,,Episodi tjetër\NPagëzimi i Charlotte
