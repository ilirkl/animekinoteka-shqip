Dialogue: 0,0:00:06.96,0:00:10.42,Q2,,0,0,0,,{\pos(166.4,504)}{\an7}Ik
Dialogue: 0,0:00:06.96,0:00:07.75,Q3,,0,0,0,,{\pos(448,453.6)}{\an7}????
Dialogue: 0,0:00:06.96,0:00:07.75,Q3,,0,0,0,,{\pos(473.6,504)}{\an7}«O Zot, kjo është e frikshme...»
Dialogue: 0,0:00:07.75,0:00:08.75,Q2,,0,0,0,,{\pos(460.8,453.6)}{\an7}Ashram
Dialogue: 0,0:00:07.75,0:00:08.75,Q2,,0,0,0,,{\pos(512,504)}{\an7}«Më beso! Ja ku po ia nis!»
Dialogue: 0,0:00:08.75,0:00:10.42,Q2,,0,0,0,,{\pos(448,453.6)}{\an7}????
Dialogue: 0,0:00:08.75,0:00:10.42,Q2,,0,0,0,,{\pos(473.6,504)}{\an7}«U mor vesh! Hja!»
Dialogue: 0,0:00:10.42,0:00:14.21,Q4,,0,0,0,,{\pos(460.8,403.2)}{\an7}Ceres
Dialogue: 0,0:00:10.42,0:00:14.21,Q4,,0,0,0,,{\pos(473.6,453.6)}{\an7}«Prit...
Dialogue: 0,0:00:10.42,0:00:14.21,Q4,,0,0,0,,{\pos(486.4,504)}{\an7}Po më fton në takim?»
