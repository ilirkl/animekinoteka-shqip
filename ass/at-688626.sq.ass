Dialogue: 0,0:00:25.50,0:00:28.16,Default,Inmei,0,0,0,,Ky është Perandori Suprem i vërtetë.
Dialogue: 0,0:00:28.16,0:00:30.06,Default,Inmei,0,0,0,,S'po pushoj dot së dridhuri.
Dialogue: 0,0:00:31.09,0:00:34.01,Default,Inmei,0,0,0,,Ajo parzmore është imja!
Dialogue: 0,0:00:34.56,0:00:35.77,Default,Gai,0,0,0,,Inmei...
Dialogue: 0,0:00:38.61,0:00:40.88,Default,Gai,0,0,0,,Nëse e do aq shumë, eja merre!
Dialogue: 0,0:00:41.48,0:00:42.71,Default,Gai,0,0,0,,Hë?
Dialogue: 0,0:00:42.71,0:00:44.38,Default,Yamato,0,0,0,,Hej! Çfarë po bën?!
Dialogue: 0,0:00:44.38,0:00:47.44,Default,Yamato,0,0,0,,Mos u përpiq të na bësh për të qeshur \Ntani që kemi arritur deri këtu!
Dialogue: 0,0:00:47.44,0:00:48.49,Default,Gai,0,0,0,,Nuk po bëj shaka!
Dialogue: 0,0:00:48.49,0:00:50.84,Default,Gai,0,0,0,,Parzmorja është aq e rëndë, sa s'lëviz dot!
Dialogue: 0,0:00:50.84,0:00:51.99,Default,Yamato,0,0,0,,Çfarë?
Dialogue: 0,0:00:52.24,0:00:55.91,Default,Inmei,0,0,0,,Me sa duket, kjo barrë \Nqenka tepër e rëndë për ty!
Dialogue: 0,0:01:08.09,0:01:10.67,Default,Inmei,0,0,0,,Art Qiellor: Bubullima e Rëndë!
Dialogue: 0,0:01:13.72,0:01:16.61,Default,Gai,0,0,0,,Dreqin! Pse nuk lëviz?!
Dialogue: 0,0:01:16.61,0:01:18.06,Default,Yamato,0,0,0,,Gai!
Dialogue: 0,0:01:18.41,0:01:21.12,Default,Yamato,0,0,0,,Zemërimi dhe urrejtja s'të bëjnë të fortë.
Dialogue: 0,0:01:21.12,0:01:24.90,Default,Yamato,0,0,0,,Dëshira për ta ndihmuar dikë, për ta shpëtuar...
Dialogue: 0,0:01:24.90,0:01:27.19,Default,Yamato,0,0,0,,Këto janë ndjenjat që kanë rëndësi!
Dialogue: 0,0:01:28.20,0:01:30.41,Default,Musashi,0,0,0,,Po përsërit fjalët e zotit Sanada!
Dialogue: 0,0:01:30.41,0:01:32.62,Default,Yamato,0,0,0,,Pusho! Mos ma prish çastin!
Dialogue: 0,0:01:34.45,0:01:37.48,Default,Inmei,0,0,0,,S'kam më nevojë për ju!
Dialogue: 0,0:01:42.13,0:01:43.15,Default,Kaito,0,0,0,,Gai!
Dialogue: 0,0:01:43.15,0:01:44.38,Default,Gai,0,0,0,,Më falni që ju mbajta në pritje.
Dialogue: 0,0:01:44.38,0:01:46.52,Default,Gai,0,0,0,,Tani e kam unë radhën!
Dialogue: 0,0:01:47.59,0:01:50.26,Default,Inmei,0,0,0,,Mos mendo se mund të më mundësh \Nme fuqi të pamerituar—
Dialogue: 0,0:01:57.16,0:01:59.17,Default,Gai,0,0,0,,Tani po më ndizet gjaku!
Dialogue: 0,0:03:32.27,0:03:37.95,Signs,Sign; title,0,0,0,,EPISODI XXIII\NI VËRTETË
Dialogue: 0,0:03:38.53,0:03:39.68,Main - Italics,Inmei {M},0,0,0,,Si ka mundësi?
Dialogue: 0,0:03:40.25,0:03:43.33,Main - Italics,Inmei {M},0,0,0,,Sapo mësoi të lëvizte me të,
Dialogue: 0,0:03:43.33,0:03:45.45,Main - Italics,Inmei {M},0,0,0,,dhe papritur fuqia e tij po rritet.
Dialogue: 0,0:03:46.61,0:03:49.29,Default,Ryusei,0,0,0,,Inmei ishte aq i fortë. Shiheni tani.
Dialogue: 0,0:03:49.29,0:03:50.61,Default,Musashi,0,0,0,,Uau.
Dialogue: 0,0:03:50.61,0:03:55.84,Default,Yamato,0,0,0,,E gjithë kjo sepse ia futa në kokë \Nç'do të thotë të jesh luftëtar samurai. {\i1}Bam! Bum!{\i0}
Dialogue: 0,0:03:58.65,0:03:59.72,Default,Ryusei,0,0,0,,Ka ndonjë problem?
Dialogue: 0,0:03:59.72,0:04:00.84,Default,Kaito,0,0,0,,Jo.
Dialogue: 0,0:04:01.28,0:04:04.05,Default,Kaito,0,0,0,,Thjesht m'u duk sikur Gai \Nishte shumë larg...
Dialogue: 0,0:04:05.99,0:04:07.44,Default,Inmei,0,0,0,,Çfarë poshtërimi.
Dialogue: 0,0:04:07.44,0:04:09.27,Default,Inmei,0,0,0,,Meqë puna arriti deri këtu...
Dialogue: 0,0:04:10.29,0:04:11.52,Default,Yamato,0,0,0,,Futi bishtin ndër shalë e ia mbathi!
Dialogue: 0,0:04:13.40,0:04:15.50,Default,Gai,0,0,0,,E ndiej praninë e tij.
Dialogue: 0,0:04:16.69,0:04:17.86,Default,Gai,0,0,0,,Andej!
Dialogue: 0,0:04:18.40,0:04:20.21,Default,Musashi,0,0,0,,U zhduk edhe Gai!
Dialogue: 0,0:04:20.21,0:04:22.05,Default,Yamato,0,0,0,,Ç'do të thotë «andej»?!
Dialogue: 0,0:04:22.05,0:04:23.13,Default,Kaito,0,0,0,,Prisni.
Dialogue: 0,0:04:24.46,0:04:26.04,Default,Kaito,0,0,0,,Unë e ndiej Gain.
Dialogue: 0,0:04:28.96,0:04:30.50,Default,Musashi,0,0,0,,K-Ke të drejtë.
Dialogue: 0,0:04:30.50,0:04:34.25,Default,Musashi,0,0,0,,Disi e di ku shkoi.
Dialogue: 0,0:04:34.53,0:04:36.63,Default,Ryusei,0,0,0,,Ndoshta, ngaqë u lidhëm me mendjen e Gait,
Dialogue: 0,0:04:37.07,0:04:40.45,Default,Ryusei,0,0,0,,tani mund të ndiejmë \Natë që ndien ai.
Dialogue: 0,0:04:41.49,0:04:42.96,Default,Kaito,0,0,0,,Të nxitojmë të bashkohemi me të!
Dialogue: 0,0:04:49.55,0:04:52.55,Default,Gai,0,0,0,,Ç'bos fundor frikacak qenka ky, \Nqë ia mbath nga lufta?
Dialogue: 0,0:04:53.07,0:04:55.07,Default,Inmei,0,0,0,,Mos më keqkupto.
Dialogue: 0,0:04:55.07,0:04:57.82,Default,Inmei,0,0,0,,Unë nuk jam kundërshtari yt i fundit.
Dialogue: 0,0:04:58.28,0:05:01.19,Default,Inmei,0,0,0,,Unë jam vetëm themeli.
Dialogue: 0,0:05:02.05,0:05:03.86,Default,Inmei,0,0,0,,Ju përgjërohem, zgjohuni,
Dialogue: 0,0:05:03.86,0:05:07.00,Default,Inmei,0,0,0,,zoti Yatogojin!
Dialogue: 0,0:05:09.73,0:05:11.10,Default,Yamato,0,0,0,,U këputa fare.
Dialogue: 0,0:05:12.11,0:05:14.54,Default,Kaito,0,0,0,,Kjo është Bota Hyjnore?
Dialogue: 0,0:05:14.54,0:05:16.42,Default,Musashi,0,0,0,,Hej, shikoni!
Dialogue: 0,0:05:32.00,0:05:34.20,Default,Yamato,0,0,0,,Çfarë {\i1}është{\i0} ai dragua?
Dialogue: 0,0:05:34.69,0:05:39.19,Default,Ryusei,0,0,0,,Yatogojin, që dikur ia kishin frikën \Nsi perëndisë së shkatërrimit.
Dialogue: 0,0:05:39.19,0:05:44.02,Default,Inmei,0,0,0,,Për fat të keq, nuk arrita ta merrja \NParzmoren e Perandorit Suprem.
Dialogue: 0,0:05:44.02,0:05:49.15,Default,Inmei,0,0,0,,Por ju lutem, përdoreni trupin tim \Npër të përmbushur ëndrrën tuaj të lashtë!
Dialogue: 0,0:05:51.41,0:05:52.33,Default,Gai,0,0,0,,Çfarë?!
Dialogue: 0,0:06:08.62,0:06:09.72,Default,Kaito,0,0,0,,Ç'është ajo?
Dialogue: 0,0:06:09.72,0:06:12.98,Default,Yamato,0,0,0,,Ai dreq Inmei evoluoi {\i1}përsëri{\i0}.
Dialogue: 0,0:06:13.37,0:06:14.50,Default,Ryusei,0,0,0,,Jo...
Dialogue: 0,0:06:14.87,0:06:18.05,Default,Ryusei,0,0,0,,Kjo është forma fillestare e Yatogojinit!
Dialogue: 0,0:06:23.24,0:06:25.81,Default,Yamato,0,0,0,,Etja e tij për gjak po më rrëqeth.
Dialogue: 0,0:06:25.81,0:06:27.36,Default,Yatogojin,0,0,0,,Nuk do ta toleroj.
Dialogue: 0,0:06:28.68,0:06:33.29,Default,Yatogojin,0,0,0,,Njerëz të rëndomtë guxojnë të shkelin \Nnë Botën Hyjnore?
Dialogue: 0,0:06:33.29,0:06:35.77,Default,Yatogojin,0,0,0,,Këtë nuk do ta toleroj kurrsesi.
Dialogue: 0,0:06:51.08,0:06:52.85,Default,Yamato,0,0,0,,Çfarë ndodhi?
Dialogue: 0,0:06:56.44,0:06:57.78,Default,Musashi,0,0,0,,Ai është Tokio.
Dialogue: 0,0:06:58.20,0:06:59.89,Default,Yamato,0,0,0,,E bëri ai këtë?
Dialogue: 0,0:07:00.32,0:07:04.03,Default,Gai,0,0,0,,Mos më bëj budallallëqe të tilla!
Dialogue: 0,0:07:09.03,0:07:10.81,Default,Yatogojin,0,0,0,,Nuk do ta toleroj.
Dialogue: 0,0:07:11.49,0:07:14.25,Default,Yatogojin,0,0,0,,Njerëz të rëndomtë guxojnë të më sfidojnë?
Dialogue: 0,0:07:14.52,0:07:17.15,Default,Yatogojin,0,0,0,,E gjithë qenia ime e kundërshton këtë.
Dialogue: 0,0:07:18.60,0:07:19.87,Default,Kaito,0,0,0,,Katër Luftëtarët e Bishave!
Dialogue: 0,0:07:19.87,0:07:21.59,Default,Ryusei,0,0,0,,Ç'po ndodh?
Dialogue: 0,0:07:21.59,0:07:24.84,Default,Yatogojin,0,0,0,,Mendoni pak, e vutë jetën në rrezik \Npa ditur asgjë...
Dialogue: 0,0:07:25.49,0:07:28.09,Default,Yatogojin,0,0,0,,Do t'jua hap sytë para se të vdisni.
Dialogue: 0,0:07:30.45,0:07:34.43,Default,Yatogojin,0,0,0,,Katër Luftëtarët e Bishave \Nnë fillim ishin thjesht pjesë të miat.
Dialogue: 0,0:07:34.77,0:07:41.19,Default,Yatogojin,0,0,0,,Janë kukulla që perënditë, nga frika ime, \Ni krijuan për të shpërndarë fuqinë time.
Dialogue: 0,0:07:41.83,0:07:47.86,Default,Yatogojin,0,0,0,,Më morën fuqinë dhe kujtesën, \Npastaj më shndërruan në dragua.
Dialogue: 0,0:07:49.74,0:07:53.74,Default,Kaito,0,0,0,,Si u ktheve në formën e parë \Npa kujtimet e tua?
Dialogue: 0,0:07:53.74,0:07:57.75,Default,Yatogojin,0,0,0,,Inmei zgjoi një pjesë të tyre
Dialogue: 0,0:07:58.03,0:08:00.04,Default,Yatogojin,0,0,0,,kur u la në dritën time.
Dialogue: 0,0:08:01.42,0:08:07.44,Default,Ryusei,0,0,0,,Prandaj i përthithi Luftëtarët e tjerë \Ntë Bishave dhe iu vu pas parzmores?
Dialogue: 0,0:08:07.89,0:08:10.22,Default,Ryusei,0,0,0,,Për të të ringjallur?
Dialogue: 0,0:08:10.55,0:08:13.31,Default,Yatogojin,0,0,0,,Kaq mjafton si dhuratë lamtumire.
Dialogue: 0,0:08:13.31,0:08:15.57,Default,Yatogojin,0,0,0,,Vdisni pa pengje.
Dialogue: 0,0:08:16.68,0:08:19.53,Default,Ryusei,0,0,0,,Ndërsa ne mbajmë të zënë \NKatër Luftëtarët e Bishave,
Dialogue: 0,0:08:19.53,0:08:21.15,Default,Ryusei,0,0,0,,ti mposht Yatogojinin!
Dialogue: 0,0:08:31.95,0:08:35.45,Default,Gai,0,0,0,,Prerja e Dyfishtë Verbëruese!
Dialogue: 0,0:08:39.87,0:08:41.40,Default,Yatogojin,0,0,0,,Shpatë e shkëlqyer.
Dialogue: 0,0:08:41.85,0:08:44.65,Default,Yatogojin,0,0,0,,Por dora që e mban qenka pa përvojë.
Dialogue: 0,0:09:01.58,0:09:05.03,Default,Kaede,0,0,0,,Me shumë mund ia dolëm \Nt'i evakuonim të gjithë banorët.
Dialogue: 0,0:09:06.50,0:09:08.74,Default,Nasti,0,0,0,,Shyqyr që janë të gjithë të sigurt.
Dialogue: 0,0:09:09.32,0:09:13.42,Default,Jun,0,0,0,,S'do t'ia kishim dalë \Npo të mos kishit dhënë gjithçka.
Dialogue: 0,0:09:13.42,0:09:15.23,Default,Ryo,0,0,0,,S'kemi ende kohë të çlodhemi.
Dialogue: 0,0:09:15.58,0:09:19.45,Default,Ryo,0,0,0,,Ta zgjerojmë zonën e evakuimit \Ne të shpëtojmë sa më shumë njerëz.
Dialogue: 0,0:09:20.92,0:09:23.52,Default,Jun,0,0,0,,White Blaze, a sheh diçka?
Dialogue: 0,0:09:29.08,0:09:30.25,Default,Shin,0,0,0,,Çfarë është ajo?
Dialogue: 0,0:09:31.69,0:09:34.12,Default,Jun,0,0,0,,Besoj se të çon në Botën Hyjnore.
Dialogue: 0,0:09:34.12,0:09:35.57,Default,Xiu,0,0,0,,Vërtet?!
Dialogue: 0,0:09:35.57,0:09:38.39,Default,Xiu,0,0,0,,Por ne sërish s'mund të shkojmë, apo jo?
Dialogue: 0,0:09:38.39,0:09:41.17,Default,Jun,0,0,0,,Po. Duhet të jesh i shuguruar.
Dialogue: 0,0:09:41.17,0:09:44.27,Default,Jun,0,0,0,,Por White Blaze mund të arrijë të kalojë.
Dialogue: 0,0:09:44.27,0:09:45.92,Default,Ryo,0,0,0,,Do të dërgosh White Blaze?
Dialogue: 0,0:09:45.92,0:09:52.03,Default,Jun,0,0,0,,Po. Përmes tij do të mund të shohim \Nç'po ndodh në Botën Hyjnore.
Dialogue: 0,0:09:52.31,0:09:56.66,Default,Seiji,0,0,0,,White Blaze na ka shpëtuar\Nmë shumë herë nga ç'mund të numëroj.
Dialogue: 0,0:09:56.66,0:09:59.62,Default,Seiji,0,0,0,,Jam i sigurt se do t'i ndihmojë edhe djemtë \Nkur të jenë në vështirësi.
Dialogue: 0,0:10:01.67,0:10:06.54,Default,Jun,0,0,0,,Janë ca kokëkrisur, \Npor po luftojnë fort për të gjithë ne.
Dialogue: 0,0:10:06.92,0:10:09.55,Default,Jun,0,0,0,,Të lutem, bëj ç'të mundesh për ta.
Dialogue: 0,0:10:17.49,0:10:18.84,Default,Jun,0,0,0,,Tani e ke ti në dorë.
Dialogue: 0,0:10:35.77,0:10:39.28,Default,Yatogojin,0,0,0,,Parzmorja e Perandorit Suprem \Nu krijua për mua.
Dialogue: 0,0:10:39.59,0:10:41.12,Default,Yatogojin,0,0,0,,Pse e mban ti?
Dialogue: 0,0:10:41.12,0:10:42.79,Default,Gai,0,0,0,,Ç'rëndësi ka?!
Dialogue: 0,0:10:43.27,0:10:46.64,Default,Yatogojin,0,0,0,,Parzmorja mbetet e paplotë \Npër fajin tënd.
Dialogue: 0,0:10:46.64,0:10:48.79,Default,Gai,0,0,0,,Tani është e plotë, apo jo?
Dialogue: 0,0:10:49.17,0:10:51.81,Default,Yatogojin,0,0,0,,Është larg shkëlqimit që duhet të ketë.
Dialogue: 0,0:10:52.33,0:10:55.97,Default,Yatogojin,0,0,0,,Kështu siç je tani, \Ns'e zotëron dot Perandorin Suprem.
Dialogue: 0,0:10:56.53,0:10:57.55,Default,Yatogojin,0,0,0,,Art Qiellor:
Dialogue: 0,0:10:57.55,0:10:59.39,Default,Yatogojin,0,0,0,,Asgjësimi.
Dialogue: 0,0:11:10.29,0:11:12.37,Default,Ryusei,0,0,0,,U zhduk Perandori Suprem?
Dialogue: 0,0:11:13.69,0:11:15.40,Default,Kaito,0,0,0,,A je mirë, Gai?
Dialogue: 0,0:11:17.19,0:11:19.87,Default,Yatogojin,0,0,0,,Ti quhesh Gai?
Dialogue: 0,0:11:21.25,0:11:22.91,Default,Gai,0,0,0,,Po edhe nëse quhem ashtu?
Dialogue: 0,0:11:25.59,0:11:28.98,Default,Yatogojin,0,0,0,,E kuptoj. Kjo shpjegon gjithçka.
Dialogue: 0,0:11:29.41,0:11:32.55,Default,Yatogojin,0,0,0,,Pra, ti qenke im bir.
Dialogue: 0,0:11:38.87,0:11:40.47,Default,Gai,0,0,0,,Ç'po thua?
Dialogue: 0,0:11:40.98,0:11:43.16,Default,Gai,0,0,0,,Babai im është Ramaga.
Dialogue: 0,0:11:43.16,0:11:46.57,Default,Yatogojin,0,0,0,,Ramaga? Mos më bëj të qesh.
Dialogue: 0,0:11:46.57,0:11:50.87,Default,Yatogojin,0,0,0,,Ti je djali i lindur \Nnga unë dhe Sagume.
Dialogue: 0,0:11:50.87,0:11:51.82,Default,Gai,0,0,0,,Çfarë?
Dialogue: 0,0:11:52.10,0:11:57.32,Default,Yatogojin,0,0,0,,Më shndërruan në dragua \Npak pasi Sagume të solli në jetë.
Dialogue: 0,0:11:58.07,0:12:03.91,Default,Yatogojin,0,0,0,,Sagume mund ta përdorte fuqinë time \Nvetëm falë betimit që na bashkonte.
Dialogue: 0,0:12:04.49,0:12:09.00,Default,Yatogojin,0,0,0,,Por ajo grua kërkoi të ma hidhte,
Dialogue: 0,0:12:09.71,0:12:13.50,Default,Yatogojin,0,0,0,,prandaj përfundoi ashtu siç përfundoi.
Dialogue: 0,0:12:14.39,0:12:18.26,Default,Yatogojin,0,0,0,,Ndonëse u shërbente perëndive, \Najo kishte lindur njeri.
Dialogue: 0,0:12:18.53,0:12:24.21,Default,Yatogojin,0,0,0,,Në fund, mbeti një krijesë \Ne ulët dhe mendjelehtë.
Dialogue: 0,0:12:26.08,0:12:28.68,Default,Gai,0,0,0,,Më lodhe me llafet e tua.
Dialogue: 0,0:12:28.68,0:12:30.29,Default,Gai,0,0,0,,Sikur do t'i besoja këto!
Dialogue: 0,0:12:30.29,0:12:32.79,Default,Yatogojin,0,0,0,,Ende nuk e kupton?
Dialogue: 0,0:12:32.79,0:12:36.52,Default,Yatogojin,0,0,0,,Fakti që mund të veshësh \Nparzmoren e krijuar për mua
Dialogue: 0,0:12:36.52,0:12:40.28,Default,Yatogojin,0,0,0,,është prova më e qartë \Nqë ke gjakun tim.
Dialogue: 0,0:12:40.28,0:12:44.53,Default,Ryusei,0,0,0,,Ka të drejtë. Nëse Gai dhe Ramaga \Nnuk kanë lidhje gjaku,
Dialogue: 0,0:12:44.53,0:12:48.43,Default,Ryusei,0,0,0,,atëherë kjo shpjegon pse Ramaga \Ns'e kontrollonte dot Perandorin Suprem.
Dialogue: 0,0:12:48.43,0:12:52.23,Default,Musashi,0,0,0,,Prit, pra Gai vërtet është djali i Yatogojinit?
Dialogue: 0,0:12:52.23,0:12:53.17,Default,Yamato,0,0,0,,Pra, ai qenka...
Dialogue: 0,0:12:53.74,0:12:56.05,Default,Yamato,0,0,0,,biri i një perëndie?
Dialogue: 0,0:12:56.38,0:12:57.75,Default,Kaito,0,0,0,,I një perëndie?
Dialogue: 0,0:12:58.72,0:13:01.47,Default,Gai,0,0,0,,S'ka rëndësi kush janë prindërit e mi.
Dialogue: 0,0:13:01.90,0:13:04.53,Default,Gai,0,0,0,,Do të të shkatërroj!
Dialogue: 0,0:13:07.80,0:13:11.06,Default,Yatogojin,0,0,0,,Kërkon të më mposhtësh\N me atë forcën tënde të mjerë?
Dialogue: 0,0:13:19.99,0:13:22.16,Default,Kaito,0,0,0,,Gai! Mjaft!
Dialogue: 0,0:13:24.76,0:13:25.79,Default,Kaito,0,0,0,,Gai!
Dialogue: 0,0:13:33.58,0:13:35.00,Default,Musashi,0,0,0,,White Blaze!
Dialogue: 0,0:13:36.03,0:13:37.80,Default,Yatogojin,0,0,0,,Një bishë e shenjtë, hë?
Dialogue: 0,0:13:39.34,0:13:43.13,Default,Kaede,0,0,0,,Për momentin, po i drejtojmë banorët \Ndrejt strehimoreve pa probleme.
Dialogue: 0,0:13:46.30,0:13:48.58,Default,Jun,0,0,0,,Duket se White Blaze \Narriti në Botën Hyjnore.
Dialogue: 0,0:13:53.87,0:13:55.06,Default,Kaede,0,0,0,,Ja ku janë!
Dialogue: 0,0:13:56.11,0:13:57.32,Default,Ryo,0,0,0,,Ç'është ai?
Dialogue: 0,0:13:58.04,0:13:59.86,Default,Jun,0,0,0,,Duke gjykuar nga aura që lëshon,
Dialogue: 0,0:13:59.86,0:14:01.96,Default,Jun,0,0,0,,mendoj se është Yatogojin.
Dialogue: 0,0:14:03.61,0:14:06.09,Default,Xiu,0,0,0,,Janë të gjithë në gjendje të rëndë.
Dialogue: 0,0:14:06.09,0:14:09.53,Default,Shin,0,0,0,,Kanë luftuar deri në rraskapitje.
Dialogue: 0,0:14:09.53,0:14:12.18,Default,Seiji,0,0,0,,Ah, sikur të mund të shkonim \Nnë Botën Hyjnore...
Dialogue: 0,0:14:13.24,0:14:16.67,Default,Ryo,0,0,0,,Edhe nëse s'mund të shkojmë, \Nndoshta prapë mund t'i ndihmojmë.
Dialogue: 0,0:14:17.49,0:14:18.73,Default,Seiji,0,0,0,,Si e ke fjalën?
Dialogue: 0,0:14:19.31,0:14:21.30,Default,Ryo,0,0,0,,Dua të provoj diçka.
Dialogue: 0,0:14:24.08,0:14:27.11,Default,Ryusei,0,0,0,,Kush e dinte se Yatogojin do të ishte kaq i fortë?
Dialogue: 0,0:14:27.11,0:14:30.24,Default,Yamato,0,0,0,,Vetëm me forcë krahu \Ns'dalim dot nga kjo situatë...
Dialogue: 0,0:14:30.24,0:14:32.88,Default,Musashi,0,0,0,,Kushdo e sheh se kjo lojë është e trukuar.
Dialogue: 0,0:14:33.45,0:14:34.35,Default,Yatogojin,0,0,0,,Ashtu siç mendoja.
Dialogue: 0,0:14:35.12,0:14:39.38,Default,Yatogojin,0,0,0,,As im bir nuk mundi t'ia kthente \Nshkëlqimin Perandorit Suprem.
Dialogue: 0,0:14:40.41,0:14:43.22,Default,Yatogojin,0,0,0,,Art Qiellor: Asgjësimi.
Dialogue: 0,0:15:04.56,0:15:06.18,Default,Yamato,0,0,0,,Gai ngriti një barrierë?
Dialogue: 0,0:15:06.68,0:15:09.07,Default,Musashi,0,0,0,,Por ai ende s'ka ndjenja!
Dialogue: 0,0:15:10.26,0:15:13.49,Default,Ryusei,0,0,0,,S'është Gai. Është magji demonësh.
Dialogue: 0,0:15:13.49,0:15:16.27,Default,Sasuke,0,0,0,,Ç'ju ka bërë të dukeni kaq të mjerë?
Dialogue: 0,0:15:16.27,0:15:20.29,Default,Seikai Nyudo,0,0,0,,S'gjejmë dot prehje nëse vazhdoni të trembeni!
Dialogue: 0,0:15:20.29,0:15:21.52,Default,Isa Nyudo,0,0,0,,Po! Po!
Dialogue: 0,0:15:21.52,0:15:22.94,Default,Yamato,0,0,0,,Ata zëra ngjajnë me...
Dialogue: 0,0:15:25.00,0:15:26.57,Default,Yamato,0,0,0,,Dhjetë Luftëtarët!
Dialogue: 0,0:15:28.07,0:15:30.82,Default,Ryusei,0,0,0,,Ju e ngritët atë barrierë?
Dialogue: 0,0:15:31.53,0:15:34.91,Default,Kakei,0,0,0,,Jo «ju». Barrierën e ngrita vetëm unë.
Dialogue: 0,0:15:34.91,0:15:37.92,Default,Musashi,0,0,0,,Si ka mundësi që i dëgjojmë Dhjetë Luftëtarët?
Dialogue: 0,0:15:37.92,0:15:43.13,Default,Saizo,0,0,0,,Besoj se ka lidhje me kohën që kaluam \Nsë bashku në botën mendore të princit.
Dialogue: 0,0:15:43.50,0:15:46.72,Default,Kaito,0,0,0,,Domethënë, jeni të gjithë brenda Gait?
Dialogue: 0,0:15:46.72,0:15:48.14,Default,Kamanosuke,0,0,0,,Pikërisht.
Dialogue: 0,0:15:48.14,0:15:54.18,Default,Kamanosuke,0,0,0,,Saizo bëri magjinë e tij dhe shpirtrat \Ntanë përfunduan të gjithë brenda princit.
Dialogue: 0,0:15:54.47,0:15:56.56,Default,Saizo,0,0,0,,Fundi i mirë, gjithçka mirë.
Dialogue: 0,0:15:56.56,0:16:00.02,Default,Saizo,0,0,0,,Falë kësaj u bashkuam sërish \Nme ata me mbiemra.
Dialogue: 0,0:16:00.31,0:16:02.61,Default,Anayama,0,0,0,,Boll na quajte kështu.
Dialogue: 0,0:16:02.61,0:16:06.71,Default,Mochizuki,0,0,0,,M-Mirë, mirë. Ka kaluar shumë kohë \Nqë nga hera e fundit që u mblodhëm të gjithë.
Dialogue: 0,0:16:07.07,0:16:12.08,Default,Nezu,0,0,0,,Ja pra. \NDo t'ju japim një dorë.
Dialogue: 0,0:16:12.08,0:16:15.71,Default,Unno,0,0,0,,Kur t'i bashkojmë forcat, \Ndo të jemi më të fortë se kurrë.
Dialogue: 0,0:16:15.71,0:16:17.33,Default,Unno,0,0,0,,Madje, të pandalshëm.
Dialogue: 0,0:16:17.33,0:16:18.98,Default,Seikai Nyudo,0,0,0,,Hej, Yamato!
Dialogue: 0,0:16:18.98,0:16:20.08,Default,Isa Nyudo,0,0,0,,Musashi!
Dialogue: 0,0:16:20.08,0:16:22.26,Default,Seikai Nyudo; Isa Nyudo,0,0,0,,Çfarë po prisni?!
Dialogue: 0,0:16:25.19,0:16:27.47,Default,Yamato,0,0,0,,Kollaj ta thuash ti.
Dialogue: 0,0:16:27.47,0:16:32.14,Default,Musashi,0,0,0,,Si mundet që njerëz si ne \Ntë përballen me një perëndi?
Dialogue: 0,0:16:32.14,0:16:34.56,Default,Ryusei,0,0,0,,Ah, sikur të ishim aq të fortë sa Gai...
Dialogue: 0,0:16:35.50,0:16:41.47,Default,Kaito,0,0,0,,Ai u plagos kaq rëndë, \Ne ne as e ndihmuam, as e mbështetëm dot.
Dialogue: 0,0:16:41.47,0:16:42.94,Default,Sasuke,0,0,0,,Ç'keni kështu?
Dialogue: 0,0:16:43.26,0:16:44.76,Default,Sasuke,0,0,0,,S'ju njoh për të tillë.
Dialogue: 0,0:16:45.70,0:16:48.82,Default,Sasuke,0,0,0,,Deri tani i keni përballuar \Ntë gjitha sfidat.
Dialogue: 0,0:16:49.61,0:16:51.86,Default,Sasuke,0,0,0,,Sado i fortë të ishte armiku...
Dialogue: 0,0:16:52.95,0:16:55.51,Default,Sasuke,0,0,0,,dhe çfarëdo pengesash \Nt'ju dilnin përpara,
Dialogue: 0,0:16:56.51,0:17:00.13,Default,Sasuke,0,0,0,,ju bashkonit forcat, shtrëngonit dhëmbët
Dialogue: 0,0:17:01.30,0:17:04.42,Default,Sasuke,0,0,0,,dhe luftonit \Nderi në fund, ju kujtohet?
Dialogue: 0,0:17:06.13,0:17:10.43,Default,Saizo,0,0,0,,Ne humbëm përballë forcës së lidhjes suaj.
Dialogue: 0,0:17:10.43,0:17:14.93,Default,Saizo,0,0,0,,Dhe na shpëtoi \Nforca e shpirtit tuaj.
Dialogue: 0,0:17:16.61,0:17:21.19,Default,Sasuke,0,0,0,,Princi ngrihet sa herë që i duhet, \Nsepse ju ka ju.
Dialogue: 0,0:17:21.65,0:17:26.43,Default,Sasuke,0,0,0,,Kush do të besojë tek ai, nëse jo ju?
Dialogue: 0,0:17:28.27,0:17:29.68,Default,Kaito,0,0,0,,Këtu na zure ngushtë.
Dialogue: 0,0:17:30.29,0:17:33.00,Default,Kaito,0,0,0,,S'ka rëndësi kush apo çfarë je.
Dialogue: 0,0:17:38.94,0:17:40.25,Default,Gai,0,0,0,,Ç'dreqin?!
Dialogue: 0,0:17:40.77,0:17:42.59,Default,Kaito,0,0,0,,Pushimi mbaroi.
Dialogue: 0,0:17:43.33,0:17:44.75,Default,Kaito; Yamato; Musashi; Ryusei,0,0,0,,Parzmore!
Dialogue: 0,0:17:46.54,0:17:48.96,Default,Ryusei,0,0,0,,Do të të mbështesim \Nme gjithçka që kemi.
Dialogue: 0,0:17:48.96,0:17:52.34,Default,Yamato,0,0,0,,Ti mos mendo për asgjë tjetër, \Nveçse si t'ia thyesh turinjtë Yatogojinit!
Dialogue: 0,0:17:52.34,0:17:55.10,Default,Musashi,0,0,0,,I ke në krah të gjithë Dhjetë Luftëtarët!
Dialogue: 0,0:17:55.10,0:17:57.35,Default,Kaito,0,0,0,,Gai, çfarëdo që të ndodhë,
Dialogue: 0,0:17:57.35,0:17:59.22,Default,Kaito,0,0,0,,jemi bashkë!
Dialogue: 0,0:18:01.68,0:18:03.71,Default,Gai,0,0,0,,Tani po më ndizet gjaku!
Dialogue: 0,0:18:05.60,0:18:07.36,Default,Yatogojin,0,0,0,,Nuk mund ta toleroj.
Dialogue: 0,0:18:07.90,0:18:10.28,Default,Yatogojin,0,0,0,,Fytyrat tuaja plot shpresë...
Dialogue: 0,0:18:11.00,0:18:13.35,Default,Yatogojin,0,0,0,,Shpirti im nuk mund t'i durojë.
Dialogue: 0,0:18:13.61,0:18:15.14,Default,Gai,0,0,0,,Hajde.
Dialogue: 0,0:18:15.54,0:18:18.79,Default,Gai,0,0,0,,Tani askush s'na mund dot!
Dialogue: 0,0:18:55.28,0:18:56.24,Default,Anayama,0,0,0,,Zjarr!
Dialogue: 0,0:19:22.18,0:19:25.19,Default,Yatogojin,0,0,0,,Si ka mundësi që qenie si ju \Ntë përdorin Arte Qiellore?
Dialogue: 0,0:19:25.19,0:19:27.82,Default,Gai,0,0,0,,Ky s'është Art Qiellor! Është magji!
Dialogue: 0,0:19:30.15,0:19:31.21,Default,Yatogojin,0,0,0,,Çfarë?
Dialogue: 0,0:19:44.19,0:19:45.57,Default,Yamato,0,0,0,,Janë shënjestra të lehta!
Dialogue: 0,0:19:47.00,0:19:47.96,Signs,Sign,0,0,0,,DREJTËSI
Dialogue: 0,0:19:47.13,0:19:50.50,Default,Yamato,0,0,0,,Art i Fshehtë: Shndërrimi i Tokës!
Dialogue: 0,0:19:53.42,0:19:56.22,Default,Musashi,0,0,0,,Art i Fshehtë: Topi i Akullit!
Dialogue: 0,0:19:53.67,0:19:54.55,Signs,Sign,0,0,0,,BESIM
Dialogue: 0,0:19:59.43,0:20:01.89,Default,Ryusei,0,0,0,,Art i Fshehtë: Sulmi i Rrufesë Shpërthyese!
Dialogue: 0,0:19:59.55,0:20:00.35,Signs,Sign,0,0,0,,MIRËSI
Dialogue: 0,0:20:04.68,0:20:07.85,Default,Kaito,0,0,0,,Art i Fshehtë: Goditja e Furtunës!
Dialogue: 0,0:20:04.93,0:20:05.98,Signs,Sign,0,0,0,,URTËSI
Dialogue: 0,0:20:14.15,0:20:15.86,Default,Yatogojin,0,0,0,,Nuk do ta toleroj.
Dialogue: 0,0:20:16.36,0:20:18.15,Default,Yatogojin,0,0,0,,Nuk mund ta toleroj.
Dialogue: 0,0:20:20.41,0:20:21.47,Default,Gai,0,0,0,,Ta sulmojmë!
Dialogue: 0,0:20:21.47,0:20:22.44,Default,Kaito; Musashi; Yamato; Ryusei,0,0,0,,Po!
Dialogue: 0,0:20:23.27,0:20:27.33,Default,Kaito,0,0,0,,Art Suprem: Zbrazëtia e Pesë Skandhave!
Dialogue: 0,0:20:23.27,0:20:27.33,Default,Yamato,0,0,0,,Art Suprem: Forcë dhe Gjallëri!
Dialogue: 0,0:20:23.27,0:20:27.33,Main - Top,Musashi,0,0,0,,Art Suprem: I Pashoq!
Dialogue: 0,0:20:23.27,0:20:27.33,Main - Top,Ryusei,0,0,0,,Art Suprem: Vetëtima e Rrezes së Dritës!
Dialogue: 0,0:20:29.52,0:20:32.29,Default,Saizo,0,0,0,,Art Suprem: Lule në Pasqyrë, Hënë mbi Ujë!
Dialogue: 0,0:20:33.94,0:20:36.76,Default,Kamanosuke,0,0,0,,Art Suprem: Qielli i Galaktikës!
Dialogue: 0,0:20:38.38,0:20:41.22,Default,Seikai Nyudo,0,0,0,,Art Suprem: Hija e Gjetheve të Gjelbra!
Dialogue: 0,0:20:42.68,0:20:46.93,Default,Isa Nyudo,0,0,0,,Art Suprem: Feniksi i Mëngjesit!
Dialogue: 0,0:20:47.31,0:20:50.80,Default,Sasuke,0,0,0,,Art Suprem: Dragoi i Reve, Tigri i Erës!
Dialogue: 0,0:20:53.97,0:20:57.43,Default,Gai,0,0,0,,Art Suprem: Mendje e Kthjellët!
Dialogue: 0,0:21:41.67,0:21:43.03,Default,Jun,0,0,0,,Ai është...
Dialogue: 0,0:21:43.03,0:21:45.35,Default,Jun,0,0,0,,Perandori Suprem i vërtetë.
Dialogue: 0,0:21:47.58,0:21:50.24,Default,Yatogojin,0,0,0,,Pasardhësi im vleka për diçka, me sa shoh.
Dialogue: 0,0:21:50.66,0:21:52.33,Default,Yatogojin,0,0,0,,Ngjyrë e shkëlqyer.
Dialogue: 0,0:21:52.96,0:21:56.25,Default,Yatogojin,0,0,0,,E denjë për parzmoren time.
Dialogue: 0,0:21:59.36,0:22:00.63,Default,Gai,0,0,0,,Pse?
Dialogue: 0,0:22:02.88,0:22:04.60,Default,Gai,0,0,0,,Dreqi e mori.
Dialogue: 0,0:22:06.19,0:22:09.82,Default,Gai,0,0,0,,Prerja e Dyfishtë Verbëruese!
Dialogue: 0,0:22:09.82,0:22:12.02,Default,Yatogojin,0,0,0,,Më pëlqen!
Dialogue: 0,0:22:12.63,0:22:17.00,Default,Gai,0,0,0,,Digju!
Dialogue: 0,0:22:25.84,0:22:29.26,Signs,Credits,0,0,0,,Përkthimi: William Varteresian
Dialogue: 0,0:22:29.55,0:22:33.51,Signs,Credits,0,0,0,,Sinkronizimi: Mariana Martinez\N Redaktimi: Riley Dalton
Dialogue: 0,0:22:34.18,0:22:37.98,Signs,Credits,0,0,0,,Kontrolli i cilësisë: SMR \NKontrolli i përkthimit: Michelle Tymon
Dialogue: 0,0:23:53.95,0:23:59.50,Signs,Sign,0,0,0,,EPISODI XXIV\NGAI
Dialogue: 0,0:23:55.41,0:23:58.92,Default,Gai; Kaito; Musashi; Yamato; Ryusei,0,0,0,,Parzmorja të përshkon zemrën!

