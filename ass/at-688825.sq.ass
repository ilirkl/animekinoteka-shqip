Dialogue: 0,0:00:02.50,0:00:05.98,Main - Italics,Mizuki(M),0,0,0,,Fustani nuk ma fsheh dot fashën!
Dialogue: 0,0:00:05.98,0:00:08.23,Main - Italics,Mizuki(M),0,0,0,,Ç-Ç-Çfarë të bëj tani?!
Dialogue: 0,0:00:09.39,0:00:12.37,Main - Italics,Mizuki(M),0,0,0,,S'ka shans ta heq.
Dialogue: 0,0:00:12.37,0:00:14.20,Main - Italics,Mizuki(M),0,0,0,,Por as ta mbaj veshur nuk mundem...
Dialogue: 0,0:00:14.20,0:00:15.61,Default,Yao,0,0,0,,Ashiya-kun.
Dialogue: 0,0:00:16.19,0:00:18.43,Default,Yao,0,0,0,,A është në rregull gjatësia?
Dialogue: 0,0:00:18.43,0:00:19.81,Default,Mizuki,0,0,0,,P-Po!
Dialogue: 0,0:00:19.81,0:00:21.28,Default,Mizuki,0,0,0,,Duket tamam siç duhet.
Dialogue: 0,0:00:21.28,0:00:22.67,Default,Yao,0,0,0,,Mirë.
Dialogue: 0,0:00:22.67,0:00:25.12,Default,Yao,0,0,0,,Pra fustani i Ashiya-kun-it është në rregull.
Dialogue: 0,0:00:25.48,0:00:28.88,Main - Italics,Mizuki(M),0,0,0,,Më duhet të heq dorë nga fasha...
Dialogue: 0,0:00:31.37,0:00:32.76,Default,Nanba,0,0,0,,Më në fund je—
Dialogue: 0,0:00:33.10,0:00:35.51,Default,Nanba,0,0,0,,Hej, po dukesh shumë lezetshëm!
Dialogue: 0,0:00:36.56,0:00:37.52,Main - Italics,Mizuki(M),0,0,0,,Obobo!
Dialogue: 0,0:00:37.52,0:00:39.76,Main - Italics,Mizuki(M),0,0,0,,Të lutem, bëj të shpëtoj nga kjo!
Dialogue: 0,0:00:40.85,0:00:43.29,Default,Nakao,0,0,0,,Vërtet po dukesh si vajzë.
Dialogue: 0,0:00:43.29,0:00:44.27,Default,Nakao,0,0,0,,Mendoj se bën punë.
Dialogue: 0,0:00:45.60,0:00:48.85,Default,Nakao,0,0,0,,Megjithatë, këto reçipetat me mbushje \Njanë vërtet të bukura, ë?
Dialogue: 0,0:00:48.85,0:00:49.77,Default,Mizuki,0,0,0,,Po, ashtu janë.
Dialogue: 0,0:00:51.45,0:00:53.15,Default,Sano,0,0,0,,Hej. Këpucët e tua.
Dialogue: 0,0:00:53.15,0:00:55.20,Default,Mizuki,0,0,0,,Faleminderit, Sano.
Dialogue: 0,0:00:55.20,0:00:56.32,Default,Mizuki,0,0,0,,Ti po merresh me këpucët?
Dialogue: 0,0:00:56.32,0:00:58.16,Default,Sano,0,0,0,,Më thanë të ndihmoja po të kisha kohë.
Dialogue: 0,0:00:59.06,0:01:01.91,Default,Sano,0,0,0,,Gjithsesi, ai fustan...
Dialogue: 0,0:01:03.99,0:01:05.29,Default,Sano,0,0,0,,Të shkon shumë.
Dialogue: 0,0:01:08.01,0:01:09.92,Main - Italics,Mizuki(M),0,0,0,,Më bëri kompliment.
Dialogue: 0,0:01:10.67,0:01:12.49,Main - Italics,Mizuki(M),0,0,0,,Po më digjen veshët.
Dialogue: 0,0:01:12.49,0:01:14.23,Main - Italics,Mizuki(M),0,0,0,,Jam aq naive.
Dialogue: 0,0:01:14.23,0:01:15.36,Default,Kanna,0,0,0,,Mizuki-kun.
Dialogue: 0,0:01:16.18,0:01:18.93,Default,Kanna,0,0,0,,Këto janë çorapet e tua\N për kërcimin e vërtetë.
Dialogue: 0,0:01:18.93,0:01:19.96,Default,Kanna,0,0,0,,Urdhëro.
Dialogue: 0,0:01:20.76,0:01:23.22,Default,Mizuki,0,0,0,,Ka ndodhur ndonjë gjë e mirë, Kanna-chan?
Dialogue: 0,0:01:23.22,0:01:23.90,Default,Kanna,0,0,0,,Çfarë?
Dialogue: 0,0:01:24.87,0:01:26.19,Default,Kanna,0,0,0,,Dallohet vallë?
Dialogue: 0,0:01:26.67,0:01:28.80,Default,Mizuki,0,0,0,,Po pra, çfarë ka ndodhur?
Dialogue: 0,0:01:29.28,0:01:31.44,Default,Kanna,0,0,0,,Epo, e shikon...
Dialogue: 0,0:01:32.24,0:01:36.45,Default,Kanna,0,0,0,,Dje, Megumi-sama më kërkoi \Ntë jem partnerja e tij në kërcim.
Dialogue: 0,0:01:36.45,0:01:38.45,Default,Mizuki,0,0,0,,Të lumtë, Kanna-chan!
Dialogue: 0,0:01:38.45,0:01:40.30,Main - Italics,Mizuki(M),0,0,0,,Të lumtë, o djali gorilla!
Dialogue: 0,0:01:41.91,0:01:44.83,Default,Nanba,0,0,0,,Epo, si ta them këtë?
Dialogue: 0,0:01:45.38,0:01:48.58,Default,Nanba,0,0,0,,Mendoj se ke shanse reale\N për t'u kurorëzuar mbretëreshë.
Dialogue: 0,0:01:49.58,0:01:51.59,Default,Himejima,0,0,0,,Schöne Fräulein!
Dialogue: 0,0:01:51.59,0:01:53.24,Default,Himejima,0,0,0,,A dëshironi të kër—
Dialogue: 0,0:01:52.58,0:01:53.90,Main - Top,Nakao,0,0,0,,Qërohu.
Dialogue: 0,0:01:54.78,0:01:55.84,Default,Himejima,0,0,0,,Warum?!
Dialogue: 0,0:01:58.35,0:02:01.19,Default,Himejima,0,0,0,,E bukura zonjushë me flokë të korbta,
Dialogue: 0,0:02:01.19,0:02:02.20,Default,Himejima,0,0,0,,a dëshironi të...
Dialogue: 0,0:02:02.20,0:02:03.97,Default,Tennouji,0,0,0,,Hiqi duart prej saj!
Dialogue: 0,0:02:03.97,0:02:06.85,Default,Tennouji,0,0,0,,Kanna është e fejuara ime!
Dialogue: 0,0:02:09.71,0:02:10.86,Default,Himejima,0,0,0,,Ç'po ndodh kështu?!
Dialogue: 0,0:03:41.99,0:03:44.49,Default,sign,0,0,0,,{\fnImpact\fay-.02\an3\shad0\bord0\c&H6461A2&\3c&H2E2D30&\4c&H2E2D30&\fs18\pos(319.887,292.081)}Jam aq e lumtur!
Dialogue: 1,0:03:43.64,0:03:48.54,Default,Mizuki,0,0,0,,Dhe kështu, ai shkon e i nxjerr të gjitha\N në shesh para syve të të gjithëve.
Dialogue: 0,0:03:48.54,0:03:51.51,Default,Mizuki,0,0,0,,Tennoji u vu shumë në siklet pas asaj.
Dialogue: 0,0:03:53.27,0:03:57.12,Default,Sano,0,0,0,,Më vjen çudi që asaj i pëlqen\N një kokëtrashë si ai.
Dialogue: 0,0:03:57.12,0:03:58.00,Default,Mizuki,0,0,0,,Apo jo?
Dialogue: 0,0:03:59.69,0:04:02.34,Default,Mizuki,0,0,0,,Pra, nesër qenka dita e madhe, ë?
Dialogue: 0,0:04:03.04,0:04:04.12,Default,Sano,0,0,0,,Ashtu është.
Dialogue: 0,0:04:05.41,0:04:09.65,Default,Mizuki,0,0,0,,H-Hej, po mendoja sikur \Ntë të kërkoja një nder.
Dialogue: 0,0:04:11.56,0:04:14.76,Default,Mizuki,0,0,0,,Kisha shpresuar të kërceje me mua...
Dialogue: 0,0:04:15.85,0:04:16.64,Default,Mizuki,0,0,0,,Pikërisht tani.
Dialogue: 0,0:04:18.08,0:04:19.34,Main - Italics,Mizuki(M),0,0,0,,Vërtet e pyeta!
Dialogue: 0,0:04:20.25,0:04:21.40,Default,Sano,0,0,0,,Patjetër.
Dialogue: 0,0:04:31.62,0:04:33.21,Default,Sano,0,0,0,,Dhe një, dhe dy...
Dialogue: 0,0:04:45.22,0:04:46.39,Default,Mizuki,0,0,0,,F-Faleminderit!
Dialogue: 0,0:04:46.39,0:04:47.47,Default,Mizuki,0,0,0,,Të jam mirënjohëse!
Dialogue: 0,0:04:47.47,0:04:49.14,Default,Mizuki,0,0,0,,Po shkoj të fle!
Dialogue: 0,0:04:49.60,0:04:50.79,Default,Mizuki,0,0,0,,Natën e mirë!
Dialogue: 0,0:04:54.88,0:04:56.47,Main - Italics,Mizuki(M),0,0,0,,Nuk e prisja këtë.
Dialogue: 0,0:04:57.84,0:05:00.61,Default,Hibari,0,0,0,,Zonja dhe zotërinj.
Dialogue: 0,0:05:00.96,0:05:05.11,Default,Hibari,0,0,0,,Mirë se vini në mbledhjen tradicionale \Ntë dy shkollave tona.
Dialogue: 0,0:05:05.49,0:05:08.74,Default,Hibari,0,0,0,,Shpresojmë të kënaqeni \Nsa më shumë të jetë e mundur.
Dialogue: 0,0:05:08.74,0:05:11.35,Default,Nakao,0,0,0,,Pse qenka ajo e vetmja \Nqë merr një fustan të veçantë?
Dialogue: 0,0:05:11.35,0:05:12.53,Default,Nakao,0,0,0,,Sa e dyshimtë.
Dialogue: 0,0:05:21.93,0:05:22.63,Default,Sano,0,0,0,,Hej.
Dialogue: 0,0:05:23.88,0:05:26.51,Main - Italics,Mizuki(M),0,0,0,,Sano duket aq i mahnitshëm!
Dialogue: 0,0:05:26.51,0:05:28.76,Default,Nakatsu,0,0,0,,Mizuki qenka shumë, shumë i lezetshëm!
Dialogue: 0,0:05:26.51,0:05:28.76,Default,sign,0,0,0,,{\fad(114,1)\an8\fnImpact\shad0\fs36\c&HA987F4&\3c&HECEBF4&}PËRPLASJE
Dialogue: 0,0:05:30.14,0:05:31.33,Default,Nakatsu,0,0,0,,Por seriozisht...
Dialogue: 0,0:05:31.33,0:05:32.95,Default,Nakatsu,0,0,0,,Të shkon me të vërtetë shumë.
Dialogue: 0,0:05:32.95,0:05:34.78,Default,Nakatsu,0,0,0,,Edhe gjoksi duket kaq i vërtetë.
Dialogue: 0,0:05:35.49,0:05:37.27,Main - Italics,Mizuki(M),0,0,0,,Sepse i vërtetë është.
Dialogue: 0,0:05:38.49,0:05:40.54,Default,Mizuki,0,0,0,,Edhe ti dukesh goxha bukur.
Dialogue: 0,0:05:51.47,0:05:53.41,Main - Italics,Mizuki(M),0,0,0,,Uau!
Dialogue: 0,0:05:53.80,0:05:55.66,Main - Italics,Mizuki(M),0,0,0,,Duket si një ballo e vërtetë!
Dialogue: 0,0:05:55.66,0:05:59.57,Default,Kadoma,0,0,0,,Senpai, mendoj se jemi në vendin e gabuar.
Dialogue: 0,0:05:59.57,0:06:01.23,Default,Mizuki,0,0,0,,Ashtu mendoj edhe unë.
Dialogue: 0,0:06:01.23,0:06:02.67,Default,Guy,0,0,0,,Të lutem, kërce me mua.
Dialogue: 0,0:06:02.67,0:06:04.07,Default,GuyB,0,0,0,,Me mua!
Dialogue: 0,0:06:04.07,0:06:06.72,Default,Nakao,0,0,0,,Oh, çfarë të bëj?
Dialogue: 0,0:06:06.72,0:06:10.43,Default,Mizuki,0,0,0,,Duket sikur {\i1}dikush{\i0} ndihet \Nplotësisht si në shtëpi këtu.
Dialogue: 0,0:06:11.04,0:06:12.33,Default,Mizuki,0,0,0,,Ja ku është Nanba-senpai!
Dialogue: 0,0:06:12.33,0:06:14.56,Default,Kadoma,0,0,0,,Ai është i famshëm si gjithmonë.
Dialogue: 0,0:06:14.90,0:06:18.58,Default,Mizuki,0,0,0,,Vë dhjetë mijë pikë bast\N që kjo nuk do të zgjasë shumë.
Dialogue: 0,0:06:18.58,0:06:19.94,Default,Kadoma,0,0,0,,Çfarë do të thoni?
Dialogue: 0,0:06:20.65,0:06:21.94,Default,Mizuki,0,0,0,,Ja ku po vjen!
Dialogue: 0,0:06:22.30,0:06:23.94,Default,Nakao,0,0,0,,Senpai!
Dialogue: 0,0:06:25.68,0:06:27.19,Default,Mizuki,0,0,0,,Të thashë.
Dialogue: 0,0:06:28.13,0:06:30.70,Main - Italics,Mizuki(M),0,0,0,,Pyes veten ku ka shkuar Sano.
Dialogue: 0,0:06:30.70,0:06:33.08,Default,Himejima,0,0,0,,Përshëndetje, qengja të vegjël.
Dialogue: 0,0:06:36.77,0:06:38.21,Default,Himejima,0,0,0,,Schöner Abend.
Dialogue: 0,0:06:40.86,0:06:44.56,Default,Himejima,0,0,0,,Vazhdoni t'i mbani ato fytyra të pafajshme,
Dialogue: 0,0:06:44.56,0:06:47.21,Default,Himejima,0,0,0,,dhe Ujku i Madh i Keq\N do t'ju hajë menjëherë.
Dialogue: 0,0:06:49.14,0:06:51.95,Default,Kujo,0,0,0,,Kur e thua ti,\N nuk tingëllon aspak si shaka.
Dialogue: 0,0:06:51.95,0:06:53.47,Default,Himejima,0,0,0,,Më frikësove!
Dialogue: 0,0:06:53.47,0:06:55.18,Default,Both,0,0,0,,Kujo-senpai!
Dialogue: 0,0:06:55.18,0:06:59.23,Default,Kujo,0,0,0,,Kadoma është partneri im, ndaj të lutem \Nmos i kalo kufijtë.
Dialogue: 0,0:07:00.13,0:07:02.86,Default,Kujo,0,0,0,,Duke qenë se jemi këtu, a do të provojmë \Nnjë kërcim para ngjarjes kryesore?
Dialogue: 0,0:07:04.48,0:07:06.19,Default,Kadoma,0,0,0,,O-Osu!
Dialogue: 0,0:07:07.01,0:07:10.09,Main - Italics,Mizuki(M),0,0,0,,Nuk mund të bësh lëvizje karateje\N e veshur në atë mënyrë.
Dialogue: 0,0:07:10.99,0:07:14.21,Default,Blossoms,0,0,0,,O zot, qenka Oscar-sama!
Dialogue: 0,0:07:14.21,0:07:16.01,Default,Himejima,0,0,0,,Schöne Fräulein.
Dialogue: 0,0:07:17.09,0:07:19.00,Default,Rio,0,0,0,,Hej, ja ku qenke!
Dialogue: 0,0:07:19.00,0:07:21.56,Default,Rio,0,0,0,,Mizuki-kun, po të kërkoja gjithandej.
Dialogue: 0,0:07:21.56,0:07:22.88,Default,Mizuki,0,0,0,,Rio-chan.
Dialogue: 0,0:07:22.88,0:07:24.07,Default,Rio,0,0,0,,Ku ke qenë?
Dialogue: 0,0:07:24.07,0:07:25.88,Default,Rio,0,0,0,,Nuk ishe në dhomën e zhveshjes.
Dialogue: 0,0:07:25.88,0:07:27.76,Default,Mizuki,0,0,0,,Më fal! Isha në tualet...
Dialogue: 0,0:07:27.76,0:07:29.63,Main - Italics,Mizuki(M),0,0,0,,Është i vetmi vend ku mund të ndërrohem.
Dialogue: 0,0:07:29.63,0:07:31.72,Default,Rio,0,0,0,,Këtë ma dha Kanna-chan.
Dialogue: 0,0:07:31.72,0:07:32.88,Default,Mizuki,0,0,0,,Çfarë?
Dialogue: 0,0:07:32.88,0:07:35.56,Default,Rio,0,0,0,,Të gjithë i kanë vënë të tyret,
Dialogue: 0,0:07:35.56,0:07:37.55,Default,Rio,0,0,0,,por ti nuk ishe vërdallë, kështu që...
Dialogue: 0,0:07:37.55,0:07:38.14,Default,Rio,0,0,0,,Urdhëro.
Dialogue: 0,0:07:38.40,0:07:39.58,Default,Rio,0,0,0,,Mbaruam!
Dialogue: 0,0:07:41.14,0:07:43.77,Default,Rio,0,0,0,,Po të shkon kaq shumë, Mizuki-kun!
Dialogue: 0,0:07:43.77,0:07:46.04,Default,Rio,0,0,0,,Vërtet po dukesh si një vajzë e vërtetë!
Dialogue: 0,0:07:46.04,0:07:47.15,Default,Mizuki,0,0,0,,Vërtet?
Dialogue: 0,0:07:50.17,0:07:51.28,Default,Rio,0,0,0,,Më vjen keq.
Dialogue: 0,0:07:51.28,0:07:52.80,Default,Mizuki,0,0,0,,Hë? Pse?
Dialogue: 0,0:07:52.80,0:07:55.48,Default,Rio,0,0,0,,Që rashë në çift me Sano-n.
Dialogue: 0,0:07:58.32,0:07:59.96,Default,Rio,0,0,0,,Më fal, por e kam vënë re.
Dialogue: 0,0:07:59.96,0:08:02.66,Default,Rio,0,0,0,,Vëllai im i madh është ashtu siç është, e di vetë.
Dialogue: 0,0:08:03.06,0:08:06.39,Default,Rio,0,0,0,,Është e vështirë kur njeriu që të pëlqen \Nështë aq i paarritshëm, ë?
Dialogue: 0,0:08:06.39,0:08:08.00,Default,Rio,0,0,0,,Të mban gjithmonë si mbi gjemba.
Dialogue: 0,0:08:08.00,0:08:08.85,Default,Mizuki,0,0,0,,Hë?
Dialogue: 0,0:08:08.85,0:08:11.17,Default,Rio,0,0,0,,E pashë Sano-kun-in më parë.
Dialogue: 0,0:08:11.17,0:08:13.67,Default,Rio,0,0,0,,Vajzat po i mblidheshin rreth e rrotull,
Dialogue: 0,0:08:13.67,0:08:15.11,Default,Rio,0,0,0,,kështu që atij iu desh të largohej me vrap.
Dialogue: 0,0:08:15.11,0:08:16.93,Main - Italics,Mizuki(M),0,0,0,,Pse nuk habitem fare?
Dialogue: 0,0:08:16.93,0:08:19.43,Default,Rio,0,0,0,,Më vjen keq për ty, Mizuki-kun.
Dialogue: 0,0:08:20.05,0:08:24.06,Default,Rio,0,0,0,,Por unë i kuptoj këto\N lloj gjërash, ndaj mos u shqetëso.
Dialogue: 0,0:08:24.06,0:08:24.94,Default,Mizuki,0,0,0,,Ehm...
Dialogue: 0,0:08:24.94,0:08:26.01,Default,Rio,0,0,0,,Paç fat!
Dialogue: 0,0:08:26.01,0:08:27.28,Default,Rio,0,0,0,,Bëj tifo për ty!
Dialogue: 0,0:08:27.28,0:08:28.86,Default,Rio,0,0,0,,Shihemi më vonë!
Dialogue: 0,0:08:28.86,0:08:31.19,Main - Italics,Mizuki(M),0,0,0,,Rio-chan, ti je...
Dialogue: 0,0:08:34.62,0:08:37.42,Main - Italics,Mizuki(M),0,0,0,,Pra vajzat po i mblidhen rrotull, ë?
Dialogue: 0,0:08:37.95,0:08:39.40,Default,Nakatsu,0,0,0,,Hej, Mizuki.
Dialogue: 0,0:08:39.40,0:08:41.20,Default,Nakatsu,0,0,0,,Këtu qenke.
Dialogue: 0,0:08:41.92,0:08:43.84,Default,Nakatsu,0,0,0,,Ç'kemi? Po dukesh i mërzitur.
Dialogue: 0,0:08:43.84,0:08:44.96,Default,Mizuki,0,0,0,,Nakatsu?
Dialogue: 0,0:08:46.55,0:08:48.71,Default,Nakatsu,0,0,0,,A do të kërcesh me mua, princeshë?
Dialogue: 0,0:08:51.73,0:08:52.46,Default,Mizuki,0,0,0,,Në rregull!
Dialogue: 0,0:08:59.67,0:09:01.47,Main - Italics,Nakatsu(M),0,0,0,,P-Prapëseprapë...
Dialogue: 0,0:09:02.00,0:09:04.48,Main - Italics,Nakatsu(M),0,0,0,,E di që s'duhet, por nuk i ndaj dot sytë!
Dialogue: 0,0:09:04.81,0:09:07.76,Main - Italics,Nakatsu(M),0,0,0,,S'është faji im kur duken kaq të vërtetë!
Dialogue: 0,0:09:09.18,0:09:10.23,Default,Mizuki,0,0,0,,Nakatsu.
Dialogue: 0,0:09:10.53,0:09:11.31,Default,Nakatsu,0,0,0,,Po?!
Dialogue: 0,0:09:11.31,0:09:12.29,Default,Mizuki,0,0,0,,Shiko atje.
Dialogue: 0,0:09:12.29,0:09:13.86,Default,Mizuki,0,0,0,,Duket se po kërcen Hibari-sama.
Dialogue: 0,0:09:14.24,0:09:18.41,Default,Nakatsu,0,0,0,,Oh, ajo vajza me ato gjokset \Ne mëdha do të kërcejë gjithashtu?
Dialogue: 0,0:09:18.41,0:09:19.12,Main - Italics,Nakatsu(M),0,0,0,,Oh jo!
Dialogue: 0,0:09:19.57,0:09:23.01,Main - Italics,Nakatsu(M),0,0,0,,Tani që i vura re,\N nuk i heq dot më nga mendja!
Dialogue: 0,0:09:23.01,0:09:25.37,Main - Italics,Nakatsu(M),0,0,0,,Harro-gjoks...
Dialogue: 0,0:09:25.37,0:09:27.75,Main - Italics,Nakatsu(M),0,0,0,,Gjokse!
Dialogue: 0,0:09:28.48,0:09:29.38,Default,Mizuki,0,0,0,,Nakatsu?!
Dialogue: 0,0:09:30.30,0:09:32.02,Default,Kadoma,0,0,0,,Senpai, çfarë ke?
Dialogue: 0,0:09:32.02,0:09:36.49,Default,Mizuki,0,0,0,,Duke parë sa seksi është Hibari-sama, \Nme sa duket i ra të fikët.
Dialogue: 0,0:09:36.49,0:09:37.88,Main - Italics,Nakatsu(M),0,0,0,,S-S'është ajo!
Dialogue: 0,0:09:41.39,0:09:43.42,Default,Mizuki,0,0,0,,A do të jetë mirë?
Dialogue: 0,0:09:48.61,0:09:49.65,Default,Rio,0,0,0,,Mizuki-kun!
Dialogue: 0,0:09:49.98,0:09:50.95,Default,Rio,0,0,0,,Oh jo!
Dialogue: 0,0:09:50.95,0:09:53.40,Default,Rio,0,0,0,,Sa e tmerrshme! \NKush do të bënte një gjë të tillë?!
Dialogue: 0,0:09:53.40,0:09:54.30,Default,GuyC,0,0,0,,Kjo është shumë e ulët.
Dialogue: 0,0:09:54.30,0:09:55.90,Default,GirlA,0,0,0,,Oh jo. E gjora...
Dialogue: 0,0:09:55.90,0:09:57.85,Main - Italics,Mizuki(M),0,0,0,,Me sa duket ma hodhën.
Dialogue: 0,0:09:57.85,0:09:59.03,Default,Sano,0,0,0,,Ashiya.
Dialogue: 0,0:09:59.44,0:10:00.34,Default,Mizuki,0,0,0,,Sano...
Dialogue: 0,0:10:00.34,0:10:02.32,Default,Nanba,0,0,0,,Kjo është e tmerrshme.
Dialogue: 0,0:10:02.32,0:10:03.55,Default,Sano,0,0,0,,Çfarë ndodhi?
Dialogue: 0,0:10:03.55,0:10:04.42,Default,Rio,0,0,0,,Është e tmerrshme.
Dialogue: 0,0:10:04.42,0:10:06.29,Default,Rio,0,0,0,,Dikush ia shkatërroi fustanin Mizuki-kun-it.
Dialogue: 0,0:10:06.29,0:10:07.87,Default,Mizuki,0,0,0,,Nuk ka problem, nuk ka problem!
Dialogue: 0,0:10:07.87,0:10:10.45,Default,Mizuki,0,0,0,,Rio-chan, mendoj se mund ta laj e të pastrohet.
Dialogue: 0,0:10:10.45,0:10:12.07,Default,Mizuki,0,0,0,,Po shkoj ta provoj njëherë.
Dialogue: 0,0:10:12.07,0:10:12.79,Default,Sano,0,0,0,,Hej.
Dialogue: 0,0:10:13.11,0:10:16.55,Main - Italics,Mizuki(M),0,0,0,,Nuk dua që Sano të më shohë në këtë gjendje.
Dialogue: 0,0:10:23.14,0:10:24.31,Main - Italics,Mizuki(M),0,0,0,,Nuk po hiqet fare...
Dialogue: 0,0:10:26.29,0:10:27.43,Main - Italics,Mizuki(M),0,0,0,,Gjithsesi, nuk do të qaj.
Dialogue: 0,0:10:27.43,0:10:28.54,Main - Italics,Mizuki(M),0,0,0,,Jo për këtë gjë.
Dialogue: 0,0:10:28.54,0:10:29.94,Default,Rio,0,0,0,,Si po duket?
Dialogue: 0,0:10:29.94,0:10:32.02,Default,Mizuki,0,0,0,,Më duket se nuk pata fat.
Dialogue: 0,0:10:32.02,0:10:33.19,Default,Mizuki,0,0,0,,Kjo qe e thënë.
Dialogue: 0,0:10:33.19,0:10:34.54,Default,Erika,0,0,0,,O zot.
Dialogue: 0,0:10:34.54,0:10:36.03,Default,Yumi,0,0,0,,Uau, ke të drejtë.
Dialogue: 0,0:10:36.03,0:10:37.69,Default,Erika,0,0,0,,Qenka bërë me njolla vërtet të këqija.
Dialogue: 0,0:10:40.21,0:10:43.08,Default,Yumi,0,0,0,,Mizuki-kun, a do të na lësh\N të merremi ne me këtë?
Dialogue: 0,0:10:43.08,0:10:43.79,Default,Mizuki,0,0,0,,Hë?
Dialogue: 0,0:10:45.16,0:10:45.99,Default,Mizuki,0,0,0,,P-Po, patjetër...
Dialogue: 0,0:10:48.39,0:10:50.54,Default,Announcement,0,0,0,,Dhe tani, kulmi i mbrëmjes:
Dialogue: 0,0:10:50.91,0:10:55.55,Default,Announcement,0,0,0,,kërcimi ku do të zgjidhen mbreti, mbretëresha \Ndhe çifti më i mirë.
Dialogue: 0,0:10:57.35,0:10:59.30,Main - Italics,Nihonbashi,0,0,0,,Po, kur vjen puna te veshja si femër,
Dialogue: 0,0:10:59.30,0:11:01.07,Main - Italics,Nihonbashi,0,0,0,,të bësh foto është shumë më mirë sesa ta bësh vetë!
Dialogue: 0,0:11:02.60,0:11:04.34,Default,Sekime,0,0,0,,E di që nuk gjeta dot partner,
Dialogue: 0,0:11:04.34,0:11:06.64,Default,Sekime,0,0,0,,por pse duhet të kërcej me Nakao-n?
Dialogue: 0,0:11:06.95,0:11:10.64,Default,Nakao,0,0,0,,Nuk kërcej me asnjë djalë\N përveç Senpai-t!
Dialogue: 0,0:11:10.64,0:11:13.19,Default,Sekime,0,0,0,,Hej, djalë jam edhe unë.
Dialogue: 0,0:11:16.19,0:11:20.85,Main - Italics,Mizuki(M),0,0,0,,Ma rregulluan fustanin, \Npor edhe Nakatsu është larguar.
Dialogue: 0,0:11:20.85,0:11:23.67,Default,Announcement,0,0,0,,Zonja dhe zotërinj, \Nmë në fund kërcimi i fundit!
Dialogue: 0,0:11:25.32,0:11:28.00,Main - Italics,Mizuki(M),0,0,0,,Jam ende këtu në ballon e Krishtlindjes.
Dialogue: 0,0:11:28.00,0:11:30.21,Main - Italics,Mizuki(M),0,0,0,,Më mirë ta shfrytëzoj sa më mirë\N dhe të kënaqem.
Dialogue: 0,0:11:36.87,0:11:37.95,Main - Italics,Sano(M),0,0,0,,Ashiya...
Dialogue: 0,0:11:38.96,0:11:41.75,Default,Rio,0,0,0,,Nëse je kaq i shqetësuar\N për të, shko pranë tij.
Dialogue: 0,0:11:42.40,0:11:44.31,Default,Rio,0,0,0,,Unë do të jem mirë.
Dialogue: 0,0:11:44.31,0:11:46.97,Default,Rio,0,0,0,,Përveç kësaj, po s'shkove ti, \Nmund ta marrë dikush tjetër.
Dialogue: 0,0:11:46.97,0:11:48.01,Default,Sano,0,0,0,,Më fal për këtë.
Dialogue: 0,0:11:52.98,0:11:54.05,Default,Mizuki,0,0,0,,Sano?
Dialogue: 0,0:11:57.36,0:11:58.98,Default,Mizuki,0,0,0,,Hë? Sano?
Dialogue: 0,0:12:03.88,0:12:05.20,Default,Sano,0,0,0,,Do të kërcej unë me ty.
Dialogue: 0,0:12:05.78,0:12:07.99,Default,Sano,0,0,0,,Të rrish i vetëm në cep s'ka lezet fare.
Dialogue: 0,0:12:08.76,0:12:09.65,Default,Mizuki,0,0,0,,Por...
Dialogue: 0,0:12:10.37,0:12:11.67,Default,Rio,0,0,0,,Është në rregull! Është në rregull!
Dialogue: 0,0:12:11.67,0:12:13.58,Default,Rio,0,0,0,,Shko, shko, shko!
Dialogue: 0,0:12:14.51,0:12:16.28,Default,Sano,0,0,0,,Pra, çfarë thua?
Dialogue: 0,0:12:16.28,0:12:18.17,Default,Sano,0,0,0,,Apo mbarove me kërcimin?
Dialogue: 0,0:12:21.03,0:12:23.38,Default,Mizuki,0,0,0,,Do të doja të kërceja.
Dialogue: 0,0:12:25.76,0:12:26.64,Default,Sano,0,0,0,,Edhe unë.
Dialogue: 0,0:12:29.83,0:12:30.76,Default,Sano,0,0,0,,Ja ku po fillojmë.
Dialogue: 0,0:12:31.84,0:12:33.13,Default,Sano,0,0,0,,Mos i largo sytë.
Dialogue: 0,0:12:33.13,0:12:34.59,Default,Mizuki,0,0,0,,P-Por...
Dialogue: 0,0:12:34.59,0:12:35.71,Default,Sano,0,0,0,,Por çfarë?
Dialogue: 0,0:12:35.71,0:12:38.52,Default,Mizuki,0,0,0,,Më vjen turp.
Dialogue: 0,0:12:39.35,0:12:40.28,Default,Sano,0,0,0,,Budallaçkë.
Dialogue: 0,0:12:40.28,0:12:42.03,Default,Sano,0,0,0,,Qetësohu.
Dialogue: 0,0:12:42.68,0:12:44.30,Default,Sano,0,0,0,,Është thjesht një kërcim.
Dialogue: 0,0:12:44.30,0:12:45.41,Default,Sano,0,0,0,,Ta marrim me qetësi.
Dialogue: 0,0:12:52.29,0:12:53.64,Default,Yumemi,0,0,0,,Shiko.
Dialogue: 0,0:12:53.64,0:12:55.16,Default,Kanna,0,0,0,,Sa lezetshëm.
Dialogue: 0,0:12:55.16,0:12:57.46,Default,Tennouji,0,0,0,,Për mua, ti je njëqind herë më e bukur!
Dialogue: 0,0:12:57.46,0:12:59.54,Default,Kadoma,0,0,0,,Senpai, Senpai! Shikoje atje!
Dialogue: 0,0:12:59.54,0:13:01.02,Default,Kadoma,0,0,0,,Duken aq bukur!
Dialogue: 0,0:13:01.02,0:13:03.28,Default,Kujo,0,0,0,,Do të vritesh\Nnëse i shpërqendron sytë.
Dialogue: 0,0:13:18.78,0:13:20.94,Default,Hibari,0,0,0,,Shikoje kolibrin si po lëviz.
Dialogue: 0,0:13:21.29,0:13:24.96,Default,Hibari,0,0,0,,Nuk mund të humbasim përballë tyre, Masao-san.
Dialogue: 0,0:13:24.96,0:13:26.64,Default,Himejima,0,0,0,,Edhe unë mendoj njësoj.
Dialogue: 0,0:13:26.64,0:13:28.44,Main - Italics,Hibari(M),0,0,0,,Më duhet ta duroj vetëm këtë kërcim.
Dialogue: 0,0:13:28.44,0:13:31.62,Main - Italics,Hibari(M),0,0,0,,Vetëm e vetëm që t'i shfaq \Naftësitë e mia në maksimum.
Dialogue: 0,0:13:31.62,0:13:33.45,Main - Italics,Himejima,0,0,0,,Mbahuni, mbahuni.
Dialogue: 0,0:13:33.45,0:13:38.21,Main - Italics,Himejima,0,0,0,,Ajo thjesht qëllon të jetë e vetmja\N që mund të më ndihmojë të jap më të mirën.
Dialogue: 0,0:13:38.21,0:13:41.19,Main - Top,Announcement,0,0,0,,Faleminderit të gjithëve për durimin tuaj.
Dialogue: 0,0:13:41.19,0:13:44.72,Main - Top,Announcement,0,0,0,,Tani do të shpallim fituesin e këtij\N viti bazuar në votat tuaja.
Dialogue: 0,0:13:43.18,0:13:45.67,Default,Sano,0,0,0,,Kjo nuk na përket neve, ndaj le të ikim.
Dialogue: 0,0:13:45.67,0:13:46.72,Default,Mizuki,0,0,0,,E the fjalën.
Dialogue: 0,0:13:47.13,0:13:49.91,Default,Announcement,0,0,0,,Do të fillojmë me shpalljen e mbretëreshës sonë.
Dialogue: 0,0:13:49.91,0:13:51.51,Default,Mizuki,0,0,0,,A mund të më presësh këtu për një sekondë?
Dialogue: 0,0:13:53.97,0:13:55.48,Default,Mizuki,0,0,0,,Urdhëro.
Dialogue: 0,0:13:56.60,0:13:57.48,Default,Sano,0,0,0,,Çfarë është kjo?
Dialogue: 0,0:13:58.44,0:14:00.83,Default,Mizuki,0,0,0,,Nesër e ke ditëlindjen, apo jo?
Dialogue: 0,0:14:00.83,0:14:03.48,Default,Mizuki,0,0,0,,Jam një ditë para kohe, por kjo është \Ndhurata jote e ditëlindjes.
Dialogue: 0,0:14:04.47,0:14:07.09,Default,Mizuki,0,0,0,,Vitin e kaluar disi më iku pa e vënë re,
Dialogue: 0,0:14:07.09,0:14:09.28,Default,Mizuki,0,0,0,,kështu që u betova ta jepja këtë vit.
Dialogue: 0,0:14:09.86,0:14:12.49,Default,Mizuki,0,0,0,,Doja të isha e para\N që të të uronte ditëlindjen.
Dialogue: 0,0:14:19.04,0:14:20.37,Default,Mizuki,0,0,0,,Oh, borë!
Dialogue: 0,0:14:20.37,0:14:21.50,Default,Mizuki,0,0,0,,E mrekullueshme!
Dialogue: 0,0:14:21.50,0:14:23.51,Default,Mizuki,0,0,0,,Po bie borë!
Dialogue: 0,0:14:23.51,0:14:25.17,Default,Sano,0,0,0,,Dukesh si fëmijë i vogël.
Dialogue: 0,0:14:25.17,0:14:28.22,Default,Mizuki,0,0,0,,Por kjo është hera ime e parë që shoh borë.
Dialogue: 0,0:14:28.22,0:14:29.15,Default,Mizuki,0,0,0,,Borë të vërtetë!
Dialogue: 0,0:14:29.15,0:14:30.20,Default,Sano,0,0,0,,Vërtet?
Dialogue: 0,0:14:30.20,0:14:31.26,Default,Mizuki,0,0,0,,Vërtet.
Dialogue: 0,0:14:31.68,0:14:32.89,Default,Mizuki,0,0,0,,Sa ftohtë qenka!
Dialogue: 0,0:14:33.65,0:14:35.72,Default,Mizuki,0,0,0,,Oh, u shkri.
Dialogue: 0,0:14:35.72,0:14:36.77,Default,Sano,0,0,0,,Ah!
Dialogue: 0,0:14:39.77,0:14:41.02,Default,Sano,0,0,0,,Do të ftohesh.
Dialogue: 0,0:14:45.23,0:14:47.33,Default,Mizuki,0,0,0,,Gëzuar ditëlindjen, Sano.
Dialogue: 0,0:14:48.53,0:14:49.52,Default,Sano,0,0,0,,Faleminderit.
Dialogue: 0,0:14:59.16,0:15:00.62,Default,Umeda,0,0,0,,Duket se do të zërë vend.
Dialogue: 0,0:15:00.62,0:15:02.04,Default,Akiha,0,0,0,,Dëshiron të të ngroh unë?
Dialogue: 0,0:15:02.04,0:15:03.25,Default,Akiha,0,0,0,,Senpai!
Dialogue: 0,0:15:03.25,0:15:04.24,Default,Umeda,0,0,0,,Akiha!
Dialogue: 0,0:15:04.24,0:15:05.41,Default,Umeda,0,0,0,,Çfarë po bën këtu?
Dialogue: 0,0:15:05.41,0:15:06.30,Default,Umeda,0,0,0,,Lëshomë!
Dialogue: 0,0:15:07.36,0:15:10.75,Default,Akiha,0,0,0,,Krishtlindja është mu te dera.\N Ndoshta duhet të vij e të fle te ti?
Dialogue: 0,0:15:10.75,0:15:12.15,Default,Umeda,0,0,0,,Në asnjë mënyrë.
Dialogue: 0,0:15:16.06,0:15:19.35,Default,Mizuki,0,0,0,,Oh, uau, sa e këndshme që qenka.
Dialogue: 0,0:15:19.35,0:15:22.94,Default,Sano,0,0,0,,Hej, a nuk ishte ajo dhurata ime?
Dialogue: 0,0:15:24.17,0:15:26.62,Default,Mizuki,0,0,0,,Por po ndihet aq mirë.
Dialogue: 0,0:15:27.89,0:15:31.11,Flashback,Mizuki,0,0,0,,Jam një ditë para kohe, por kjo është \Ndhurata jote e ditëlindjes.
Dialogue: 0,0:15:34.74,0:15:36.99,Main - Italics,Sano(M),0,0,0,,Një masazhator me ultratinguj!
Dialogue: 0,0:15:37.44,0:15:38.91,Main - Italics,Sano(M),0,0,0,,Sa aspak tërheqëse.
Dialogue: 0,0:15:38.91,0:15:40.65,Default,Mizuki,0,0,0,,Ishte me ofertë!
Dialogue: 0,0:15:40.65,0:15:42.64,Default,Mizuki,0,0,0,,E mora goxha lirë!
Dialogue: 0,0:15:43.25,0:15:47.07,Default,Mizuki,0,0,0,,As mos u shqetëso për çmimin.
Dialogue: 0,0:15:48.00,0:15:49.51,Default,Sano,0,0,0,,Të thashë, jam i lumtur që e more.
Dialogue: 0,0:15:52.30,0:15:53.42,Default,Sano,0,0,0,,Faleminderit.
Dialogue: 0,0:15:56.76,0:15:58.03,Main - Italics,Mizuki(M),0,0,0,,Qetësohu.
Dialogue: 0,0:15:58.03,0:15:59.93,Main - Italics,Mizuki(M),0,0,0,,Më duhet të qetësohem.
Dialogue: 0,0:16:01.02,0:16:02.39,Default,sign,0,0,0,,{\fax-.1\fnArial\shad0\fs18\frz343.1\pos(375.732,140.572)\3c&H362A33&}Julia
Dialogue: 0,0:16:02.85,0:16:04.17,Default,Mizuki,0,0,0,,Është Julia.
Dialogue: 0,0:16:04.17,0:16:05.15,Default,Nakatsu,0,0,0,,Mizuki!
Dialogue: 0,0:16:05.15,0:16:07.52,Default,Nakatsu,0,0,0,,A do të hash pak taiyaki me mua?
Dialogue: 0,0:16:07.52,0:16:10.03,Default,sign,0,0,0,,{\fnArial Black\shad0\bord0\an8\c&H7C2ECA&\pos(363.236,21.412)}Ngjitur
Dialogue: 0,0:16:07.52,0:16:08.37,Default,Sano,0,0,0,,Hej.
Dialogue: 0,0:16:08.37,0:16:10.03,Default,Mizuki,0,0,0,,Ura, dua edhe unë!
Dialogue: 0,0:16:13.41,0:16:17.67,Default,Nakatsu,0,0,0,,Ta dish, unë i dikurshmi kur ta shihte këtë \Ndo ta kishte humbur toruan krejtësisht,
Dialogue: 0,0:16:17.67,0:16:19.91,Default,Nakatsu,0,0,0,,por unë i riu jam ndryshe.
Dialogue: 0,0:16:19.91,0:16:22.16,Default,Nakatsu,0,0,0,,Po bëhem burrë në kulm!
Dialogue: 0,0:16:22.16,0:16:26.67,Default,Nakatsu,0,0,0,,Kështu që, si super burrërori \NNakatsu-kun Revolucioni Lloji E,
Dialogue: 0,0:16:26.67,0:16:28.82,Default,Nakatsu,0,0,0,,Mizuki, zemra jote do të rrahë për mu—
Dialogue: 0,0:16:28.82,0:16:30.30,Default,Mizuki,0,0,0,,Si po shkojnë punët, Julia?
Dialogue: 0,0:16:31.30,0:16:32.46,Main - Italics,Julia,0,0,0,,Përshëndetje, Mizuki!
Dialogue: 0,0:16:32.46,0:16:33.49,Main - Italics,Julia,0,0,0,,Po ia kaloj shkëlqyeshëm.
Dialogue: 0,0:16:33.49,0:16:37.68,Main - Italics,Julia,0,0,0,,Dëgjo, po pyesja veten se si \Ntë shkoi kërcimi në ballo.
Dialogue: 0,0:16:39.44,0:16:40.74,Default,Mizuki,0,0,0,,Epo, në fakt...
Dialogue: 0,0:16:40.74,0:16:43.81,Default,Nakatsu,0,0,0,,Hej. Ka kohë pa u parë, o grua amerikane.
Dialogue: 0,0:16:44.24,0:16:47.94,Main - Italics,Julia,0,0,0,,Po shoh që je po aq i bezdisshëm sa kurrë, \No majmun trap.
Dialogue: 0,0:16:47.94,0:16:49.74,Default,Nakatsu,0,0,0,,Si guxon?!
Dialogue: 0,0:16:49.74,0:16:50.92,Default,Nanba,0,0,0,,Hej, çuna.
Dialogue: 0,0:16:51.73,0:16:54.32,Default,Nanba,0,0,0,,E mora këtë kupon nga gjyshja ime.
Dialogue: 0,0:16:54.32,0:16:55.45,Default,Nanba,0,0,0,,A doni të shkojmë për patinazh?
Dialogue: 0,0:16:55.45,0:16:56.81,Default,Both,0,0,0,,Po!
Dialogue: 0,0:16:57.45,0:16:59.08,Main - Italics,Julia,0,0,0,,Kjo tingëllon si...
Dialogue: 0,0:16:59.08,0:17:00.58,Default,Nanba,0,0,0,,Përshëndetje, Julia.
Dialogue: 0,0:17:01.29,0:17:03.58,Default,Nanba,0,0,0,,Kanë kaluar muaj që kur u largove,
Dialogue: 0,0:17:03.58,0:17:05.36,Default,Nanba,0,0,0,,dhe nuk e ke idenë sa i vetmuar jam n—
Dialogue: 0,0:17:05.36,0:17:06.89,Default,Mizuki,0,0,0,,E mbylli telefonin.
Dialogue: 0,0:17:12.71,0:17:17.41,Default,Mizuki,0,0,0,,Mos rri thjesht aty! \NEja këtu, Nakatsu!
Dialogue: 0,0:17:17.41,0:17:18.60,Default,Nakatsu,0,0,0,,P-Po...
Dialogue: 0,0:17:18.60,0:17:21.60,Default,Kids,0,0,0,,Hej, ai djali nuk di të bëjë patinazh!
Dialogue: 0,0:17:21.60,0:17:22.64,Default,Both,0,0,0,,Ha ha!
Dialogue: 0,0:17:22.64,0:17:23.60,Default,Nakatsu,0,0,0,,Idiotë!
Dialogue: 0,0:17:23.60,0:17:25.19,Default,Nakatsu,0,0,0,,Kur vjen puna te sportet dimërore,
Dialogue: 0,0:17:25.19,0:17:29.20,Default,Nakatsu,0,0,0,,ne njerëzit e Kansai-t bëjmë ski apo snowboard\N në luginën e liqenit Biwa.
Dialogue: 0,0:17:29.20,0:17:31.73,Default,Nakatsu,0,0,0,,Ne mund të bëjmë patinazh edhe me sy mbyllur!
Dialogue: 0,0:17:31.73,0:17:35.24,Default,Nakao,0,0,0,,Të jesh në gjendje të patinosh në atë \Npozicion është talent më vete.
Dialogue: 0,0:17:37.08,0:17:39.24,Default,Kayashima,0,0,0,,Ashiya duket sikur po kënaqet.
Dialogue: 0,0:17:39.24,0:17:41.37,Default,Sano,0,0,0,,Si peshku në ujë.
Dialogue: 0,0:17:43.25,0:17:46.87,Default,Kayashima,0,0,0,,Ka dhe dikush tjetër që po ndihet \Nkëtu si peshku në ujë.
Dialogue: 0,0:17:46.87,0:17:49.88,Default,GirlA,0,0,0,,E dija që të njihja, je \Nnjë nga ata modelet e PuPa-s!
Dialogue: 0,0:17:49.88,0:17:52.30,Default,GirlB,0,0,0,,Dukesh kaq bukur në të vërtetë!
Dialogue: 0,0:17:52.30,0:17:56.07,Default,Sano,0,0,0,,Nuk po e besoj dot. \NAjo palltoja është e setit fotografik?
Dialogue: 0,0:17:56.07,0:17:59.14,Default,Nakatsu,0,0,0,,Po përdor marifete të lira, po e shoh.
Dialogue: 0,0:18:01.01,0:18:02.76,Default,Nakao,0,0,0,,Senpai!
Dialogue: 0,0:18:03.37,0:18:07.17,Default,Nakao,0,0,0,,Më the që do të bëje patinazh me mua.
Dialogue: 0,0:18:08.54,0:18:10.02,Default,Nakao,0,0,0,,Je djalë shumë i prapë.
Dialogue: 0,0:18:10.50,0:18:12.51,Default,Girls,0,0,0,,N-Nuk konkurrojmë dot!
Dialogue: 0,0:18:13.02,0:18:15.13,Default,Nakao,0,0,0,,Shkojmë, Senpai.
Dialogue: 0,0:18:15.86,0:18:17.53,Default,Nanba,0,0,0,,Pra kjo qenka jeta ime tani...
Dialogue: 0,0:18:17.53,0:18:19.82,Default,Kayashima,0,0,0,,Nakao ka gjetur një strategji të re.
Dialogue: 0,0:18:19.82,0:18:20.99,Default,Sano,0,0,0,,Lëvizje e zgjuar.
Dialogue: 0,0:18:20.99,0:18:24.54,Default,Nakatsu,0,0,0,,E efektshme dhe nuk iu desh\N të sakrifikonte asgjë vetë...
Dialogue: 0,0:18:24.91,0:18:27.04,Default,Mizuki,0,0,0,,Hej, hej, për çfarë po flisni ju të dy?
Dialogue: 0,0:18:27.04,0:18:31.04,Default,Mizuki,0,0,0,,Oh, po, Nakao-kun ka një rrugë të vështirë përpara.
Dialogue: 0,0:18:31.04,0:18:35.71,Default,Mizuki,0,0,0,,Në fund të fundit, i ra në kokë për djalin \Nqë u kurorëzua mbret.
Dialogue: 0,0:18:35.71,0:18:37.69,Default,Nakatsu,0,0,0,,Ashtu është.
Dialogue: 0,0:18:37.69,0:18:40.07,Default,Kayashima,0,0,0,,Mendova se Hibari-sama ishte e pakrahasueshme.
Dialogue: 0,0:18:40.07,0:18:41.22,Default,Mizuki,0,0,0,,Absolutisht!
Dialogue: 0,0:18:41.49,0:18:44.28,Default,Mizuki,0,0,0,,Nuk është çudi që u kurorëzua mbretëreshë!
Dialogue: 0,0:18:44.76,0:18:47.02,Default,Kayashima,0,0,0,,Nuk e kisha aty fjalën.
Dialogue: 0,0:18:47.02,0:18:48.36,Flashback,Girls,0,0,0,,Hibari-sama!
Dialogue: 0,0:18:48.43,0:18:49.58,Flashback,Girls,0,0,0,,Hibari-sama!
Dialogue: 0,0:18:49.64,0:18:51.69,Flashback,Girls,0,0,0,,Hibari-sama!
Dialogue: 0,0:18:51.69,0:18:52.75,Default,Nakatsu,0,0,0,,Të them të drejtën,
Dialogue: 0,0:18:52.75,0:18:56.59,Default,Nakatsu,0,0,0,,jam i bindur se votimi ishte \Ni manipuluar që të fitonte vetëm Shën Blossom.
Dialogue: 0,0:18:56.59,0:18:57.47,Default,Kayashima,0,0,0,,Po.
Dialogue: 0,0:18:58.02,0:19:00.95,Default,Kayashima,0,0,0,,Mendova se Ashiya ishte më i lezetshëm.
Dialogue: 0,0:19:00.95,0:19:02.20,Default,Nakatsu,0,0,0,,Një rival!
Dialogue: 0,0:19:03.16,0:19:04.99,Default,Mizuki,0,0,0,,Për çfarë e ke fjalën, Kayashima?
Dialogue: 0,0:19:04.99,0:19:06.95,Default,Kayashima,0,0,0,,Dua të them, shikojeni veten tuaj.
Dialogue: 0,0:19:07.36,0:19:10.58,Default,Kayashima,0,0,0,,Ju të dy fituat çmimin \Nspecial për çiftin më të mirë.
Dialogue: 0,0:19:10.58,0:19:13.62,Main - Italics,Mizuki(M),0,0,0,,Oh, po!
Dialogue: 0,0:19:13.62,0:19:16.34,Main - Italics,Mizuki(M),0,0,0,,Nuk kisha menduar kurrë se unë dhe Sano \Ndo të fitonim një çmim bashkë!
Dialogue: 0,0:19:16.72,0:19:20.19,Default,Mizuki,0,0,0,,Por nuk është se kjo ishte\N ndonjë gjë tepër zyrtare.
Dialogue: 0,0:19:20.19,0:19:23.97,Default,Mizuki,0,0,0,,Çifti i vërtetë më i mirë ishin \NTennoji dhe Kanna-chan.
Dialogue: 0,0:19:25.39,0:19:27.64,Main - Italics,Nakatsu,0,0,0,,Sa dështak që jam!
Dialogue: 0,0:19:27.64,0:19:29.69,Main - Italics,Nakatsu,0,0,0,,Sikur të mos më kishte rënë të fikët atëherë!
Dialogue: 0,0:19:29.69,0:19:32.58,Main - Italics,Nakatsu,0,0,0,,Çifti më i mirë do të kishim\N qenë unë dhe Mizuki!
Dialogue: 0,0:19:32.58,0:19:33.23,Default,Kyoumi,0,0,0,,Budalla.
Dialogue: 0,0:19:34.59,0:19:35.57,Default,Nakatsu,0,0,0,,Kyomi?
Dialogue: 0,0:19:36.60,0:19:38.38,Default,Nakatsu,0,0,0,,Çfarë po bën këtu?
Dialogue: 0,0:19:38.38,0:19:41.02,Default,Kagurazaka,0,0,0,,Hej! Të thashë të mos ikësh me vrap!
Dialogue: 0,0:19:42.13,0:19:43.49,Default,Nakatsu,0,0,0,,Kagurazaka?
Dialogue: 0,0:19:43.78,0:19:46.30,Default,Nakatsu,0,0,0,,Të paska hije, po bën vëllain e madh të mirë.
Dialogue: 0,0:19:46.30,0:19:48.24,Default,Kagurazaka,0,0,0,,Ç'dreqin po flet?
Dialogue: 0,0:19:48.24,0:19:49.58,Default,Tamami,0,0,0,,Onii-chan!
Dialogue: 0,0:19:49.58,0:19:50.87,Default,Mizuki,0,0,0,,Tamami-chan!
Dialogue: 0,0:19:52.00,0:19:53.94,Default,Mizuki,0,0,0,,Kemi një përjetësi pa u parë!
Dialogue: 0,0:19:52.00,0:19:53.94,Main - Top,Kayashima,0,0,0,,Nga gjimnazi i Tokyo-s?
Dialogue: 0,0:19:53.94,0:19:54.63,Default,Sano,0,0,0,,Po.
Dialogue: 0,0:19:58.13,0:20:01.26,Default,Tamami,0,0,0,,Çfarë rastësie, Mizuki-kun.
Dialogue: 0,0:20:01.26,0:20:03.87,Default,Tamami,0,0,0,,Izumi-sama, do të shkosh\N në garën e ardhshme, apo jo?
Dialogue: 0,0:20:03.87,0:20:05.01,Default,Tamami,0,0,0,,Do të bëj tifo për ty!
Dialogue: 0,0:20:05.01,0:20:06.39,Default,Tamami,0,0,0,,Shihemi!
Dialogue: 0,0:20:07.78,0:20:11.14,Default,Kagurazaka,0,0,0,,Sano, më mirë mos nxirr ndonjë rezultat të dobët.
Dialogue: 0,0:20:11.60,0:20:13.14,Default,Sano,0,0,0,,Sigurisht që jo.
Dialogue: 0,0:20:16.74,0:20:17.90,Default,Kagurazaka,0,0,0,,Shkojmë.
Dialogue: 0,0:20:19.44,0:20:20.39,Default,Nakatsu,0,0,0,,Kyomi.
Dialogue: 0,0:20:21.15,0:20:22.78,Default,Nakatsu,0,0,0,,Pritma dorën!
Dialogue: 0,0:20:25.44,0:20:26.41,Default,Mizuki,0,0,0,,Prit pak.
Dialogue: 0,0:20:26.41,0:20:28.42,Default,Mizuki,0,0,0,,Ata janë prindërit e Rio-chan-it!
Dialogue: 0,0:20:28.42,0:20:29.16,Default,Mom,0,0,0,,O bobo!
Dialogue: 0,0:20:29.63,0:20:31.26,Default,Mizuki,0,0,0,,A jeni të dy në një takim?
Dialogue: 0,0:20:31.26,0:20:32.66,Default,Mom,0,0,0,,Pikërisht!
Dialogue: 0,0:20:32.66,0:20:34.49,Default,Mom,0,0,0,,Kuponi skadon sot.
Dialogue: 0,0:20:34.49,0:20:37.85,Default,Kayashima,0,0,0,,Prit pak, ata të dy janë \Nprindërit e doktor Umeda-s?
Dialogue: 0,0:20:37.85,0:20:40.61,Default,Nakatsu,0,0,0,,Janë në të pesëdhjetat. Sa për dijeni.
Dialogue: 0,0:20:40.61,0:20:43.72,Default,Nakao,0,0,0,,Nanba-senpai, më prit!
Dialogue: 0,0:20:43.72,0:20:44.43,Default,Mom,0,0,0,,Prit një sekondë.
Dialogue: 0,0:20:44.43,0:20:47.76,Default,Mom,0,0,0,,Ajo bukuroshja me flokë të gjata është Minami-chan!
Dialogue: 0,0:20:47.76,0:20:52.06,Default,Nanba,0,0,0,,Oh, çfarë rastësie të përplasemi kështu,\N gjyshe dhe gjysh...
Dialogue: 0,0:20:52.06,0:20:54.19,Default,Nakao,0,0,0,,Gjyshe? Gjysh?
Dialogue: 0,0:20:54.79,0:20:57.06,Default,All,0,0,0,,Gjyshe? Gjysh?
Dialogue: 0,0:20:57.55,0:20:59.07,Default,All,0,0,0,,Ai është nipi i tyre?!
Dialogue: 0,0:20:59.07,0:21:01.19,Default,Nakatsu,0,0,0,,Atëherë kjo do të thotë se Io është...
Dialogue: 0,0:21:00.19,0:21:03.32,Default,Sign,0,0,0,,{\fad(1,440)\shad0\fnArial Black\fs12\an8\pos(422.4,42.853)\3c&HE7FBE5&\c&H010101&}Nënë e bir
Dialogue: 0,0:21:01.19,0:21:02.07,Default,Sano,0,0,0,,Umeda është...
Dialogue: 0,0:21:01.19,0:21:03.32,Default,Sign,0,0,0,,{\fad(1,440)\shad0\fnArial Black\fs12\3c&HFEFBE0&\c&H010101&\pos(317.156,112.237)}Dajë dhe nip
Dialogue: 0,0:21:02.07,0:21:03.53,Default,Nakao,0,0,0,,Rio-chan është...
Dialogue: 0,0:21:02.07,0:21:03.32,Default,Sign,0,0,0,,{\fad(1,440)\shad0\fnArial Black\fs16\3c&HCCEBFB&\c&H010101&\pos(164.124,53.659)\frz10.47}Teze dhe nip
Dialogue: 0,0:21:03.53,0:21:04.39,Default,Noe,0,0,0,,Ç'po ndodh?
Dialogue: 0,0:21:04.39,0:21:05.32,Default,Sekime,0,0,0,,Çfarë po bëhet?
Dialogue: 0,0:21:05.32,0:21:08.49,Default,Nakatsu,0,0,0,,Ajo që po ndodh është se \NRio-chan është tezja e Nanba-s.
Dialogue: 0,0:21:08.49,0:21:09.96,Main - Italics,Mizuki(M),0,0,0,,Rio-chan, më vjen shumë keq!
Dialogue: 0,0:21:09.96,0:21:11.25,Main - Italics,Mizuki(M),0,0,0,,U mor vesh gjithçka!
Dialogue: 0,0:21:08.49,0:21:10.52,Main - Top,Noe,0,0,0,,Çfarë? Rio-chan është tezja e tij?!
Dialogue: 0,0:21:10.52,0:21:12.33,Main - Top,Sekime,0,0,0,,Teze? {\i1}Tezja e tij{\i0}?!
Dialogue: 0,0:21:12.33,0:21:14.54,Default,Seira,0,0,0,,Oh, ti, Minami-chan!
Dialogue: 0,0:21:14.54,0:21:18.13,Default,Seira,0,0,0,,Të kam thënë aq shumë herë të na \Nthërrasësh mami Seira dhe babi Azuma!
Dialogue: 0,0:21:18.13,0:21:19.34,Default,Azuma,0,0,0,,Seira.
Dialogue: 0,0:21:20.29,0:21:21.34,Default,Azuma,0,0,0,,Eja tek unë.
Dialogue: 0,0:21:22.72,0:21:24.04,Main - Italics,Seira,0,0,0,,Ahhh!
Dialogue: 0,0:21:24.04,0:21:26.00,Default,Seira,0,0,0,,Azuma-chan!
Dialogue: 0,0:21:26.00,0:21:28.32,Default,All,0,0,0,,F-Faleminderit për këtë shfaqje...
Dialogue: 0,0:21:28.32,0:21:29.84,Default,Nanba,0,0,0,,Meqë ra fjala,
Dialogue: 0,0:21:29.84,0:21:33.22,Default,Nanba,0,0,0,,ata fituan çmimin për çiftin më të mirë \Nnë ballon e përbashkët në kohën e tyre.
Dialogue: 0,0:21:36.12,0:21:41.23,Main - Italics,Mizuki(M),0,0,0,,Kushdo që votohet si çifti më i mirë,\Nthuhet se jeton i lumtur përgjithmonë.
Dialogue: 0,0:21:41.73,0:21:46.46,Main - Italics,Mizuki(M),0,0,0,,Duke i parë bashkë, nuk mund ta\N hedh poshtë thjesht si bestytni.
Dialogue: 0,0:21:48.84,0:21:50.62,Default,Sano,0,0,0,,Për pak.
Dialogue: 0,0:21:51.16,0:21:52.49,Default,Mizuki,0,0,0,,Faleminderit.
Dialogue: 0,0:21:52.49,0:21:53.89,Default,Sano,0,0,0,,Kujdes.
Dialogue: 0,0:21:53.89,0:21:56.00,Default,Sano,0,0,0,,Është shumë e rrëshqitshme\N në buzë të pistës.
Dialogue: 0,0:21:56.52,0:21:58.58,Default,Sano,0,0,0,,Hajde të patinojmë.
Dialogue: 0,0:22:00.58,0:22:02.50,Default,Nakatsu,0,0,0,,Hej! Mos më lini pas!
Dialogue: 0,0:22:06.05,0:22:09.26,Main - Italics,Mizuki(M),0,0,0,,Ndoshta pak nga kjo\N bestytni do të na ngjitet edhe neve.
Dialogue: 0,0:22:09.53,0:22:12.26,Main - Italics,Mizuki(M),0,0,0,,Në fund të fundit, e fituam çiftin më të mirë.
Dialogue: 0,0:22:20.32,0:22:22.52,Main - Italics,Mizuki(M),0,0,0,,Jam kaq e lumtur tani.
Dialogue: 0,0:22:22.77,0:22:27.29,Main - Italics,Mizuki(M),0,0,0,,Uroj që unë dhe Sano të jemi gjithmonë bashkë!

