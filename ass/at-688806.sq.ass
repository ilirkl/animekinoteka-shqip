Dialogue: 0,0:00:03.36,0:00:04.67,Default,CAPTAIN,0,0,0,,Po kontrolloj zonën e uljes.
Dialogue: 0,0:00:04.67,0:00:06.98,Default,BALCUS,0,0,0,,Zbritini të gjithë! Shpejt!
Dialogue: 0,0:00:07.89,0:00:09.13,Default,EVACUEES,0,0,0,,Shpëtuam.
Dialogue: 0,0:00:09.13,0:00:10.99,Default,EVACUEES,0,0,0,,Këtu do të jemi të sigurt.
Dialogue: 0,0:00:11.25,0:00:14.29,Default,BALCUS,0,0,0,,Të gjithë zbritën nga anija. \NPo kthehemi sërish në fushëbetejë.
Dialogue: 0,0:00:14.29,0:00:15.45,Default,RAYMOND,0,0,0,,Babi i Leon-it.
Dialogue: 0,0:00:15.45,0:00:16.99,Default,DANIEL,0,0,0,,Po vijmë me ju.
Dialogue: 0,0:00:17.37,0:00:21.99,Default,BALCUS,0,0,0,,Jeni të lënduar. Nxënësit \Nduhet të qëndrojnë të evakuuar.
Dialogue: 0,0:00:21.99,0:00:23.37,Default,DANIEL,0,0,0,,P-Por...
Dialogue: 0,0:00:23.37,0:00:25.46,Default,CLARICE,0,0,0,,Gjithçka është në rregull, djema.
Dialogue: 0,0:00:25.75,0:00:28.70,Default,DEIRDRE,0,0,0,,Tashmë e keni dëshmuar guximin tuaj.
Dialogue: 0,0:00:28.70,0:00:30.34,Default,RAYMOND,0,0,0,,Zonjusha...
Dialogue: 0,0:00:30.34,0:00:33.30,Default,CLARICE,0,0,0,,Leon-i do t'ia dalë mbanë.
Dialogue: 0,0:00:33.30,0:00:35.19,Default,DEIRDRE,0,0,0,,Kini besim tek ai.
Dialogue: 0,0:00:36.67,0:00:37.86,Default,RAYMOND,0,0,0,,Besim tek ai?
Dialogue: 0,0:00:38.58,0:00:39.92,Default,DANIEL,0,0,0,,Besim te Leon-i?
Dialogue: 0,0:00:41.35,0:00:43.27,Default,RAYMOND,0,0,0,,Prit, prit, prit pak.
Dialogue: 0,0:00:43.27,0:00:44.92,Default,DANIEL,0,0,0,,Nuk ka asnjë shans.
Dialogue: 0,0:00:54.61,0:00:56.91,Default,COMMANDER A,0,0,0,,M-Me këtë ritëm, do të asgjësohemi plotësisht!
Dialogue: 0,0:01:08.16,0:01:11.69,Default,VANDEL,0,0,0,,Bashkimi me atë mjet të çuditshëm \Nnuk të ndihmoi dot shumë!
Dialogue: 0,0:01:17.26,0:01:21.68,Default,VANDEL,0,0,0,,Maskarenj të mbretërisë, \Ndo t'ju vras të gjithëve!
Dialogue: 0,0:01:21.90,0:01:24.26,Default,LUXION,0,0,0,,E ka humbur arsyen.
Dialogue: 0,0:01:24.26,0:01:26.69,Default,LUXION,0,0,0,,Objekti magjik ia ka pushtuar \Nkrejtësisht trupin.
Dialogue: 0,0:01:26.69,0:01:27.93,Default,LEON,0,0,0,,Dreqi ta hajë.
Dialogue: 0,0:01:27.93,0:01:32.07,Default,LEON,0,0,0,,Kaq shumë dëshirë ke \Ntë vazhdosh të luftosh, o plak?!
Dialogue: 0,0:01:44.62,0:01:45.62,Title1,SIGN,0,0,0,,{\c&H000000&}I Ngecur në
Dialogue: 0,0:01:48.33,0:01:49.87,Title2,SIGN,0,0,0,,një Lojë{\c&H000000&} Otome
Dialogue: 0,0:01:57.86,0:02:02.10,Title3,SIGN,0,0,0,,{\pos(323,274)\fad(589,1)}I Ngecur{\c&H000000&} në një {\c&H1100D6&}Lojë {\c&H000000&}Otome
Dialogue: 0,0:02:02.10,0:02:06.70,Title3,SIGN,0,0,0,,{\pos(323,274)\fad(589,1)}I Ngecur{\c&H000000&} në një {\c&H1100D6&}Lojë {\c&H000000&}Otome {\fs55\c&H984A07&}2
Dialogue: 0,0:03:10.00,0:03:13.96,Ep Title,SIGN,0,0,0,,{\an3\q2\fad(553,750)\3c&HE7E7ED&\3a&H8F&\c&HE37024&}Nuk më {\c&H0500CD&}Bëhet Vonë {\c&H000000&}për Këtë!
Dialogue: 0,0:03:09.68,0:03:12.96,Default_top,MARIE,0,0,0,,Ka një mënyrë për ta ndalur atë përbindësh.
Dialogue: 0,0:03:14.23,0:03:17.28,Default,MASKED KNIGHT,0,0,0,,Vërtet, Marie? Dua të them, Zonjusha Marie?
Dialogue: 0,0:03:17.28,0:03:18.19,Default,MARIE,0,0,0,,Po.
Dialogue: 0,0:03:19.21,0:03:23.97,Italics_top,MARIE/ID,0,0,0,,E kam parë vetëm atë skenë nga \Nskedari i ruajtur i vëllait tim, por...
Dialogue: 0,0:03:24.40,0:03:28.18,Default,MARIE,0,0,0,,Ky përbindësh po thirret \Nnga një objekt i quajtur fyelli magjik.
Dialogue: 0,0:03:28.18,0:03:33.73,Default,ANGELICA,0,0,0,,Ka të drejtë. Pashë përbindësha që \Npo thirreshin gjatë udhëtimit tonë shkollor.
Dialogue: 0,0:03:34.09,0:03:35.55,Default,JILK,0,0,0,,Një fyell magjik?
Dialogue: 0,0:03:36.14,0:03:39.29,Default,CLEARE,0,0,0,,Ajo anije është burimi \Ni zërit të fyellit.
Dialogue: 0,0:03:41.15,0:03:45.12,Default,OLIVIA,0,0,0,,Le të shkojmë. Duhet t'i japim fund këtyre vuajtjeve.
Dialogue: 0,0:03:45.45,0:03:48.62,Default,MASKED KNIGHT,0,0,0,,Në rregull. Drejtohuni te pronari \Ni fyellit magjik!
Dialogue: 0,0:03:48.85,0:03:52.89,Default,KYLE,0,0,0,,Çfarë? Kush kujton se je ti? \NMos na thuaj çfarë të bëjmë.
Dialogue: 0,0:03:52.89,0:03:55.25,Italics,MARIE/ID,0,0,0,,Ende nuk e paskeni kuptuar?!
Dialogue: 0,0:03:55.58,0:03:57.69,Default,MARIE,0,0,0,,Kyle, thjesht bëje.
Dialogue: 0,0:03:57.69,0:04:01.60,Default,KYLE,0,0,0,,Sinqerisht, nuk ndryshon kurrë, zonjë.
Dialogue: 0,0:04:04.48,0:04:06.85,Default,VANDEL,0,0,0,,Çfarë keni? Vetëm kaq keni në dorë?
Dialogue: 0,0:04:06.85,0:04:08.76,Default,LEON,0,0,0,,Pusho, luftëtar i rënë!
Dialogue: 0,0:04:12.54,0:04:13.60,Default,MARIE,0,0,0,,Kujdes!
Dialogue: 0,0:04:13.60,0:04:14.99,Default,MARIE,0,0,0,,Dreqin!
Dialogue: 0,0:04:24.73,0:04:26.76,Default_top,MARIE,0,0,0,,Nuk mundem, nuk mundem, nuk mundem dot!
Dialogue: 0,0:04:25.53,0:04:28.36,Default,CLEARE,0,0,0,,Sa zë i pahijshëm për një zonjë.
Dialogue: 0,0:04:28.36,0:04:30.44,Default,CLEARE,0,0,0,,Gjithsesi, gjithçka është në rregull.
Dialogue: 0,0:04:30.44,0:04:31.62,Default,OLIVIA,0,0,0,,Eare?
Dialogue: 0,0:04:32.09,0:04:37.13,Default,CLEARE,0,0,0,,Kështu po më quan \Ntani? Sa e këndshme.
Dialogue: 0,0:04:37.50,0:04:40.22,Default,CLEARE,0,0,0,,Në çdo rast, nuk ka \Nasgjë për t'u shqetësuar.
Dialogue: 0,0:04:40.22,0:04:43.13,Default,CLEARE,0,0,0,,Ai fytyrëngrysuri do të na eskortojë.
Dialogue: 0,0:04:44.02,0:04:45.63,Default,LUXION,0,0,0,,Energjia u ngarkua plotësisht.
Dialogue: 0,0:04:46.05,0:04:48.39,Default,LUXION,0,0,0,,Po qëlloj me topin e grimcave boson.
Dialogue: 0,0:04:59.24,0:05:01.50,Default,MASKED KNIGHT,0,0,0,,Ç-Çfarë ishte ajo dritë?
Dialogue: 0,0:05:01.50,0:05:03.40,Default,MASKED KNIGHT,0,0,0,,Nuk kam parë kurrë më parë një magji të tillë.
Dialogue: 0,0:05:04.76,0:05:09.41,Default,CLEARE,0,0,0,,Po, magji është.\NMagji jashtëzakonisht e fuqishme.
Dialogue: 0,0:05:09.76,0:05:12.39,Default,GREG,0,0,0,,J-Jo, kjo është...
Dialogue: 0,0:05:12.86,0:05:15.04,Default,GREG & JILK,0,0,0,,Zemërimi i mbretit demon!
Dialogue: 0,0:05:18.41,0:05:21.85,Default,MARIE,0,0,0,,Tani, para se ai përbindësh të rigjenerohet!
Dialogue: 0,0:05:21.85,0:05:24.05,Default,KYLE,0,0,0,,Po, e di.
Dialogue: 0,0:05:28.36,0:05:30.48,Default,MASKED KNIGHT,0,0,0,,Ne do të jemi mbështetja e tyre!
Dialogue: 0,0:05:30.48,0:05:32.01,Default,IDIOTS,0,0,0,,Mos na urdhëro çfarë të bëjmë!
Dialogue: 0,0:05:38.56,0:05:40.36,Default,MARIE,0,0,0,,Ja ku është! Fyelli magjik!
Dialogue: 0,0:05:40.73,0:05:41.63,Default,ANGELICA,0,0,0,,Kjo është...
Dialogue: 0,0:05:42.33,0:05:43.58,Default,ANGELICA,0,0,0,,Hertrude!
Dialogue: 0,0:05:44.15,0:05:45.87,Default,ANGELICA,0,0,0,,Si arrite deri këtu?
Dialogue: 0,0:05:45.87,0:05:48.16,Default,ANGELICA,0,0,0,,Jo, prit. Ti i re fyellit?
Dialogue: 0,0:05:49.67,0:05:52.16,Default,HERTRUDE,0,0,0,,Do t'i shkatërroj të gjithë.
Dialogue: 0,0:05:52.74,0:05:56.72,Default,OLIVIA,0,0,0,,Të lutem, ndalo. Me këtë ritëm, \Ntë gjithë do të vdesin.
Dialogue: 0,0:05:58.01,0:05:58.91,Default,HERTRUDE,0,0,0,,E pastaj?
Dialogue: 0,0:05:59.69,0:06:04.55,Default,OLIVIA,0,0,0,,Edhe populli i principatës \Ndo të vdesë gjithashtu!
Dialogue: 0,0:06:04.55,0:06:06.17,Default,OLIVIA,0,0,0,,Le t'i japim fund kësaj!
Dialogue: 0,0:06:06.55,0:06:07.40,Default,HERTRUDE,0,0,0,,Jo.
Dialogue: 0,0:06:08.65,0:06:09.89,Default,HERTRUDE,0,0,0,,Kurrë.
Dialogue: 0,0:06:09.89,0:06:10.82,Default,ANGELICA,0,0,0,,Ti...
Dialogue: 0,0:06:10.82,0:06:13.47,Default,HERTRUDE,0,0,0,,Nëse doni të më vrisni, më vrisni!
Dialogue: 0,0:06:13.76,0:06:16.70,Default,HERTRUDE,0,0,0,,Kjo nuk do ta ndalë mbrojtësin e tokës!
Dialogue: 0,0:06:16.70,0:06:18.73,Default,HERTRUDE,0,0,0,,Ai do të vazhdojë të ringjallet!
Dialogue: 0,0:06:21.11,0:06:25.89,Default,ANGELICA,0,0,0,,E kuptoj që na urren, por \Nçfarë kuptimi ka të vazhdosh luftën?
Dialogue: 0,0:06:25.89,0:06:28.57,Default,ANGELICA,0,0,0,,A nuk do të shkaktojë kjo vetëm vdekje të kota?
Dialogue: 0,0:06:28.57,0:06:30.04,Default,HERTRUDE,0,0,0,,Oh, mbylle gojën.
Dialogue: 0,0:06:30.04,0:06:34.58,Default,ANGELICA,0,0,0,,Principata i ka rrënjët e saj \Nte familja mbretërore e Holfort-it.
Dialogue: 0,0:06:36.17,0:06:40.58,Default,HERTRUDE,0,0,0,,Principata? Nuk më intereson më \Nfare se çfarë ndodh me të.
Dialogue: 0,0:06:40.95,0:06:41.72,Default,OLIVIA,0,0,0,,Çfarë?
Dialogue: 0,0:06:42.21,0:06:43.22,Default,ANGELICA,0,0,0,,Çfarë the?
Dialogue: 0,0:06:44.06,0:06:45.04,Default,HERTRUDE,0,0,0,,Nuk më bëhet vonë
Dialogue: 0,0:06:45.65,0:06:51.47,Default,HERTRUDE,0,0,0,,se çfarë ndodh me principatën \Nqë më shfrytëzoi mua dhe motrën time.
Dialogue: 0,0:06:52.89,0:06:58.04,Default,HERTRUDE,0,0,0,,Ne nuk e dinim se na kishin vrarë \Nprindërit, dhe i lamë të na përdornin.
Dialogue: 0,0:07:00.02,0:07:05.11,Default,HERTRUDE,0,0,0,,Çdo gjë që doja ma morën, \Nmadje edhe motrën time Rauda!
Dialogue: 0,0:07:05.54,0:07:07.51,Default,HERTRUDE,0,0,0,,Nuk i zë besë më askujt.
Dialogue: 0,0:07:07.51,0:07:10.31,Default,HERTRUDE,0,0,0,,Të gjithë duhet të zhduken!
Dialogue: 0,0:07:10.31,0:07:14.62,Default,HERTRUDE,0,0,0,,Nuk dua asgjë tjetër veçse \Ntë shkatërroj këtë botë të pashpresë!
Dialogue: 0,0:07:14.62,0:07:18.24,Default,HERTRUDE,0,0,0,,Dua të marr hak për motrën dhe prindërit e mi!
Dialogue: 0,0:07:18.62,0:07:21.79,Default,HERTRUDE,0,0,0,,A nuk është kështu? Pse?
Dialogue: 0,0:07:22.22,0:07:26.63,Default,HERTRUDE,0,0,0,,Pse nuk mund të ishim të lumtur? Pse?!
Dialogue: 0,0:07:27.17,0:07:30.38,Default,OLIVIA,0,0,0,,P-Prapëseprapë, kjo është e gabuar.
Dialogue: 0,0:07:30.79,0:07:32.84,Default,OLIVIA,0,0,0,,Ç'të mirë sjell hakmarrja?
Dialogue: 0,0:07:32.84,0:07:36.02,Default,OLIVIA,0,0,0,,Motra jote nuk do ta donte kurrë këtë!
Dialogue: 0,0:07:36.02,0:07:37.14,Default,MARIE,0,0,0,,Mbylle!
Dialogue: 0,0:07:37.39,0:07:40.27,Default,MARIE,0,0,0,,Mbylle gojën, moj ëndërrimtare!
Dialogue: 0,0:07:40.27,0:07:41.99,Default,OLIVIA,0,0,0,,Zonjusha Marie?
Dialogue: 0,0:07:41.99,0:07:45.69,Default,ANGELICA,0,0,0,,Ç-Çfarë po thua?\NMe cilën anë je ti?
Dialogue: 0,0:07:45.69,0:07:48.88,Default,MARIE,0,0,0,,Nuk e di dhe nuk më intereson!
Dialogue: 0,0:07:48.88,0:07:51.32,Default,MARIE,0,0,0,,Këto janë thjesht një tufë \Nmarrëzirash idealiste!
Dialogue: 0,0:07:51.32,0:07:56.33,Default,MARIE,0,0,0,,Hakmarrja është e gabuar? As që më plas! \NKush kujton se je ti?
Dialogue: 0,0:07:56.68,0:07:59.76,Default,MARIE,0,0,0,,Motra e saj nuk do ta donte këtë?
Dialogue: 0,0:07:59.76,0:08:03.54,Default,MARIE,0,0,0,,Paske shumë guxim \Nqë flet në emër të saj!
Dialogue: 0,0:08:03.54,0:08:04.83,Default,OLIVIA,0,0,0,,P-Por...
Dialogue: 0,0:08:04.83,0:08:08.41,Default,MARIE,0,0,0,,Pra ajo duhet të pranojë mjerimin \Ne saj dhe të mos kërkojë hakmarrje?
Dialogue: 0,0:08:08.41,0:08:10.59,Default,MARIE,0,0,0,,A nuk ka ajo të drejtë të jetë e lumtur?
Dialogue: 0,0:08:10.59,0:08:13.29,Default,MARIE,0,0,0,,Po për ndjenjat e saj mendon njeri?!
Dialogue: 0,0:08:14.97,0:08:16.96,Default,MARIE,0,0,0,,Është shumë e lehtë për ty t'i japësh leksione,
Dialogue: 0,0:08:16.96,0:08:20.45,Default,MARIE,0,0,0,,por po t'i humbisje njerëzit e tu të dashur, \Na do ta duroje dot kështu pa bërë zë?
Dialogue: 0,0:08:20.45,0:08:23.28,Default,MARIE,0,0,0,,Nuk do të merrje hak për ta, \Nedhe sikur të ishte e gabuar?
Dialogue: 0,0:08:23.28,0:08:24.98,Default,OLIVIA,0,0,0,,U-Unë...
Dialogue: 0,0:08:25.39,0:08:27.99,Default,MARIE,0,0,0,,A ke përjetuar ndonjëherë \Npendesë të padurueshme?
Dialogue: 0,0:08:27.99,0:08:30.20,Default,MARIE,0,0,0,,A të ka vdekur ndonjëherë ndonjë i dashur?
Dialogue: 0,0:08:30.20,0:08:31.99,Default,MARIE,0,0,0,,Nuk arrin t'i shohësh më kurrë!
Dialogue: 0,0:08:33.04,0:08:38.74,Default,MARIE,0,0,0,,Të dhemb kur të vdesin njerëzit \Nqë do. Të dhemb me të vërtetë!
Dialogue: 0,0:08:39.06,0:08:43.62,Default,ANGELICA,0,0,0,,P-Prit pak. Tani për tani, prioriteti \Nynë është të ndalim atë përbindësh.
Dialogue: 0,0:08:43.62,0:08:45.08,Default,MARIE,0,0,0,,Pusho!
Dialogue: 0,0:08:45.30,0:08:49.13,Default,MARIE,0,0,0,,Nëse mjafton kaq pak për të shkatërruar \Nkëtë botë, atëherë them le të shkatërrohet!
Dialogue: 0,0:08:49.50,0:08:54.52,Default,MARIE,0,0,0,,E di që është e gabuar dhe që nuk \Nduhet ta lëmë të ndodhë, por...
Dialogue: 0,0:08:54.52,0:08:58.28,Default,MARIE,0,0,0,,por prapëseprapë nuk e ndalim dot!
Dialogue: 0,0:09:41.72,0:09:48.77,Default,HERTRUDE,0,0,0,,Nuk e mendoja kurrë se Shenjtorja që mendon \Nvetëm për para do të më mbronte mua.
Dialogue: 0,0:09:50.04,0:09:51.67,Default,MARIE,0,0,0,,Nuk po të mbroj ty.
Dialogue: 0,0:09:51.67,0:09:56.39,Default,MARIE,0,0,0,,Thjesht nuk i duroj dot ato të dyja dhe \Nsindromën e tyre të protagonistes kryesore.
Dialogue: 0,0:09:59.13,0:10:03.04,Default,HERTRUDE,0,0,0,,Nuk do të isha ndier kurrë \Nkështu po të mos ishe ti.
Dialogue: 0,0:10:03.93,0:10:07.12,Default,MARIE,0,0,0,,A je vërtet e pajtuar me këtë, gjithsesi?
Dialogue: 0,0:10:07.43,0:10:08.80,Default,HERTRUDE,0,0,0,,Jo.
Dialogue: 0,0:10:10.06,0:10:11.59,Default,HERTRUDE,0,0,0,,Aspak.
Dialogue: 0,0:10:13.28,0:10:14.17,Default,HERTRUDE,0,0,0,,Por...
Dialogue: 0,0:10:19.45,0:10:23.10,Default,HERTRUDE,0,0,0,,Shpejt. Largohuni nga unë.
Dialogue: 0,0:10:24.50,0:10:25.63,Default,ANGELICA,0,0,0,,Çfarë ka?
Dialogue: 0,0:10:25.63,0:10:30.25,Default,HERTRUDE,0,0,0,,Çmimi i thirrjes së mbrojtësve me \Nkëtë fyell është jeta e përdoruesit.
Dialogue: 0,0:10:30.58,0:10:32.53,Default,HERTRUDE,0,0,0,,Tani që e theva marrëveshjen,
Dialogue: 0,0:10:33.43,0:10:38.69,Default,HERTRUDE,0,0,0,,nuk do të mund t'i bie më kurrë, \Ndhe mbrojtësi do të përpiqet të më vrasë.
Dialogue: 0,0:10:39.11,0:10:40.33,Default,ANGELICA,0,0,0,,Çfarë?
Dialogue: 0,0:10:40.83,0:10:41.99,Default,OLIVIA,0,0,0,,P-Por...
Dialogue: 0,0:10:42.51,0:10:46.41,Default,HERTRUDE,0,0,0,,Dhe principata do të dorëzohet.
Dialogue: 0,0:10:54.42,0:10:56.13,Default,CLEARE,0,0,0,,Largohuni të gjithë!
Dialogue: 0,0:11:00.47,0:11:01.78,Default,ANGELICA,0,0,0,,Livia, je mirë?
Dialogue: 0,0:11:01.78,0:11:02.79,Default,HERTRUDE,0,0,0,,Vandel!
Dialogue: 0,0:11:03.50,0:11:04.64,Default,LEON,0,0,0,,Çfarë po ndodh?
Dialogue: 0,0:11:05.01,0:11:07.02,Default,LEON,0,0,0,,Çfarë po bëjnë këta këtu?
Dialogue: 0,0:11:09.13,0:11:11.12,Default,LEON,0,0,0,,Edhe zonjusha Hertrude qenka këtu?
Dialogue: 0,0:11:17.12,0:11:19.22,Default,HERTRUDE,0,0,0,,Vandel, mjaft më!
Dialogue: 0,0:11:19.22,0:11:22.28,Default,HERTRUDE,0,0,0,,Fanoss-i shpalli përfundimin e luftimeve!
Dialogue: 0,0:11:22.98,0:11:26.79,Default,VANDEL,0,0,0,,Princeshë, mos u shqetësoni.
Dialogue: 0,0:11:26.79,0:11:29.42,Default,VANDEL,0,0,0,,Do ta vras atë horr në këtë çast.
Dialogue: 0,0:11:31.83,0:11:35.79,Default,VANDEL,0,0,0,,Do t'i zhduk plotësisht forcat e mbretërisë.
Dialogue: 0,0:11:35.79,0:11:39.55,Default,HERTRUDE,0,0,0,,Jo! Mori fund, Vandel!
Dialogue: 0,0:11:41.77,0:11:43.48,Default,VANDEL,0,0,0,,Princeshë...
Dialogue: 0,0:11:53.59,0:11:57.74,Flashback,HERTAUDA,0,0,0,,{\an8}Baba, Nënë...
Dialogue: 0,0:11:54.34,0:11:58.57,Flashback,VANDEL,0,0,0,,A jeni të sigurt se kjo ishte zgjedhja e duhur?
Dialogue: 0,0:11:59.00,0:12:03.80,Flashback,GELATT,0,0,0,,Si populli ashtu edhe fisnikëria \Ndëshirojnë të luftojnë kundër mbretërisë,
Dialogue: 0,0:12:03.80,0:12:08.47,Flashback,GELATT,0,0,0,,ja përse mbreti dhe \Nmbretëresha duhej të largoheshin.
Dialogue: 0,0:12:09.11,0:12:11.65,Flashback,GELATT,0,0,0,,Nuk ka kuptim të qani për këtë tani.
Dialogue: 0,0:12:11.65,0:12:15.05,Flashback,GELATT,0,0,0,,Do të keni mundësinë të hakmerreni për familjen tuaj.
Dialogue: 0,0:12:15.45,0:12:19.45,Flashback,GELATT,0,0,0,,Nëse jeni një kalorës i principatës, \Nharrojini pendesat tuaja të kota.
Dialogue: 0,0:12:29.35,0:12:30.30,Flashback,VANDEL,0,0,0,,Princeshë.
Dialogue: 0,0:12:35.16,0:12:36.25,Flashback,HERTRUDE,0,0,0,,Vandel...
Dialogue: 0,0:12:37.98,0:12:46.59,Flashback,VANDEL,0,0,0,,Mos u shqetësoni. Do të luftoj për ju dhe \Nmotrën tuaj në vend të prindërve tuaj.
Dialogue: 0,0:12:48.43,0:12:50.62,Flashback,HERTRAUDA,0,0,0,,Vandel...
Dialogue: 0,0:12:52.84,0:12:54.77,Flashback,VANDEL,0,0,0,,Bëj betim mbi këtë shpatë...
Dialogue: 0,0:12:58.77,0:13:00.63,Default,VANDEL,0,0,0,,Kjo nuk mund të marrë fund.
Dialogue: 0,0:13:00.90,0:13:04.13,Default,VANDEL,0,0,0,,Ky nuk mund të jetë fundi!
Dialogue: 0,0:13:04.42,0:13:05.41,Default,HERTRUDE,0,0,0,,Vandel...
Dialogue: 0,0:13:06.64,0:13:10.19,Default,VANDEL,0,0,0,,Do të vazhdoj të luftoj edhe pas vdekjes sime.
Dialogue: 0,0:13:10.19,0:13:13.59,Default,VANDEL,0,0,0,,Vetëm kaq mund të bëj për të shlyer mëkatet.
Dialogue: 0,0:13:13.59,0:13:15.69,Default,VANDEL,0,0,0,,Ky është...
Dialogue: 0,0:13:18.15,0:13:21.65,Default,VANDEL,0,0,0,,kodi im i kalorësisë!
Dialogue: 0,0:13:29.09,0:13:32.41,Default,LEON,0,0,0,,Maskara!
Dialogue: 0,0:13:52.28,0:13:54.20,Default,LEON,0,0,0,,Dreqin!
Dialogue: 0,0:13:58.75,0:13:59.91,Default,LEON,0,0,0,,Luxion!
Dialogue: 0,0:14:00.88,0:14:02.96,Default,VANDEL,0,0,0,,Mallkuar qofsh!
Dialogue: 0,0:14:05.07,0:14:07.79,Default,LEON,0,0,0,,Më fal, o plak.
Dialogue: 0,0:14:10.82,0:14:12.05,Default,LUXIN,0,0,0,,Goditje.
Dialogue: 0,0:14:26.08,0:14:27.17,Default,HERTRUDE,0,0,0,,Vandel!
Dialogue: 0,0:14:42.53,0:14:47.19,Default,HERTRUDE,0,0,0,,Vandel! Vandel! Vandel!
Dialogue: 0,0:14:47.19,0:14:48.48,Default,HERTRUDE,0,0,0,,Vandel!
Dialogue: 0,0:14:49.43,0:14:52.01,Default,VANDEL,0,0,0,,P-Princeshë...
Dialogue: 0,0:14:52.68,0:14:56.70,Default,VANDEL,0,0,0,,Ky është fundi për mua.
Dialogue: 0,0:14:57.08,0:15:00.33,Default,HERTRUDE,0,0,0,,Të lutem, mos më lër vetëm.
Dialogue: 0,0:15:01.53,0:15:03.99,Default,VANDEL,0,0,0,,Princeshë...
Dialogue: 0,0:15:03.99,0:15:05.71,Default,MARIE,0,0,0,,Hej, ti!
Dialogue: 0,0:15:05.98,0:15:07.71,Default,MARIE,0,0,0,,Mos vdis ende!
Dialogue: 0,0:15:07.99,0:15:11.51,Default,ANGELICA,0,0,0,,Çfarë po thua? \NAi është Kalorësi i Zi!
Dialogue: 0,0:15:11.74,0:15:17.47,Default,MARIE,0,0,0,,E di shumë mirë! Sa herë kujton \Nse më ka rrahur? Megjithatë...
Dialogue: 0,0:15:20.48,0:15:23.48,Default,MARIE,0,0,0,,A do ta lash atë krejtësisht vetëm?
Dialogue: 0,0:15:29.09,0:15:34.76,Italics,VANDEL/ID,0,0,0,,Paska njerëz në mbretëri \Nqë kujdesen për princeshën.
Dialogue: 0,0:15:35.23,0:15:37.13,Italics,VANDEL/ID,0,0,0,,Tani më në fund mund të...
Dialogue: 0,0:15:49.63,0:15:51.44,Italics,VANDEL/ID,0,0,0,,Humba.
Dialogue: 0,0:15:52.93,0:15:56.03,Default,VANDEL,0,0,0,,Princeshë, ju lutem...
Dialogue: 0,0:15:57.68,0:15:58.66,Default,HERTRUDE,0,0,0,,Vandel...
Dialogue: 0,0:16:01.89,0:16:03.80,Default,VANDEL,0,0,0,,Jini e lumtur.
Dialogue: 0,0:16:07.39,0:16:08.46,Default,HERTRUDE,0,0,0,,Vandel!
Dialogue: 0,0:16:31.63,0:16:34.07,Default,HERTRUDE,0,0,0,,Mos humbisni asnjë çast.
Dialogue: 0,0:16:34.07,0:16:37.27,Default,HERTRUDE,0,0,0,,Nëse nuk largoheni shpejt nga këtu, \Ndo t'ju vrasin edhe ju.
Dialogue: 0,0:16:38.20,0:16:39.56,Default,OLIVIA,0,0,0,,Por...
Dialogue: 0,0:16:40.89,0:16:42.93,Default,CLEARE,0,0,0,,Hajdeni, ju të dyja.
Dialogue: 0,0:16:42.93,0:16:44.75,Default,CLEARE,0,0,0,,Shpejt, ju lutem.
Dialogue: 0,0:16:51.05,0:16:52.41,Default,HERTRUDE,0,0,0,,Jepi fund kësaj.
Dialogue: 0,0:17:08.20,0:17:11.71,Default,HERTRUDE,0,0,0,,Leon Fou Bartfort...
Dialogue: 0,0:17:11.98,0:17:14.65,Default,LEON,0,0,0,,Dhe tani, çfarë të bëj?
Dialogue: 0,0:17:14.65,0:17:18.97,Default,LUXION,0,0,0,,Pak gjëra mund të bëhen kundër një \Narmiku që rigjenerohet pafundësisht.
Dialogue: 0,0:17:19.22,0:17:21.91,Default,LUXION,0,0,0,,Olivia është shumë e dobësuar.
Dialogue: 0,0:17:21.91,0:17:22.97,Default,CLEARE,0,0,0,,Luxion.
Dialogue: 0,0:17:23.84,0:17:24.67,Default,LEON,0,0,0,,Çfarë ka?
Dialogue: 0,0:17:26.50,0:17:27.62,Default,LUXION,0,0,0,,U kuptua.
Dialogue: 0,0:17:28.48,0:17:32.48,Default,LUXION,0,0,0,,Anija kryesore është jashtë rrezez, \Nndaj do të mbledh energji në Arroganz.
Dialogue: 0,0:17:32.94,0:17:34.99,Default,LEON,0,0,0,,Jashtë rrezez? Për çfarë?
Dialogue: 0,0:17:39.09,0:17:40.88,Default,LUXION,0,0,0,,Për fuqinë e Olivia-s.
Dialogue: 0,0:17:42.14,0:17:43.50,Default,OLIVIA,0,0,0,,Zoti Leon...
Dialogue: 0,0:17:44.75,0:17:46.72,Default,LEON,0,0,0,,Livia... Angie...
Dialogue: 0,0:17:47.83,0:17:50.56,Default,LUXION,0,0,0,,Do të shtoj gjatësinë e valës së Olivia-s \Nnë sulmin tënd.
Dialogue: 0,0:17:56.23,0:17:59.07,Default,LEON,0,0,0,,Është koha t'i japim gjithçka ose ta lëmë fare.
Dialogue: 0,0:18:07.90,0:18:09.35,Default,MASKED KNIGHT,0,0,0,,Mos i lini të afrohen!
Dialogue: 0,0:18:09.35,0:18:11.08,Default,IDIOTS,0,0,0,,Mos na urdhëro çfarë të bëjmë!
Dialogue: 0,0:18:26.94,0:18:28.01,Default,LUXION,0,0,0,,E shkëlqyer.
Dialogue: 0,0:19:06.57,0:19:09.33,Default,HERTRUDE,0,0,0,,Ai më shpëtoi mua?
Dialogue: 0,0:19:10.82,0:19:12.11,Default,SOLDIERS,0,0,0,,E mposhti!
Dialogue: 0,0:19:12.11,0:19:13.28,Default,SOLDIERS,0,0,0,,Po!
Dialogue: 0,0:19:15.24,0:19:18.11,Default,LEON,0,0,0,,Më në fund e mposhtëm bosin përfundimtar.
Dialogue: 0,0:19:18.11,0:19:21.05,Default,LUXION,0,0,0,,Megjithatë, Arroganz ka arritur kufirin e tij.
Dialogue: 0,0:19:26.23,0:19:27.27,Default,ANGELICA,0,0,0,,Leon!
Dialogue: 0,0:19:30.93,0:19:32.14,Default,CLEARE,0,0,0,,O zot.
Dialogue: 0,0:19:47.86,0:19:51.54,Default,LEON,0,0,0,,Hej, a veprova siç duhet?
Dialogue: 0,0:19:53.33,0:19:58.47,Default,LEON,0,0,0,,Thashë se doja të bëja një jetë \Ntë qetë si personazh dytësor,
Dialogue: 0,0:19:59.65,0:20:01.86,Default,LEON,0,0,0,,por përfunduan duke vdekur një mori njerëzish.
Dialogue: 0,0:20:02.55,0:20:04.25,Default,LEON,0,0,0,,Edhe unë vrava një mori njerëzish.
Dialogue: 0,0:20:05.63,0:20:10.89,Default,LEON,0,0,0,,Sikur të isha protagonisti i një historie, \Nmund të kisha bërë një punë më të mirë.
Dialogue: 0,0:20:12.89,0:20:15.21,Default,LUXION,0,0,0,,Po e mbivlerësoni rëndësinë tuaj.
Dialogue: 0,0:20:15.21,0:20:20.90,Default,LUXION,0,0,0,,Lufta do të ndodhte në çdo rast, \Ndhe askush nuk priste shumë nga ju.
Dialogue: 0,0:20:23.99,0:20:25.34,Default,LEON,0,0,0,,Je vërtet i poshtër.
Dialogue: 0,0:20:28.15,0:20:31.06,Default,LEON,0,0,0,,Pra qenkam thjesht një personazh dytësor.
Dialogue: 0,0:20:32.26,0:20:35.18,Default,LEON,0,0,0,,Sidoqoftë, çudi që fituam.
Dialogue: 0,0:20:35.92,0:20:40.76,Default,LUXION,0,0,0,,A nuk ndodhi kjo sepse kjo është bota \Ne asaj që ju e quani 'lojë otome'?
Dialogue: 0,0:20:41.70,0:20:44.07,Default,LEON,0,0,0,,Hë? Çfarë do të thuash?
Dialogue: 0,0:20:44.96,0:20:48.55,Default,LUXION,0,0,0,,Gjithmonë ankoheni për këtë \Nduke lëshuar fjalë fyese.
Dialogue: 0,0:20:49.23,0:20:52.51,Default,LUXION,0,0,0,,Për atë se si 'dashuria do ta shpëtojë botën'.
Dialogue: 0,0:21:09.05,0:21:10.22,Default,ANGELICA,0,0,0,,Leon!
Dialogue: 0,0:21:10.22,0:21:11.82,Default,OLIVIA,0,0,0,,Zoti Leon!
Dialogue: 0,0:21:12.52,0:21:14.79,Default,LEON,0,0,0,,Angie, Livia.
Dialogue: 0,0:21:16.90,0:21:21.34,Default,LUXION,0,0,0,,Mund të jeni personazh dytësor, por dashuria e tyre është e vërtetë.
Dialogue: 0,0:21:21.95,0:21:25.12,Default,LUXION,0,0,0,,E vërteta është se dashuria i dha fund luftimeve.
Dialogue: 0,0:21:26.28,0:21:29.80,Default,LUXION,0,0,0,,A nuk erdhi koha që \Ntë merrni vendimin tuaj?
Dialogue: 0,0:21:30.79,0:21:33.47,Default,LUXION,0,0,0,,I doni ato, apo jo?
Dialogue: 0,0:21:34.76,0:21:36.73,Default,LEON,0,0,0,,Nuk e kupton ti.
Dialogue: 0,0:21:37.90,0:21:42.17,Default,LEON,0,0,0,,Dua të kujdesem mirë për \Nato {\i1}sepse{\i0} i dua.
Dialogue: 0,0:21:44.58,0:21:49.21,Italics,LEON/ID,0,0,0,,Nuk e kisha menduar se çfarë \Ndo të thoja, por tani për tani...
Dialogue: 0,0:21:52.01,0:21:53.28,Default,LEON,0,0,0,,U ktheva.
Dialogue: 0,0:23:26.25,0:23:29.53,Default,LEON,0,0,0,,Luftimet morën fund, paqja u rivendos, \Ndhe vëllai im u fejua?
Dialogue: 0,0:23:29.53,0:23:30.26,Default,LUXION,0,0,0,,Zotëri.
Dialogue: 0,0:23:30.26,0:23:32.59,Default,LEON,0,0,0,,Ulërimat e Leon-it jehojnë përmes \Nnjë të ardhmeje të pashmangshme!
Dialogue: 0,0:23:32.82,0:23:33.76,Default,LUXION,0,0,0,,Zotëri?
Dialogue: 0,0:23:33.76,0:23:36.28,Default,LEON,0,0,0,,Episodi i fundit: \N'Kjo Botë Është e Vështirë për Personazhet Dytësore'.
Dialogue: 0,0:23:36.60,0:23:39.93,Default,LEON,0,0,0,,Bosi i fundit i jetës janë ngjarjet romantike!

