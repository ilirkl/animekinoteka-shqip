Dialogue: 0,0:01:30.23,0:01:32.98,Default,sign,0,0,0,,{\fad(310,230)\bord1.5\shad0\blur\fnArial Black\4c&HABBFBC&\pos(320,305)}Poker me 17 letra — Dora e katërt
Dialogue: 0,0:01:36.74,0:01:42.24,Default,sign,0,0,0,,{\fad(390,350)\shad0\fnArial\an3\blur2\fs17\b1\pos(600,307)\c&H2D6E87&}K{\c&H0F00A1&}undërsulmi
Dialogue: 0,0:01:37.12,0:01:38.06,Main - Top,Nishida,0,0,0,,Hë?
Dialogue: 0,0:01:38.06,0:01:43.30,Main - Top,Nishida,0,0,0,,Kikuchi tha se po ta dinte ku ishte\Nxholi, do ta kishte fitoren të sigurt...
Dialogue: 0,0:01:43.30,0:01:44.87,Default,Nishida,0,0,0,,Kaq shumë të ndihmon kjo?
Dialogue: 0,0:01:45.16,0:01:47.63,Default,Nishida,0,0,0,,Këtë dorë, Akiyama e preu i dyti pakon,
Dialogue: 0,0:01:47.63,0:01:50.41,Default,Nishida,0,0,0,,pra kanë të njëjtat gjasa\Npër ta marrë xholin, apo jo?
Dialogue: 0,0:01:50.41,0:01:51.53,Default,Kosaka,0,0,0,,Ashtu është.
Dialogue: 0,0:01:51.88,0:01:55.94,Default,Kosaka,0,0,0,,Madje, për momentin, xholi\Nnuk është në dorën e Kikuchi-t.
Dialogue: 0,0:01:55.94,0:01:56.93,Default,Nishida,0,0,0,,Apo jo?
Dialogue: 0,0:01:57.14,0:02:00.55,Default,Nishida,0,0,0,,Edhe nëse xholi nuk i bie\Nasnjërit që në fillim,
Dialogue: 0,0:02:00.55,0:02:03.27,Default,Nishida,0,0,0,,gjasat që njëri apo tjetri\Nta tërheqë nga pakoja
Dialogue: 0,0:02:03.27,0:02:05.14,Default,Nishida,0,0,0,,mbeten pesëdhjetë me pesëdhjetë.
Dialogue: 0,0:02:05.14,0:02:06.41,Default,Kosaka,0,0,0,,E ke gabim.
Dialogue: 0,0:02:07.50,0:02:11.04,Default,Kosaka,0,0,0,,Kur Kikuchi tërheq letra i pari,
Dialogue: 0,0:02:11.04,0:02:14.89,Default,Kosaka,0,0,0,,është 100% e sigurt\Nqë Akiyama s'e merr xholin.
Dialogue: 0,0:02:16.22,0:02:19.90,Default,Kosaka,0,0,0,,Ta zëmë se xholi është\Nletra e parë e pakos.
Dialogue: 0,0:02:20.09,0:02:23.26,Default,Kosaka,0,0,0,,Kikuchi e di që ajo është xholi,
Dialogue: 0,0:02:23.26,0:02:26.64,Default,Kosaka,0,0,0,,ndaj, nëse tërheq i pari,\Ne merr me siguri.
Dialogue: 0,0:02:27.39,0:02:29.33,Default,Nishida,0,0,0,,Deri këtu e kuptoj, por...
Dialogue: 0,0:02:29.70,0:02:32.17,Main - Italics,Dealer,0,0,0,,Tani mund të ndërroni letrat.
Dialogue: 0,0:02:32.34,0:02:33.47,Default,Dealer,0,0,0,,Zoti Kikuchi?
Dialogue: 0,0:02:34.05,0:02:37.42,Default,Kikuchi,0,0,0,,Atëherë, i ndërroj të pesta.
Dialogue: 0,0:02:37.42,0:02:39.62,Default,Nishida,0,0,0,,Të gjitha letrat?! Pse?!
Dialogue: 0,0:02:39.62,0:02:42.26,Default,Kosaka,0,0,0,,Sepse xholi është letra e pestë.
Dialogue: 0,0:02:45.69,0:02:46.98,Default,Kosaka,0,0,0,,Tani e kupton, apo jo?
Dialogue: 0,0:02:46.98,0:02:49.83,Default,Kosaka,0,0,0,,Nëse xholi është mes pesë të parave,
Dialogue: 0,0:02:49.83,0:02:52.85,Default,Kosaka,0,0,0,,Kikuchi mund ta marrë gjithmonë.
Dialogue: 0,0:02:53.21,0:02:59.34,Default,Nishida,0,0,0,,Po nëse është letra e gjashtë\Nose e shtatë, s'e merr Akiyama?
Dialogue: 0,0:02:59.34,0:03:00.85,Default,Kosaka,0,0,0,,Vështirë.
Dialogue: 0,0:03:00.85,0:03:06.00,Default,Kosaka,0,0,0,,Në pokerin me 17 letra, dora\Nmë e dobët në fillim është një çift.
Dialogue: 0,0:03:06.00,0:03:10.87,Default,Kosaka,0,0,0,,Pra, vështirë se Akiyama\Ndo të kërkojë më shumë se tri letra.
Dialogue: 0,0:03:10.87,0:03:12.35,Default,Nishida,0,0,0,,E kuptova!
Dialogue: 0,0:03:12.35,0:03:14.97,Default,Nishida,0,0,0,,Kikuchi mund të kërkojë një ose dy.
Dialogue: 0,0:03:14.97,0:03:19.09,Default,Nishida,0,0,0,,Pastaj, meqë kundërshtari\Ns'do të marrë më shumë se tri,
Dialogue: 0,0:03:19.09,0:03:21.37,Default,Nishida,0,0,0,,dy letrat e fundit mbeten pa prekur!
Dialogue: 0,0:03:21.37,0:03:24.13,Default,Kosaka,0,0,0,,Pra, kudo që të jetë\Nxholi në pako,
Dialogue: 0,0:03:24.13,0:03:26.52,Default,Kosaka,0,0,0,,Akiyama s'ka për ta marrë.
Dialogue: 0,0:03:26.77,0:03:30.89,Default,Kosaka,0,0,0,,Kikuchi ka shumë më tepër\Ngjasa për ta marrë xholin.
Dialogue: 0,0:03:31.23,0:03:35.09,Default,Nishida,0,0,0,,Po a s'është pak me rrezik\Nt'i ndërrojë të gjitha letrat?
Dialogue: 0,0:03:35.09,0:03:36.72,Default,Kosaka,0,0,0,,Aspak.
Dialogue: 0,0:03:36.72,0:03:40.15,Default,Kosaka,0,0,0,,Në ndërrimin e fundit, Akiyama mori dy.
Dialogue: 0,0:03:40.15,0:03:43.37,Default,Kosaka,0,0,0,,Pra, janë përdorur\Ntë shtatëmbëdhjetë letrat.
Dialogue: 0,0:03:43.93,0:03:45.05,Default,Nishida,0,0,0,,Ashtu është...
Dialogue: 0,0:03:45.05,0:03:49.02,Default,Kosaka,0,0,0,,Nga ato shtatëmbëdhjetë,\NKikuchi ka parë dhjetë.
Dialogue: 0,0:03:49.02,0:03:53.57,Default,Kosaka,0,0,0,,Nga këto, mund të nxjerrë\Nshtatë letrat që ka parë kundërshtari.
Dialogue: 0,0:03:54.43,0:03:57.11,Default,Kosaka,0,0,0,,Sido që t'i kombinosh\Nato shtatë letra,
Dialogue: 0,0:03:57.11,0:03:58.87,Default,Kosaka,0,0,0,,maksimumi që mund të ketë janë dy çifte.
Dialogue: 0,0:03:58.87,0:04:01.18,Default,Kosaka,0,0,0,,Fitorja e Kikuchi-t është e sigurt.
Dialogue: 0,0:04:01.67,0:04:03.51,Default,Dealer,0,0,0,,Hapini letrat!
Dialogue: 0,0:04:05.76,0:04:07.76,Default,sign,0,0,0,,{\bord1.5\fad(270,1)\fnTimes New Roman\b1\fs18\shad0\an7\c&H5900E2&\3c&H0C0031&}Lindja - Dy çifte
Dialogue: 0,0:04:05.76,0:04:07.76,Default,sign,0,0,0,,{\\bord1.5\fad(270,1)\fnTimes New Roman\b1\fs18\shad0\c&HF6F1B2&\3c&H151206&\an9}Perëndimi - Treshe
Dialogue: 0,0:04:07.79,0:04:08.82,Default,Kikuchi,0,0,0,,Po!
Dialogue: 0,0:04:08.82,0:04:11.26,Main - Italics,Solario,0,0,0,,Kikuchi fiton dorën e katërt.
Dialogue: 0,0:04:11.27,0:04:14.27,Default,sign,0,0,0,,{\an8\fnArial Black\c&HEBEBEB&\3c&H12181A&\4c&H12181A&}Diferenca në zhetonë
Dialogue: 0,0:04:11.27,0:04:14.27,Default,sign,0,0,0,,{\shad0\bord0\fnArial Black\c&HEBEBEB&\3c&H12181A&\4c&H12181A&\pos(339.128,145.631)}zhetonë
Dialogue: 0,0:04:11.27,0:04:14.27,Default,sign,0,0,0,,{\shad0\an1\fnArial Black\c&H451C8A&\3c&HF3F0EF&\4c&H12181A&\pos(386.267,228.8)}Lindja {\bord0\c&HF7F3F1&}kryeson
Dialogue: 0,0:04:11.48,0:04:14.27,Main - Italics,Solario,0,0,0,,Njëzet zhetonë i shkojnë Perëndimit.
Dialogue: 0,0:04:16.64,0:04:18.95,Default,Dealer,0,0,0,,Tani fillojmë dorën e pestë.
Dialogue: 0,0:04:25.57,0:04:27.28,Default,Nao,0,0,0,,Mori xholin!
Dialogue: 0,0:04:27.28,0:04:29.07,Default,Nao,0,0,0,,Dhe ka katërshe!
Dialogue: 0,0:04:29.39,0:04:31.88,Default,Dealer,0,0,0,,Zoti Kikuchi, ju vini bast i pari.
Dialogue: 0,0:04:33.43,0:04:34.46,Default,Kikuchi,0,0,0,,Tërhiqem.
Dialogue: 0,0:04:36.14,0:04:39.47,Main - Italics,Solario,0,0,0,,Dora e pestë mbyllet pa përfunduar.
Dialogue: 0,0:04:39.47,0:04:41.98,Main - Italics,Solario,0,0,0,,Të dyja hyrjet me nga pesë zhetonë i merr krupieri.
Dialogue: 0,0:04:41.98,0:04:44.72,Main - Italics,Solario,0,0,0,,Diferenca në zhetonë nuk ndryshon.
Dialogue: 0,0:04:39.46,0:04:44.72,Default,sign,0,0,0,,{\frx15\an8\fnArial Black\c&HEBEBEB&\3c&H12181A&\4c&H12181A&}Diferenca në zhetonë
Dialogue: 0,0:04:39.46,0:04:44.72,Default,sign,0,0,0,,{\frx15\shad0\bord0\fnArial Black\c&HEBEBEB&\3c&H12181A&\4c&H12181A&\pos(344.666,135.785)}zhetonë
Dialogue: 0,0:04:39.46,0:04:44.72,Default,sign,0,0,0,,{\frx15\shad0\an1\fnArial Black\fs20\c&H451C8A&\3c&HF3F0EF&\4c&H12181A&\pos(389.344,197.415)}Lindja {\bord0\c&HF7F3F1&}kryeson
Dialogue: 0,0:04:45.74,0:04:47.60,Default,Nao,0,0,0,,Kishim një dorë kaq të mirë...
Dialogue: 0,0:04:47.84,0:04:51.84,Default,Nao,0,0,0,,Ç'të bëjmë? Ata zhetonë të çmuar\Ni mori krupieri...
Dialogue: 0,0:04:52.11,0:04:53.35,Default,Nishida,0,0,0,,Çfarë ndodhi?
Dialogue: 0,0:04:53.35,0:04:55.85,Default,Kosaka,0,0,0,,Kundërshtari mori xholin.
Dialogue: 0,0:04:56.13,0:04:59.39,Default,Kosaka,0,0,0,,Duke u tërhequr, siguron barazimin.
Dialogue: 0,0:04:59.39,0:05:03.23,Default,Kosaka,0,0,0,,Dhe meqë u tërhoq, në dorën tjetër\Ndo ta presë pakon i dyti.
Dialogue: 0,0:05:03.23,0:05:06.90,Default,Kosaka,0,0,0,,Kështu mund të bëjë që xholi\Nt'i bjerë që në fillim.
Dialogue: 0,0:05:06.90,0:05:08.35,Default,Nishida,0,0,0,,E kuptova.
Dialogue: 0,0:05:08.74,0:05:10.62,Default,sign,0,0,0,,{\fad(310,1)\bord1.5\shad0\blur\fnArial Black\4c&HABBFBC&\pos(320,305)}Dora e gjashtë
Dialogue: 0,0:05:14.12,0:05:15.21,Default,Kosaka,0,0,0,,E sheh?
Dialogue: 0,0:05:15.56,0:05:16.97,Default,Nishida,0,0,0,,E pabesueshme.
Dialogue: 0,0:05:16.97,0:05:19.52,Default,Dealer,0,0,0,,Raundi i parë i basteve përfundoi.
Dialogue: 0,0:05:19.52,0:05:22.23,Default,Dealer,0,0,0,,Tani, hapini letrat!
Dialogue: 0,0:05:22.34,0:05:24.46,Default,sign,0,0,0,,{\bord1.5\fad(270,1)\fnTimes New Roman\b1\fs18\shad0\c&HF6F1B2&\3c&H151206&\an7}Perëndimi - Katërshe
Dialogue: 0,0:05:22.34,0:05:24.46,Default,sign,0,0,0,,{\bord1.5\fad(270,1)\fnTimes New Roman\b1\fs18\shad0\an9\c&H5900E2&\3c&H0C0031&}Lindja - Full
Dialogue: 0,0:05:24.69,0:05:25.59,Default,Kikuchi,0,0,0,,Po!
Dialogue: 0,0:05:25.59,0:05:27.97,Main - Italics,Solario,0,0,0,,Perëndimi fiton edhe\Ndorën e gjashtë.
Dialogue: 0,0:05:27.97,0:05:30.85,Default,sign,0,0,0,,{\an8\fnArial Black\c&HEBEBEB&\3c&H12181A&\4c&H12181A&\pos(368,38.308)\frz346.7}Diferenca në zhetonë
