Dialogue: 0,0:00:06.88,0:00:07.85,Main,Alicia,0,0,0,,Prit!
Dialogue: 0,0:00:08.02,0:00:09.36,Main,Alicia,0,0,0,,Baba!
Dialogue: 0,0:00:09.36,0:00:11.12,Main,Margo,0,0,0,,Çfarë ke, Alicia?
Dialogue: 0,0:00:11.12,0:00:13.61,Main,Margo,0,0,0,,S'kam përdorur as gjysmën e forcës sime ende!
Dialogue: 0,0:00:13.61,0:00:16.03,Italics,Alicia,0,0,0,,Dreqi! Edhe zëri i tij është i njëjtë!
Dialogue: 0,0:00:16.03,0:00:18.03,Italics,Alicia,0,0,0,,Zëri i babait tim të butë...
Dialogue: 0,0:00:19.83,0:00:21.74,Main,Margo,0,0,0,,Fluturoje, Alicia!
Dialogue: 0,0:02:12.44,0:02:14.99,Sign_Basic,Sign,0,0,0,,{\fad(1375,0)\pos(320,20)\an8\fnImpact\b1\fs40\bord0\shad0\3c&HDFEAEB&\3a&HFF&\c&H261DAA&\bord1\3a&H33&)}C{\fs38}L{\fs36}E{\fs34}V{\fs32}A{\fs34}T{\fs36}E{\fs38}S{\fs40}S
Dialogue: 0,0:00:24.63,0:00:28.63,Episode_Title,Sign,0,0,0,,{\pos(505,115)\an8}Episodi 11\N{\fscy150}Çfarë Pasqyrohet në Pasqyrë
Dialogue: 0,0:00:29.49,0:00:34.05,Main,Klen,0,0,0,,E di përse erdha pa ta \Nthënë, apo jo Vordin?
Dialogue: 0,0:00:34.63,0:00:36.12,Main,Klen,0,0,0,,Erdhi koha t'i japim fund kësaj.
Dialogue: 0,0:00:36.64,0:00:38.97,Main,Vordin,0,0,0,,S'ke nevojë për fjalë, ë?
Dialogue: 0,0:02:34.97,0:02:36.86,Main,Klen,0,0,0,,Një gërmadhë e lashtë?
Dialogue: 0,0:02:37.29,0:02:40.35,Main,Klen,0,0,0,,Ky vend duhet të jetë i veçantë, në fund të fundit.
Dialogue: 0,0:02:41.32,0:02:43.72,Main,Klen,0,0,0,,Mund të përdor fuqinë e territorit tim.
Dialogue: 0,0:02:44.08,0:02:47.99,Main,Klen,0,0,0,,Kushti për të hyrë është \Ntë jesh në formë njerëzore, apo jo?
Dialogue: 0,0:02:48.25,0:02:51.11,Main,Klen,0,0,0,,Për këtë arsye ke atë formë, apo jo?
Dialogue: 0,0:02:51.81,0:02:55.44,Main,Vordin,0,0,0,,Ky nuk është vendi yt.
Dialogue: 0,0:02:55.94,0:02:58.69,Main,Vordin,0,0,0,,Mos më dil përpara.
Dialogue: 0,0:02:58.96,0:03:02.68,Main,Klen,0,0,0,,Ti ishe ai që më doli përpara mua.
Dialogue: 0,0:03:03.03,0:03:07.07,Main,Klen,0,0,0,,Territori im ishte shtrirë tashmë deri në Hiderat.
Dialogue: 0,0:03:07.07,0:03:11.83,Main,Klen,0,0,0,,E kisha lënë vetëm \Nsepse thjesht nuk më interesonte.
Dialogue: 0,0:03:12.15,0:03:15.84,Main,Klen,0,0,0,,Por nuk duroj dot që dikush \Njashtë territorit tim të ndërhyjë.
Dialogue: 0,0:03:16.04,0:03:19.09,Main,Vordin,0,0,0,,Siç e mendova, nuk e vure re.
Dialogue: 0,0:03:19.45,0:03:24.32,Main,Vordin,0,0,0,,Pse u përpoq Mbreti i Hiden-it të të vriste?
Dialogue: 0,0:03:24.32,0:03:27.84,Main,Vordin,0,0,0,,Mbreti ishte nën \Nkontrollin e Librit të Toah-ut.
Dialogue: 0,0:03:28.22,0:03:32.48,Main,Vordin,0,0,0,,Pas shumë vitesh, \Nai i ishte nënshtruar territorit të Librit,
Dialogue: 0,0:03:32.48,0:03:35.98,Main,Vordin,0,0,0,,dhe instinktet mbrojtëse të tij \Nnuk i lanë zgjidhje tjetër.
Dialogue: 0,0:03:36.79,0:03:39.04,Main,Vordin,0,0,0,,Gjithçka sipas vullnetit të Toah-ut.
Dialogue: 0,0:03:39.04,0:03:41.78,Main,Vordin,0,0,0,,Dhe vullneti i Toah-ut ende ekziston.
Dialogue: 0,0:03:42.24,0:03:47.49,Main,Vordin,0,0,0,,Toah duhet të shkatërrohet plotësisht, \Nderisa të mos mbesë as një thërrmijë.
Dialogue: 0,0:03:47.49,0:03:50.77,Main,Klen,0,0,0,,Fjalët dhe veprimet e tua nuk përputhen.
Dialogue: 0,0:03:50.77,0:03:55.51,Main,Klen,0,0,0,,Nëse do ta shkatërrosh, \Npse përpiqesh të ringjallësh legjendën e heroit?
Dialogue: 0,0:03:55.51,0:03:58.88,Main,Vordin,0,0,0,,Edhe kjo është diçka \Nqë nuk të përket ty.
Dialogue: 0,0:04:09.21,0:04:11.32,Main,Klen,0,0,0,,Së pari, do të të varros ty,
Dialogue: 0,0:04:11.32,0:04:15.80,Main,Klen,0,0,0,,pastaj do t'ia bëj njësoj 'heroit të vërtetë' \Nqë gjendet përtej asaj porte.
Dialogue: 0,0:04:16.09,0:04:19.74,Main,Klen,0,0,0,,Kush është 'Toah' \Nmund ta zbuloj pas kësaj.
Dialogue: 0,0:04:45.13,0:04:50.27,Main,Klen,0,0,0,,Ky hapësirë lufton kundër meje \Nkur përpiqem të kthehem në formën time të plotë.
Dialogue: 0,0:04:56.83,0:05:00.20,Main,Klen,0,0,0,,Ky vend është strukturuar si një piramidë.
Dialogue: 0,0:05:01.12,0:05:03.44,Main,Klen,0,0,0,,Një piramidë...?
Dialogue: 0,0:05:10.96,0:05:13.71,Italics,Alicia,0,0,0,,Dreqi! Qetësohu, Alicia!
Dialogue: 0,0:05:14.45,0:05:16.59,Main,Margo,0,0,0,,Vetëm kaq ke, Alicia?
Dialogue: 0,0:05:16.59,0:05:18.68,Italics,Alicia,0,0,0,,Ky nuk është babai im i vërtetë!
Dialogue: 0,0:05:18.68,0:05:21.15,Main,Margo,0,0,0,,Po ta them në vazhdimësi, përdor këmbët!
Dialogue: 0,0:05:21.15,0:05:21.92,Main,Margo,0,0,0,,Këmbët!
Dialogue: 0,0:05:23.20,0:05:26.96,Main,Margo,0,0,0,,Ti, sidomos, nuk duhet të përpiqesh \Ntë godasësh me krahë.
Dialogue: 0,0:05:26.96,0:05:29.44,Main,Margo,0,0,0,,Nëna jote ishte e jashtëzakonshme \Nme këmbët gjithashtu.
Dialogue: 0,0:05:30.46,0:05:33.35,Main,Margo,0,0,0,,Më kapi njëherë midis tyre \Ndhe pothuajse humba ndjenjat.
Dialogue: 0,0:05:33.64,0:05:36.38,Main - Top,Margo,0,0,0,,Ishte para se të lindeshe ti, besoj...
Dialogue: 0,0:05:34.41,0:05:36.38,Italics,Alicia,0,0,0,,Ky është i rremë...
Dialogue: 0,0:05:36.39,0:05:37.36,Italics,Alicia,0,0,0,,Kjo është...
Dialogue: 0,0:05:37.69,0:05:39.04,Italics,Alicia,0,0,0,,e rreme!
Dialogue: 0,0:05:40.56,0:05:41.60,Italics,Alicia,0,0,0,,Dreqi!
Dialogue: 0,0:05:41.60,0:05:44.61,Italics,Alicia,0,0,0,,Pse derdh gjak një i rremë?
Dialogue: 0,0:05:44.61,0:05:47.02,Main,Margo,0,0,0,,Kjo ishte një goditje e mirë.
Dialogue: 0,0:05:47.02,0:05:49.57,Main,Margo,0,0,0,,Por... nuk po i vëzhgon këmbët!
Dialogue: 0,0:05:52.17,0:05:54.28,Main,Margo,0,0,0,,Tani je e vdekur.
Dialogue: 0,0:05:58.27,0:05:59.66,Main,Margo,0,0,0,,Mirë, le të shkojmë në shtëpi.
Dialogue: 0,0:06:00.85,0:06:03.11,Main,Margo,0,0,0,,Kaq ishte stërvitja për sot.
Dialogue: 0,0:06:05.40,0:06:06.87,Main,Alicia,0,0,0,,Çfarë...?
Dialogue: 0,0:06:07.26,0:06:08.76,Main,Margo,0,0,0,,Ngrihu!
Dialogue: 0,0:06:09.30,0:06:10.94,Italics,Alicia,0,0,0,,Çfarë është kjo?
Dialogue: 0,0:06:11.59,0:06:13.51,Italics,Alicia,0,0,0,,Ç'dreqin ka aty?
Dialogue: 0,0:06:13.96,0:06:18.36,Italics,Alicia,0,0,0,,Duhet ta mposht babanë tim \Npër të dalë nga kjo hapësirë?
Dialogue: 0,0:06:18.97,0:06:22.09,Italics,Alicia,0,0,0,,Babai im ishte më i fortë se Drel-i \Nkur ai ishte në kulm.
Dialogue: 0,0:06:22.61,0:06:24.49,Italics,Alicia,0,0,0,,Çfarë të bëj?
Dialogue: 0,0:06:25.27,0:06:26.99,Italics,Alicia,0,0,0,,Kam shumë ftohtë.
Dialogue: 0,0:06:27.46,0:06:29.60,Italics,Alicia,0,0,0,,Kjo ftohtë është e vërtetë.
Dialogue: 0,0:06:30.63,0:06:32.61,Italics,Alicia,0,0,0,,Të lutem, Klen.
Dialogue: 0,0:06:32.61,0:06:34.47,Italics,Alicia,0,0,0,,Po të përgjërohem.
Dialogue: 0,0:06:34.92,0:06:37.61,Italics,Alicia,0,0,0,,Nxirrme nga këtu!
Dialogue: 0,0:06:41.55,0:06:45.04,Main,Margo,0,0,0,,Sigurisht që ke ftohtë, e veshur ashtu.
Dialogue: 0,0:06:45.04,0:06:47.25,Main,Margo,0,0,0,,Edhe për stërvitje, kjo është tepër.
Dialogue: 0,0:06:47.25,0:06:48.25,Main,Margo,0,0,0,,Hajde.
Dialogue: 0,0:06:48.77,0:06:50.76,Main,Margo,0,0,0,,Do të të çoj në shtëpi.
Dialogue: 0,0:06:51.30,0:06:52.76,Main,Margo,0,0,0,,Shpejt.
Dialogue: 0,0:06:56.32,0:06:57.38,Main,Alicia,0,0,0,,Mirë.
Dialogue: 0,0:06:58.86,0:07:00.27,Main,Margo,0,0,0,,Uf!
Dialogue: 0,0:07:00.90,0:07:03.89,Main,Margo,0,0,0,,Ke rritur, Alicia.
Dialogue: 0,0:07:04.32,0:07:08.78,Main,Alicia,0,0,0,,Shpina jote është kaq e madhe, edhe tani.
Dialogue: 0,0:07:09.10,0:07:10.17,Main,Margo,0,0,0,,Ashtu?
Dialogue: 0,0:07:10.53,0:07:11.58,Main,Alicia,0,0,0,,Po.
Dialogue: 0,0:07:12.39,0:07:13.80,Main,Alicia,0,0,0,,Është kaq ngrohtë.
Dialogue: 0,0:07:21.88,0:07:23.09,Main,Margo,0,0,0,,U kthyem!
Dialogue: 0,0:07:28.88,0:07:30.48,Italics,Alicia,0,0,0,,Shtëpia...
Dialogue: 0,0:07:30.48,0:07:32.21,Italics,Alicia,0,0,0,,E kujtoj kaq mirë...
Dialogue: 0,0:07:34.20,0:07:36.05,Main,Margo,0,0,0,,Hajde, Alicia.
Dialogue: 0,0:07:36.36,0:07:37.80,Main,Margo,0,0,0,,Eja afër zjarrit.
Dialogue: 0,0:07:37.80,0:07:39.01,Main,Margo,0,0,0,,Do të ngrohesh.
Dialogue: 0,0:07:39.35,0:07:40.32,Main,Alicia,0,0,0,,Po.
Dialogue: 0,0:07:41.55,0:07:43.69,Main,Margo,0,0,0,,Hej, e dashur! E dashur!
Dialogue: 0,0:07:44.04,0:07:45.07,Main,Margo,0,0,0,,A mund ta ngrohësh
Dialogue: 0,0:07:45.07,0:07:46.58,Main - Top,Margo,0,0,0,,supën e mëngjesit?
Dialogue: 0,0:07:45.07,0:07:46.58,Main,Alicia,0,0,0,,Mos do të thotë...?
Dialogue: 0,0:07:47.22,0:07:48.44,Main,Margo,0,0,0,,E dashur!
Dialogue: 0,0:07:48.44,0:07:51.32,Main,Samantha,0,0,0,,Pusho. Po vij.
Dialogue: 0,0:07:51.32,0:07:52.57,Main,Margo,0,0,0,,Au!
Dialogue: 0,0:07:52.87,0:07:56.58,Main,Samantha,0,0,0,,Shkove e stërvite gjithë ditën duke i shmangur punët e shtëpisë...
Dialogue: 0,0:07:57.01,0:08:01.58,Main,Samantha,0,0,0,,Ti dhe bija jote \Ns'keni për t'u rritur kurrë, apo jo?
Dialogue: 0,0:08:02.20,0:08:04.45,Main,Samantha,0,0,0,,Hajde, Alicia. Më ndihmo.
Dialogue: 0,0:08:06.38,0:08:09.72,Main,Samantha,0,0,0,,Mos rri aty. \NNxirre mbajtësen e tenxheres.
Dialogue: 0,0:08:09.72,0:08:11.60,Main,Alicia,0,0,0,,P-Po.
Dialogue: 0,0:08:11.60,0:08:14.12,Main,Margo,0,0,0,,Ajo po ngrinte jashtë në borë.
Dialogue: 0,0:08:14.12,0:08:15.63,Main,Margo,0,0,0,,Lëre të pushojë.
Dialogue: 0,0:08:15.63,0:08:19.22,Main,Samantha,0,0,0,,Është faji yt \Nqë e nxorre atë jashtë.
Dialogue: 0,0:08:19.22,0:08:22.01,Main,Samantha,0,0,0,,Si ndëshkim, \Ns'ke mish për tre ditët e ardhshme.
Dialogue: 0,0:08:22.01,0:08:23.72,Main,Margo,0,0,0,,Hej, kjo nuk është e drejtë.
Dialogue: 0,0:08:23.72,0:08:24.70,Main,Samantha,0,0,0,,Katër ditë, atëherë.
Dialogue: 0,0:08:24.70,0:08:26.88,Main,Margo,0,0,0,,Të lutem, jo.
Dialogue: 0,0:08:30.63,0:08:32.66,Main,Samantha,0,0,0,,Çfarë ke, Alicia?
Dialogue: 0,0:08:32.66,0:08:34.42,Main,Samantha,0,0,0,,Të hyri diçka në sy?
Dialogue: 0,0:08:34.72,0:08:35.62,Main,Samantha,0,0,0,,Lërmë të shikoj.
Dialogue: 0,0:08:35.62,0:08:36.50,Main,Alicia,0,0,0,,Jo, unë...
Dialogue: 0,0:08:36.50,0:08:37.50,Main,Samantha,0,0,0,,Ngadalë...
Dialogue: 0,0:08:38.60,0:08:39.24,Main,Alicia,0,0,0,,Por...
Dialogue: 0,0:08:39.24,0:08:40.15,Main,Samantha,0,0,0,,Hape.
Dialogue: 0,0:08:40.15,0:08:40.74,Main,Samantha,0,0,0,,Hajde.
Dialogue: 0,0:08:43.45,0:08:46.61,Main,Samantha,0,0,0,,Mos u shqetëso. Nuk është i kuq.
Dialogue: 0,0:08:47.99,0:08:50.75,Main,Alicia,0,0,0,,Por... Hë?
Dialogue: 0,0:08:51.44,0:08:52.90,Main,Alicia,0,0,0,,Për çfarë po shqetësohesha, prapë?
Dialogue: 0,0:08:52.90,0:08:56.01,Main,Margo,0,0,0,,Ulu. Supa po të ftohet.
Dialogue: 0,0:08:56.28,0:08:58.57,Main,Margo,0,0,0,,Stërvitemi edhe nesër pasdite.
Dialogue: 0,0:08:58.57,0:09:00.51,Main,Margo,0,0,0,,Duhet t'i futim pak muskuj!
Dialogue: 0,0:09:01.33,0:09:02.00,Main,Alicia,0,0,0,,Po.
Dialogue: 0,0:09:02.00,0:09:05.01,Main,Samantha,0,0,0,,Mos e tepro me të.
Dialogue: 0,0:09:05.23,0:09:08.40,Main,Samantha,0,0,0,,Dhe mos dilni jashtë në të ftohtë.
Dialogue: 0,0:09:08.40,0:09:09.38,Main,Samantha,0,0,0,,E kuptove?
Dialogue: 0,0:09:09.38,0:09:11.43,Main,Margo,0,0,0,,Sigurisht, e dashur.
Dialogue: 0,0:09:11.43,0:09:14.67,Main,Samantha,0,0,0,,Hej, mos u përpiq të vjedhësh mish.
Dialogue: 0,0:09:14.67,0:09:16.37,Main,Margo,0,0,0,,Hajde, të lutem?
Dialogue: 0,0:09:16.37,0:09:18.66,Main,Margo,0,0,0,,Nuk mbijetoj dot deri nesër \Nvetëm me bukë.
Dialogue: 0,0:09:18.66,0:09:19.63,Main,Margo,0,0,0,,Të lutem?
Dialogue: 0,0:09:19.63,0:09:20.90,Main,Samantha,0,0,0,,Jo.
Dialogue: 0,0:09:20.90,0:09:22.80,Main,Margo,0,0,0,,Të lutem? Të lutem?
Dialogue: 0,0:09:24.11,0:09:26.09,Main,Alicia,0,0,0,,Hiq dorë, baba.
Dialogue: 0,0:09:26.09,0:09:28.52,Main,Margo,0,0,0,,Hej! Mirë, si të thuash.
Dialogue: 0,0:09:28.52,0:09:30.93,Main,Margo,0,0,0,,Nesër do të stërvit edhe më ashpër.
Dialogue: 0,0:09:30.93,0:09:32.29,Main,Alicia,0,0,0,,Sigurisht.
Dialogue: 0,0:09:32.98,0:09:36.04,Main,Milea,0,0,0,,Le t'i përqafojnë ëndrrat e ngrohta...
Dialogue: 0,0:09:36.72,0:09:40.86,Main,Milea,0,0,0,,...derisa të ngrish deri në vdekje, \NAlicia Glenfall.
Dialogue: 0,0:09:52.02,0:09:53.79,Main,Leon,0,0,0,,Duket se i humbëm.
Dialogue: 0,0:09:53.79,0:09:56.11,Main,Tygel,0,0,0,,Patëm fat që mundëm \Nt'i mashtronim me diçka si kjo.
Dialogue: 0,0:09:56.11,0:09:58.76,Main,Leon,0,0,0,,Nga e marrim, pra?
Dialogue: 0,0:09:58.76,0:10:01.72,Main,Leon,0,0,0,,Ajo grua na tha të ngjiteshim lart, por...
Dialogue: 0,0:10:01.72,0:10:05.44,Main,Tygel,0,0,0,,Jam i sigurt se ne do të dilnim, \Npor princesha me gjasë nuk mundet.
Dialogue: 0,0:10:05.44,0:10:06.74,Main,Leon,0,0,0,,Po.
Dialogue: 0,0:10:07.09,0:10:08.66,Main,Milea,0,0,0,,Nuk mund të dal?
Dialogue: 0,0:10:08.66,0:10:10.52,Main,Leon,0,0,0,,Kjo është bota e pasqyrës,
Dialogue: 0,0:10:10.52,0:10:14.65,Main,Leon,0,0,0,,dhe ai personaliteti tjetër i yti \Ntë ka mbyllur brenda, apo jo?
Dialogue: 0,0:10:14.65,0:10:17.31,Main,Tygel,0,0,0,,Dy personalitete në një trup.
Dialogue: 0,0:10:17.55,0:10:20.60,Main,Tygel,0,0,0,,Mendoj se nuk do t'i ndaje dot \Nedhe sikur të doje.
Dialogue: 0,0:10:20.60,0:10:23.64,Main,Leon,0,0,0,,Nëse personaliteti tjetër \Nkontrollon trupin tënd,
Dialogue: 0,0:10:23.64,0:10:26.24,Main,Leon,0,0,0,,nuk do të mundeshe dot të dilje \Nedhe sikur ta doje.
Dialogue: 0,0:10:26.24,0:10:31.26,Main,Tygel,0,0,0,,Për këtë arsye me gjasë dha urdhrin \Ntë vritet personi me fytyrën e saj, apo jo?
Dialogue: 0,0:10:31.26,0:10:33.90,Main,Tygel,0,0,0,,Ajo planifikon ta pushtojë plotësisht \Ntrupin tënd.
Dialogue: 0,0:10:34.32,0:10:36.80,Main,Milea,0,0,0,,Disi e kisha kuptuar...
Dialogue: 0,0:10:36.80,0:10:41.86,Main,Milea,0,0,0,,kur u hodha në pasqyrë, \Nvendet tona u ndërruan.
Dialogue: 0,0:10:42.88,0:10:46.92,Main,Milea,0,0,0,,Kur isha e vogël, \Najo ishte një qenie brenda pasqyrës.
Dialogue: 0,0:10:47.24,0:10:50.45,Flashback,Milea,0,0,0,,Çfarë ndodh kur i heq \Nkrahët një blete?
Dialogue: 0,0:10:50.45,0:10:52.01,Flashback,Milea,0,0,0,,Bëhet milingonë.
Dialogue: 0,0:10:52.01,0:10:54.70,Flashback,Milea,0,0,0,,Bëhet milingonë \Ndhe jeton nën tokë.
Dialogue: 0,0:10:55.16,0:10:58.92,Main,Milea,0,0,0,,Një qenie që fliste për \Ntë gjitha gjërat e errëta që imagjinoja.
Dialogue: 0,0:10:59.09,0:11:00.30,Flashback,Milea,0,0,0,,Vërtet?
Dialogue: 0,0:11:00.30,0:11:03.45,Flashback,Milea,0,0,0,,Vërtet. Le ta provojmë.
Dialogue: 0,0:11:04.64,0:11:07.56,Main,Milea,0,0,0,,Një ditë, ndalova së pari atë.
Dialogue: 0,0:11:07.80,0:11:12.31,Main,Milea,0,0,0,,Mendova se ishte sepse isha rritur...
Dialogue: 0,0:11:12.86,0:11:17.56,Main,Milea,0,0,0,,Por realiteti ishte se \Najo po merrte kontrollin mbi mua...
Dialogue: 0,0:11:17.86,0:11:19.90,Main,Milea,0,0,0,,Dhe unë s'kisha pasur asnjë ide.
Dialogue: 0,0:11:20.52,0:11:22.87,Main,Milea,0,0,0,,Është gjithçka faji im.
Dialogue: 0,0:11:22.87,0:11:24.95,Main,Milea,0,0,0,,Mos u shqetësoni të përpiqeni të më shpëtoni.
Dialogue: 0,0:11:24.95,0:11:26.95,Main,Milea,0,0,0,,Ikni pa mua.
Dialogue: 0,0:11:27.66,0:11:30.33,Main,Leon,0,0,0,,Të ikim? Për çfarë po flet?
Dialogue: 0,0:11:30.62,0:11:34.55,Main,Tygel,0,0,0,,Po flasim se cila \Nështë përgjigjja e duhur.
Dialogue: 0,0:11:34.55,0:11:36.64,Main,Leon,0,0,0,,A ia kthen shpinën pasqyrës,
Dialogue: 0,0:11:36.64,0:11:39.01,Main,Leon,0,0,0,,apo e sheh drejt në sy?
Dialogue: 0,0:11:40.56,0:11:45.08,Main,Leon,0,0,0,,Pasqyrat tregojnë vetëm të vërtetën, \Npër mirë apo për keq.
Dialogue: 0,0:11:45.48,0:11:47.20,Main,Tygel,0,0,0,,Ne jemi binjakë.
Dialogue: 0,0:11:47.20,0:11:50.97,Main,Tygel,0,0,0,,Ndaj nëse ka një pasqyrë, \Ndo të shfaqemi të dy në të.
Dialogue: 0,0:11:50.97,0:11:52.76,Main,Tygel,0,0,0,,Kjo është e vërteta.
Dialogue: 0,0:11:50.97,0:11:52.76,Main - Top,Leon,0,0,0,,Kjo është e vërteta.
Dialogue: 0,0:11:53.48,0:11:57.11,Main,Leon,0,0,0,,Na kanë thënë se jemi imazhe pasqyre \Nqysh kur ishim të vegjël.
Dialogue: 0,0:11:57.11,0:11:58.98,Main,Leon,0,0,0,,Por ne nuk jemi pasqyrë.
Dialogue: 0,0:11:58.98,0:12:00.59,Main,Tygel,0,0,0,,Kështu ka qenë gjithmonë.
Dialogue: 0,0:12:00.59,0:12:02.37,Flashback,Blouyer,0,0,0,,Ja ku jeni.
Dialogue: 0,0:12:02.37,0:12:04.53,Flashback,Blouyer,0,0,0,,Jeni si pasqyrë. Më tmerroni.
Dialogue: 0,0:12:04.88,0:12:07.64,Flashback,Blouyer,0,0,0,,Mund të ketë vetëm një trashëgimtar.
Dialogue: 0,0:12:07.64,0:12:09.04,Flashback,Blouyer,0,0,0,,Nuk kemi nevojë për dy.
Dialogue: 0,0:12:09.68,0:12:12.79,Flashback,Blouyer,0,0,0,,Nëse vazhdoni të rrini pranë njëri-tjetrit, \Ndo t'ju dëboj nga familja.
Dialogue: 0,0:12:13.47,0:12:16.30,Flashback,Blouyer,0,0,0,,Nëse nuk ju pëlqen, mundohuni të siguroni \Nqë njëri prej jush të jetë më i mirë se tjetri.
Dialogue: 0,0:12:17.32,0:12:20.44,Main,Tygel,0,0,0,,Kishim mundësinë të ndiqnim \Nrrugë të ndryshme.
Dialogue: 0,0:12:20.44,0:12:24.39,Main,Leon,0,0,0,,Nuk e bëmë, për t'ia kthyer \Nbabait tonë të poshtër,
Dialogue: 0,0:12:24.39,0:12:28.05,Main,Leon,0,0,0,,dhe për ta përballuar drejtpërdrejt \Ntë vërtetën se ishim binjakë.
Dialogue: 0,0:12:28.48,0:12:30.27,Main,Tygel,0,0,0,,Vendosëm që ne të dy \Ndo të ngriheshim bashkë,
Dialogue: 0,0:12:30.27,0:12:33.10,Main,Tygel,0,0,0,,dhe ta vidhnim mbiemrin e familjes \Nnga babai ynë i poshtër.
Dialogue: 0,0:12:33.10,0:12:35.40,Main,Tygel,0,0,0,,Po ti, Princeshë?
Dialogue: 0,0:12:35.40,0:12:38.98,Main,Tygel,0,0,0,,A ke guximin ta përballosh \Ntë vërtetën drejtpërdrejt?
Dialogue: 0,0:12:39.89,0:12:44.67,Main,Tygel,0,0,0,,A ke guximin \Nta përballosh veten prapë?
Dialogue: 0,0:12:46.41,0:12:47.84,Main,Milea,0,0,0,,Unë...
Dialogue: 0,0:12:51.94,0:12:53.96,Main,Alicia,0,0,0,,Kjo është e vështirë, baba.
Dialogue: 0,0:12:54.22,0:12:58.08,Main,Alicia,0,0,0,,Të shohësh shpatën tënde dhe gurët \Nnë tokë në të njëjtën kohë...
Dialogue: 0,0:12:58.33,0:13:00.46,Main,Margo,0,0,0,,Bëje, edhe nëse është e vështirë.
Dialogue: 0,0:13:00.73,0:13:03.21,Main,Margo,0,0,0,,Do të bëhesh heroinë, apo jo?
Dialogue: 0,0:13:03.97,0:13:08.22,Italics,Alicia,0,0,0,,Hë? Pse doja të bëhesha heroinë, prapë?
Dialogue: 0,0:13:09.88,0:13:11.10,Main,Alicia,0,0,0,,Edhe një herë!
Dialogue: 0,0:13:11.60,0:13:14.98,Main,Milea,0,0,0,,Po shkon drejt \Ne në rrugën e gabuar.
Dialogue: 0,0:13:16.55,0:13:20.77,Main,Milea,0,0,0,,Forma ideale e paraqitur \Nnga ai që respekton më shumë...
Dialogue: 0,0:13:20.77,0:13:23.41,Main,Milea,0,0,0,,Është e pamundur ta refuzosh atë.
Dialogue: 0,0:13:23.41,0:13:26.61,Main,Milea,0,0,0,,Por ta refuzosh është \Ngjithashtu përgjigja e gabuar.
Dialogue: 0,0:13:27.65,0:13:30.36,Main,Milea,0,0,0,,Ndaj sidoqoftë, s'ke rrugëdalje.
Dialogue: 0,0:13:31.19,0:13:35.60,Main,Milea,0,0,0,,E vetmja gjë frustruese është se nuk \Nmund të ndërhyj me këtë deri në fund.
Dialogue: 0,0:13:35.60,0:13:37.22,Main,Milea,0,0,0,,Vdis, vdis.
Dialogue: 0,0:13:37.22,0:13:39.16,Main,Milea,0,0,0,,Vdis njëherë e mirë.
Dialogue: 0,0:13:39.16,0:13:41.03,Main,Milea,0,0,0,,Heroinë e rreme.
Dialogue: 0,0:13:42.69,0:13:45.30,Italics,Alicia,0,0,0,,Dua të jem kështu përgjithmonë.
Dialogue: 0,0:13:46.06,0:13:46.80,Italics,Alicia,0,0,0,,Por...
Dialogue: 0,0:13:47.04,0:13:48.39,Main,Samantha,0,0,0,,Obobo.
Dialogue: 0,0:13:48.39,0:13:52.42,Main,Samantha,0,0,0,,Nuk e kuptoj pse dëshiron \Nkaq shumë të bëhesh heroinë.
Dialogue: 0,0:13:52.42,0:13:55.31,Main,Margo,0,0,0,,Është e qartë, apo jo?
Dialogue: 0,0:13:55.31,0:14:00.40,Main,Margo,0,0,0,,Çdokush ka shpirtin e një heroi \Nthellë në zemër.
Dialogue: 0,0:14:00.40,0:14:03.83,Main,Margo,0,0,0,,Tregimet që na kanë treguar \Nqysh kur ishim të vegjël...
Dialogue: 0,0:14:03.83,0:14:04.81,Main,Margo,0,0,0,,dhe...
Dialogue: 0,0:14:05.48,0:14:08.69,Main,Margo,0,0,0,,tregimet e mrekullueshme të atyre që \Nu zgjodhën vërtet për t'u bërë heronj.
Dialogue: 0,0:14:08.69,0:14:10.82,Main,Margo,0,0,0,,Çdokush dëshiron të jetë si ata njerëz!
Dialogue: 0,0:14:11.25,0:14:13.08,Main,Samantha,0,0,0,,Mos u bëj budalla.
Dialogue: 0,0:14:13.45,0:14:16.21,Main,Margo,0,0,0,,Mirë, po kjo?!
Dialogue: 0,0:14:24.13,0:14:26.67,Main,Alicia,0,0,0,,Pilivesa e Vetmuar!
Dialogue: 0,0:14:32.77,0:14:35.60,Italics,Alicia,0,0,0,,Pse po përpiqem të bëhem heroinë?
Dialogue: 0,0:14:36.32,0:14:37.48,Italics,Alicia,0,0,0,,Pse?
Dialogue: 0,0:14:38.08,0:14:39.29,Main,Alicia,0,0,0,,Au!
Dialogue: 0,0:14:40.85,0:14:42.36,Main,Margo,0,0,0,,Hej, Alicia!
Dialogue: 0,0:14:44.36,0:14:45.64,Main,Margo,0,0,0,,Hej!
Dialogue: 0,0:14:45.64,0:14:47.16,Main,Samantha,0,0,0,,Alicia!
Dialogue: 0,0:14:49.86,0:14:54.91,Flashback,Alicia,0,0,0,,Do të bëhem heroinë dhe \Ndo ta bëj botën shumë, shumë më të madhe!
Dialogue: 0,0:14:54.91,0:14:58.62,Italics,Alicia,0,0,0,,Ta bëj botën... më të madhe?
Dialogue: 0,0:14:58.62,0:14:59.66,Italics,Alicia,0,0,0,,Pse?
Dialogue: 0,0:14:59.92,0:15:01.92,Flashback,Samantha,0,0,0,,Fund.
Dialogue: 0,0:15:02.23,0:15:04.42,Flashback,Samantha,0,0,0,,Të pëlqeu tregimi i heroit?
Dialogue: 0,0:15:04.42,0:15:06.08,Flashback,Alicia,0,0,0,,Ishte i mrekullueshëm!
Dialogue: 0,0:15:06.08,0:15:07.16,Flashback,Samantha,0,0,0,,Cila pjesë të pëlqeu?
Dialogue: 0,0:15:07.16,0:15:09.27,Flashback,Alicia,0,0,0,,Se sa i fortë ishte!
Dialogue: 0,0:15:09.27,0:15:10.80,Flashback,Alicia,0,0,0,,Dhe... dhe...!
Dialogue: 0,0:15:10.80,0:15:12.64,Flashback,Alicia,0,0,0,,Dhe të gjithë njerëzve të ndryshëm që takoi!
Dialogue: 0,0:15:13.01,0:15:15.46,Flashback,Alicia,0,0,0,,Shokët e tij, dhe mbreti!
Dialogue: 0,0:15:15.46,0:15:16.54,Flashback,Alicia,0,0,0,,Njerëzit në qytet!
Dialogue: 0,0:15:16.54,0:15:18.02,Flashback,Alicia,0,0,0,,Të gjithë armiqtë!
Dialogue: 0,0:15:18.46,0:15:20.52,Flashback,Alicia,0,0,0,,Dua të takoj shumë njerëz edhe unë!
Dialogue: 0,0:15:20.99,0:15:23.44,Flashback,Alicia,0,0,0,,Shumë e shumë njerëz!
Dialogue: 0,0:15:24.40,0:15:25.42,Flashback,Samantha,0,0,0,,E kuptoj.
Dialogue: 0,0:15:25.42,0:15:27.28,Flashback,Samantha,0,0,0,,Atëherë ti duhet...
Dialogue: 0,0:15:28.07,0:15:29.20,Flashback,Aunt,0,0,0,,Alicia!
Dialogue: 0,0:15:31.56,0:15:32.91,Flashback,Alicia,0,0,0,,Teze?
Dialogue: 0,0:15:35.06,0:15:37.19,Flashback,Villager,0,0,0,,Duket si një rrëshqitje dheu...
Dialogue: 0,0:15:37.44,0:15:39.21,Flashback,Villager,0,0,0,,Nga gjithë shiu që ka rënë?
Dialogue: 0,0:15:39.21,0:15:42.99,Flashback,Villager,0,0,0,,Margo doli vetë, \Npor bashkëshortja e tij...
Dialogue: 0,0:15:42.99,0:15:45.21,Flashback,Alicia,0,0,0,,Nënë! A është e lënduar?
Dialogue: 0,0:15:47.80,0:15:48.97,Flashback,Villager,0,0,0,,Jo...
Dialogue: 0,0:15:50.28,0:15:54.06,Flashback,Margo,0,0,0,,Hej! Samantha! Samantha, zgjohu!
Dialogue: 0,0:15:54.06,0:15:55.22,Flashback,Margo,0,0,0,,Zgjohu!
Dialogue: 0,0:15:55.22,0:15:56.60,Flashback,Margo,0,0,0,,Samantha!
Dialogue: 0,0:16:00.24,0:16:01.52,Flashback,Samantha,0,0,0,,Alicia...
Dialogue: 0,0:16:05.54,0:16:07.76,Flashback,Samantha,0,0,0,,Eja këtu, Alicia.
Dialogue: 0,0:16:14.75,0:16:16.07,Flashback,Alicia,0,0,0,,Nënë...
Dialogue: 0,0:16:16.75,0:16:18.64,Flashback,Samantha,0,0,0,,Mos qaj, Alicia.
Dialogue: 0,0:16:19.51,0:16:21.78,Flashback,Samantha,0,0,0,,Do të jesh mirë.
Dialogue: 0,0:16:23.11,0:16:26.63,Flashback,Samantha,0,0,0,,Të gjitha llojet e takimeve \Npo të presin...
Dialogue: 0,0:16:28.01,0:16:30.65,Flashback,Samantha,0,0,0,,Takime të mrekullueshme...
Dialogue: 0,0:16:32.11,0:16:34.49,Flashback,Samantha,0,0,0,,Nëse e bën botën më të madhe...
Dialogue: 0,0:16:35.22,0:16:38.89,Flashback,Samantha,0,0,0,,do të takosh kaq shumë më tepër njerëz.
Dialogue: 0,0:16:39.60,0:16:45.44,Flashback,Samantha,0,0,0,,Ndiq atë rrugë, drejt përpara...
Dialogue: 0,0:16:48.00,0:16:49.20,Flashback,Alicia,0,0,0,,Nënë!
Dialogue: 0,0:16:50.21,0:16:51.48,Flashback,Alicia,0,0,0,,Nënë!
Dialogue: 0,0:16:51.48,0:16:53.22,Flashback,Alicia,0,0,0,,Nënë!
Dialogue: 0,0:16:53.22,0:16:54.72,Flashback,Alicia,0,0,0,,Nënë!
Dialogue: 0,0:16:54.72,0:16:56.35,Flashback,Alicia,0,0,0,,Nënë!
Dialogue: 0,0:16:56.35,0:16:58.16,Flashback,Alicia,0,0,0,,Nënë!
Dialogue: 0,0:16:58.47,0:17:01.67,Flashback,Alicia,0,0,0,,Nënë!
Dialogue: 0,0:17:02.25,0:17:05.48,Italics,Alicia,0,0,0,,Ah... tani kujtoj.
Dialogue: 0,0:17:06.36,0:17:08.44,Main,Margo,0,0,0,,U zgjove.
Dialogue: 0,0:17:08.44,0:17:11.92,Main,Samantha,0,0,0,,Gjithmonë bën gjërat më të çmendura...
Dialogue: 0,0:17:12.16,0:17:14.77,Main - Top,Samantha,0,0,0,,Ishte kaq e rrezikshme...
Dialogue: 0,0:17:14.79,0:17:18.32,Main - Top,Samantha,0,0,0,,Duhet të tregohesh më e matur.
Dialogue: 0,0:17:12.64,0:17:15.88,Italics,Alicia,0,0,0,,Arsyeja e vërtetë pse u bëra heroinë.
Dialogue: 0,0:17:18.59,0:17:22.56,Main - Top,Margo,0,0,0,,Jo, nëse nuk e ngarkoja, \Nnuk do të ishte stërvitje.
Dialogue: 0,0:17:20.52,0:17:23.17,Italics,Alicia,0,0,0,,Nuk doja ta kujtoja.
Dialogue: 0,0:17:25.42,0:17:30.15,Main,Sarasa,0,0,0,,Duket se u zgjove.
Dialogue: 0,0:17:31.07,0:17:33.20,Main,Sarasa,0,0,0,,Si ndihesh?
Dialogue: 0,0:17:34.79,0:17:37.78,Main,Ray,0,0,0,,Ti je nxënësja e transferuar nga Orggite?
Dialogue: 0,0:17:37.78,0:17:39.41,Main,Sarasa,0,0,0,,Quhem Sarasa.
Dialogue: 0,0:17:39.41,0:17:42.29,Main,Sarasa,0,0,0,,Je e dyta që u zgjove.
Dialogue: 0,0:17:42.29,0:17:43.53,Main,Ray,0,0,0,,E dyta?
Dialogue: 0,0:17:43.89,0:17:46.52,Main,Sarasa,0,0,0,,Lutjet ta hapin oreksin.
Dialogue: 0,0:17:47.37,0:17:51.46,Main,Sarasa,0,0,0,,Shpirtrat tuaj pothuajse \Nju ishin shkulur plotësisht.
Dialogue: 0,0:17:51.46,0:17:55.28,Main,Sarasa,0,0,0,,I kërkova Zavthier-it t'i mbante të lidhura.
Dialogue: 0,0:17:55.28,0:17:56.78,Main,Ray,0,0,0,,Zavthier...
Dialogue: 0,0:17:57.19,0:17:58.98,Main,Ray,0,0,0,,Kush ishte i pari?
Dialogue: 0,0:17:58.98,0:18:00.01,Main,Mary,0,0,0,,Unë.
Dialogue: 0,0:18:01.23,0:18:02.50,Main,Ray,0,0,0,,Merry Merry.
Dialogue: 0,0:18:02.76,0:18:05.04,Main,Mary,0,0,0,,U zgjova vetëm një çast më parë.
Dialogue: 0,0:18:05.04,0:18:07.94,Main,Naie,0,0,0,,U zgjove edhe ti, Forester?
Dialogue: 0,0:18:08.14,0:18:10.19,Main,Ray,0,0,0,,Profesoreshë Chiffonlits!
Dialogue: 0,0:18:10.19,0:18:11.96,Main,Naie,0,0,0,,Jam kaq e lumtur...
Dialogue: 0,0:18:11.96,0:18:14.77,Main,Naie,0,0,0,,Jam kaq e lumtur që mbijetove \Nkundër atij përbindëshi!
Dialogue: 0,0:18:14.77,0:18:16.79,Main,Sarasa,0,0,0,,Besoj se e kurseu.
Dialogue: 0,0:18:16.79,0:18:18.69,Main,Sarasa,0,0,0,,Përndryshe, do të ishte i vdekur.
Dialogue: 0,0:18:19.26,0:18:21.51,Main,Mary,0,0,0,,Mbijetova me lëndime të lehta.
Dialogue: 0,0:18:21.88,0:18:24.00,Main,Mary,0,0,0,,Por Stema ime iku.
Dialogue: 0,0:18:24.00,0:18:25.96,Main,Mary,0,0,0,,Nuk e ndiej dot më magjinë.
Dialogue: 0,0:18:26.67,0:18:27.88,Main,Ray,0,0,0,,Të miat janë...
Dialogue: 0,0:18:28.68,0:18:30.03,Main,Ray,0,0,0,,ende këtu.
Dialogue: 0,0:18:30.50,0:18:32.25,Main,Ray,0,0,0,,Mbase sepse më kurseu?
Dialogue: 0,0:18:33.00,0:18:34.90,Main,Sarasa,0,0,0,,Lidhur me këtë...
Dialogue: 0,0:18:35.71,0:18:40.63,Main,Sarasa,0,0,0,,Ti je i vetmi që e përfundoi provën \Ne dytë dhe mori dy Stema.
Dialogue: 0,0:18:41.08,0:18:43.14,Main,Sarasa,0,0,0,,Kam dëgjuar se ruajtja \Ne kujtimeve të provës
Dialogue: 0,0:18:43.14,0:18:45.73,Main,Sarasa,0,0,0,,është një privilegj i rezervuar \Npër ata që ia dalin mbanë.
Dialogue: 0,0:18:45.73,0:18:47.76,Main,Ray,0,0,0,,Merry Merry ta tha?
Dialogue: 0,0:18:47.76,0:18:50.32,Main,Mary,0,0,0,,Nuk ka kuptim ta mbajmë \Nsekret tani, apo jo?
Dialogue: 0,0:18:50.32,0:18:52.85,Main,Sarasa,0,0,0,,Pra, çfarë ishte prova?
Dialogue: 0,0:18:54.24,0:18:58.72,Main,Ray,0,0,0,,Prova e parë ishte një betejë \Nkundër dobësisë sime.
Dialogue: 0,0:18:59.36,0:19:02.12,Main,Ray,0,0,0,,Dhe e dyta ishte...
Dialogue: 0,0:19:02.37,0:19:04.53,Main,Leon,0,0,0,,Hej, mos mbete prapa, Princeshë!
Dialogue: 0,0:19:04.53,0:19:05.70,Main,Tygel,0,0,0,,Ecim!
Dialogue: 0,0:19:05.70,0:19:06.71,Main,Milea,0,0,0,,Mirë!
Dialogue: 0,0:19:06.92,0:19:09.96,Main,Ray,0,0,0,,...një betejë për ta pranuar \Nçdo pjesë të vetes ashtu siç je,
Dialogue: 0,0:19:10.31,0:19:12.64,Main,Ray,0,0,0,,dhe të ecësh përpara!
Dialogue: 0,0:19:13.96,0:19:16.22,Main,Samantha,0,0,0,,Çfarë të kapi befas?
Dialogue: 0,0:19:16.52,0:19:20.35,Main,Alicia,0,0,0,,Nuk ka gjë. Thjesht doja ta bëja.
Dialogue: 0,0:19:20.62,0:19:21.99,Main,Samantha,0,0,0,,Ashtu?
Dialogue: 0,0:19:21.99,0:19:22.84,Main,Alicia,0,0,0,,Po.
Dialogue: 0,0:19:23.38,0:19:25.20,Main,Samantha,0,0,0,,Mirë, faleminderit.
Dialogue: 0,0:19:28.18,0:19:31.86,Main,Alicia,0,0,0,,Është bukur kur mund të bësh \Ndiçka për prindërit e tu.
Dialogue: 0,0:19:38.73,0:19:39.98,Main,Alicia,0,0,0,,Baba...
Dialogue: 0,0:19:41.04,0:19:42.49,Main,Alicia,0,0,0,,Fal që ta vonova.
Dialogue: 0,0:19:43.86,0:19:45.75,Main,Margo,0,0,0,,Je gati, ë?
Dialogue: 0,0:19:46.33,0:19:47.12,Main,Alicia,0,0,0,,Po.
Dialogue: 0,0:19:48.69,0:19:49.74,Main,Margo,0,0,0,,Mirë.
Dialogue: 0,0:20:10.64,0:20:12.45,Main,Alicia,0,0,0,,Nuk kam më ftohtë.
Dialogue: 0,0:20:13.16,0:20:15.56,Main,Alicia,0,0,0,,U ngroha mjaftueshëm.
Dialogue: 0,0:20:16.19,0:20:17.08,Main,Margo,0,0,0,,Mirë.
Dialogue: 0,0:20:19.97,0:20:22.37,Main,Margo,0,0,0,,Pra s'ka mbetur asgjë tjetër \Npër të bërë, apo jo?
Dialogue: 0,0:20:23.52,0:20:24.76,Main,Alicia,0,0,0,,Asgjë fare.
Dialogue: 0,0:20:24.76,0:20:28.90,Main,Alicia,0,0,0,,Gjërat e këndshme, gjërat e \Nvështira, gjërat e trishtuara...
Dialogue: 0,0:20:29.55,0:20:33.01,Main,Alicia,0,0,0,,Të gjitha ato më bëjnë kush jam.
Dialogue: 0,0:20:33.80,0:20:36.30,Main,Alicia,0,0,0,,Nuk mund të heq dorë nga asnjëra prej tyre.
Dialogue: 0,0:20:37.57,0:20:38.73,Main,Margo,0,0,0,,E kuptoj.
Dialogue: 0,0:20:39.68,0:20:41.30,Main,Margo,0,0,0,,Është pak e trishtuar.
Dialogue: 0,0:20:42.44,0:20:43.93,Main,Alicia,0,0,0,,E kuptoj.
Dialogue: 0,0:20:44.88,0:20:48.52,Main,Alicia,0,0,0,,Por nëse dua ta bëj \Nbotën më të madhe,
Dialogue: 0,0:20:48.52,0:20:50.68,Main,Alicia,0,0,0,,ka dikë që ka nevojë për ndihmën time.
Dialogue: 0,0:20:50.90,0:20:53.28,Main,Margo,0,0,0,,Me shumë kënaqësi do ta dëgjoja.
Dialogue: 0,0:20:54.01,0:20:55.93,Main,Margo,0,0,0,,Por e kuptoj shumë mirë!
Dialogue: 0,0:21:04.74,0:21:05.73,Main,Alicia,0,0,0,,Baba?
Dialogue: 0,0:21:06.46,0:21:08.12,Main,Margo,0,0,0,,S'ka nevojë të luftojmë.
Dialogue: 0,0:21:08.84,0:21:10.56,Main,Margo,0,0,0,,Ke rritur.
Dialogue: 0,0:21:14.45,0:21:16.08,Main,Alicia,0,0,0,,Nënë?
Dialogue: 0,0:21:22.59,0:21:27.28,Main,Margo,0,0,0,,Alicia, tani je më e fortë se unë.
Dialogue: 0,0:21:27.64,0:21:31.20,Main,Samantha,0,0,0,,Alicia, jam e lumtur që të pashë.
Dialogue: 0,0:21:33.63,0:21:34.98,Main,Alicia,0,0,0,,Edhe unë.
Dialogue: 0,0:21:36.54,0:21:39.16,Main,Alicia,0,0,0,,Jam e lumtur që ju pashë edhe unë.
Dialogue: 0,0:21:40.61,0:21:41.69,Main,Alicia,0,0,0,,Faleminderit.
Dialogue: 0,0:21:44.20,0:21:45.39,Main,Alicia,0,0,0,,Lamtumirë.
Dialogue: 0,0:21:54.81,0:21:57.61,Main,Milea,0,0,0,,Me të drejtat e mia si trashëgimtarja \Ne vërtetë e kapitullit të dytë,
Dialogue: 0,0:21:57.61,0:21:59.72,Main,Milea,0,0,0,,të Librit të Fshatit të Origjinës,
Dialogue: 0,0:21:59.72,0:22:02.25,Main,Milea,0,0,0,,e detyroj këtë provë të marrë fund!
Dialogue: 0,0:22:02.85,0:22:06.00,Main,Milea,0,0,0,,Nuk do t'ju lë asgjë fare!

