Dialogue: 0,0:00:03.22,0:00:04.81,Main,Crew,0,0,0,,L-Leviatano!
Dialogue: 0,0:00:04.81,0:00:05.32,Main,Crew,0,0,0,,Shh!
Dialogue: 0,0:00:05.32,0:00:07.42,Main,Arnold,0,0,0,,Qetësi.
Dialogue: 0,0:00:07.42,0:00:09.10,Main,Arnold,0,0,0,,Është tepër vonë për të ikur.
Dialogue: 0,0:00:09.10,0:00:10.73,Main,Arnold,0,0,0,,Duhet të presim derisa të kalojë.
Dialogue: 0,0:00:18.75,0:00:21.19,Main,Arnold,0,0,0,,Duket se iku.
Dialogue: 0,0:00:22.09,0:00:24.77,Main,Marc,0,0,0,,Mendova se morëm fund.
Dialogue: 0,0:00:24.77,0:00:28.08,Main,Arnold,0,0,0,,Bëra mirë që ngrita një barrierë\Nqë ta kishte më të vështirë të na zbulonte.
Dialogue: 0,0:00:28.08,0:00:30.30,Main,Marc,0,0,0,,Çfarë bënte këtej?
Dialogue: 0,0:00:30.58,0:00:33.33,Main,Arnold,0,0,0,,Ai e sheh çdo njeri si armik.
Dialogue: 0,0:00:33.33,0:00:35.56,Main,Arnold,0,0,0,,Mbase po shkonte\Npër t'i bërë diçka Rondine-s.
Dialogue: 0,0:00:35.56,0:00:37.78,Main,Arnold,0,0,0,,Ose e ka bërë tashmë\Ndhe po kthehet.
Dialogue: 0,0:00:37.78,0:00:39.86,Main,Arnold,0,0,0,,Sidoqoftë, Rondine do të jetë...
Dialogue: 0,0:00:39.86,0:00:41.05,Main,Crew,0,0,0,,Princ Leonard!
Dialogue: 0,0:00:41.39,0:00:44.27,Main,Crew,0,0,0,,Rondine po sulmohet nga përbindëshat!
Dialogue: 0,0:00:46.63,0:00:48.92,Main,Marc,0,0,0,,Princ, herën tjetër\Nqë mendoni diçka të tillë,
Dialogue: 0,0:00:48.92,0:00:51.17,Main,Marc,0,0,0,,a mundeni thjesht\Nta mbani gojën mbyllur?
Dialogue: 0,0:00:51.17,0:00:52.92,Main,Arnold,0,0,0,,Mos ma hidh mua fajin!
Dialogue: 0,0:00:58.20,0:00:59.95,Main,Arnold,0,0,0,,Një gjarpër deti.
Dialogue: 0,0:01:01.31,0:01:02.54,Main,Arnold,0,0,0,,Ajo është...
Dialogue: 0,0:01:02.84,0:01:04.28,Main,Arnold,0,0,0,,Anija e Leo-s?
Dialogue: 0,0:01:04.62,0:01:06.77,Main,Arnold,0,0,0,,Kapiten! Me shpejtësi të plotë!
Dialogue: 0,0:01:06.77,0:01:09.38,Main,Arnold,0,0,0,,Drejt portit!\NDo ta mbrojmë vëllanë tim të madh!
Dialogue: 0,0:01:09.38,0:01:10.58,Main,Captain,0,0,0,,U kuptua!
Dialogue: 0,0:01:10.58,0:01:12.60,Main,Captain,0,0,0,,Ekuipazhi, në pozicionet e luftimit!
Dialogue: 0,0:01:13.26,0:01:17.36,Main,Captain,0,0,0,,Përgatitni topat magjikë\Nqë na huazoi Albatro!
Dialogue: 0,0:02:54.02,0:02:57.99,Sign_Basic,Captain,0,0,0,,EPISODI 11: LEVIATANO ULËRIN
Dialogue: 0,0:02:54.02,0:02:57.99,Sign_Basic,Captain,0,0,0,,{\pos(320,230)}DUKATI I MADH I RONDINE-S
Dialogue: 0,0:01:17.36,0:01:18.93,Main,Crew,0,0,0,,Po!
Dialogue: 0,0:01:18.93,0:01:23.29,Main,Arnold,0,0,0,,Hë, a do të më jepet\Nndonjë rast të ndërrohemi prapë?
Dialogue: 0,0:03:07.47,0:03:09.99,Main,Leonard,0,0,0,,Kapiten, s'kemi pse të rrezikojmë\Nduke e luftuar!
Dialogue: 0,0:03:09.99,0:03:11.59,Main,Leonard,0,0,0,,Vetëm tërhiqjani vëmendjen!
Dialogue: 0,0:03:11.59,0:03:15.69,Main,Captain,0,0,0,,Princ i Plogësht, jo, princ Arnold,\Npo kërkoni të pamundurën.
Dialogue: 0,0:03:15.69,0:03:18.09,Main,Captain,0,0,0,,Po patët frikë, fshihuni në dhomën tuaj.
Dialogue: 0,0:03:18.75,0:03:22.14,Italics,Leonard,0,0,0,,Si arrin vëllai im\Nt'i motivojë gjithmonë njerëzit?
Dialogue: 0,0:03:22.38,0:03:26.38,Main,Captain,0,0,0,,Një gjarpër deti kaq afër portit?
Dialogue: 0,0:03:27.30,0:03:30.30,Main,Leonard,0,0,0,,Kapiten, kaloni në anën\Ne majtë të gjarprit të detit!
Dialogue: 0,0:03:30.30,0:03:33.09,Main,Captain,0,0,0,,Princ, mjaft kërkuat të pamundurën!
Dialogue: 0,0:03:33.09,0:03:34.15,Main,Captain,0,0,0,,S'kemi kohë—
Dialogue: 0,0:03:34.37,0:03:36.06,Main,Leonard,0,0,0,,Thjesht bëjeni!
Dialogue: 0,0:03:36.83,0:03:37.86,Main,Leonard,0,0,0,,Leo erdhi!
Dialogue: 0,0:03:37.86,0:03:40.73,Main,Leonard,0,0,0,,Do të bashkëpunojmë\Npër ta sulmuar gjarprin e detit!
Dialogue: 0,0:03:42.73,0:03:44.79,Main,Arnold,0,0,0,,Kapiten! Kaloni nga e majta!
Dialogue: 0,0:03:44.79,0:03:45.75,Main,Captain,0,0,0,,Urdhëroni!
Dialogue: 0,0:03:45.75,0:03:47.20,Main,Captain,0,0,0,,Timonin krejt majtas!
Dialogue: 0,0:03:47.20,0:03:48.70,Main,Captain,0,0,0,,Hapni frëngjitë e topave djathtas!
Dialogue: 0,0:03:48.70,0:03:51.99,Main,Captain,0,0,0,,Goditeni gjarprin e detit\Nme topat tanë më të rinj magjikë!
Dialogue: 0,0:03:52.61,0:03:54.66,Main,Crew,0,0,0,,Gati për zjarr!
Dialogue: 0,0:03:55.99,0:03:57.48,Main,Captain,0,0,0,,Mos u nxitoni.
Dialogue: 0,0:03:57.48,0:03:59.17,Main,Captain,0,0,0,,Tërhiqeni më afër më parë.
Dialogue: 0,0:04:01.59,0:04:02.46,Main,Leonard,0,0,0,,Zjarr!
Dialogue: 0,0:04:01.59,0:04:02.46,Main,Arnold,0,0,0,,Zjarr!
Dialogue: 0,0:04:05.79,0:04:07.89,Main,Captain,0,0,0,,Mirë! Topat janë aq\Ntë fuqishëm sa shpresonim!
Dialogue: 0,0:04:07.89,0:04:09.22,Main,Captain,0,0,0,,Vazhdoni zjarrin!
Dialogue: 0,0:04:18.26,0:04:19.77,Main,Arnold,0,0,0,,Ende s'kemi mbaruar!
Dialogue: 0,0:04:19.77,0:04:22.33,Main,Arnold,0,0,0,,Përbindëshat më të vegjël po shkojnë\Ndrejt anijes së vëllait tim!
Dialogue: 0,0:04:22.95,0:04:23.96,Main,Arnold,0,0,0,,Kapiten!
Dialogue: 0,0:04:23.96,0:04:25.11,Main,Captain,0,0,0,,Po i afrohemi!
Dialogue: 0,0:04:25.33,0:04:27.29,Main,Marc,0,0,0,,Kalorës, përgatituni për luftim trup më trup.
Dialogue: 0,0:04:27.29,0:04:28.44,Main,Knight,0,0,0,,Po!
Dialogue: 0,0:04:28.44,0:04:29.19,Main,Arnold,0,0,0,,Marc!
Dialogue: 0,0:04:30.76,0:04:33.05,Main,Arnold,0,0,0,,Po shkoj të shpëtoj vëllanë tim.
Dialogue: 0,0:04:33.05,0:04:34.64,Main,Arnold,0,0,0,,Më mbulo.
Dialogue: 0,0:04:35.73,0:04:36.98,Main,Marc,0,0,0,,E kuptoj.
Dialogue: 0,0:04:36.98,0:04:38.50,Main,Marc,0,0,0,,Në rregull! U kuptua!
Dialogue: 0,0:04:38.50,0:04:40.17,Main,Marc,0,0,0,,Ma lini mua në dorë.
Dialogue: 0,0:04:42.71,0:04:43.96,Main,Arnold,0,0,0,,Sulm!
Dialogue: 0,0:05:19.81,0:05:20.95,Main,Leonard,0,0,0,,U vonove.
Dialogue: 0,0:05:20.95,0:05:23.72,Main,Arnold,0,0,0,,Më fal. Më dolën ca telashe.
Dialogue: 0,0:05:23.72,0:05:26.08,Main,Leonard,0,0,0,,Mendoj se kemi mjaft telashe tashmë.
Dialogue: 0,0:05:26.08,0:05:28.81,Main,Arnold,0,0,0,,Po ja, do të bëhet edhe më keq.
Dialogue: 0,0:05:28.81,0:05:30.50,Main,Leonard,0,0,0,,Uau, ç'lajm i bukur.
Dialogue: 0,0:05:34.84,0:05:37.51,Main,Leonard,0,0,0,,S'bëre ndonjë gjë të çuditshme\Nduke u shtirur si unë, apo jo?
Dialogue: 0,0:05:37.51,0:05:40.64,Main,Arnold,0,0,0,,Jo. Bëra punë të shkëlqyer\Nduke u shtirur si ti.
Dialogue: 0,0:05:40.64,0:05:42.20,Main,Arnold,0,0,0,,Prandaj jam i lodhur.
Dialogue: 0,0:05:42.41,0:05:44.13,Main,Leonard,0,0,0,,Po, këtu jam dakord.
Dialogue: 0,0:05:44.13,0:05:47.03,Main,Leonard,0,0,0,,U mundova shumë të shtiresha\Nsi ti dhe jam rraskapitur.
Dialogue: 0,0:05:47.03,0:05:50.65,Main,Arnold,0,0,0,,Që në çastin kur nise\N«të mundoheshe shumë» të bëheshe si unë,
Dialogue: 0,0:05:50.65,0:05:52.28,Main,Arnold,0,0,0,,ia kishe futur gabim.
Dialogue: 0,0:05:52.57,0:05:53.65,Main,Arnold,0,0,0,,Ku është Elna?
Dialogue: 0,0:05:53.65,0:05:55.35,Main,Leonard,0,0,0,,Po lufton në tokë.
Dialogue: 0,0:05:55.35,0:05:57.31,Main,Arnold,0,0,0,,Mirë, pjesën tjetër ta lë ty.
Dialogue: 0,0:05:57.31,0:05:58.22,Main,Leonard,0,0,0,,Po, po.
Dialogue: 0,0:05:58.22,0:06:00.21,Main,Leonard,0,0,0,,Do që ta pastroj unë gjithë rrëmujën, apo jo?
Dialogue: 0,0:06:00.54,0:06:02.56,Main,Arnold,0,0,0,,E kuptove drejt.
Dialogue: 0,0:06:05.18,0:06:06.81,Main,Captain,0,0,0,,Princ Arnold!
Dialogue: 0,0:06:07.37,0:06:09.47,Main,Captain,0,0,0,,Sa larg duhet t'i tërheqim\Nvijat mbrojtëse?
Dialogue: 0,0:06:09.82,0:06:12.96,Main,Arnold,0,0,0,,Vendosni vetë. Unë do të fle.
Dialogue: 0,0:06:12.96,0:06:14.51,Main,Captain,0,0,0,,Si, ju lutem?
Dialogue: 0,0:06:14.51,0:06:15.97,Main,Arnold,0,0,0,,Merruni si të doni me këtë.
Dialogue: 0,0:06:15.97,0:06:18.32,Main,Arnold,0,0,0,,Gjithsesi, Leo do të kujdeset për gjithçka.
Dialogue: 0,0:06:19.06,0:06:20.31,Main,Captain,0,0,0,,Aman...
Dialogue: 0,0:06:20.31,0:06:24.18,Main,Captain,0,0,0,,Mendova se ishte përmirësuar pak\Nsa kohë princ Leonard s'ishte këtu...
Dialogue: 0,0:06:28.42,0:06:31.76,Main,Carlo,0,0,0,,Princ Leonard, më vjen mirë që jeni shëndoshë.
Dialogue: 0,0:06:31.76,0:06:36.09,Main,Carlo,0,0,0,,Dhe ju falënderoj që luftuat\Nkrah flotës sonë.
Dialogue: 0,0:06:36.09,0:06:40.06,Main,Carlo,0,0,0,,Por po thoni se dragoi i detit,\NLeviatano, është zgjuar?
Dialogue: 0,0:06:40.06,0:06:43.65,Main,Carlo,0,0,0,,Prandaj u shfaq ai gjarpri i detit?
Dialogue: 0,0:06:43.65,0:06:47.68,Main,Arnold,0,0,0,,Po, besoj se ky është\Nshpjegimi i saktë, Hirësi.
Dialogue: 0,0:06:49.60,0:06:52.10,Main,Elna,0,0,0,,Arn-i ende po shtiret si ti?
Dialogue: 0,0:06:52.10,0:06:56.40,Main,Leonard,0,0,0,,Shpjegohet më shpejt prej tij\Nsesa prej meje, apo jo?
Dialogue: 0,0:06:56.40,0:06:58.60,Main,Elna,0,0,0,,Po... kjo është e vërtetë.
Dialogue: 0,0:06:59.56,0:07:04.12,Main,Carlo,0,0,0,,Pra, s'është vetëm Albatro\Nnë rrezik, por edhe Rondine?
Dialogue: 0,0:07:04.12,0:07:06.81,Main,Carlo,0,0,0,,Besoj se s'mund ta shpërfillim këtë.
Dialogue: 0,0:07:06.81,0:07:10.32,Main,Carlo,0,0,0,,Nëse ndërpriten rrugët detare,\Ns'do të importojmë dot asgjë.
Dialogue: 0,0:07:10.32,0:07:12.90,Main,Carlo,0,0,0,,Ky vend do të shembet.
Dialogue: 0,0:07:13.21,0:07:15.03,Main,Arnold,0,0,0,,Keni plotësisht të drejtë.
Dialogue: 0,0:07:15.03,0:07:19.75,Main,Arnold,0,0,0,,Prandaj unë, Leonard Reks Adler,\Nsi ambasador i jashtëzakonshëm i perandorisë,
Dialogue: 0,0:07:19.75,0:07:22.10,Main,Arnold,0,0,0,,ju bëj këtë propozim, dukë Rondine.
Dialogue: 0,0:07:22.57,0:07:24.98,Main,Arnold,0,0,0,,Për t'u përballur me këtë kërcënim,
Dialogue: 0,0:07:24.98,0:07:27.19,Main,Arnold,0,0,0,,ju kërkoj t'i lini mënjanë mëritë e vjetra,
Dialogue: 0,0:07:27.19,0:07:31.82,Main,Arnold,0,0,0,,të bëni armëpushim të përkohshëm me Albatro-n\Ndhe të krijoni aleancë kundër dragoit.
Dialogue: 0,0:07:31.82,0:07:35.71,Main,Arnold,0,0,0,,Ju premtoj se perandoria\Ndo ta mbështesë këtë aleancë.
Dialogue: 0,0:07:36.84,0:07:38.42,Main,Carlo,0,0,0,,Por...
Dialogue: 0,0:07:41.37,0:07:42.54,Main,Carlo,0,0,0,,Shumë mirë.
Dialogue: 0,0:07:42.54,0:07:44.57,Main,Carlo,0,0,0,,E pranoj propozimin tuaj.
Dialogue: 0,0:07:44.57,0:07:47.46,Main,Carlo,0,0,0,,Do të pranojmë armëpushim të përkohshëm
Dialogue: 0,0:07:47.46,0:07:50.39,Main,Carlo,0,0,0,,dhe do ta dërgojmë flotën në Albatro\Npër t'u përballur me dragoin.
Dialogue: 0,0:07:50.39,0:07:52.77,Main,Carlo,0,0,0,,Filloni menjëherë përgatitjet.
Dialogue: 0,0:07:53.46,0:07:54.94,Main,Arnold,0,0,0,,Faleminderit.
Dialogue: 0,0:07:56.58,0:07:58.90,Main,Leonard,0,0,0,,Vëllai është i jashtëzakonshëm, apo jo?
Dialogue: 0,0:07:58.90,0:08:01.66,Main,Elna,0,0,0,,Atëherë pse s'i bën\Ngjithmonë gjërat siç duhet?!
Dialogue: 0,0:08:04.00,0:08:06.46,Sign_Basic,,0,0,0,,DY DITË MË VONË...\NKRYEQYTETI PERANDORAK WIRTH,\NKËSHTJELLA E SHPATËS PERANDORAKE
Dialogue: 0,0:08:06.46,0:08:08.80,Sign_Basic,Elna,0,0,0,,ZYRA E ARNOLD-IT
Dialogue: 0,0:08:10.57,0:08:14.35,Main,Arnold,0,0,0,,S'ka kaluar shumë që ika,\Npor më duket sikur ka shkuar një jetë.
Dialogue: 0,0:08:14.35,0:08:16.88,Main,Sebastian,0,0,0,,Mirë se u kthyet, princ Arnold.
Dialogue: 0,0:08:18.47,0:08:21.56,Main,Arnold,0,0,0,,Nga e dije që do të kthehesha sot?
Dialogue: 0,0:08:21.94,0:08:23.48,Main,Sebastian,0,0,0,,Fundja, jam shërbëtori juaj personal.
Dialogue: 0,0:08:23.48,0:08:25.51,Main,Arnold,0,0,0,,Kjo s'është përgjigje.
Dialogue: 0,0:08:25.51,0:08:27.67,Main,Sebastian,0,0,0,,Po shkon gjithçka mirë atje?
Dialogue: 0,0:08:27.67,0:08:28.58,Main,Arnold,0,0,0,,Po.
Dialogue: 0,0:08:28.58,0:08:31.02,Main,Arnold,0,0,0,,Duka Rondine po e drejton vetë\Nflotën e tij për në Albatro,
Dialogue: 0,0:08:31.41,0:08:36.41,Main,Arnold,0,0,0,,për të shpallur armëpushimin\Ndhe për t'u përballur me dragoin.
Dialogue: 0,0:08:36.63,0:08:37.96,Main,Arnold,0,0,0,,Leo është me të.
Dialogue: 0,0:08:38.55,0:08:41.45,Main,Arnold,0,0,0,,Unë gjoja jam në shtrat nga sëmundja e detit.
Dialogue: 0,0:08:41.86,0:08:45.58,Main,Arnold,0,0,0,,Elna ka aq frikë nga oqeani\Nsa vërtet s'pranon të dalë nga shtrati.
Dialogue: 0,0:08:47.81,0:08:52.70,Main,Arnold,0,0,0,,Dhe Albatro ka shpallur një mision zyrtar\Npër të mposhtur dragoin e detit.
Dialogue: 0,0:08:52.70,0:08:55.09,Main,Arnold,0,0,0,,Silver-i ka deklaruar se do ta pranojë.
Dialogue: 0,0:08:55.09,0:08:56.79,Main,Sebastian,0,0,0,,Atëherë gjithçka po shkon mirë.
Dialogue: 0,0:08:56.79,0:08:59.91,Main,Arnold,0,0,0,,Duket se do të jetë\Nnjë mision i klasës SS.
Dialogue: 0,0:09:00.36,0:09:02.50,Main,Arnold,0,0,0,,Hë, ç'po ndodh këtu?
Dialogue: 0,0:09:02.50,0:09:04.78,Main,Sebastian,0,0,0,,Gjërat po shkojnë mirë.
Dialogue: 0,0:09:04.78,0:09:07.32,Main,Sebastian,0,0,0,,Lynphia po dëshmon\Nse është jashtëzakonisht e talentuar.
Dialogue: 0,0:09:07.32,0:09:09.51,Main,Sebastian,0,0,0,,Por Finne është pak...
Dialogue: 0,0:09:09.76,0:09:11.02,Main,Arnold,0,0,0,,Bëri ndonjë gabim?
Dialogue: 0,0:09:11.45,0:09:14.35,Main,Sebastian,0,0,0,,Gjatë takimit me Kompaninë e Gjysmënjerëzve,
Dialogue: 0,0:09:14.35,0:09:17.24,Main,Sebastian,0,0,0,,ofroi veten\Nsi pjesë të një marrëveshjeje...
Dialogue: 0,0:09:18.83,0:09:23.08,Main,Sebastian,0,0,0,,Në fund, ata s'ishin në gjendje\Ntë ofronin asgjë me vlerë të barabartë,
Dialogue: 0,0:09:23.08,0:09:25.92,Main,Sebastian,0,0,0,,dhe ajo i vendosi kushtet lehtësisht.
Dialogue: 0,0:09:25.92,0:09:27.42,Main,Arnold,0,0,0,,Ç'vajzë që të hap telashe...
Dialogue: 0,0:09:27.42,0:09:29.67,Main,Sebastian,0,0,0,,A keni ju të drejtë\Nta quani dikë kështu?
Dialogue: 0,0:09:29.67,0:09:31.21,Main,Arnold,0,0,0,,Ç'do të thotë kjo?
Dialogue: 0,0:09:31.45,0:09:34.82,Main,Sebastian,0,0,0,,Përderisa veprimet e saj të fshehta\Nsynojnë të ndihmojnë dikë tjetër,
Dialogue: 0,0:09:34.82,0:09:36.85,Main,Sebastian,0,0,0,,çfarë ndryshimi ka nga ju?
Dialogue: 0,0:09:40.07,0:09:41.34,Main,Arnold,0,0,0,,Me leje.
Dialogue: 0,0:09:41.53,0:09:43.60,Main,Finne,0,0,0,,Oh? Zotëri Silver!
Dialogue: 0,0:09:43.88,0:09:46.10,Main,Lynphia,0,0,0,,Silver?! Ç'bëni këtu?
Dialogue: 0,0:09:46.10,0:09:47.43,Main,Silver,0,0,0,,Mirëdita.
Dialogue: 0,0:09:47.43,0:09:49.80,Main,Silver,0,0,0,,Zonjusha Finne, duhet të flas me ju.
Dialogue: 0,0:09:50.04,0:09:51.64,Main,Finne,0,0,0,,N-Në rregull.
Dialogue: 0,0:09:52.30,0:09:54.24,Main,Silver,0,0,0,,Mund të na lini vetëm?
Dialogue: 0,0:09:54.24,0:09:57.43,Main,Silver,0,0,0,,Zonjusha aventuriere, që takova\Nnë tokat e dukës Kleinert.
Dialogue: 0,0:09:57.43,0:10:00.06,Main,Lynphia,0,0,0,,Jam e nderuar që më mbani mend.
Dialogue: 0,0:10:00.06,0:10:03.08,Main,Lynphia,0,0,0,,Por tani jam truproja e saj.
Dialogue: 0,0:10:03.37,0:10:05.07,Main,Silver,0,0,0,,Dua të flas vetëm me të.
Dialogue: 0,0:10:05.07,0:10:06.76,Main,Silver,0,0,0,,Ju lutem, na jepni pak kohë bashkë.
Dialogue: 0,0:10:06.76,0:10:09.17,Main,Sebastian,0,0,0,,Silver-it mund t'i besohet.
Dialogue: 0,0:10:09.17,0:10:10.82,Main,Sebastian,0,0,0,,E garantoj unë.
Dialogue: 0,0:10:12.74,0:10:13.69,Main,Lynphia,0,0,0,,Mirë.
Dialogue: 0,0:10:18.25,0:10:20.21,Main,Finne,0,0,0,,Ka ndodhur diçka?
Dialogue: 0,0:10:20.21,0:10:24.69,Main,Arnold,0,0,0,,Shumë gjëra, por flasim më vonë për ato.
Dialogue: 0,0:10:24.69,0:10:26.34,Main,Arnold,0,0,0,,Hej, Finne...
Dialogue: 0,0:10:26.34,0:10:31.05,Main,Arnold,0,0,0,,E di që s'kam të drejtë ta them këtë,\Ndhe mbase s'do të duash ta dëgjosh.
Dialogue: 0,0:10:31.05,0:10:32.80,Main,Arnold,0,0,0,,Por më dëgjo.
Dialogue: 0,0:10:33.27,0:10:34.53,Main,Finne,0,0,0,,Po?
Dialogue: 0,0:10:34.77,0:10:37.99,Main,Arnold,0,0,0,,Për atë që i the gruas\Nsë Kompanisë së Gjysmënjerëzve...
Dialogue: 0,0:10:37.99,0:10:40.38,Main,Arnold,0,0,0,,Dua të kujdesesh\Nmë shumë për veten.
Dialogue: 0,0:10:40.38,0:10:43.27,Main,Arnold,0,0,0,,Më dhemb të të shoh të rrezikosh kështu.
Dialogue: 0,0:10:43.65,0:10:45.11,Main,Arnold,0,0,0,,S'ke pse të shkosh kaq larg.
Dialogue: 0,0:10:45.34,0:10:50.46,Main,Finne,0,0,0,,Por ndryshe s'mund\Ntë të hyj në punë...
Dialogue: 0,0:10:50.46,0:10:53.30,Main,Arnold,0,0,0,,Finne, ti je e veçantë.
Dialogue: 0,0:10:56.16,0:11:00.67,Main,Arnold,0,0,0,,Vetëm ty dhe Sebas-it\Nmund t'ju tregoj të dyja fytyrat e mia.
Dialogue: 0,0:11:00.99,0:11:04.15,Main,Arnold,0,0,0,,Ëh... Sebas-i është si kujdestar për mua.
Dialogue: 0,0:11:04.15,0:11:06.82,Main,Arnold,0,0,0,,Si një prind që ka qenë gjithmonë pranë.
Dialogue: 0,0:11:06.82,0:11:07.64,Main,Arnold,0,0,0,,Prandaj...
Dialogue: 0,0:11:09.11,0:11:11.24,Main,Arnold,0,0,0,,Ti je e vetmja tjetër\Nme të cilën mund ta bëj këtë.
Dialogue: 0,0:11:12.04,0:11:13.66,Main,Finne,0,0,0,,Zotëri Arn...
Dialogue: 0,0:11:13.66,0:11:17.50,Main,Arnold,0,0,0,,Dhe tani që e di kush jam,\Nkjo ka shumë rëndësi për mua.
Dialogue: 0,0:11:17.50,0:11:19.76,Main,Arnold,0,0,0,,Nëse Leo është vëllai im i vetëm e i pazëvendësueshëm,
Dialogue: 0,0:11:19.76,0:11:22.34,Main,Arnold,0,0,0,,ti je e vetmja që\Nndan sekretin tim.
Dialogue: 0,0:11:22.34,0:11:24.06,Main,Arnold,0,0,0,,Askush s'mund ta zërë vendin tënd.
Dialogue: 0,0:11:24.06,0:11:26.12,Main,Arnold,0,0,0,,Më mjafton të të kem pranë.
Dialogue: 0,0:11:29.08,0:11:34.54,Main,Arnold,0,0,0,,S'e ke idenë sa më ndihmon thjesht\Ntë kem dikë që ndan sekretin tim...
Dialogue: 0,0:11:39.54,0:11:41.32,Main,Arnold,0,0,0,,Ti më ndihmon gjithmonë kaq shumë.
Dialogue: 0,0:11:41.79,0:11:43.10,Main,Arnold,0,0,0,,Faleminderit.
Dialogue: 0,0:11:43.10,0:11:47.30,Main,Arnold,0,0,0,,Duhej ta kisha thënë më parë,\Npor kisha tepër gjëra në mendje.
Dialogue: 0,0:11:47.79,0:11:48.81,Main,Arnold,0,0,0,,Më fal.
Dialogue: 0,0:11:48.81,0:11:51.61,Main,Finne,0,0,0,,Jo, s'është faji yt.
Dialogue: 0,0:11:54.14,0:11:57.27,Main,Arnold,0,0,0,,Mirë, atëherë të përpiqemi të dy më shumë.
Dialogue: 0,0:11:59.21,0:12:03.37,Main,Finne,0,0,0,,Të lutem, më trego\Nçfarë po ndodh në jug.
Dialogue: 0,0:12:03.37,0:12:05.36,Main,Finne,0,0,0,,Do të ndihmoj si të mundem.
Dialogue: 0,0:12:08.41,0:12:10.13,Main,Arnold,0,0,0,,...Dhe kjo është historia.
Dialogue: 0,0:12:10.13,0:12:12.51,Main,Finne,0,0,0,,E kuptoj. U sqarova.
Dialogue: 0,0:12:12.51,0:12:17.46,Main,Finne,0,0,0,,Do që ushtria perandorake\Ntë mos përfshihet në këtë betejë, apo jo?
Dialogue: 0,0:12:17.46,0:12:18.38,Main,Arnold,0,0,0,,Po.
Dialogue: 0,0:12:18.38,0:12:22.55,Main,Arnold,0,0,0,,Besoj se më e mira është që unë,\Nsi Silver, ta vras dragoin.
Dialogue: 0,0:12:22.55,0:12:24.48,Main,Finne,0,0,0,,Jam dakord.
Dialogue: 0,0:12:24.48,0:12:29.19,Main,Finne,0,0,0,,Por çelësi është t'i bindim\Nata që e kanë vendimin në dorë.
Dialogue: 0,0:12:29.19,0:12:30.19,Main,Arnold,0,0,0,,Po.
Dialogue: 0,0:12:30.19,0:12:31.81,Main,Arnold,0,0,0,,Por unë s'mund ta bëj këtë.
Dialogue: 0,0:12:31.81,0:12:32.98,Main,Arnold,0,0,0,,Mund të të kërkoj ndihmë?
Dialogue: 0,0:12:32.98,0:12:36.57,Main,Finne,0,0,0,,Ma lër mua! Do ta bëj!
Dialogue: 0,0:12:43.90,0:12:45.40,Sign_Basic,Finne,0,0,0,,TRAUGOTT REKS ADLER
Dialogue: 0,0:12:42.19,0:12:43.90,Main,Traugott,0,0,0,,Përgjigjja është jo.
Dialogue: 0,0:12:45.40,0:12:47.49,Main,Finne,0,0,0,,Por, princ...
Dialogue: 0,0:12:47.49,0:12:52.03,Main,Traugott,0,0,0,,Edhe nëse ma kërkon Blau Mowe,\Ns'mund të bëj të pamundurën.
Dialogue: 0,0:12:52.03,0:12:54.79,Main,Traugott,0,0,0,,Tani po shkruaj kryeveprën time.
Dialogue: 0,0:12:54.79,0:12:57.47,Main,Traugott,0,0,0,,Ah, ti je Silver-i i famshëm?
Dialogue: 0,0:12:57.47,0:12:58.63,Main,Arnold,0,0,0,,Pikërisht.
Dialogue: 0,0:12:58.63,0:12:59.91,Main,Arnold,0,0,0,,Kënaqësi që ju njoh.
Dialogue: 0,0:13:00.31,0:13:04.38,Main,Traugott,0,0,0,,Ishte ideja jote të vije tek unë?
Dialogue: 0,0:13:04.38,0:13:08.78,Main,Arnold,0,0,0,,Dua mbështetje për të siguruar\Nqë ta vras dragoin.
Dialogue: 0,0:13:08.78,0:13:11.85,Main,Arnold,0,0,0,,Fatmirësisht, zotëruesja e shpatës\Nsë shenjtë ndodhet tani në jug.
Dialogue: 0,0:13:11.85,0:13:14.42,Main,Traugott,0,0,0,,Dhe, meqë jam princi i katërt,
Dialogue: 0,0:13:14.42,0:13:17.09,Main,Traugott,0,0,0,,doni të shkoj në jug\Ndhe të jap lejen
Dialogue: 0,0:13:17.09,0:13:19.66,Main,Traugott,0,0,0,,për përdorimin e shpatës së shenjtë\Nnë emër të perandorit?
Dialogue: 0,0:13:19.66,0:13:21.45,Main,Traugott,0,0,0,,Jo vëllezërit e mëdhenj apo motra e vogël?
Dialogue: 0,0:13:21.64,0:13:24.50,Main,Arnold,0,0,0,,Do të shkaktonte telashe\Ndërgimi i ushtrisë në jug,
Dialogue: 0,0:13:24.50,0:13:26.52,Main,Arnold,0,0,0,,kur dragoi i detit është atje.
Dialogue: 0,0:13:27.68,0:13:30.73,Main,Traugott,0,0,0,,S'doni t'i përfshini të dy vendet\Nnë luftën për fronin?
Dialogue: 0,0:13:30.73,0:13:32.69,Main,Traugott,0,0,0,,Shumë e mprehtë nga ana juaj.
Dialogue: 0,0:13:32.69,0:13:36.25,Main,Traugott,0,0,0,,Por siç e shihni, jam mjaft i zënë,\Nndaj ju lutem largohuni.
Dialogue: 0,0:13:36.25,0:13:38.82,Main,Finne,0,0,0,,Princ, shkrimtarët më të mirë\Nkanë qenë gjithmonë ata
Dialogue: 0,0:13:38.82,0:13:40.95,Main,Finne,0,0,0,,që kanë pasur përvojat\Nmë interesante.
Dialogue: 0,0:13:42.42,0:13:46.17,Main,Finne,0,0,0,,Dhe të ngrihesh për të mbrojtur jugun\Ns'do të ishte vetëm përvojë e mirë,
Dialogue: 0,0:13:46.17,0:13:47.72,Main,Finne,0,0,0,,por do t'ju sillte edhe famë.
Dialogue: 0,0:13:47.72,0:13:52.30,Main,Finne,0,0,0,,Shumë njerëz të letrave do t'ju vizitojnë,\Ntë tërhequr nga fama juaj.
Dialogue: 0,0:13:52.30,0:13:55.97,Main,Finne,0,0,0,,A s'vlen kjo më shumë\Nse kryevepra që po shkruani tani?
Dialogue: 0,0:13:55.97,0:13:57.23,Main,Traugott,0,0,0,,Mund t'ju pyes diçka?
Dialogue: 0,0:13:57.23,0:13:57.89,Main,Finne,0,0,0,,Sigurisht.
Dialogue: 0,0:13:57.89,0:14:00.82,Main,Traugott,0,0,0,,Zonjusha Finne, pse jeni këtu?
Dialogue: 0,0:14:00.82,0:14:02.72,Main,Traugott,0,0,0,,Kjo është pjesë\Ne luftës për fronin?
Dialogue: 0,0:14:02.72,0:14:04.61,Main,Traugott,0,0,0,,Apo ka ndonjë arsye tjetër?
Dialogue: 0,0:14:04.95,0:14:08.82,Main,Finne,0,0,0,,A duhet arsye për t'i shpëtuar\Nnjerëzit që i ke për zemër?
Dialogue: 0,0:14:15.11,0:14:16.09,Main,Traugott,0,0,0,,Fisnike!
Dialogue: 0,0:14:16.09,0:14:17.42,Main,Traugott,0,0,0,,Sa fisnike!
Dialogue: 0,0:14:17.42,0:14:18.34,Main,Traugott,0,0,0,,Shumë mirë!
Dialogue: 0,0:14:18.34,0:14:20.81,Main,Traugott,0,0,0,,Përballë një përgjigjeje\Nkaq të bukur e të sinqertë,
Dialogue: 0,0:14:20.81,0:14:24.57,Main,Traugott,0,0,0,,unë, Traugott, do ta turpëroja veten si autor\Npo të mos pranoja të ndihmoja!
Dialogue: 0,0:14:24.57,0:14:27.49,Main,Traugott,0,0,0,,A mund ta marr pagesën\Nnë formën e kësaj shprehjeje?
Dialogue: 0,0:14:27.05,0:14:28.80,Sign_Basic,Traugott,0,0,0,,A DUHET ARSYE PËR T'I SHPËTUAR\NNJERËZIT QË I KE PËR ZEMËR?
Dialogue: 0,0:14:32.14,0:14:33.22,Main,Traugott,0,0,0,,Baba!
Dialogue: 0,0:14:33.22,0:14:35.53,Main,Traugott,0,0,0,,Kam ardhur me një kërkesë!
Dialogue: 0,0:14:35.53,0:14:36.22,Main,Traugott,0,0,0,,Të lutem, më lejo të...
Dialogue: 0,0:14:36.22,0:14:37.28,Main,Johannes,0,0,0,,Ç'paturpësi!
Dialogue: 0,0:14:37.28,0:14:38.95,Main,Johannes,0,0,0,,Mos ma ndërprit mbledhjen!
Dialogue: 0,0:14:38.95,0:14:40.19,Main,Johannes,0,0,0,,Dhe mos bërtit kaq fort, dreqi ta hajë!
Dialogue: 0,0:14:41.31,0:14:43.20,Main,Traugott,0,0,0,,K-Kërkoj ndjesë...
Dialogue: 0,0:14:43.20,0:14:44.59,Main,Johannes,0,0,0,,Zhduku...
Dialogue: 0,0:14:44.59,0:14:47.62,Main,Johannes,0,0,0,,Ja një vizitor i rrallë.
Dialogue: 0,0:14:48.74,0:14:51.95,Main,Silver,0,0,0,,Unë, Silver, paraqitem\Npara Madhërisë Suaj.
Dialogue: 0,0:14:51.95,0:14:54.10,Main,Johannes,0,0,0,,Çfarë do?
Dialogue: 0,0:14:54.10,0:14:56.53,Main,Johannes,0,0,0,,Është për dragoin e detit në jug?
Dialogue: 0,0:14:56.80,0:15:02.00,Main,Silver,0,0,0,,Esnafi i Aventurierëve shqetësohet\Nse mos ndërhyni.
Dialogue: 0,0:15:02.90,0:15:05.56,Main,Johannes,0,0,0,,«Ndërhyjmë»? Kjo është mënyrë e vrazhdë të foluri.
Dialogue: 0,0:15:05.56,0:15:09.21,Main,Johannes,0,0,0,,Do të ishte gabim\Ntë përpiqeshim ta shpëtonim jugun?
Dialogue: 0,0:15:09.46,0:15:11.24,Main,Silver,0,0,0,,S'e kam problem këtë.
Dialogue: 0,0:15:11.24,0:15:13.25,Main,Silver,0,0,0,,S'e di çfarë mendon esnafi,
Dialogue: 0,0:15:13.25,0:15:16.97,Main,Silver,0,0,0,,por po vepruat siç duhet,\Nmund të shpëtoni shumë jetë.
Dialogue: 0,0:15:17.37,0:15:21.06,Main,Silver,0,0,0,,Shqetësimi im është\Nse s'do të veproni siç duhet.
Dialogue: 0,0:15:21.34,0:15:25.77,Main,Johannes,0,0,0,,Atëherë ta dëgjojmë ç'nënkupton\Nme «të veprojmë siç duhet».
Dialogue: 0,0:15:25.77,0:15:29.14,Main,Silver,0,0,0,,Shpjegimi është detyra\Ne njerëzve pas meje.
Dialogue: 0,0:15:29.14,0:15:30.37,Main,Finne,0,0,0,,Me leje.
Dialogue: 0,0:15:30.62,0:15:32.95,Main,Johannes,0,0,0,,Dukesh mirë, Finne.
Dialogue: 0,0:15:32.95,0:15:37.73,Main,Finne,0,0,0,,Madhëria Juaj, më falni\Nqë ndërhyj kështu.
Dialogue: 0,0:15:39.66,0:15:43.25,Main,Johannes,0,0,0,,S'ka gjë. Ti je gjithmonë e mirëpritur.
Dialogue: 0,0:15:43.25,0:15:44.96,Main,Traugott,0,0,0,,B-Baba... Unë...
Dialogue: 0,0:15:44.96,0:15:46.32,Main,Johannes,0,0,0,,«Madhëria Juaj!»
Dialogue: 0,0:15:47.45,0:15:49.34,Main,Traugott,0,0,0,,M-Madhëria Juaj...
Dialogue: 0,0:15:49.34,0:15:55.17,Main,Traugott,0,0,0,,Shkurt, do të doja të më dërgonit\Nnë jug si përfaqësuesin tuaj...
Dialogue: 0,0:15:55.17,0:15:57.68,Main,Zandra,0,0,0,,Mos fol marrëzira, derr.
Dialogue: 0,0:15:57.68,0:16:00.02,Main,Erik,0,0,0,,S'më pëlqen që\Npo përfshihesh në këtë.
Dialogue: 0,0:16:00.69,0:16:02.73,Main,Gordon,0,0,0,,Nëse ndërhyn, do të të dërrmoj.
Dialogue: 0,0:16:02.98,0:16:04.43,Main,Traugott,0,0,0,,Të më dërrmosh?!
Dialogue: 0,0:16:07.60,0:16:10.57,Main,Finne,0,0,0,,Ju lutem, më dëgjoni, Madhëri.
Dialogue: 0,0:16:10.57,0:16:14.66,Main,Finne,0,0,0,,S'ka pasur kurrë rast që një ushtri\Ntë dërgohej për të mposhtur një dragua.
Dialogue: 0,0:16:14.66,0:16:18.37,Main,Finne,0,0,0,,Sepse për këtë duhen aftësi,\Njo numra.
Dialogue: 0,0:16:20.88,0:16:24.98,Main,Finne,0,0,0,,Ndaj besoj se mënyra më e shpejtë\Npër ta zgjidhur këtë problem
Dialogue: 0,0:16:24.98,0:16:27.92,Main,Finne,0,0,0,,është ta dërgoni princ Traugott-in\Nsi përfaqësuesin tuaj,
Dialogue: 0,0:16:27.92,0:16:30.47,Main,Finne,0,0,0,,që t'i japë Elna-s leje\Npër përdorimin e shpatës së shenjtë.
Dialogue: 0,0:16:30.76,0:16:35.96,Main,Johannes,0,0,0,,Por Finne, pse duhet të jetë Trau?
Dialogue: 0,0:16:36.33,0:16:39.68,Main,Finne,0,0,0,,Sepse tre të tjerët\Nkanë pozitë tepër të lartë.
Dialogue: 0,0:16:39.68,0:16:44.98,Main,Finne,0,0,0,,T'u jepet vetëm detyra e sjelljes së shpatës\Ndo t'ua dëmtonte reputacionin.
Dialogue: 0,0:16:44.98,0:16:48.64,Main,Finne,0,0,0,,Por me princ Traugott-in,\Nky shqetësim s'ekziston.
Dialogue: 0,0:16:48.64,0:16:50.72,Main,Traugott,0,0,0,,Au...
Dialogue: 0,0:16:50.72,0:16:52.11,Main,Zandra,0,0,0,,Lojë fjalësh.
Dialogue: 0,0:16:52.11,0:16:56.85,Main,Zandra,0,0,0,,Kush ta shpëtojë i vetëm jugun\Ndo të fitojë famë të madhe.
Dialogue: 0,0:16:56.85,0:16:59.57,Main,Zandra,0,0,0,,Refuzoj të bashkëpunoj\Nme Esnafin e Aventurierëve.
Dialogue: 0,0:16:59.57,0:17:03.50,Main,Gordon,0,0,0,,Madhëria Juaj, ma lini mua këtë.
Dialogue: 0,0:17:03.50,0:17:06.41,Main,Gordon,0,0,0,,Do ta shfrytëzoj këtë situatë\Npër ta pushtuar jugun!
Dialogue: 0,0:17:06.64,0:17:09.01,Main,Johannes,0,0,0,,Sa njeri i sinqertë që je.
Dialogue: 0,0:17:09.01,0:17:11.17,Main,Johannes,0,0,0,,Por jugun s'e kemi të nevojshëm tani.
Dialogue: 0,0:17:11.17,0:17:15.08,Main,Johannes,0,0,0,,Nëse e do, mund ta marrësh\Nkur të bëhesh perandor.
Dialogue: 0,0:17:15.08,0:17:17.00,Main,Johannes,0,0,0,,Çfarë mendon, Erik?
Dialogue: 0,0:17:17.31,0:17:20.22,Main,Erik,0,0,0,,Jam dakord me Finne-n.
Dialogue: 0,0:17:20.42,0:17:21.41,Main,Johannes,0,0,0,,Oh?
Dialogue: 0,0:17:21.41,0:17:23.56,Main,Erik,0,0,0,,Është mënyra më e lehtë.
Dialogue: 0,0:17:23.56,0:17:25.56,Main,Erik,0,0,0,,Propozimet e Zandra-s dhe Gordon-it
Dialogue: 0,0:17:25.56,0:17:28.64,Main,Erik,0,0,0,,jo vetëm do të dëmtonin marrëdhëniet\Nme Esnafin e Aventurierëve...
Dialogue: 0,0:17:28.64,0:17:33.84,Main,Erik,0,0,0,,Mund t'ia ulin njerëzve mendimin\Npër perandorinë dhe për ju vetë.
Dialogue: 0,0:17:35.25,0:17:38.48,Main,Johannes,0,0,0,,Shumë mirë. Atëherë do të ndjekim\Npropozimin e Finne-s.
Dialogue: 0,0:17:38.48,0:17:41.98,Main,Johannes,0,0,0,,Për momentin, pushtimi i jugut\Nna sjell pak përfitim,
Dialogue: 0,0:17:41.98,0:17:44.17,Main,Johannes,0,0,0,,dhe s'ia vlen të dërgojmë ushtrinë.
Dialogue: 0,0:17:44.17,0:17:45.62,Main,Zandra,0,0,0,,Por, baba...
Dialogue: 0,0:17:45.62,0:17:47.37,Main,Johannes,0,0,0,,«Madhëria Juaj».
Dialogue: 0,0:17:47.78,0:17:52.16,Main,Zandra,0,0,0,,Por Madhëri, s'ka nevojë\Ntë ndjekim planin e një aventurieri.
Dialogue: 0,0:17:52.45,0:17:57.22,Main,Johannes,0,0,0,,S'jam dakord. Shpërfillja e esnafit\Nnë Keel na dëmtoi rëndë.
Dialogue: 0,0:17:57.22,0:18:00.87,Main,Johannes,0,0,0,,Këtë herë do të ndjekim\Nplanin e Silver-it.
Dialogue: 0,0:18:00.87,0:18:03.68,Main,Johannes,0,0,0,,Me siguri do të të vinte mirë\Ntë kishe Elna-n me vete, apo jo, Silver?
Dialogue: 0,0:18:04.00,0:18:08.82,Main,Silver,0,0,0,,Fundja, do të ishte mjaft e vështirë\Nta mposhtje i vetëm Leviatano-n.
Dialogue: 0,0:18:09.61,0:18:11.03,Main,Johannes,0,0,0,,Afrohu.
Dialogue: 0,0:18:11.03,0:18:12.89,Main,Traugott,0,0,0,,P-Po, sigurisht.
Dialogue: 0,0:18:15.56,0:18:20.04,Main,Johannes,0,0,0,,Urdhëroj Traugott Reks Adler-in\Ntë veprojë në emrin tim.
Dialogue: 0,0:18:20.04,0:18:23.52,Main,Johannes,0,0,0,,Shko në jug\Ndhe çoji heroinës shpatën e saj.
Dialogue: 0,0:18:23.52,0:18:26.38,Main,Johannes,0,0,0,,Kjo do të jetë shenja jote\Nsi përfaqësuesi im.
Dialogue: 0,0:18:26.38,0:18:28.24,Main,Traugott,0,0,0,,Po, Madhëria Juaj.
Dialogue: 0,0:18:31.16,0:18:35.00,Main,Johannes,0,0,0,,Silver, kujdesu për Trau-n, djalin tim.
Dialogue: 0,0:18:35.24,0:18:36.70,Main,Silver,0,0,0,,Mos kini frikë.
Dialogue: 0,0:18:36.70,0:18:39.21,Main,Silver,0,0,0,,Do t'jua kthej\Npa asnjë gërvishtje.
Dialogue: 0,0:18:41.10,0:18:44.76,Main,Traugott,0,0,0,,Do të parapëlqeja të më\Nshoqëronte një vajzë e bukur.
Dialogue: 0,0:18:46.94,0:18:50.15,Sign_Basic,,0,0,0,,{\pos(320,230)}ALBATRO, TË NESËRMEN
Dialogue: 0,0:18:51.60,0:18:54.73,Main,Donato,0,0,0,,Mirë se erdhët, dukë Rondine!
Dialogue: 0,0:18:54.73,0:18:59.25,Main,Carlo,0,0,0,,S'mund të rrija në shtëpi në këto\Nrrethana, dukë Albatro.
Dialogue: 0,0:18:59.25,0:19:03.33,Main,Carlo,0,0,0,,Të shpallim armëpushim dhe t'i dalim\Nsë bashku përballë dragoit të detit!
Dialogue: 0,0:19:03.33,0:19:05.07,Main,Donato,0,0,0,,Ju falënderoj për bashkëpunimin.
Dialogue: 0,0:19:05.46,0:19:10.32,Main,Leonard,0,0,0,,Si ambasador i jashtëzakonshëm i perandorisë,\Njap dëshminë time për këtë armëpushim.
Dialogue: 0,0:19:10.32,0:19:15.66,Main,Leonard,0,0,0,,Të bashkëpunojmë me Esnafin e Aventurierëve\Npër ta luftuar dragoin e detit!
Dialogue: 0,0:19:20.00,0:19:21.14,Main,Elna,0,0,0,,Ku është Arn-i?
Dialogue: 0,0:19:21.14,0:19:22.59,Main,Marc,0,0,0,,S'është këtu?
Dialogue: 0,0:19:22.90,0:19:24.84,Main,Elna,0,0,0,,Ende po fle?
Dialogue: 0,0:19:24.84,0:19:27.35,Main,Elna,0,0,0,,Ai njeri...
Dialogue: 0,0:19:49.20,0:19:51.71,Main,Leviatano,0,0,0,,Njerëz të mjerë!
Dialogue: 0,0:19:51.71,0:19:55.84,Main,Leviatano,0,0,0,,Dëgjoni zërin e urrejtjes sime shumëvjeçare!
Dialogue: 0,0:19:58.96,0:20:00.08,Main,Carlo,0,0,0,,Kjo është...
Dialogue: 0,0:20:00.08,0:20:00.97,Main,Donato,0,0,0,,S'ka mundësi...
Dialogue: 0,0:20:00.97,0:20:01.97,Main,Messenger,0,0,0,,Raportim!
Dialogue: 0,0:20:01.97,0:20:04.29,Main,Messenger,0,0,0,,Dragoi i detit Leviatano është shfaqur!
Dialogue: 0,0:20:09.41,0:20:10.68,Main,Finne,0,0,0,,Bëni kujdes...
Dialogue: 0,0:20:11.48,0:20:14.43,Main,Traugott,0,0,0,,Zonjusha Finne, do të kthehem.
Dialogue: 0,0:20:14.43,0:20:15.15,Main,Silver,0,0,0,,Tani...
Dialogue: 0,0:20:15.46,0:20:16.48,Main,Finne,0,0,0,,Zotëri Silver!
Dialogue: 0,0:20:20.61,0:20:21.52,Main,Finne,0,0,0,,Ëh...
Dialogue: 0,0:20:22.84,0:20:24.99,Main,Silver,0,0,0,,S'ka asgjë për t'u shqetësuar.
Dialogue: 0,0:20:26.46,0:20:27.49,Main,Finne,0,0,0,,Po.
Dialogue: 0,0:20:33.73,0:20:35.67,Main,Finne,0,0,0,,Të lutem, ruaju.
Dialogue: 0,0:20:35.67,0:20:37.42,Main,Finne,0,0,0,,Dhe kthehu shpejt...
Dialogue: 0,0:20:49.67,0:20:52.35,Main,Carlo,0,0,0,,Zjarr! Zjarr!
Dialogue: 0,0:20:52.66,0:20:57.32,Main,Carlo,0,0,0,,Dragoi i detit Leviatano,\Nflotat e Rondine-s të dalin përballë!
Dialogue: 0,0:21:01.93,0:21:04.24,Main,Donato,0,0,0,,Mos mbetni pas flotës së Rondine-s!
Dialogue: 0,0:21:04.24,0:21:07.44,Main,Donato,0,0,0,,Leviatano, ne do ta mbrojmë Albatro-n!
Dialogue: 0,0:21:10.45,0:21:12.37,Main,Leonard,0,0,0,,Këtej, Leviatano!
Dialogue: 0,0:21:13.48,0:21:14.91,Main,Leonard,0,0,0,,Ku janë vëllai im dhe Elna?
Dialogue: 0,0:21:15.25,0:21:17.34,Main,Captain,0,0,0,,Princ Arnold s'është në anije.
Dialogue: 0,0:21:17.34,0:21:20.22,Main,Captain,0,0,0,,Me siguri është kthyer në kështjellë,\Nduke u dridhur nga frika.
Dialogue: 0,0:21:20.22,0:21:23.38,Main,Captain,0,0,0,,Komandantja Elna është në tokë\Nduke ndihmuar me evakuimin.
Dialogue: 0,0:21:23.38,0:21:24.53,Main,Leonard,0,0,0,,U kuptua!
Dialogue: 0,0:21:24.53,0:21:27.93,Main,Leonard,0,0,0,,Dukë Albatro! Dukë Rondine! Tërhiquni!
Dialogue: 0,0:21:27.93,0:21:28.83,Main,Leonard,0,0,0,,Është e rrezikshme!
Dialogue: 0,0:21:29.12,0:21:31.07,Main,Donato,0,0,0,,Tërhiqjani vëmendjen Leviatano-s!
Dialogue: 0,0:21:31.07,0:21:32.91,Main,Donato,0,0,0,,Kombi ynë është në rrezik të madh!
Dialogue: 0,0:21:32.91,0:21:34.75,Main,Carlo,0,0,0,,Tani që kemi krijuar aleancë,
Dialogue: 0,0:21:34.75,0:21:37.99,Main,Carlo,0,0,0,,banorët e Albatro-s vlejnë për ne\Npo aq sa populli ynë!
Dialogue: 0,0:21:37.99,0:21:40.49,Main,Carlo,0,0,0,,Do të luftojmë për ta mbrojtur popullin!
Dialogue: 0,0:21:40.70,0:21:43.78,Main,Leonard,0,0,0,,Dukë Albatro... Dukë Rondine...
Dialogue: 0,0:21:43.78,0:21:44.70,Main,Marc,0,0,0,,Princ.
Dialogue: 0,0:21:45.12,0:21:46.20,Main,Leonard,0,0,0,,Po...
Dialogue: 0,0:21:46.20,0:21:48.81,Main,Leonard,0,0,0,,Shumë mirë! Do të luftojmë bashkë!
Dialogue: 0,0:21:49.25,0:21:51.16,Main,Leonard,0,0,0,,Hapni zjarr!
Dialogue: 0,0:21:57.74,0:21:58.91,Main,Elna,0,0,0,,Shpejt!
Dialogue: 0,0:22:00.79,0:22:03.49,Main,Elna,0,0,0,,Ah, sikur ta kisha shpatën e shenjtë...

