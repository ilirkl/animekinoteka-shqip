Dialogue: 0,0:00:05.27,0:00:07.98,Signs,,0,0,0,,{\fad(1500,000)\bord0\fs15\fscx108\fscy77\pos(463.111,75.111)\c&H03032C&}Vajza Magjike Lirike Nanoha
Dialogue: 0,0:00:15.97,0:00:16.98,Default,Towa,0,0,0,,Shinomiya është...
Dialogue: 0,0:00:20.63,0:00:22.14,Default,Towa,0,0,0,,ende gjallë?
Dialogue: 0,0:00:23.26,0:00:26.19,Default,Towa,0,0,0,,Trupi i saj i poshtëm dhe tentakulat \Npo ju synonin,
Dialogue: 0,0:00:26.19,0:00:28.02,Default,Towa,0,0,0,,por i hoqa qafe.
Dialogue: 0,0:00:29.52,0:00:30.97,Default,Shiina,0,0,0,,Faleminderit.
Dialogue: 0,0:00:30.97,0:00:35.34,Default,Shiina,0,0,0,,Por gjysma e sipërme iku në momentin \Nqë dhashë goditjen e fundit.
Dialogue: 0,0:00:36.75,0:00:38.19,Default,Shiina,0,0,0,,Duhet ta gjejmë.
Dialogue: 0,0:00:39.75,0:00:41.67,Default,Shiina,0,0,0,,Nano-chan, Fate-chan!
Dialogue: 0,0:00:41.67,0:00:43.83,Italics,Nanoha,0,0,0,,Shiina-san! A je mirë?
Dialogue: 0,0:00:43.83,0:00:45.04,Default,Shiina,0,0,0,,Zor se.
Dialogue: 0,0:00:45.04,0:00:46.01,Default,Shiina,0,0,0,,Po ju të dyja?
Dialogue: 0,0:00:46.48,0:00:48.65,Default,Fate,0,0,0,,E shfarosëm Zero,
Dialogue: 0,0:00:48.65,0:00:50.61,Default,Fate,0,0,0,,por diçka nuk shkon.
Dialogue: 0,0:00:51.02,0:00:52.55,Italics,Shiina,0,0,0,,Më vjen keq për atë që ndodhi nga ana ime.
Dialogue: 0,0:00:52.55,0:00:54.32,Italics,Shiina,0,0,0,,Shinomiya më shpëtoi.
Dialogue: 0,0:01:09.67,0:01:14.10,Default,Hayate,0,0,0,,Më thanë se Shinomiya refuzoi të \Nbashkëpunonte me kërkimin tonë dhe iku.
Dialogue: 0,0:01:14.91,0:01:17.80,Default,Hayate,0,0,0,,Edhe Zero ka filluar \Ntë dalë jashtë kontrollit.
Dialogue: 0,0:01:18.20,0:01:20.18,Default,Hayate,0,0,0,,A mund ta ndaloni për ne?
Dialogue: 0,0:01:21.91,0:01:27.07,Default,Hayate,0,0,0,,Edhe ti edhe Shinomiya do të \Npërballeni me një hetim zyrtar.
Dialogue: 0,0:01:27.07,0:01:31.93,Default,Hayate,0,0,0,,Kështu edhe marrëveshjet e tua me\Noficerët e lartë të policisë që përdorën drogat e tua Diaboli.
Dialogue: 0,0:01:31.93,0:01:34.36,Default,Hayate,0,0,0,,Do të \Nakuzohesh për krimet e tua.
Dialogue: 0,0:01:34.36,0:01:37.01,Default,Hayate,0,0,0,,Pra, lejimi i çdo dëmi tjetër është thjesht—
Dialogue: 0,0:01:37.01,0:01:40.17,Default,Kuragi,0,0,0,,Po sugjeron që të bashkëpunoj me arrestimin\Ne Manës, sepse s'ka kuptim të mos e bëj?
Dialogue: 0,0:01:41.22,0:01:42.20,Default,Hayate,0,0,0,,Po.
Dialogue: 0,0:01:42.94,0:01:44.95,Default,Kuragi,0,0,0,,Pse do ta bëja ndonjëherë diçka të tillë?
Dialogue: 0,0:01:45.51,0:01:49.91,Default,Kuragi,0,0,0,,Nuk kam asgjë që dua të mbroj \Nme çmimin e tradhtimit të saj.
Dialogue: 0,0:01:50.81,0:01:52.63,Default,Hayate,0,0,0,,A është Shinomiya...
Dialogue: 0,0:01:52.63,0:01:54.31,Default,Hayate,0,0,0,,A është ajo...?
Dialogue: 0,0:01:58.56,0:02:01.10,Default,Kuragi,0,0,0,,Ajo është një përbindësh i dhunshëm dhe i rrezikshëm.
Dialogue: 0,0:02:01.10,0:02:03.29,Default,Kuragi,0,0,0,,Është egoiste dhe e papërgjegjshme.
Dialogue: 0,0:02:05.14,0:02:08.48,Default,Kuragi,0,0,0,,E megjithatë është disi e sinqertë \Npër ëndrrën e saj.
Dialogue: 0,0:02:12.41,0:02:14.49,Flashback,Mana,0,0,0,,Kjo është argëtuese!
Dialogue: 0,0:02:14.49,0:02:16.33,Flashback,Mana,0,0,0,,Jam kaq e lumtur!
Dialogue: 0,0:02:18.11,0:02:20.62,Flashback,Mana,0,0,0,,Gjithçka është falë teje, Eiji-kun!
Dialogue: 0,0:02:20.62,0:02:22.97,Flashback,Mana,0,0,0,,Ky është Eiji-kun im!
Dialogue: 0,0:02:22.97,0:02:25.17,Flashback,Mana,0,0,0,,Ti je shoku im më i mirë!
Dialogue: 0,0:02:26.78,0:02:30.02,Default,Kuragi,0,0,0,,Ajo ka një buzëqeshje të pafajshme \Nmegjithëse është e ligë.
Dialogue: 0,0:02:32.28,0:02:34.23,Default,Kuragi,0,0,0,,Ajo është thjesht bashkëpunëtorja ime në krim.
Dialogue: 0,0:02:36.63,0:02:39.54,Default,Hayate,0,0,0,,Tani do ta ndaloj atë.
Dialogue: 0,0:02:39.54,0:02:40.99,Default,Hayate,0,0,0,,Ju lutem, mbani një sy mbi të.
Dialogue: 0,0:02:40.99,0:02:41.93,Default,Staff,0,0,0,,Po, zonjë!
Dialogue: 0,0:02:46.64,0:02:50.12,Default,Mana,0,0,0,,Më dhemb...! Kjo më dhemb!!
Dialogue: 0,0:02:50.90,0:02:53.25,Italics,Mana,0,0,0,,Plagët e mia nuk po shërohen.
Dialogue: 0,0:02:53.25,0:02:56.59,Italics,Mana,0,0,0,,Ajo vodhi gjithë fuqinë që kisha grumbulluar.
Dialogue: 0,0:02:58.64,0:03:02.16,Italics,Mana,0,0,0,,Megjithatë, kjo nuk ka mbaruar ende!
Dialogue: 0,0:03:02.43,0:03:08.56,Italics,Mana,0,0,0,,Sapo të kthehem te Eiji-kun, \Nai do të gjejë një zgjidhje!
Dialogue: 0,0:03:08.56,0:03:14.19,Italics,Mana,0,0,0,,Por më duhet të rifitoj \Npak fuqi më parë.
Dialogue: 0,0:03:22.68,0:03:27.43,Italics,Mana,0,0,0,,Njerëzit e asaj grupi të OKB-së janë \Nvendosur rreth fidanit që rrita.
Dialogue: 0,0:03:27.43,0:03:29.05,Default,Mana,0,0,0,,Keq për ju!
Dialogue: 0,0:03:29.05,0:03:33.44,Default,Mana,0,0,0,,Trupi kryesor i bimës sime \Ntë vogël të bukur është këtu!
Dialogue: 0,0:03:34.17,0:03:36.02,Default,Mana,0,0,0,,Bimë në vazo!
Dialogue: 0,0:03:36.02,0:03:38.93,Default,Mana,0,0,0,,Më jep fuqi përsëri!
Dialogue: 0,0:03:45.73,0:03:49.13,Default,Mana,0,0,0,,Kështu, kështu, kështu!
Dialogue: 0,0:03:50.79,0:03:52.97,Default,Mana,0,0,0,,Plagët e mia u shëruan plotësisht!
Dialogue: 0,0:03:52.97,0:03:55.71,Default,Mana,0,0,0,,Ndjehem shkëlqyeshëm!
Dialogue: 0,0:03:55.95,0:04:00.58,Default,Mana,0,0,0,,Do të marr fuqinë e Setsunës \Ndhe do të kap edhe Towa-chan!
Dialogue: 0,0:04:00.58,0:04:02.96,Default,Mana,0,0,0,,Ëndrrat e mia nuk kanë fund!
Dialogue: 0,0:04:02.96,0:04:05.27,Default,Mana,0,0,0,,Të rregulloj farat?
Dialogue: 0,0:04:05.27,0:04:07.02,Default,Mana,0,0,0,,Kjo është e kotë!
Dialogue: 0,0:04:07.02,0:04:10.71,Default,Mana,0,0,0,,Do të bëhem edhe më e fortë!
Dialogue: 0,0:04:11.56,0:04:12.75,Default,Mana,0,0,0,,Hë?
Dialogue: 0,0:04:12.75,0:04:15.22,Default,Mana,0,0,0,,Nuk mund ta thith?
Dialogue: 0,0:04:16.59,0:04:17.73,Default,Mana,0,0,0,,Hë?
Dialogue: 0,0:04:17.73,0:04:19.19,Default,Mana,0,0,0,,Prit?!
Dialogue: 0,0:04:19.19,0:04:21.53,Default,Mana,0,0,0,,Pse po më thith mua?!
Dialogue: 0,0:04:24.74,0:04:26.18,Default,Mana,0,0,0,,Nuk mund ta ndaloj!
Dialogue: 0,0:04:26.18,0:04:27.90,Default,Mana,0,0,0,,Jo, jo!
Dialogue: 0,0:04:27.90,0:04:29.94,Default,Mana,0,0,0,,Po merr edhe aftësinë time!
Dialogue: 0,0:04:29.94,0:04:34.05,Default,Mana,0,0,0,,Kjo do të thotë se Zero po më konsumon!
Dialogue: 0,0:04:34.05,0:04:35.84,Default,Mana,0,0,0,,Jo!
Dialogue: 0,0:04:35.84,0:04:41.26,Default,Mana,0,0,0,,Nuk e dua këtë!
Dialogue: 0,0:04:51.48,0:04:55.34,Italics,Mana,0,0,0,,Çfarë bëra gabim?
Dialogue: 0,0:04:56.00,0:04:58.83,Italics,Mana,0,0,0,,Nuk mund të bëj asgjë nëse \Nnuk bëhem më e fortë.
Dialogue: 0,0:04:59.14,0:05:01.90,Italics,Mana,0,0,0,,Nuk mund të bëj asgjë për askënd.
Dialogue: 0,0:05:02.34,0:05:06.99,Italics,Mana,0,0,0,,Nuk do të kisha mundur të bëja asgjë\Npo të isha e dobët.
Dialogue: 0,0:05:07.62,0:05:11.88,Default,Mana,0,0,0,,Eiji-kun, më shpëto!
Dialogue: 0,0:05:31.85,0:05:33.06,Default,Towa,0,0,0,,Çfarë është ajo?
Dialogue: 0,0:05:34.84,0:05:36.68,Default,Shiina,0,0,0,,Paraardhësi Zero?!
Dialogue: 0,0:05:46.46,0:05:48.74,Default,Luke,0,0,0,,Ky është qendra e komandimit \Ne degës së Lindjes së Largët.
Dialogue: 0,0:05:49.28,0:05:53.83,Default,Luke,0,0,0,,Kemi konfirmuar një variant mutant \Ntë Paraardhësit Zero në Polin e Jugut.
Dialogue: 0,0:05:54.35,0:05:56.94,Default,Luke,0,0,0,,Pjesët që kanë depërtuar në \Nsipërfaqe janë grykëzat e hedhjes.
Dialogue: 0,0:05:56.94,0:06:00.49,Default,Luke,0,0,0,,Qëllimi i organit duket se është të \Nlëshojë dhe shpërndajë fara e vezë.
Dialogue: 0,0:06:00.84,0:06:02.52,Default,Hayate,0,0,0,,Cila është rreze e parashikuar e shpërndarjes?
Dialogue: 0,0:06:02.52,0:06:05.30,Italics,Luke,0,0,0,,Do të arrijë të gjithë \Nhemisferën jugore brenda një jave.
Dialogue: 0,0:06:05.30,0:06:09.55,Italics,Luke,0,0,0,,Në varësi të sasisë së lëshuar,\Nato mund të arrijnë edhe të gjithë botën.
Dialogue: 0,0:06:10.19,0:06:11.55,Italics,Rein,0,0,0,,Flet Yagami nga shtabi qendror.
Dialogue: 0,0:06:12.08,0:06:15.78,Default,Rein,0,0,0,,Shtabi ynë qendror po shkëmben \Ninformacione me secilën degë.
Dialogue: 0,0:06:16.38,0:06:19.02,Default,Rein,0,0,0,,Nëse ky variant mutant i \NZeros fillon të shumohet,
Dialogue: 0,0:06:19.02,0:06:21.34,Default,Rein,0,0,0,,do të shkaktojë një katastrofë botërore.
Dialogue: 0,0:06:21.72,0:06:24.36,Default,Rein,0,0,0,,Dëshironi të kërkoni \Nvendosjen e kalorësve tuaj?
Dialogue: 0,0:06:24.36,0:06:25.78,Default,Hayate,0,0,0,,Po, të lutem.
Dialogue: 0,0:06:30.28,0:06:32.20,Default,Fate,0,0,0,,Do të jemi atje së shpejti!
Dialogue: 0,0:06:32.20,0:06:34.28,Default,Nanoha,0,0,0,,Thjesht duhet të pastrojmë këtu më parë!
Dialogue: 0,0:06:38.82,0:06:41.16,Default,Towa,0,0,0,,Shinomiya është brenda.
Dialogue: 0,0:06:41.16,0:06:43.41,Default,Shiina,0,0,0,,Do të thuash që ajo po e manipulon?
Dialogue: 0,0:06:43.41,0:06:46.71,Default,Towa,0,0,0,,Jo, Shinomiya ndoshta është thithur.
Dialogue: 0,0:06:47.03,0:06:49.35,Default,Towa,0,0,0,,Vullneti dhe vetëdija e saj \Nduhet të jenë zhdukur.
Dialogue: 0,0:07:00.27,0:07:04.63,Default,Setsuna,0,0,0,,Nuk mund të lejojmë grabitqarë si \Nne të shumohen tepër
Dialogue: 0,0:07:05.27,0:07:07.51,Default,Setsuna,0,0,0,,ose të bëhen tepër të fortë.
Dialogue: 0,0:07:08.32,0:07:11.14,Default,Setsuna,0,0,0,,Sepse të mbetesh krejt vetëm në \Nnjë botë pa askënd tjetër
Dialogue: 0,0:07:11.73,0:07:13.63,Default,Setsuna,0,0,0,,do të ishte me siguri e trishtueshme.
Dialogue: 0,0:07:17.82,0:07:20.90,Default,Shiina,0,0,0,,Mendoj se jam në gjendje ta ndaloj këtë.
Dialogue: 0,0:07:22.18,0:07:23.78,Default,Shiina,0,0,0,,Jo, nuk është plotësisht ashtu.
Dialogue: 0,0:07:23.78,0:07:25.98,Default,Shiina,0,0,0,,Është detyra ime ta ndaloj.
Dialogue: 0,0:07:27.61,0:07:29.34,Default,Towa,0,0,0,,Atëherë le të shkojmë bashkë.
Dialogue: 0,0:07:29.88,0:07:31.34,Default,Shiina,0,0,0,,Jo, ti duhet—
Dialogue: 0,0:07:31.34,0:07:34.02,Default,Towa,0,0,0,,Shinomiya është ajo që kam ndjekur.
Dialogue: 0,0:07:34.02,0:07:36.59,Default,Towa,0,0,0,,Përveç kësaj, nuk je në formën më të mirë, apo jo?
Dialogue: 0,0:07:37.02,0:07:40.86,Default,Towa,0,0,0,,Dukesh tepër e paqëndrueshme, sikur \Nmund të rrëzohesh në çdo moment.
Dialogue: 0,0:07:41.26,0:07:42.86,Default,Towa,0,0,0,,Pra, po shkojmë bashkë.
Dialogue: 0,0:07:42.86,0:07:45.23,Default,Towa,0,0,0,,Do të të mbështes.
Dialogue: 0,0:07:46.32,0:07:47.28,Default,Shiina,0,0,0,,Në rregull.
Dialogue: 0,0:07:48.76,0:07:51.04,Italics,Shiina,0,0,0,,Oh, alo?
Dialogue: 0,0:07:51.04,0:07:53.49,Italics,Shiina,0,0,0,,Flet Kuze Shiina nga \Ndega e Lindjes së Largët.
Dialogue: 0,0:07:53.49,0:07:54.53,Default,Rein,0,0,0,,Kuze-san?
Dialogue: 0,0:07:54.98,0:07:55.95,Default,Shiina,0,0,0,,Po.
Dialogue: 0,0:07:55.95,0:07:59.57,Default,Shiina,0,0,0,,Po shkoj te trupi \Nkryesor i Paraardhësit Zero.
Dialogue: 0,0:07:59.57,0:08:02.13,Default,Shiina,0,0,0,,Jo, unë dhe Kuze Setsuna!
Dialogue: 0,0:08:02.13,0:08:06.76,Default,Shiina,0,0,0,,Dhe Yorumi Towa-san do të\Nmë ndihmojë të merrem me shfarosjen.
Dialogue: 0,0:08:07.14,0:08:08.64,Default,Shiina,0,0,0,,Ju lutem, lëreni tek ne!
Dialogue: 0,0:08:10.64,0:08:11.69,Default,Towa,0,0,0,,Burgu i Akullit!
Dialogue: 0,0:08:21.28,0:08:24.06,Italics,Shiina,0,0,0,,Fuqia që mora nga Setsuna
Dialogue: 0,0:08:24.06,0:08:28.25,Italics,Shiina,0,0,0,,është fuqia për të shfarosur çdo gjë, nga \Nnjë farë e vetme deri te një individ i rrezikshëm.
Dialogue: 0,0:08:29.18,0:08:35.59,Italics,Shiina,0,0,0,,Është menduar të vrasë të tjerë të \Nllojit të saj, për të parandaluar që një grabitqar i vetëm
Dialogue: 0,0:08:36.56,0:08:39.43,Italics,Shiina,0,0,0,,të shkatërrojë ekosistemin \Ndhe të gjithë botën.
Dialogue: 0,0:08:40.57,0:08:42.68,Italics,Shiina,0,0,0,,Është tepër e trishtueshme,
Dialogue: 0,0:08:42.68,0:08:44.21,Default,Shiina,0,0,0,,Arma, gati!
Dialogue: 0,0:08:47.41,0:08:50.64,Italics,Shiina,0,0,0,,por jam e sigurt se është edhe një fuqi e mirë.
Dialogue: 0,0:08:51.85,0:08:53.78,Default,Towa,0,0,0,,Unë do të merrem me grykëzat!
Dialogue: 0,0:08:53.78,0:08:55.18,Default,Towa,0,0,0,,Ti merr trupin kryesor!
Dialogue: 0,0:08:54.11,0:08:59.17,Italics Top,Song - Flame of Hope,0,0,0,,Kohët kur ecëm bashkë
Dialogue: 0,0:08:55.45,0:08:56.43,Default,Shiina,0,0,0,,Po!
Dialogue: 0,0:08:59.17,0:09:04.33,Italics Top,Song - Flame of Hope,0,0,0,,Kohët kur qeshëm bashkë
Dialogue: 0,0:09:05.26,0:09:15.06,Italics Top,Song - Flame of Hope,0,0,0,,Ai vendi i butë thellë në\Nzemrat tona ku u lidhëm
Dialogue: 0,0:09:15.66,0:09:18.58,Italics Top,Song - Flame of Hope,0,0,0,,Dhimbja që ndamë
Dialogue: 0,0:09:18.58,0:09:24.08,Italics Top,Song - Flame of Hope,0,0,0,,Buzëqeshjet, lotët,\Ne di se asgjë prej saj nuk ishte gënjeshtër
Dialogue: 0,0:09:22.09,0:09:23.66,Default,Shiina,0,0,0,,Nuk kam mbaruar ende!
Dialogue: 0,0:09:24.08,0:09:26.98,Italics Top,Song - Flame of Hope,0,0,0,,Zëri yt i butë
Dialogue: 0,0:09:26.98,0:09:34.46,Italics Top,Song - Flame of Hope,0,0,0,,Dëshira ime për ta mbrojtur është\Nnjë flakë që digjet në këto krahë
Dialogue: 0,0:09:29.33,0:09:31.34,Default,Shiina,0,0,0,,Towa, mund të sinkronizohesh me mua?!
Dialogue: 0,0:09:31.34,0:09:32.46,Default,Towa,0,0,0,,Do të sinkronizohem!
Dialogue: 0,0:09:34.46,0:09:40.25,Italics Top,Song - Flame of Hope,0,0,0,,Tani do ta lëshoj gjithë këtë fuqi\Npër të kapërcyer gjithçka
Dialogue: 0,0:09:35.81,0:09:36.71,Default,Both,0,0,0,,Tre!
Dialogue: 0,0:09:37.35,0:09:38.47,Default,Both,0,0,0,,Dy!
Dialogue: 0,0:09:38.78,0:09:39.73,Default,Both,0,0,0,,Një!
Dialogue: 0,0:09:40.13,0:09:43.80,Default,Both,0,0,0,,Shko!
Dialogue: 0,0:09:40.25,0:09:46.47,Italics Top,Song - Flame of Hope,0,0,0,,Zemra ime shpërndan shkëndija,\Nmjaft të nxehta për të djegur
Dialogue: 0,0:09:46.47,0:09:51.52,Italics Top,Song - Flame of Hope,0,0,0,,Kjo flakë që thur lidhjen tonë \Nnuk do të shuhet kurrë, sado larg të shkoj
Dialogue: 0,0:09:51.52,0:09:59.95,Italics Top,Song - Flame of Hope,0,0,0,,Ky zjarr i ndritshëm do ta kthejë\Ngjithçka në dritë
Dialogue: 0,0:10:07.50,0:10:08.74,Default,Rein,0,0,0,,E pabesueshme!
Dialogue: 0,0:10:08.74,0:10:10.24,Default,Rein,0,0,0,,E godite?!
Dialogue: 0,0:10:10.75,0:10:12.51,Italics,Shiina,0,0,0,,Më vjen keq, jo ende!
Dialogue: 0,0:10:14.07,0:10:15.73,Italics,Shiina,0,0,0,,Trupi kryesor shkoi nën tokë.
Dialogue: 0,0:10:16.51,0:10:18.57,Italics,Shiina,0,0,0,,Duhet ta rrëzoj.
Dialogue: 0,0:10:18.57,0:10:21.48,Default,Towa,0,0,0,,Megjithëse grykëzat në sipërfaqe janë ende...
Dialogue: 0,0:10:37.01,0:10:38.77,Default,Nanoha,0,0,0,,Na falni për pritjen!
Dialogue: 0,0:10:39.16,0:10:41.38,Default,Shiina,0,0,0,,Nano-chan, Fate-chan!
Dialogue: 0,0:10:42.75,0:10:46.31,Default,Fate,0,0,0,,Sapo e vumë\NZeron atje të pushojë!
Dialogue: 0,0:10:47.78,0:10:49.90,Default,Shiina,0,0,0,,A mund t'jua lë ju të dyjave pjesën e sipërfaqes?
Dialogue: 0,0:10:49.90,0:10:53.51,Default,Shiina,0,0,0,,Ne do të shkojmë të shtypim trupin kryesor nën tokë!
Dialogue: 0,0:10:53.51,0:10:54.67,Default,Nanoha,0,0,0,,E mora vesh!
Dialogue: 0,0:10:54.67,0:10:56.03,Default,Fate,0,0,0,,Ju lutem, vazhdoni!
Dialogue: 0,0:10:56.64,0:10:59.36,Default,Shiina,0,0,0,,Le të shkojmë, Towa. Më kap.
Dialogue: 0,0:10:59.36,0:11:00.02,Default,Towa,0,0,0,,Po.
Dialogue: 0,0:11:04.30,0:11:07.06,Italics,Shiina,0,0,0,,Fuqia e Setsunës për të vrarë llojin e saj
Dialogue: 0,0:11:07.06,0:11:09.87,Italics,Shiina,0,0,0,,është një fuqi që zhduket \Nkur nuk nevojitet më.
Dialogue: 0,0:11:14.31,0:11:17.99,Italics,Shiina,0,0,0,,Përveç kësaj, e kam sforcuar veten pak tepër.
Dialogue: 0,0:11:18.47,0:11:20.87,Italics,Shiina,0,0,0,,Kur këto flakë të shuhen,
Dialogue: 0,0:11:20.87,0:11:24.57,Italics,Shiina,0,0,0,,fuqia ime si Diaboli do të\Nzhduket gjithashtu, me gjasë.
Dialogue: 0,0:11:25.42,0:11:27.81,Italics,Shiina,0,0,0,,Të kem fuqinë që më dha Setsuna
Dialogue: 0,0:11:27.81,0:11:32.32,Italics,Shiina,0,0,0,,dhe kujtimet e mia me Setsunën \Ntë marrin fund kështu
Dialogue: 0,0:11:32.32,0:11:33.76,Italics,Shiina,0,0,0,,është vërtet e dhimbshme.
Dialogue: 0,0:11:34.44,0:11:36.21,Italics,Shiina,0,0,0,,Por nuk ka problem.
Dialogue: 0,0:11:36.21,0:11:39.05,Italics,Shiina,0,0,0,,Arrita të shpëtoja ato vajza të mira,
Dialogue: 0,0:11:39.57,0:11:43.54,Italics,Shiina,0,0,0,,dhe nëse kjo do të thotë të parandaloj një \Nkatastrofë të madhe e të afërt,
Dialogue: 0,0:11:44.32,0:11:50.11,Italics,Shiina,0,0,0,,atëherë jam e sigurt se ajo do të pajtohet \NJetova besnikërisht ndaj vetes.
Dialogue: 0,0:11:59.41,0:12:00.99,Italics,Shiina,0,0,0,,Pra, nuk ka problem.
Dialogue: 0,0:12:14.55,0:12:16.84,Default,Shiina,0,0,0,,Shinomiya është thithur brenda asaj?
Dialogue: 0,0:12:16.84,0:12:17.79,Default,Towa,0,0,0,,Po.
Dialogue: 0,0:12:18.37,0:12:19.62,Default,Shiina,0,0,0,,Më jep një dorë.
Dialogue: 0,0:12:19.62,0:12:21.39,Default,Shiina,0,0,0,,Do ta djeg nga lart.
Dialogue: 0,0:12:21.39,0:12:22.94,Default,Shiina,0,0,0,,Ti eja nga poshtë.
Dialogue: 0,0:12:35.38,0:12:37.82,Italics,Shiina,0,0,0,,T'i thëmë lamtumirë Setsunës përsëri
Dialogue: 0,0:12:38.26,0:12:40.88,Italics,Shiina,0,0,0,,do të jetë e trishtueshme.
Dialogue: 0,0:12:53.87,0:12:55.07,Default,Shiina,0,0,0,,Oh jo!
Dialogue: 0,0:13:29.39,0:13:30.82,Default,Shiina,0,0,0,,Towa!
Dialogue: 0,0:13:30.82,0:13:32.83,Default,Shiina,0,0,0,,Nuk mundesh! Është e rrezikshme!
Dialogue: 0,0:13:32.83,0:13:33.98,Default,Towa,0,0,0,,Do të të ndihmoj.
Dialogue: 0,0:13:34.56,0:13:36.40,Default,Towa,0,0,0,,Mos u shqetëso, Shiina.
Dialogue: 0,0:13:36.40,0:13:40.20,Default,Towa,0,0,0,,Nuk do të vdes, dhe nuk do të\Ntë lë as ty të vdesësh.
Dialogue: 0,0:13:42.86,0:13:44.09,Default,Shiina,0,0,0,,Faleminderit.
Dialogue: 0,0:13:44.09,0:13:48.28,Default,Towa,0,0,0,,Hej, flakët e tua dhe të Setsunës\Njanë vërtet të bukura.
Dialogue: 0,0:13:48.28,0:13:50.98,Default,Shiina,0,0,0,,Po. Janë thesari im.
Dialogue: 0,0:13:58.57,0:13:59.98,Italics,Shiina,0,0,0,,Megjithatë, më vjen keq.
Dialogue: 0,0:14:02.46,0:14:06.44,Italics,Shiina,0,0,0,,Setsuna, do ta përdor të gjithë këtu.
Dialogue: 0,0:14:07.68,0:14:09.46,Default,Shiina,0,0,0,,Nisemi, Towa!
Dialogue: 0,0:14:09.46,0:14:10.30,Default,Towa,0,0,0,,Po!
Dialogue: 0,0:14:31.64,0:14:33.70,Default,Towa,0,0,0,,Shiina, nxirrna jashtë!
Dialogue: 0,0:14:38.02,0:14:39.39,Default,Towa,0,0,0,,Shiina!
Dialogue: 0,0:14:55.28,0:14:56.66,Default,Yuuna,0,0,0,,Shiina.
Dialogue: 0,0:14:57.30,0:14:59.36,Default,Yuuna,0,0,0,,Hej, zgjohu.
Dialogue: 0,0:15:00.80,0:15:01.82,Default,Shiina,0,0,0,,Hë?
Dialogue: 0,0:15:02.41,0:15:05.83,Default,Yuuna,0,0,0,,Ora e kujdestarisë mbaroi. Po shkojmë në shtëpi.
Dialogue: 0,0:15:07.71,0:15:08.91,Default,Shiina,0,0,0,,Yuuna?
Dialogue: 0,0:15:08.91,0:15:09.66,Default,Yuuna,0,0,0,,Po.
Dialogue: 0,0:15:09.66,0:15:12.51,Default,Yuuna,0,0,0,,Ishe krejt e zhytur\Nnë gjumë, Shiina.
Dialogue: 0,0:15:12.51,0:15:16.56,Default,Yuuna,0,0,0,,Të mbaja mësuesin që të mos e\Nkapte, ishte mjaft e vështirë, e di.
Dialogue: 0,0:15:18.52,0:15:20.97,Italics,Shiina,0,0,0,,Kjo është shkolla?
Dialogue: 0,0:15:19.32,0:15:20.55,Top,Luke,0,0,0,,Jo!
Dialogue: 0,0:15:20.55,0:15:23.69,Top,Luke,0,0,0,,Duhet t'i përmbahesh rreptësisht \Nafatit për dorëzimin e raportit tënd.
Dialogue: 0,0:15:21.30,0:15:23.69,Italics,Shiina,0,0,0,,Unë jam nxënëse e vitit të dytë të gjimnazit?
Dialogue: 0,0:15:24.49,0:15:26.38,Default,Towa,0,0,0,,Shiina, Yuuna!
Dialogue: 0,0:15:26.38,0:15:28.34,Default,Aoi,0,0,0,,Ju të dyja jeni vonë!
Dialogue: 0,0:15:28.34,0:15:30.66,Default,Yuuna,0,0,0,,Kjo sepse Shiina flinte thellë.
Dialogue: 0,0:15:30.66,0:15:32.83,Default,Shiina,0,0,0,,Po, më vjen keq, më vjen keq.
Dialogue: 0,0:15:32.83,0:15:34.96,Default,Shiori,0,0,0,,Kam ende mjaftueshëm për ju të dyja.
Dialogue: 0,0:15:34.96,0:15:35.88,Default,Shiori,0,0,0,,Ja.
Dialogue: 0,0:15:35.88,0:15:37.13,Default,Yuuna,0,0,0,,Jeee!
Dialogue: 0,0:15:37.71,0:15:40.19,Italics,Shiina,0,0,0,,Po, e kuptoj.
Dialogue: 0,0:15:40.19,0:15:41.74,Italics,Shiina,0,0,0,,Ky është një ëndërr.
Dialogue: 0,0:15:42.20,0:15:43.71,Italics,Shiina,0,0,0,,Nuk është realitet.
Dialogue: 0,0:15:43.71,0:15:47.61,Italics,Shiina,0,0,0,,Por është një botë që mund të kishte qenë.
Dialogue: 0,0:15:49.08,0:15:53.46,Italics,Shiina,0,0,0,,Ka rend në qytete dhe \Nnë shoqëri, dhe nuk ka rrezik.
Dialogue: 0,0:15:54.15,0:15:55.98,Italics,Shiina,0,0,0,,Shokët dhe familjarët
Dialogue: 0,0:15:56.42,0:15:59.39,Italics,Shiina,0,0,0,,nuk sulmohen nga monstra \Nrrugës për në shtëpi.
Dialogue: 0,0:16:00.51,0:16:05.08,Italics,Shiina,0,0,0,,Njerëzit nuk kthehen në monstra \Nnga marrja e drogave të rrezikshme.
Dialogue: 0,0:16:05.97,0:16:10.46,Italics,Shiina,0,0,0,,Është një botë ku lajmet për katastrofa dhe \Ntingulli i sirenave nuk janë të zakonshme.
Dialogue: 0,0:16:13.74,0:16:16.09,Default,Touya,0,0,0,,Oh, Towa, Shiina-chan.
Dialogue: 0,0:16:16.09,0:16:18.35,Default,Ema,0,0,0,,O, mirë se vini në shtëpi, ju të dyja.
Dialogue: 0,0:16:18.74,0:16:21.60,Default,Towa,0,0,0,,U ktheva në shtëpi, baba, nënë.
Dialogue: 0,0:16:23.01,0:16:24.35,Default,Touya,0,0,0,,Mirë se u ktheve, Towa.
Dialogue: 0,0:16:24.35,0:16:25.78,Default,Ema,0,0,0,,Oh, Touya.
Dialogue: 0,0:16:27.21,0:16:31.66,Italics,Shiina,0,0,0,,Kam punuar shumë për të krijuar një botë \Nsi kjo ku njerëzit të jetojnë.
Dialogue: 0,0:16:34.29,0:16:36.11,Default,Towa,0,0,0,,Çfarë ke, Shiina?
Dialogue: 0,0:16:36.11,0:16:38.02,Default,Shiina,0,0,0,,Oh, asgjë.
Dialogue: 0,0:16:38.02,0:16:39.77,Default,Shiina,0,0,0,,Kjo është rruga për në shtëpinë tënde?
Dialogue: 0,0:16:40.65,0:16:44.90,Default,Towa,0,0,0,,Ne do të qëndronim\Nsot në shtëpinë tënde, Shiina.
Dialogue: 0,0:16:44.90,0:16:46.68,Default,Shiina,0,0,0,,Shtëpia ime?
Dialogue: 0,0:16:46.68,0:16:49.78,Default,Towa,0,0,0,,Po. Shtëpia jote. Në Amatorishima.
Dialogue: 0,0:16:51.10,0:16:52.70,Default,Shiina,0,0,0,,Në ishull?
Dialogue: 0,0:16:58.34,0:16:59.64,Default,Shiina,0,0,0,,Towa, më vjen keq.
Dialogue: 0,0:16:59.64,0:17:01.82,Default,Shiina,0,0,0,,Vetëm... vetëm më prit një moment.
Dialogue: 0,0:17:01.82,0:17:03.54,Default,Towa,0,0,0,,Sigurisht, sa të duash.
Dialogue: 0,0:17:08.79,0:17:12.79,Italics,Shiina,0,0,0,,Mendoja se nuk do ta takoja kurrë më,\Nas edhe në ëndrrat e mia.
Dialogue: 0,0:17:16.55,0:17:17.54,Default,Shiina,0,0,0,,Setsuna?
Dialogue: 0,0:17:18.16,0:17:19.56,Default,Setsuna,0,0,0,,Këtu brenda!
Dialogue: 0,0:17:25.86,0:17:33.43,Italics Top,Song - Ephemeral,0,0,0,,Sa herë që mbështetja ime rozë dridhet,\Nduke refuzuar të lëvizë
Dialogue: 0,0:17:28.71,0:17:30.90,Default,Setsuna,0,0,0,,Shii-chan! Mirë se u ktheve!
Dialogue: 0,0:17:33.10,0:17:35.32,Default,Shiina,0,0,0,,Setsuna.
Dialogue: 0,0:17:33.43,0:17:39.90,Italics Top,Song - Ephemeral,0,0,0,,Kujtoj baltën që mblidhej te këmbët e mia.
Dialogue: 0,0:17:38.56,0:17:39.93,Default,Shiina,0,0,0,,Setsuna...
Dialogue: 0,0:17:39.90,0:17:45.06,Italics Top,Song - Ephemeral,0,0,0,,Mendoja se kisha fluturuar
Dialogue: 0,0:17:40.40,0:17:42.07,Default,Shiina,0,0,0,,Setsuna!
Dialogue: 0,0:17:42.91,0:17:45.09,Default,Setsuna,0,0,0,,Çfarë ke, Shiina?
Dialogue: 0,0:17:45.06,0:17:48.12,Italics Top,Song - Ephemeral,0,0,0,,me vetëm gjëra që hidhen lehtë
Dialogue: 0,0:17:45.09,0:17:46.84,Default,Setsuna,0,0,0,,Po sillesh si e përkëdhelur.
Dialogue: 0,0:17:46.84,0:17:50.09,Default,Shiina,0,0,0,,Kjo sepse... më ke munguar!
Dialogue: 0,0:17:48.12,0:17:49.18,Italics Top,Song - Ephemeral,0,0,0,,(Të shoh ty)
Dialogue: 0,0:17:49.18,0:17:50.08,Italics Top,Song - Ephemeral,0,0,0,,Të lëndohesh
Dialogue: 0,0:17:50.08,0:17:54.98,Italics Top,Song - Ephemeral,0,0,0,,Është një e ardhme që nuk dua ta shoh kurrë.
Dialogue: 0,0:17:50.09,0:17:51.63,Default,Setsuna,0,0,0,,Po sillesh çuditshëm.
Dialogue: 0,0:17:51.63,0:17:53.37,Default,Setsuna,0,0,0,,Kemi qenë gjithmonë bashkë, apo jo?
Dialogue: 0,0:17:53.37,0:17:55.64,Default,Setsuna,0,0,0,,Unë jam motra jote e vogël, në fund të fundit.
Dialogue: 0,0:17:54.98,0:18:02.24,Italics Top,Song - Ephemeral,0,0,0,,Do ta forcoj veten për pjesën tjetër të jetës\Ndhe do të shpenzoj gjithçka që kam
Dialogue: 0,0:17:56.48,0:18:01.57,Default,Setsuna,0,0,0,,Je munduar vërtet shumë... për \Nmua dhe për të gjithë të tjerët.
Dialogue: 0,0:18:01.57,0:18:02.90,Default,Setsuna,0,0,0,,E di se e ke bërë.
Dialogue: 0,0:18:02.24,0:18:09.27,Italics Top,Song - Ephemeral,0,0,0,,për të krijuar një botë ku ajo vajza\Nnuk humbet në lotët e saj
Dialogue: 0,0:18:03.86,0:18:06.37,Default,Setsuna,0,0,0,,Edhe nëse ndahemi, dhe \Nnuk mund të flasim më,
Dialogue: 0,0:18:06.37,0:18:08.23,Default,Setsuna,0,0,0,,Do të jem gjithmonë afër.
Dialogue: 0,0:18:08.77,0:18:10.60,Default,Setsuna,0,0,0,,Pra, mos qaj.
Dialogue: 0,0:18:09.27,0:18:16.41,Italics Top,Song - Ephemeral,0,0,0,,Do ta kthej edhe pamëshirshmërinë\Nqë të përqafojë shkatërrimin
Dialogue: 0,0:18:11.13,0:18:12.73,Default,Setsuna,0,0,0,,Të dua, Shii-chan.
Dialogue: 0,0:18:13.52,0:18:17.99,Default,Setsuna,0,0,0,,Të doja atëherë, dhe përgjithmonë.
Dialogue: 0,0:18:16.41,0:18:24.86,Italics Top,Song - Ephemeral,0,0,0,,në një forcë që nuk venitet me këto\Nduar të djegura që shtrihen për të ndihmuar
Dialogue: 0,0:18:21.41,0:18:23.21,Default,Shiina,0,0,0,,Edhe unë!
Dialogue: 0,0:18:23.21,0:18:24.86,Default,Shiina,0,0,0,,Edhe unë të dua, Setsuna!
Dialogue: 0,0:18:25.41,0:18:26.93,Default,Setsuna,0,0,0,,Do të jem gjithmonë me ty.
Dialogue: 0,0:18:27.41,0:18:29.64,Default,Setsuna,0,0,0,,Përgjithmonë, në rregull?
Dialogue: 0,0:18:38.62,0:18:40.89,Default,Towa,0,0,0,,Shiina. Shiina.
Dialogue: 0,0:18:42.87,0:18:43.89,Default,Shiina,0,0,0,,Towa?
Dialogue: 0,0:18:45.12,0:18:46.35,Default,Towa,0,0,0,,Mirëmëngjes.
Dialogue: 0,0:18:46.78,0:18:47.88,Default,Shiina,0,0,0,,Mirëmëngjes.
Dialogue: 0,0:18:48.29,0:18:51.47,Default,Towa,0,0,0,,Zero është shfarosur plotësisht.
Dialogue: 0,0:18:51.47,0:18:53.29,Default,Towa,0,0,0,,Punë e mirë, Shiina.
Dialogue: 0,0:18:53.90,0:18:55.11,Default,Shiina,0,0,0,,Edhe ti, Towa.
Dialogue: 0,0:18:55.11,0:18:57.35,Default,Shiina,0,0,0,,Faleminderit. Ishe një ndihmë e madhe.
Dialogue: 0,0:18:55.37,0:18:59.36,Italics Top,Song - Ephemeral,0,0,0,,Do ta qëlloj armën time për herë të fundit
Dialogue: 0,0:18:58.39,0:19:01.65,Default,Towa,0,0,0,,Pusho edhe pak \Nderisa të mbërrijë shpëtimi.
Dialogue: 0,0:18:59.36,0:19:02.98,Italics Top,Song - Ephemeral,0,0,0,,Pra, dëshira e kësaj flake
Dialogue: 0,0:19:02.00,0:19:04.91,Default,Shiina,0,0,0,,Pashë një ëndërr ndërsa isha \Nnë prag të vdekjes.
Dialogue: 0,0:19:02.98,0:19:09.45,Italics Top,Song - Ephemeral,0,0,0,,Për të siguruar që as drejtësia\Nas e keqja të mos jenë kurrë vetëm
Dialogue: 0,0:19:06.62,0:19:09.92,Default,Towa,0,0,0,,Një ëndërr ku ne jetojmë në një botë paqësore?
Dialogue: 0,0:19:09.45,0:19:16.30,Italics Top,Song - Ephemeral,0,0,0,,Kështu këto fragmente të ngrohta\Nqë një ditë do të veniten
Dialogue: 0,0:19:11.40,0:19:12.41,Default,Shiina,0,0,0,,Po.
Dialogue: 0,0:19:12.69,0:19:17.72,Default,Towa,0,0,0,,Arrita të takoja babanë dhe \Nnënën... dhe edhe atë vajzën.
Dialogue: 0,0:19:16.30,0:19:23.23,Italics Top,Song - Ephemeral,0,0,0,,Do të kujtohen të gjitha\Nnë paqen që fitojmë
Dialogue: 0,0:19:17.72,0:19:19.93,Default,Towa,0,0,0,,Ata buzëqeshën dhe më uruan mirëseardhjen.
Dialogue: 0,0:19:20.38,0:19:23.29,Default,Towa,0,0,0,,Nuk jam ndjerë kurrë më e përmbushur.
Dialogue: 0,0:19:23.96,0:19:27.19,Default,Towa,0,0,0,,A arrite të bisedoje shumë me Setsunën?
Dialogue: 0,0:19:24.92,0:19:32.43,Italics Top,Song - Ephemeral,0,0,0,,E qëlloj armën time, duke përmbushur fatin tim
Dialogue: 0,0:19:27.19,0:19:28.37,Default,Shiina,0,0,0,,Po.
Dialogue: 0,0:19:28.37,0:19:30.78,Default,Shiina,0,0,0,,Setsuna buzëqeshte vërtet.
Dialogue: 0,0:19:30.78,0:19:32.44,Default,Shiina,0,0,0,,Tha se do të ishte gjithmonë me mua.
Dialogue: 0,0:19:32.43,0:19:39.42,Italics Top,Song - Ephemeral,0,0,0,,Kjo flakë që digjet për të krijuar një botë\Nku askush nuk vdes vetëm
Dialogue: 0,0:19:33.16,0:19:37.28,Default,Shiina,0,0,0,,Jam e lumtur që arrita ta shoh, \Nedhe pse ishte në ëndërr.
Dialogue: 0,0:19:39.42,0:19:46.63,Italics Top,Song - Ephemeral,0,0,0,,Ngrohtësia e trupit tënd\Nqë mbështetet tek unë pa hezitim
Dialogue: 0,0:19:39.47,0:19:40.35,Default,Towa,0,0,0,,Po.
Dialogue: 0,0:19:45.19,0:19:46.27,Default,Girls,0,0,0,,Towa-san!
Dialogue: 0,0:19:46.27,0:19:47.31,Default,Girls,0,0,0,,Shiina-san!
Dialogue: 0,0:19:46.63,0:19:54.86,Italics Top,Song - Ephemeral,0,0,0,,Kuptoj se të dyja janë njësoj si\Nforca për të shtrirë një dorë ndihmëse
Dialogue: 0,0:19:57.30,0:19:58.63,Italics,Shiina,0,0,0,,Dhe kështu...
Dialogue: 0,0:19:58.63,0:20:01.16,Italics,Shiina,0,0,0,,Pasi mbaruam shfarosjen e Zeros,
Dialogue: 0,0:20:01.16,0:20:04.99,Italics,Shiina,0,0,0,,Operacioni i madh i shfarosjes i EXCEEDS \Npërfundoi për momentin.
Dialogue: 0,0:20:05.47,0:20:11.05,Italics,Shiina,0,0,0,,Kur Kuragi Eiji mësoi për \Nvdekjen e Shinomiyas, ai vdiq në burg.
Dialogue: 0,0:20:11.05,0:20:15.35,Italics,Shiina,0,0,0,,Dëgjova se nuk zbuloi kurrë asgjë \Npër Shinomiyan gjatë gjithë kohës.
Dialogue: 0,0:20:17.69,0:20:19.72,Italics,Shiina,0,0,0,,Kërkimet e tij mbi drogat Diaboli
Dialogue: 0,0:20:19.72,0:20:22.74,Italics,Shiina,0,0,0,,u morën përsipër nga Shtabi i OKB-së \Npër Ndihmë në Katastrofa.
Dialogue: 0,0:20:23.13,0:20:24.30,Italics,Shiina,0,0,0,,Sigurisht,
Dialogue: 0,0:20:24.30,0:20:28.52,Italics,Shiina,0,0,0,,tani po e kërkojnë për sigurinë \Ne të gjithëve, jo për t'i kthyer njerëzit në Diaboli.
Dialogue: 0,0:20:29.23,0:20:33.05,Italics,Shiina,0,0,0,,Udhëheqja korruptive e policisë\Nu zëvendësua gjithashtu,
Dialogue: 0,0:20:33.05,0:20:36.41,Italics,Shiina,0,0,0,,dhe krimet e Diabolit filluan \Ntë trajtohen si duhet.
Dialogue: 0,0:20:36.75,0:20:38.86,Signs,ArticleHeadline,0,0,0,,{\an7\shad2\blur1\p1\alpha&H50&\c&HF5F5F5&\3c&HF0EFE4&\4c&HF7F7F7&\fscx183\fscy56\move(0.222,32.445,-0.667,-47.555,27,2070)}m 0 0 l 268 0 268 88 0 88
Dialogue: 0,0:20:36.75,0:20:38.86,Signs,ArticleHeadline,0,0,0,,{\fnTimes New Roman\fs27\3c&HF1F1F1&\c&H86323D&\move(279.112,44,279.112,-22.667,27,2070)}Paraardhësi më i vjetër shfaroset në Polin e Jugut
Dialogue: 0,0:20:36.75,0:20:43.95,Signs,ArticleHeadline,0,0,0,,{\an7\shad2\blur1\p1\alpha&H50&\c&HF5F5F5&\3c&HF0EFE4&\4c&HF7F7F7&\fscx104\fscy34\move(299.155,247.734,300.933,-28.71,27,7159)}m 0 0 l 268 0 268 88 0 88
Dialogue: 0,0:20:36.75,0:20:43.95,Signs,ArticleHeadline,0,0,0,,{\an1\fs12\fnTimes New Roman\3c&HF1F1F1&\c&H97898B&\move(304,274.556,304,-6.333,27,7159)}Zëvendësim në shkallë të gjerë i stafit në Byronë e Policisë\NPërfshirë drejtorin e përgjithshëm të shtabit
Dialogue: 0,0:20:37.11,0:20:44.01,Signs,ArticleHeadline,0,0,0,,{\an7\shad2\blur1\p1\alpha&H50&\c&HFFFFFF&\3c&HF0EFE4&\4c&HF7F7F7&\move(0,357,-17,93,0,6882)\fscx95\fscy44}m 0 0 l 268 0 268 88 0 88
Dialogue: 0,0:20:37.65,0:20:44.01,Signs,ArticleHeadline,0,0,0,,{\fad(100,000)\an7\fs17\bord2\fnTimes New Roman\3c&HF1F1F1&\c&H504E4E&\move(8,332,7,96,3,6342)}Përcaktohet politika për krimet speciale\Ntë kryera nga përdoruesit e drogave
Dialogue: 0,0:20:37.27,0:20:43.55,Italics,Shiina,0,0,0,,Lloji invaziv nuk përbën më\Nkërcënim ekzistencial për njerëzimin.
Dialogue: 0,0:20:44.01,0:20:46.47,Italics,Shiina,0,0,0,,Drejtori Yagami, \NNano-chan dhe të tjerët
Dialogue: 0,0:20:46.47,0:20:50.50,Italics,Shiina,0,0,0,,janë gati të nisen diku tjetër \Npër një mision tjetër.
Dialogue: 0,0:20:51.51,0:20:53.61,Default,Nanoha,0,0,0,,Jam e sigurt se do të takohemi përsëri së shpejti.
Dialogue: 0,0:20:53.61,0:20:55.29,Default,Fate,0,0,0,,Po, jam e sigurt se do të takohemi.
Dialogue: 0,0:20:55.29,0:20:58.11,Italics,Shiina,0,0,0,,Lamtumirat tona ishin tepër të shkurtra.
Dialogue: 0,0:20:58.78,0:21:02.64,Italics,Shiina,0,0,0,,Mora edhe një \Npushim të gjatë me pagesë.
Dialogue: 0,0:21:07.85,0:21:10.03,Italics,Shiina,0,0,0,,Tani jam kthyer në ishull.
Dialogue: 0,0:21:10.35,0:21:12.48,Italics,Shiina,0,0,0,,Towa dhe vajzat u bashkuan me mua.
Dialogue: 0,0:21:14.57,0:21:19.04,Default,Towa,0,0,0,,Pyes veten se çfarë po bëjnë Takamachi-san dhe \Ntë tjerët tani dhe ku ndodhen.
Dialogue: 0,0:21:19.04,0:21:21.96,Default,Shiina,0,0,0,,Ndoshta përsëri diku jashtë vendit.
Dialogue: 0,0:21:21.96,0:21:24.22,Default,Shiina,0,0,0,,Por jam e sigurt se janë mirë.
Dialogue: 0,0:21:29.41,0:21:30.98,Default,Nanoha,0,0,0,,Oh, Shiina-san!
Dialogue: 0,0:21:30.98,0:21:31.87,Default,Shiina,0,0,0,,Oh!
Dialogue: 0,0:21:31.87,0:21:33.30,Default,Shiina,0,0,0,,Nano-chan, çfarë ka?
Dialogue: 0,0:21:33.30,0:21:34.66,Italics,Fate,0,0,0,,Na vjen keq.
Dialogue: 0,0:21:34.66,0:21:38.42,Italics,Fate,0,0,0,,Ka pasur një urgjencë \Nnë vendndodhjen tonë të re.
Dialogue: 0,0:21:38.42,0:21:39.43,Default,Shiina,0,0,0,,Oh, o.
Dialogue: 0,0:21:39.43,0:21:41.78,Default,Nanoha,0,0,0,,Na vjen vërtet keq që po e kërkojmë këtë,
Dialogue: 0,0:21:41.78,0:21:46.45,Default,Nanoha,0,0,0,,por a do të ishte e mundur që ti \Ndhe Towa-san të na jepni një dorë?
Dialogue: 0,0:21:46.45,0:21:48.53,Default,Fate,0,0,0,,Situata është pak e vështirë.
Dialogue: 0,0:21:51.96,0:21:53.82,Default,Shiina,0,0,0,,Në rregull. Lëre tek unë.
Dialogue: 0,0:21:53.82,0:21:55.20,Default,Towa,0,0,0,,Do të ndihmoj edhe unë.
Dialogue: 0,0:21:55.20,0:21:57.72,Default,Towa,0,0,0,,T'i marr edhe vajzat me vete?
Dialogue: 0,0:21:57.72,0:21:58.97,Default,Fate,0,0,0,,Po, të lutem!
Dialogue: 0,0:22:01.21,0:22:02.97,Default,Shiina,0,0,0,,Faleminderit, Yuzu.
Dialogue: 0,0:22:03.79,0:22:05.07,Default,Shiina,0,0,0,,Në rregull!
Dialogue: 0,0:22:05.07,0:22:06.23,Default,Shiina,0,0,0,,E pra!
Dialogue: 0,0:22:06.23,0:22:07.94,Default,All,0,0,0,,Është koha të nisemi!
Dialogue: 0,0:22:28.61,0:22:33.64,Default,Shiina,0,0,0,,Në rregull, le t'i bëjmë të gjitha bashkë!
Dialogue: 0,0:22:33.64,0:22:35.36,Default,All,0,0,0,,Po!
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,OP

