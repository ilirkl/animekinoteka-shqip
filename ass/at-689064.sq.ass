Dialogue: 0,0:01:40.75,0:01:43.19,Default,Araki,0,0,0,,H-Hej, Stella...
Dialogue: 0,0:01:43.19,0:01:45.23,Default,Stella,0,0,0,,Olga, cila është loja e sotme?
Dialogue: 0,0:01:45.23,0:01:46.88,Default,Stella,0,0,0,,A na ka kontaktuar profesori ende?
Dialogue: 0,0:01:46.88,0:01:50.25,Default,Araki,0,0,0,,Stella, të lutem më dëgjo.
Dialogue: 0,0:01:51.33,0:01:53.85,Default,Araki,0,0,0,,I pyeta të gjithë tashmë, dhe...
Dialogue: 0,0:01:53.85,0:01:56.05,Default,Stella,0,0,0,,Nuk më intereson çfarë thanë ata. Nuk mundem!
Dialogue: 0,0:02:01.35,0:02:02.47,Default,Shousei,0,0,0,,Epo...
Dialogue: 0,0:02:02.47,0:02:04.19,Default,Kai,0,0,0,,Mendoj se do të kërkojë pak kohë.
Dialogue: 0,0:02:09.37,0:02:10.94,Default,Olga,0,0,0,,Prit, Stella!
Dialogue: 0,0:02:16.04,0:02:17.95,Default,Stella,0,0,0,,Ti vërtet e ke ndërmend ta falësh Araki-n?
Dialogue: 0,0:02:18.27,0:02:22.10,Default,Olga,0,0,0,,As unë nuk e di ende.
Dialogue: 0,0:02:22.76,0:02:28.71,Default,Olga,0,0,0,,Por ai tha se do t'i rregullonte gjërat me\Nty, dhe se nuk do të gënjejë më.
Dialogue: 0,0:02:28.71,0:02:33.15,Default,Olga,0,0,0,,Ndaj mendova se mbase nuk ka\Nndonjë të keqe ta dëgjosh atë.
Dialogue: 0,0:02:33.82,0:02:35.16,Default,Stella,0,0,0,,E ke seriozisht?
Dialogue: 0,0:02:37.03,0:02:42.18,Default,Stella,0,0,0,,As nuk e di më se kush jam.
Dialogue: 0,0:02:42.67,0:02:44.54,Default,Stella,0,0,0,,A jam Stella Tomori?
Dialogue: 0,0:02:44.54,0:02:46.27,Default,Stella,0,0,0,,A jam Stella Ichigaya?
Dialogue: 0,0:02:44.98,0:02:47.48,Sign,Text,0,0,0,,{\c&HC57C1A&\fs15\bord2\fax0.15\frz8.312\2a&HFF&\ko11.3\3c&H3E3837&\pos(202.5,76.5)}S{\ko11.3}t{\ko11.3}e{\ko11.3}l{\ko11.3}l{\ko11.3}a {\ko11.3}I{\ko11.3}c{\ko11.3}h{\ko11.3}i{\ko11.3}g{\ko11.3}a{\ko11.3}y{\ko11.3}a {\ko11.3}f{\ko11.3}a{\ko11.3}m{\ko11.3}i{\ko11.3}l{\ko11.3}y
Dialogue: 0,0:02:48.15,0:02:50.21,Default,Stella,0,0,0,,A jam nga Mizumoto?
Dialogue: 0,0:02:50.61,0:02:52.51,Default,Stella,0,0,0,,A janë gjallë prindërit e mi?
Dialogue: 0,0:02:53.15,0:02:54.86,Default,Stella,0,0,0,,Nuk e kam idenë fare.
Dialogue: 0,0:02:56.08,0:02:58.84,Default,Stella,0,0,0,,Nuk pendohem që e hapa atë kuti.
Dialogue: 0,0:02:59.24,0:03:04.36,Default,Stella,0,0,0,,Por nuk e prisja kurrë se do të isha\Naq e hutuar për veten time.
Dialogue: 0,0:03:05.66,0:03:06.66,Default,Olga,0,0,0,,Më fal.
Dialogue: 0,0:03:06.66,0:03:11.24,Default,Olga,0,0,0,,Thashë se do të bëhesha bashkëpunëtore, dhe përfundova\Nduke thënë gjëra që të tradhtuan.
Dialogue: 0,0:03:12.09,0:03:14.07,Default,Stella,0,0,0,,Nuk bëre asgjë të gabuar.
Dialogue: 0,0:03:15.51,0:03:17.47,Default,Olga,0,0,0,,E kuptoj atë që po thua.
Dialogue: 0,0:03:17.86,0:03:19.42,Default,Olga,0,0,0,,Është e vështirë për mua ta imagjinoj,
Dialogue: 0,0:03:20.30,0:03:23.86,Default,Olga,0,0,0,,por edhe unë do të isha e hutuar po\Ntë isha në vendin tënd.
Dialogue: 0,0:03:24.99,0:03:29.62,Default,Olga,0,0,0,,Por për mua, ajo që je tani është Stella.
Dialogue: 0,0:03:30.84,0:03:33.10,Default,Olga,0,0,0,,U shpërngule në Mizumoto.
Dialogue: 0,0:03:33.10,0:03:36.15,Default,Olga,0,0,0,,Dole me vrull pas shpinës së Araki-t,\Ni cili nuk thoshte asnjë fjalë.
Dialogue: 0,0:03:36.47,0:03:39.61,Default,Olga,0,0,0,,Më fole.\NMë the që të pëlqenin flokët e mi.
Dialogue: 0,0:03:39.61,0:03:41.57,Default,Olga,0,0,0,,U bëmë menjëherë shoqe.
Dialogue: 0,0:03:42.73,0:03:45.97,Default,Olga,0,0,0,,Dhe kemi kaluar pothuajse të gjithë\Nkohën tonë bashkë që atëherë.
Dialogue: 0,0:03:47.53,0:03:50.45,Default,Olga,0,0,0,,Stella që kam njohur për\Ndhjetë vitet e fundit është Stella ime.
Dialogue: 0,0:03:54.16,0:03:56.56,flashback italics,Araki,0,0,0,,Ajo është motra ime!
Dialogue: 0,0:03:59.06,0:04:03.01,Default,Stella,0,0,0,,Supozohej të kisha shkuar nga kjo rrugë.
Dialogue: 0,0:04:03.01,0:04:05.72,Default,Stella,0,0,0,,Por tani, jam këtu.
Dialogue: 0,0:04:06.47,0:04:10.19,Default,Olga,0,0,0,,Ajo Stella është Stella ime.
Dialogue: 0,0:04:24.50,0:04:25.92,Default,Stella,0,0,0,,Mirë.
Dialogue: 0,0:04:25.92,0:04:29.37,Default,Stella,0,0,0,,Do të flas me të vetëm edhe një herë.
Dialogue: 0,0:04:32.50,0:04:36.83,Default,Haruto,0,0,0,,Araki, unë do të flas me Stella-n\Nkur të jetë një moment i mirë.
Dialogue: 0,0:04:37.58,0:04:40.02,Default,Araki,0,0,0,,Jo, do të flas vetë me të.
Dialogue: 0,0:04:40.02,0:04:42.22,Default,Araki,0,0,0,,Më duhet të flas me të siç duhet.
Dialogue: 0,0:04:44.39,0:04:45.10,Default,Haruto,0,0,0,,Në rregull.
Dialogue: 0,0:04:45.62,0:04:47.17,Default,Haruto,0,0,0,,Paç fat!
Dialogue: 0,0:04:50.60,0:04:52.05,Default,Haruto,0,0,0,,Çfarë është ajo?
Dialogue: 0,0:04:48.60,0:04:50.60,Sign,Text,0,0,0,,{\fnTimes New Roman\bord2\fscx90\fs15\fax-0.5\3c&H1F3F76&\c&HE0F8F9&\frz337.9\pos(363.31,139.862)}Alarm Emergjence
Dialogue: 0,0:04:53.28,0:04:55.33,Default,Kai,0,0,0,,Një alarm emergjence?
Dialogue: 0,0:04:56.10,0:04:57.10,Default,Haruto,0,0,0,,Marimo?
Dialogue: 0,0:04:58.24,0:05:04.49,Sign,Text,0,0,0,,{\bord0\fs10\c&HF1E1DF&\fax0.2\move(305.5,54.5,302.5,50)\t(\fs12)\frz0.3497}Shippo Marimo
Dialogue: 0,0:04:58.24,0:05:04.49,Sign,Text; Marimo,0,0,0,,{\an7\bord3\fs10\c&HAA9B99&\fax0.2\t(\fs12)\frz0.3497\2c&HC1B8B6&\3c&HFEF4F1&\b0\move(207.236,117.441,185.412,124.235,0,6230)}Të gjithë, kemi nevojë për ndihmën tuaj!\N\hPo dalin masa të çuditshme Pluhuri\N\h\hnë lagjen tonë tregtare!
Dialogue: 0,0:04:58.57,0:05:00.64,italics,Marimo,0,0,0,,Të gjithë, kemi nevojë për ndihmën tuaj!
Dialogue: 0,0:05:00.64,0:05:04.49,italics,Marimo,0,0,0,,Po shfaqen masa të çuditshme Pluhuri\Nnë lagjen tonë tregtare!
Dialogue: 0,0:05:09.25,0:05:13.13,Sign,Text,0,0,0,,{\frz346\fscx80\fs15\fax0.3\3c&H090D3C&\c&HDCD9FD&\pos(272.227,90.158)}Alarm Emergjence
Dialogue: 0,0:05:16.38,0:05:17.42,Default,Girl,0,0,0,,E neveritshme!
Dialogue: 0,0:05:17.42,0:05:18.92,Default,Man,0,0,0,,Ç'dreqin është kjo?!
Dialogue: 0,0:05:19.76,0:05:21.82,Default,Man 2,0,0,0,,Hej! Hiqu prej meje!
Dialogue: 0,0:05:20.81,0:05:22.26,Default,Man 3,0,0,0,,Më ndihmoni!
Dialogue: 0,0:05:25.20,0:05:26.38,Default,Man2,0,0,0,,Më lër të qetë!
Dialogue: 0,0:05:29.35,0:05:30.56,Default,Marimo,0,0,0,,Hyni brenda!
Dialogue: 0,0:05:30.55,0:05:35.31,Sign,Text,0,0,0,,{\frz345.6\fs18\fnArial Black\fax0.2\bord0\c&H655A6A&\pos(261.866,24.933)}Kasaphana Torinuma
Dialogue: 0,0:05:33.34,0:05:35.31,Default,Woman,0,0,0,,Faleminderit, Marimo-chan!
Dialogue: 0,0:05:36.03,0:05:36.98,Default,Araki,0,0,0,,Marimo!
Dialogue: 0,0:05:37.31,0:05:41.32,Sign,Text,0,0,0,,{\fs15\fnArial Black\bord0\c&H6E5D5A&\pos(197.599,40.133)}Kasaphana Torinuma
Dialogue: 0,0:05:41.72,0:05:42.72,Default,Marimo,0,0,0,,Araki.
Dialogue: 0,0:05:47.08,0:05:50.08,Default,Haruto,0,0,0,,Hej, pse po ndodh kjo?
Dialogue: 0,0:05:50.08,0:05:52.98,Default,Tenrou,0,0,0,,Nuk e dimë.\NThjesht u shfaqën nga hiçi.
Dialogue: 0,0:05:53.83,0:05:58.69,Default,Kirara,0,0,0,,Deri tani nuk ka pasur ndonjë dëm serioz,\Npor ato nuk po ndalojnë së ardhuri.
Dialogue: 0,0:05:58.69,0:05:59.84,Default,Kirara,0,0,0,,Janë një bezdi e vërtetë.
Dialogue: 0,0:06:04.07,0:06:07.35,Default,Kirara,0,0,0,,A po ndodh kjo seriozisht vetëm\Nnë{\i1}lagjen{\i0}tonë tregtare?
Dialogue: 0,0:06:03.59,0:06:07.34,Sign,Text,0,0,0,,{\fs16\fnArial Black\fax-0.2\bord0\c&H948290&\frz11.4\move(347,96.8,290,96.8,0,3735)}Kasaphana Torinuma
Dialogue: 0,0:06:07.60,0:06:09.85,italics,Suzaku,0,0,0,,Marimo, më vjen keq që nuk vijmë dot.
Dialogue: 0,0:06:10.15,0:06:12.55,Default,Suzaku,0,0,0,,Po përballemi me\Ntë njëjtën situatë këtu.
Dialogue: 0,0:06:28.74,0:06:30.17,italics,Taketsune,0,0,0,,E njëjta gjë edhe në Yotsugi.
Dialogue: 0,0:06:30.62,0:06:34.08,Default,Taketsune,0,0,0,,Më vjen keq, por nuk vijmë dot për të ndihmuar.
Dialogue: 0,0:06:43.26,0:06:44.48,Default,Mao,0,0,0,,Nuk kanë fund.
Dialogue: 0,0:06:45.01,0:06:46.28,italics,Taketsune,0,0,0,,Dreqi!
Dialogue: 0,0:06:50.33,0:06:52.09,Default,Shousei,0,0,0,,Duhet të bëjmë gjithçka që mundemi.
Dialogue: 0,0:06:52.50,0:06:55.03,Default,Shousei,0,0,0,,Araki, përpiqu të zbulosh\Nse nga po vijnë ato.
Dialogue: 0,0:06:55.03,0:06:57.12,Default,Shousei,0,0,0,,Unë do të shkoj me Kai-n dhe të\Ntjerët për të ndihmuar Hirou-n.
Dialogue: 0,0:06:57.12,0:06:58.02,Default,Araki,0,0,0,,E kuptova.
Dialogue: 0,0:07:19.16,0:07:20.92,Default,Araki,0,0,0,,Pse ka kaq shumë vallë?
Dialogue: 0,0:07:25.94,0:07:28.03,Default,Kei,0,0,0,,Hej, erdha!
Dialogue: 0,0:07:28.03,0:07:30.52,Default,Kei,0,0,0,,Kei-kun-i juaj mbërriti!
Dialogue: 0,0:07:32.55,0:07:34.25,Default,Kei,0,0,0,,Nuk po funksionon!
Dialogue: 0,0:07:36.11,0:07:37.61,Default,Maria,0,0,0,,Sigurisht që jo!
Dialogue: 0,0:07:44.41,0:07:47.11,Default,Ainojou,0,0,0,,Jo furra e bukës!
Dialogue: 0,0:07:42.56,0:07:47.57,Sign,Text,0,0,0,,{\fnVerdana\b0\fs13\bord1.5\pos(319.25,169.25)\c&H12100E&\3c&H272722&}Buka Tanabe
Dialogue: 0,0:07:42.56,0:07:47.57,Sign,Text,0,0,0,,{\fnVerdana\b0\fs11\fax-0.05\fscx80\bord1.5\c&H513223&\3c&H7E6852&\pos(150.75,174)\frz2.89}Buka Tanabe
Dialogue: 0,0:07:52.08,0:07:54.17,Default,Shousei,0,0,0,,Ç'dreqin janë këto gjëra?
Dialogue: 0,0:07:54.17,0:07:56.08,Default,Shousei,0,0,0,,Araki, ndonjë të dhënë?
Dialogue: 0,0:07:58.96,0:08:03.05,Default,Araki,0,0,0,,A po ndodh kjo në\Ntë gjithë Shin-Katsushika-n?
Dialogue: 0,0:08:03.63,0:08:06.60,italics,Spica,0,0,0,,Edhe Kosuge është nën rrethim nga\NPluhuri misterioz gjithashtu.
Dialogue: 0,0:08:07.99,0:08:09.28,italics,Spica,0,0,0,,Më vjen keq.
Dialogue: 0,0:08:11.98,0:08:15.44,Default,Spica,0,0,0,,Dyshoj se ky është faji i vëllait tim.
Dialogue: 0,0:08:17.72,0:08:19.59,Default,Kurusu,0,0,0,,Është faji i Araki-t.
Dialogue: 0,0:08:20.11,0:08:22.87,Default,Kurusu,0,0,0,,The se ne ishim të veçantë.
Dialogue: 0,0:08:22.87,0:08:24.92,Default,Kurusu,0,0,0,,Dhe tani po më lë.
Dialogue: 0,0:08:26.54,0:08:27.68,Default,Kurusu,0,0,0,,Pse?
Dialogue: 0,0:08:28.40,0:08:30.55,Default,Kurusu,0,0,0,,Pse nuk rri me mua?
Dialogue: 0,0:08:31.14,0:08:33.06,Default,Kurusu,0,0,0,,Pse po largohesh?
Dialogue: 0,0:08:35.06,0:08:37.00,Default,Kurusu,0,0,0,,Dua të jem shoku yt.
Dialogue: 0,0:08:37.31,0:08:39.40,Default,Kurusu,0,0,0,,Dua të jesh pranë meje.
Dialogue: 0,0:08:40.03,0:08:43.36,Default,Kurusu,0,0,0,,Pse çdo gjë është kaq e vështirë për mua?
Dialogue: 0,0:08:48.59,0:08:51.00,Default,Kurusu,0,0,0,,Do t'i bëj të gjithë ta ndiejnë dhimbjen time.
Dialogue: 0,0:09:19.82,0:09:21.29,Default,Kurusu,0,0,0,,Do t'i bëj të gjithë...
Dialogue: 0,0:09:21.29,0:09:22.67,Default,Kurusu,0,0,0,,të vuajnë!
Dialogue: 0,0:09:40.85,0:09:43.35,Sign,Text,0,0,0,,{\fnVerdana\b1\fs9\bord0\c&H4E3F36&\pos(296.5,10.75)}Stacioni Policor Shin-Katsushika
Dialogue: 0,0:09:40.85,0:09:43.35,Sign,Text,0,0,0,,{\fnVerdana\b1\fs12\bord0\c&H4E3F36&\pos(300.5,59.25)}Posta Policore e Stacionit Shin-Koiwa
Dialogue: 0,0:09:53.36,0:09:55.52,Default,Taiyou,0,0,0,,Dreqi. Po vijnë edhe nga ana jonë.
Dialogue: 0,0:09:55.52,0:09:56.39,Default,Haoyu,0,0,0,,Shkojmë.
Dialogue: 0,0:09:59.23,0:10:01.84,italics,Araki,0,0,0,,Spica, e gjeta Kurusu-n.
Dialogue: 0,0:10:01.84,0:10:04.85,italics,Araki,0,0,0,,Pse po e bën këtë?
Dialogue: 0,0:10:07.07,0:10:09.26,Default,Spica,0,0,0,,Sepse u largove nga skuadra jonë.
Dialogue: 0,0:10:09.26,0:10:10.28,italics,Araki,0,0,0,,Çfarë?!
Dialogue: 0,0:10:11.25,0:10:14.38,Default,Araki,0,0,0,,Vetëm për shkak të kësaj?! Pse?!
Dialogue: 0,0:10:15.09,0:10:19.12,flashback,Araki,0,0,0,,Pse më duron gjithmonë mua?
Dialogue: 0,0:10:21.54,0:10:25.48,flashback,Kurusu,0,0,0,,A të duhet një arsye për të dashur\Ntë bëhesh shok me dikë?
Dialogue: 0,0:10:27.22,0:10:28.65,Default,Araki,0,0,0,,Pse...
Dialogue: 0,0:10:32.07,0:10:33.40,Default,Kurusu,0,0,0,,Më shumë.
Dialogue: 0,0:10:33.83,0:10:35.94,Default,Kurusu,0,0,0,,Nuk jam ngopur ende.
Dialogue: 0,0:10:36.49,0:10:38.51,Default,Kurusu,0,0,0,,Më duhet më shumë Pluhur.
Dialogue: 0,0:10:41.61,0:10:43.47,Default,Kurusu,0,0,0,,Nëse lidhem me{\i1}atë{\i0}...
Dialogue: 0,0:11:43.96,0:11:48.44,Default,Yuda,0,0,0,,Dreqi! Të gjitha këto të dhëna që mblodhëm!
Dialogue: 0,0:11:48.74,0:11:50.50,Default,Himizu,0,0,0,,Ndonjë gjë me të cilën mund të ndihmoj?
Dialogue: 0,0:11:50.99,0:11:53.76,Default,Yuda,0,0,0,,Sikur të kishte!
Dialogue: 0,0:11:57.90,0:11:59.82,Default,Himizu,0,0,0,,Profesor, shikoni.
Dialogue: 0,0:11:59.82,0:12:02.20,Default,Yuda,0,0,0,,Çfarë dëshironi?!
Dialogue: 0,0:12:02.20,0:12:05.12,Default,Himizu,0,0,0,,A më bëjnë sytë mua, apo po tkurret?
Dialogue: 0,0:12:08.67,0:12:10.89,Default,Yuda,0,0,0,,P-Pse?!
Dialogue: 0,0:12:14.50,0:12:16.35,Default,Yuda,0,0,0,,Çfarë bëhet tani?!
Dialogue: 0,0:12:24.83,0:12:26.91,Default,Yuda,0,0,0,,Ai është lidhur me Kristalin Mëmë...
Dialogue: 0,0:12:30.94,0:12:33.31,Default,Yuda,0,0,0,,Mos do të marrë fuqinë\Ne Kristalit Mëmë?
Dialogue: 0,0:12:33.82,0:12:35.84,Default,Himizu,0,0,0,,Kjo do të çonte në...
Dialogue: 0,0:12:37.66,0:12:39.32,Default,Himizu,0,0,0,,çfarë, saktësisht?
Dialogue: 0,0:12:39.62,0:12:41.80,Default,Yuda,0,0,0,,Kjo është thjesht një hipotezë, por...
Dialogue: 0,0:12:42.51,0:12:44.83,Default,Yuda,0,0,0,,Pluhuri po emetohet\Nnga Kristali Mëmë.
Dialogue: 0,0:12:45.12,0:12:47.21,Default,Yuda,0,0,0,,Nëse Pluhuri zhduket...
Dialogue: 0,0:12:50.46,0:12:51.58,Default,Yuda,0,0,0,,Më duhet të bëj diçka!
Dialogue: 0,0:12:55.79,0:12:58.59,italics,Yuda,0,0,0,,Të gjithë, ju lutem më dëgjoni me qetësi.
Dialogue: 0,0:12:58.59,0:12:59.94,Default,Yuda,0,0,0,,Ka një mundësi që...
Dialogue: 0,0:13:01.60,0:13:04.60,Default,Yuda,0,0,0,,Jo, duhet të jem i drejtpërdrejtë.
Dialogue: 0,0:13:05.21,0:13:10.60,Default,Yuda,0,0,0,,Me këtë ritëm, Shin-Katsushika-s\Ndo t'i mbarojë Pluhuri Mebius.
Dialogue: 0,0:13:11.98,0:13:13.61,Default,Araki,0,0,0,,Do t'i mbarojë?
Dialogue: 0,0:13:13.61,0:13:15.16,Default,Suzaku,0,0,0,,Çfarë do të thotë kjo?
Dialogue: 0,0:13:15.86,0:13:20.30,italics,Yuda,0,0,0,,Po bëjmë gjithçka mundemi, por ende\Nnuk e kemi idenë pse po ndodh kjo.
Dialogue: 0,0:13:20.30,0:13:25.26,italics,Yuda,0,0,0,,E sigurt është vetëm se barriera\Npo tkurret drejt brendësisë.
Dialogue: 0,0:13:25.85,0:13:31.38,Default,Suzaku,0,0,0,,A do të thotë kjo se zona jonë\Ne banueshme po zvogëlohet?
Dialogue: 0,0:13:33.19,0:13:36.84,Default,Marimo,0,0,0,,Kjo do të thotë se të gjithë ne...
Dialogue: 0,0:13:54.13,0:13:55.37,Default,Araki,0,0,0,,Kurusu...
Dialogue: 0,0:13:56.08,0:13:57.32,italics,Suzaku,0,0,0,,Në rregull.
Dialogue: 0,0:13:57.32,0:13:59.46,italics,Suzaku,0,0,0,,Unë do të shkoj ta mposht Kurusu-n.
Dialogue: 0,0:13:59.94,0:14:01.02,Default,Araki,0,0,0,,Prit!
Dialogue: 0,0:14:01.02,0:14:02.93,Default,Araki,0,0,0,,Çfarë do të thuash me 'ta mposhtësh' atë?
Dialogue: 0,0:14:02.93,0:14:04.16,italics,Suzaku,0,0,0,,Nuk e di.
Dialogue: 0,0:14:04.62,0:14:09.29,italics,Suzaku,0,0,0,,Por duke parë gjithçka që po na bën,\Nmadje duke vënë jetët tona në rrezik,
Dialogue: 0,0:14:09.77,0:14:11.79,italics,Suzaku,0,0,0,,ai nuk mund të lejohet të mbetet pa u ndëshkuar.
Dialogue: 0,0:14:11.79,0:14:15.45,italics,Kyouko,0,0,0,,Dhe dyshoj se mund ta bindim\Nme fjalë në këtë pikë.
Dialogue: 0,0:14:16.35,0:14:20.61,italics,Suzaku,0,0,0,,February Roars do të shkojë te Mëma\Npër t'u përballur drejtpërdrejt me Kurusu-n.
Dialogue: 0,0:14:20.61,0:14:21.60,italics,All,0,0,0,,Kuptuar.
Dialogue: 0,0:14:22.05,0:14:22.89,Default,Araki,0,0,0,,Pritni!
Dialogue: 0,0:14:22.89,0:14:24.70,Default,Taketsune,0,0,0,,Lamps do të bëjë të njëjtën gjë.
Dialogue: 0,0:14:24.70,0:14:27.45,Default,Taketsune,0,0,0,,Duhet ta ndalojmë inatin e tij me forcë.
Dialogue: 0,0:14:27.94,0:14:30.58,Default,Taketsune,0,0,0,,Edhe nëse kjo do të thotë ta lëndojmë.
Dialogue: 0,0:14:30.58,0:14:31.43,Default,Araki,0,0,0,,Por...
Dialogue: 0,0:14:32.07,0:14:33.95,Default,Taketsune,0,0,0,,Nuk po na lihet asnjë zgjidhje tjetër.
Dialogue: 0,0:14:34.76,0:14:36.49,Default,Taketsune,0,0,0,,E dëgjove se çfarë po diskutonim.
Dialogue: 0,0:14:36.49,0:14:39.86,Default,Taketsune,0,0,0,,Disa prej nesh do të jenë në rrezik serioz\Npa Pluhurin.
Dialogue: 0,0:14:39.86,0:14:41.53,Default,Taketsune,0,0,0,,Edhe ti gjithashtu, Araki.
Dialogue: 0,0:14:42.62,0:14:45.66,Default,Araki,0,0,0,,Por si supozohet\Ntë ngjitemi atje lart?
Dialogue: 0,0:14:45.66,0:14:48.65,Default,Taketsune,0,0,0,,Për fat të mirë, njëri prej nesh fluturon dot.
Dialogue: 0,0:14:49.72,0:14:51.29,Default,Ainojou,0,0,0,,Në asnjë mënyrë!
Dialogue: 0,0:14:51.29,0:14:54.05,Default,Ainojou,0,0,0,,Jo atje lart! Është shumë, shumë lart!
Dialogue: 0,0:14:54.88,0:14:57.82,Default,Gengo,0,0,0,,Tani është momenti yt për të\Nshfrytëzuar potencialin tënd!
Dialogue: 0,0:14:55.47,0:14:57.82,top,Ainojou,0,0,0,,Çfarë po bën? Më lësho!
Dialogue: 0,0:14:57.82,0:15:02.16,Default,Gengo,0,0,0,,Prano fatin tënd dhe shpëto Shin-Katsushika-n!
Dialogue: 0,0:14:59.21,0:15:01.22,top,Ainojou,0,0,0,,Çfarë po...
Dialogue: 0,0:15:03.69,0:15:05.80,top,Ainojou,0,0,0,,Të lutem, jo!
Dialogue: 0,0:15:05.13,0:15:05.80,Default,Taketsune,0,0,0,,Epo,
Dialogue: 0,0:15:05.80,0:15:07.32,italics,Taketsune,0,0,0,,ky është plani.
Dialogue: 0,0:15:08.15,0:15:10.58,italics,Marimo,0,0,0,,Araki, edhe ne po mbrojmë qytetin.
Dialogue: 0,0:15:10.58,0:15:11.46,Default,Araki,0,0,0,,Marimo?
Dialogue: 0,0:15:11.46,0:15:15.04,italics,Marimo,0,0,0,,Dhe për këtë qëllim, do të na duhet\Ntë sulmojmë vetë burimin.
Dialogue: 0,0:15:16.43,0:15:17.90,Default,Araki,0,0,0,,Jo...
Dialogue: 0,0:15:19.52,0:15:20.69,Default,Marimo,0,0,0,,Shkojmë!
Dialogue: 0,0:15:20.69,0:15:21.53,Default,All,0,0,0,,Po!
Dialogue: 0,0:15:21.53,0:15:23.69,Default,Takara,0,0,0,,Koha për të shkëlqyer!
Dialogue: 0,0:15:25.20,0:15:27.95,Default,Takara,0,0,0,,Shko atje!
Dialogue: 0,0:15:35.20,0:15:36.96,Default,Ainojou,0,0,0,,Kam frikë...
Dialogue: 0,0:15:56.84,0:15:57.98,Default,Anzu,0,0,0,,Kei-chan!
Dialogue: 0,0:15:58.93,0:16:00.98,Default,Kei,0,0,0,,Bëra shaka!
Dialogue: 0,0:16:03.10,0:16:04.63,Default,Shirayuki,0,0,0,,Çfarë lehtësimi.
Dialogue: 0,0:16:26.09,0:16:26.97,Default,Mao,0,0,0,,Djema!
Dialogue: 0,0:16:39.13,0:16:41.12,Default,Anzu,0,0,0,,Tepër i rëndë!
Dialogue: 0,0:17:09.28,0:17:10.52,Default,Taketsune,0,0,0,,Jo...
Dialogue: 0,0:17:11.08,0:17:12.82,Default,Taketsune,0,0,0,,S'mund të jetë...
Dialogue: 0,0:17:18.53,0:17:19.54,Default,Taketsune,0,0,0,,Më vjen keq...
Dialogue: 0,0:17:20.03,0:17:21.68,Default,Taketsune,0,0,0,,Nuk duhej t'ju kisha detyruar të shkonit.
Dialogue: 0,0:17:24.62,0:17:26.01,Default,Taketsune,0,0,0,,Ky është faji im.
Dialogue: 0,0:17:27.48,0:17:28.56,Default,Taketsune,0,0,0,,Më falni.
Dialogue: 0,0:17:34.47,0:17:35.38,Default,Renji,0,0,0,,Hë?
Dialogue: 0,0:17:35.38,0:17:36.71,Default,Yuichi,0,0,0,,Au...
Dialogue: 0,0:17:37.05,0:17:39.46,Default,Gengo,0,0,0,,Mendova se mbarova.
Dialogue: 0,0:17:40.39,0:17:42.22,Default,Ainojou,0,0,0,,Jam gjallë!
Dialogue: 0,0:17:45.67,0:17:48.23,Default,Yuichi,0,0,0,,Kjo ishte ajo që na e zbuti rënien.
Dialogue: 0,0:17:55.40,0:17:57.51,Default,Taketsune,0,0,0,,Më vjen keq, të gjithë.
Dialogue: 0,0:18:01.07,0:18:02.94,Default,Mao,0,0,0,,T-Taketsune...
Dialogue: 0,0:18:06.62,0:18:09.19,Default,Taketsune,0,0,0,,A jeni mirë?
Dialogue: 0,0:18:11.26,0:18:14.20,Default,Renji,0,0,0,,Po qan për ne?
Dialogue: 0,0:18:20.01,0:18:22.38,Default,All,0,0,0,,Taketsune!
Dialogue: 0,0:18:28.83,0:18:29.96,Default,Suzaku,0,0,0,,Nuk ka mjaftueshëm kohë.
Dialogue: 0,0:18:30.69,0:18:32.08,Default,Tenrou,0,0,0,,E rregulloj unë këtë!
Dialogue: 0,0:18:32.08,0:18:33.04,Default,Suzaku,0,0,0,,Tenrou.
Dialogue: 0,0:18:49.54,0:18:50.82,Default,Anzu,0,0,0,,Dreqi!
Dialogue: 0,0:18:50.82,0:18:52.02,Default,Shirayuki,0,0,0,,Po përplasemi!
Dialogue: 0,0:18:52.02,0:18:53.66,Default,Atsushi,0,0,0,,Marimo!
Dialogue: 0,0:18:54.72,0:18:55.92,Default,Marimo,0,0,0,,Tenrou!
Dialogue: 0,0:19:12.98,0:19:14.20,Default,Kurusu,0,0,0,,Ejani pra!
Dialogue: 0,0:19:14.20,0:19:16.84,Default,Kurusu,0,0,0,,Ejani më godisni, pse s'vini?!
Dialogue: 0,0:19:17.10,0:19:19.85,Default,Kurusu,0,0,0,,Silleni sikur jeni trima të mëdhenj!
Dialogue: 0,0:19:38.43,0:19:39.24,Default,Shousei,0,0,0,,Djema!
Dialogue: 0,0:19:39.60,0:19:40.67,Default,Shousei,0,0,0,,A jeni të gjithë mirë?
Dialogue: 0,0:19:40.67,0:19:41.93,Default,Taketsune,0,0,0,,Mezi.
Dialogue: 0,0:19:41.93,0:19:44.17,Default,Shousei,0,0,0,,Haruto, shëroji ata.
Dialogue: 0,0:19:44.17,0:19:45.37,Default,Haruto,0,0,0,,E kuptova.
Dialogue: 0,0:19:45.83,0:19:48.52,Default,Haruto,0,0,0,,Uh... Por kë?
Dialogue: 0,0:19:49.34,0:19:53.00,Default,Haruto,0,0,0,,S'ka rëndësi. Të gjithë!
Dialogue: 0,0:20:05.59,0:20:07.87,Default,Araki,0,0,0,,Kjo nuk ka për të funksionuar.
Dialogue: 0,0:20:07.87,0:20:11.89,Default,Araki,0,0,0,,Sa më shumë të luftoni, aq\Nmë kokëfortë bëhet Kurusu.
Dialogue: 0,0:20:12.46,0:20:13.42,Default,Spica,0,0,0,,Araki.
Dialogue: 0,0:20:16.03,0:20:17.39,Default,Araki,0,0,0,,Spica.
Dialogue: 0,0:20:17.39,0:20:19.53,Default,Araki,0,0,0,,Dua të flas me Kurusu-n.
Dialogue: 0,0:20:21.08,0:20:25.12,Default,Araki,0,0,0,,Ajo që i duhet tani është\Nqë dikush ta dëgjojë.
Dialogue: 0,0:20:26.32,0:20:27.36,Default,Spica,0,0,0,,Araki...
Dialogue: 0,0:20:31.10,0:20:32.80,italics,Araki,0,0,0,,Të gjithë, më dëgjoni.
Dialogue: 0,0:20:34.14,0:20:36.19,italics,Araki,0,0,0,,Kurusu po vuan në këto momente.
Dialogue: 0,0:20:36.55,0:20:40.68,italics,Araki,0,0,0,,Dua të shkoj dhe ta dëgjoj.
Dialogue: 0,0:20:41.35,0:20:44.68,italics,Araki,0,0,0,,Në të kaluarën thjesht do ta kisha shpërfillur.
Dialogue: 0,0:20:45.23,0:20:48.16,italics,Araki,0,0,0,,Por nuk dua të vazhdoj të veproj ashtu.
Dialogue: 0,0:20:49.47,0:20:56.93,Default,Araki,0,0,0,,Duhet të ndaloj së injoruari të gjitha mangësitë e mia\Ndhe të gjitha mënyrat se si ai është i bezdisshëm.
Dialogue: 0,0:20:58.17,0:21:01.30,Default,Araki,0,0,0,,Dua të përballem me çdo problem një nga një.
Dialogue: 0,0:21:02.59,0:21:05.44,Default,Suzaku,0,0,0,,Nuk e kisha pritur kurrë këtë nga ti.
Dialogue: 0,0:21:05.44,0:21:08.45,Default,Suzaku,0,0,0,,Mendoj se kjo është shumë më mirë\Nnga sa ishe më parë, gjithsesi.
Dialogue: 0,0:21:08.45,0:21:11.21,Default,Taketsune,0,0,0,,Po. Ke ndryshuar, Araki.
Dialogue: 0,0:21:11.73,0:21:13.21,Default,Marimo,0,0,0,,Padyshim.
Dialogue: 0,0:21:15.71,0:21:19.12,italics,Haruto,0,0,0,,Por si ke ndërmend të mbërrish te Kurusu?
Dialogue: 0,0:21:20.24,0:21:21.82,Default,Araki,0,0,0,,Epo...
Dialogue: 0,0:21:21.82,0:21:23.35,Default,Stella,0,0,0,,A do ndihmën time?
Dialogue: 0,0:21:27.56,0:21:28.96,Default,Araki,0,0,0,,Stella.
Dialogue: 0,0:21:29.95,0:21:34.65,Default,Stella,0,0,0,,Por vetëm nëse u përgjigjesh pyetjeve të mia.
Dialogue: 0,0:21:35.50,0:21:36.69,Default,Araki,0,0,0,,Pyetjeve të tua?
Dialogue: 0,0:21:41.72,0:21:44.07,Default,Stella,0,0,0,,Pse më bëre motrën tënde?
Dialogue: 0,0:21:46.42,0:21:49.22,Default,Stella,0,0,0,,Pse më ndryshove?
Dialogue: 0,0:21:51.53,0:21:53.48,Default,Stella,0,0,0,,Më trego pse.
Dialogue: 0,0:22:03.22,0:22:04.88,Default,Araki,0,0,0,,Sigurisht që do të të tregoj.
Dialogue: 0,0:22:06.25,0:22:08.11,Default,Araki,0,0,0,,Kisha ndërmend të flisja me ty gjithsesi.
Dialogue: 0,0:22:19.94,0:22:24.90,Sign,Text,0,0,0,,{\3c&HC3499D&\blur2\fs16}Përkthimi: Rei Miyasaka
