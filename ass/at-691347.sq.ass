Dialogue: 0,0:01:30.23,0:01:34.49,Default,sign,0,0,0,,{\fad(390,0)\shad0\fnArial\an3\blur2\fs17\b1\pos(600,307)\c&H2D6E87&}Ndeshja{\c&H0F00A1&}e Gjeneralit
Dialogue: 0,0:01:32.16,0:01:34.48,Main - Top,Kikuchi,0,0,0,,Je budalla, Akiyama!
Dialogue: 0,0:01:34.92,0:01:37.48,Default,Kikuchi,0,0,0,,Ke pasur të drejtë gjithë kohën!
Dialogue: 0,0:01:37.74,0:01:40.75,Default,Kikuchi,0,0,0,,E dija saktësisht ku ishte jokeri!
Dialogue: 0,0:01:40.99,0:01:44.92,Default,Kikuchi,0,0,0,,Por nuk më duhej një truk i lirë\Nsi të shikoja kartat!
Dialogue: 0,0:01:45.24,0:01:47.23,Default,Kikuchi,0,0,0,,Isha boksier!
Dialogue: 0,0:01:47.23,0:01:51.87,Default,Kikuchi,0,0,0,,Shikimi im kinetik i mprehur më lejon të ndjek\Njokerin në çdo përzierje!
Dialogue: 0,0:01:52.21,0:01:58.89,Default,Kikuchi,0,0,0,,Kuptova se jokeri është gjithmonë karta\Ne sipërme e paketave të përdorura në këtë lojë.
Dialogue: 0,0:01:58.89,0:02:04.90,Default,Kikuchi,0,0,0,,E përdora këtë fakt dhe shikimin tim kinetik për\Ntë marrë kontroll të plotë se ku përfundonte.
Dialogue: 0,0:02:05.20,0:02:06.52,Default,Nao,0,0,0,,Sa e tmerrshme!
Dialogue: 0,0:02:06.52,0:02:09.68,Default,Kikuchi,0,0,0,,Nuk duhej të kishe shkuar\Npër atë dorë të fundit.
Dialogue: 0,0:02:09.68,0:02:15.02,Default,Kikuchi,0,0,0,,E kishe rimarrë epërsinë në të nëntën,\Ndhe mund të kishe thjesht ta mbanit.
Dialogue: 0,0:02:15.02,0:02:18.78,Default,Kikuchi,0,0,0,,Më vjen keq të them se kam\Nnjë dorë të tmerrshme.
Dialogue: 0,0:02:19.60,0:02:24.53,Default,Dealer,0,0,0,,Plot pesëdhjetë çipa në lojë,\Ne përshtatshme për dorën e fundit.
Dialogue: 0,0:02:24.53,0:02:27.03,Default,Dealer,0,0,0,,Tani... hapini!
Dialogue: 0,0:02:28.05,0:02:30.99,Default,Kikuchi,0,0,0,,Vdis, Akiyama!
Dialogue: 1,0:02:35.27,0:02:38.21,Main - Italics,Solario,0,0,0,,Ushtria e Perëndimit ka\Nnjë full house me asë të lartë,
Dialogue: 1,0:02:38.21,0:02:40.54,Main - Italics,Solario,0,0,0,,ndërsa Ushtria e Lindjes ka katër mbretëresha.
Dialogue: 0,0:02:35.17,0:02:40.55,Default,sign,0,0,0,,{\bord1.5\fad(270,1)\fnTimes New Roman\b1\fs18\shad0\c&HF6F1B2&\3c&H151206&\an7\pos(34,67.333)}Ushtria e Perëndimit - Full House
Dialogue: 0,0:02:35.17,0:02:40.55,Default,sign,0,0,0,,{\bord1.5\fad(270,1)\fnTimes New Roman\b1\fs18\shad0\an3\c&H5900E2&\3c&H0C0031&\pos(599.333,289.333)}Ushtria e Lindjes - Katër të Njëjta
Dialogue: 1,0:02:40.83,0:02:43.55,Main - Italics,Solario,0,0,0,,Akiyama i Ushtrisë së Lindjes fiton.
Dialogue: 0,0:02:43.55,0:02:45.30,Default,Nao,0,0,0,,Ia doli!
Dialogue: 0,0:02:45.58,0:02:48.81,Default,Kikuchi,0,0,0,,K-Katër të njëjta përsëri?
Dialogue: 0,0:02:48.81,0:02:51.80,Default,Kikuchi,0,0,0,,Si?!
Dialogue: 0,0:02:52.81,0:02:54.94,Default,Nao,0,0,0,,Kjo ishte e mahnitshme, Akiyama-san!
Dialogue: 0,0:02:54.94,0:02:57.41,Default,Nao,0,0,0,,Nxore katër të njëjta dy herë radhazi!
Dialogue: 0,0:02:57.41,0:02:59.98,Default,Nao,0,0,0,,Fati të buzëqeshi vërtet atje!
Dialogue: 0,0:02:59.98,0:03:01.15,Default,Akiyama,0,0,0,,Nuk ishte fat.
Dialogue: 0,0:03:01.57,0:03:03.86,Default,Nao,0,0,0,,Atëherë si e nxore atë dorë?
Dialogue: 0,0:03:05.73,0:03:09.71,Default,Akiyama,0,0,0,,Do t'ju tregoj gjithë strategjinë time.
Dialogue: 0,0:03:10.07,0:03:13.43,Default,Akiyama,0,0,0,,Kikuchi po ndiqte\Njokerin ndërsa luante.
Dialogue: 0,0:03:13.82,0:03:17.43,Default,Akiyama,0,0,0,,Kjo u bë e qartë pas\Nrreth dorës së katërt.
Dialogue: 0,0:03:17.82,0:03:19.76,Default,Akiyama,0,0,0,,Në atë moment, e kuptova.
Dialogue: 0,0:03:20.23,0:03:24.91,Default,Akiyama,0,0,0,,Çdo paketë e re duhej të ishte\Nnë të njëjtin rend.
Dialogue: 0,0:03:25.70,0:03:28.31,Default,Nao,0,0,0,,Kikuchi-san tha të njëjtën gjë.
Dialogue: 0,0:03:28.71,0:03:32.55,Default,Akiyama,0,0,0,,Por unë u binda për këtë\Nrreth dorës së gjashtë.
Dialogue: 0,0:03:32.55,0:03:35.31,Default,Akiyama,0,0,0,,Kikuchi kishte një epërsi mbi mua.
Dialogue: 0,0:03:35.62,0:03:37.57,Default,Akiyama,0,0,0,,Pastaj pata një mendim...
Dialogue: 0,0:03:37.89,0:03:41.09,Default,Akiyama,0,0,0,,Nëse Kikuchi mund të ndiqte jokerin,
Dialogue: 0,0:03:41.09,0:03:44.17,Default,Akiyama,0,0,0,,mua thjesht duhej të ndiqja{\i1}çdo{\i0} kartë.
Dialogue: 0,0:03:44.86,0:03:46.57,Default,Fukunaga,0,0,0,,Kjo është e pamundur.
Dialogue: 0,0:03:46.84,0:03:48.40,Default,Akiyama,0,0,0,,Aspak e pamundur.
Dialogue: 0,0:03:48.40,0:03:53.07,Default,Akiyama,0,0,0,,Nëse mund të ndjekësh jokerin sepse kartat\Njanë gjithmonë në të njëjtin rend,
Dialogue: 0,0:03:53.07,0:03:54.96,Default,Akiyama,0,0,0,,mund të ndjekësh edhe kartat\Ne tjera në të njëjtën mënyrë.
Dialogue: 0,0:03:57.55,0:04:01.18,Default,Akiyama,0,0,0,,Kartat rreshtohen gjithmonë\Nkështu në fillim.
Dialogue: 0,0:04:01.80,0:04:03.57,Default,Akiyama,0,0,0,,Do t'i përziej.
Dialogue: 0,0:04:10.89,0:04:12.91,Default,Akiyama,0,0,0,,E kam bërë shtatëmbëdhjetë herë.
Dialogue: 0,0:04:13.60,0:04:17.02,Default,Akiyama,0,0,0,,Por ende e di ku janë të gjitha kartat.
Dialogue: 0,0:04:18.59,0:04:21.13,Default,Akiyama,0,0,0,,Sipër është asi i maçit.
Dialogue: 0,0:04:21.77,0:04:22.92,Default,Akiyama,0,0,0,,Jokeri.
Dialogue: 0,0:04:24.53,0:04:25.93,Default,Akiyama,0,0,0,,Mbreti i karos.
Dialogue: 0,0:04:26.27,0:04:28.41,Default,Nao,0,0,0,,Si e di ai?
Dialogue: 0,0:04:28.41,0:04:29.81,Default,Fukunaga,0,0,0,,E kuptoj.
Dialogue: 0,0:04:29.81,0:04:31.68,Default,Fukunaga,0,0,0,,Është një përzierje perfekte.
Dialogue: 0,0:04:31.68,0:04:33.53,Default,Nao,0,0,0,,Përzierje perfekte?
Dialogue: 0,0:04:33.78,0:04:36.12,Default,Fukunaga,0,0,0,,Ndaj paketën saktësisht në gjysmë,
Dialogue: 0,0:04:36.12,0:04:40.54,Default,Fukunaga,0,0,0,,pastaj bën një përzierje riffle që\Nvendos në mënyrë të përsosur një kartë në një herë.
Dialogue: 0,0:04:40.54,0:04:46.31,Default,Akiyama,0,0,0,,E vura re në lojën e provës se\Nshpërndarësi bënte një përzierje perfekte riffle.
Dialogue: 0,0:04:46.31,0:04:48.29,Default,Akiyama,0,0,0,,Atëherë më erdhi frymëzimi.
Dialogue: 0,0:04:48.29,0:04:51.17,Default,Akiyama,0,0,0,,"Mund ta përdor këtë për ta mposhtur Kikuchin."
Dialogue: 0,0:04:51.17,0:04:53.14,Default,Nao,0,0,0,,Çfarë do të thuash?
Dialogue: 0,0:04:54.19,0:04:57.99,Default,Akiyama,0,0,0,,Le të themi se bën një\Npërzierje perfekte tetë herë.
Dialogue: 0,0:05:03.69,0:05:06.09,Default,Nao,0,0,0,,Kthehesh në rreshtimin origjinal!
Dialogue: 0,0:05:06.09,0:05:07.19,Default,Akiyama,0,0,0,,Dhe jo vetëm kaq.
Dialogue: 0,0:05:07.44,0:05:11.34,Default,Akiyama,0,0,0,,Nëse bën përzierjen perfekte\Ndy herë, ose gjashtë herë...
Dialogue: 0,0:05:13.34,0:05:16.13,Default,Nao,0,0,0,,Kartat grupohen të gjitha bashkë!
Dialogue: 0,0:05:16.13,0:05:20.96,Default,Akiyama,0,0,0,,Nëse përziej numrin e duhur të herëve,\Nkartat rreshtohen në mënyra të rregullta.
Dialogue: 0,0:05:21.21,0:05:22.63,Default,Nao,0,0,0,,E kuptoj!
Dialogue: 0,0:05:22.63,0:05:27.72,Default,Nao,0,0,0,,Prandaj e akuzove për\Nmashtrim për të anuluar përzierjen hinduse.
Dialogue: 0,0:05:27.72,0:05:31.68,Default,Akiyama,0,0,0,,Kërkova të anulohej përzierja\Nhinduse në dorën e tetë
Dialogue: 0,0:05:31.68,0:05:33.98,Default,Akiyama,0,0,0,,pikërisht për të mësuar\Nsekuencën e kartave.
Dialogue: 0,0:05:34.49,0:05:36.98,Default,Akiyama,0,0,0,,Nxora pesë në atë dorë, mba mend?
Dialogue: 0,0:05:37.39,0:05:42.48,Default,Akiyama,0,0,0,,Nxjerrja e pesë më lejoi të shihja dhjetë nga\Nshtatëmbëdhjetë kartat e paketës.
Dialogue: 0,0:05:42.48,0:05:45.67,Default,Akiyama,0,0,0,,Të shihja dhjetë karta nga rezultati\Ni një përzierjeje perfekte
Dialogue: 0,0:05:45.67,0:05:49.23,Default,Akiyama,0,0,0,,më lejoi të llogaritja mbrapsht\Nrreshtimin e tyre origjinal.
Dialogue: 0,0:05:49.23,0:05:51.61,Default,Akiyama,0,0,0,,Pasi e pata atë, loja ishte e imja.
Dialogue: 0,0:05:52.06,0:05:55.62,Default,Akiyama,0,0,0,,Thjesht duhej të zgjidhja kohën\Ne saktë për lëvizjen time.
Dialogue: 0,0:05:55.88,0:05:57.98,Default,Nao,0,0,0,,Kohën e saktë?
Dialogue: 0,0:05:57.98,0:06:01.43,Default,Akiyama,0,0,0,,Kishte një model që mund\Nta arrija me përzierjen perfekte
Dialogue: 0,0:06:01.43,0:06:05.07,Default,Akiyama,0,0,0,,që do të garantonte\Nfitoren time çdo herë.
Dialogue: 0,0:06:05.07,0:06:06.23,Default,Akiyama,0,0,0,,Ishte...
Dialogue: 0,0:06:06.90,0:06:11.78,Default,Akiyama,0,0,0,,ky model, që shfaqet pas\Ndy, gjashtë dhe dhjetë përzierjeve.
Dialogue: 0,0:06:11.78,0:06:13.72,Default,Akiyama,0,0,0,,Për ta arritur këtë,
Dialogue: 0,0:06:13.72,0:06:15.88,Default,Akiyama,0,0,0,,bëra disa kërkesa të tjera.
Dialogue: 0,0:06:16.21,0:06:18.22,Flashback,Akiyama,0,0,0,,Përzieji edhe tri herë.
Dialogue: 0,0:06:18.92,0:06:21.43,Default,Nao,0,0,0,,Prandaj e bëre atë?
Dialogue: 0,0:06:21.43,0:06:24.63,Default,Akiyama,0,0,0,,Në dorën e nëntë, i kërkova shpërndarësit\Nt'i përzihte në këtë model.
Dialogue: 0,0:06:25.21,0:06:26.88,Default,Akiyama,0,0,0,,Pas prerjes, dukej kështu.
Dialogue: 0,0:06:26.88,0:06:28.68,Default,Akiyama,0,0,0,,Kartat u shpërndanë kështu.
Dialogue: 0,0:06:28.45,0:06:33.95,Default,sign,0,0,0,,{\fad(310,600)\an8\fnArial Black\shad1\fs16\pos(150,122.667)\4c&H849EA2&\3c&H111011&}Kikuchi
Dialogue: 0,0:06:28.45,0:06:33.95,Default,sign,0,0,0,,{\fad(310,600)\fnArial Black\shad1\fs16\4c&H849EA2&\3c&H111011&\pos(150,230)}Akiyama
Dialogue: 0,0:06:29.20,0:06:34.14,Default,sign,0,0,0,,{\fad(480,790)\fnArial Black\shad1\fs16\4c&H849EA2&\3c&H111011&\pos(449.333,148.001)}Paketa
Dialogue: 0,0:06:29.12,0:06:33.95,Default,Akiyama,0,0,0,,Pastaj vë bast në mënyrë që\Ntë garantoja të nxirrja i dyti.
Dialogue: 0,0:06:34.54,0:06:39.73,Default,Akiyama,0,0,0,,Sepse, në ato rrethana,\Ne dija se do të nxirrte një ose dy karta.
Dialogue: 0,0:06:40.07,0:06:44.70,Default,Akiyama,0,0,0,,Që do të thoshte se me nxjerrjen e dytë,\Nmund të garantoja katër të njëjta.
Dialogue: 0,0:06:44.70,0:06:46.84,Default,Nao,0,0,0,,E-Mahnitshme!
Dialogue: 0,0:06:47.97,0:06:51.13,Default,Akiyama,0,0,0,,Ngjashëm, dora e dhjetë\Npërfundoi në këtë model.
Dialogue: 0,0:06:51.77,0:06:53.14,Default,Akiyama,0,0,0,,Prerja e zhvendosi kështu.
Dialogue: 0,0:06:53.70,0:06:55.47,Default,Akiyama,0,0,0,,Këto ishin kartat e shpërndara.
Dialogue: 0,0:06:54.35,0:06:57.50,Default,Sign,0,0,0,,{\fad(310,340)\an8\fnArial Black\shad1\fs16\pos(150,122.667)\4c&H849EA2&\3c&H111011&}Kikuchi
Dialogue: 0,0:06:54.35,0:06:57.50,Default,Sign,0,0,0,,{\fad(310,340)\fnArial Black\shad1\fs16\4c&H849EA2&\3c&H111011&\pos(150,230)}Akiyama
Dialogue: 0,0:06:55.08,0:06:59.62,Default,Sign,0,0,0,,{\fad(480,1)\fnArial Black\shad1\fs16\4c&H849EA2&\3c&H111011&\move(449.333,148.001,316.19,86.287,2080,3000)\t(2080,3000,\fs24)}Paketa
Dialogue: 0,0:06:56.06,0:06:59.35,Default,Akiyama,0,0,0,,Këtë herë, vë bast në mënyrë që\Ntë nxirrja i pari.
Dialogue: 0,0:06:59.78,0:07:04.10,Default,Nao,0,0,0,,Nxjerrja e parë do të thoshte se mund\Ntë garantoje katër mbretëreshat!
Dialogue: 0,0:07:04.36,0:07:06.55,Default,Nao,0,0,0,,Kjo është e mahnitshme, Akiyama-san!
Dialogue: 0,0:07:06.55,0:07:08.78,Default,Nao,0,0,0,,Përpunove një plan kaq të pagabueshëm...
Dialogue: 0,0:07:08.78,0:07:12.03,Default,Akiyama,0,0,0,,Aspak. Isha në mëngët e këmishës\Nshumicën e kohës.
Dialogue: 0,0:07:13.12,0:07:16.37,Default,sign,0,0,0,,{\an8\fnArial Black\c&HEBEBEB&\3c&H12181A&\4c&H12181A&}Ndarja e Çipave
Dialogue: 0,0:07:13.12,0:07:16.37,Default,sign,0,0,0,,{\shad0\bord0\fnArial Black\c&HEBEBEB&\3c&H12181A&\4c&H12181A&\pos(370.666,145.734)}çip
Dialogue: 0,0:07:13.12,0:07:16.37,Default,sign,0,0,0,,{\shad0\an1\fnArial Black\c&H451C8A&\3c&HF3F0EF&\4c&H12181A&\pos(417.601,226.8)}Ushtria e Lindjes{\bord0\c&HF7F3F1&}kryeson
Dialogue: 0,0:07:12.03,0:07:15.14,Default,Akiyama,0,0,0,,Por të paktën e zgjata epërsinë tonë.
Dialogue: 0,0:07:15.60,0:07:19.13,Default,Akiyama,0,0,0,,Tani më duhet vetëm ta mbrosh atë.
Dialogue: 0,0:07:19.32,0:07:20.30,Default,Nao,0,0,0,,Në rregull.
Dialogue: 0,0:07:22.16,0:07:25.12,Main - Italics,Solario,0,0,0,,Tani do të fillojmë Ndeshjen e Gjeneralit.
Dialogue: 0,0:07:25.45,0:07:28.62,Main - Italics,Solario,0,0,0,,Loja që do të luani\Npër Ndeshjen e Gjeneralit...
Dialogue: 0,0:07:28.62,0:07:31.64,Main - Italics,Solario,0,0,0,,quhet Ruleta e Palëvizshme.
Dialogue: 0,0:07:31.97,0:07:35.13,Default,Nao,0,0,0,,Ruleta e Palëvizshme?
Dialogue: 0,0:07:35.44,0:07:40.36,Default,Dealer,0,0,0,,Si shpërndarës për Ndeshjen e Gjeneralit,\Ndo t'ju shpjegoj rregullat.
Dialogue: 0,0:07:41.65,0:07:45.31,Default,Dealer,0,0,0,,Së pari, kjo është rrota e\Nruletës së palëvizshme në fjalë.
Dialogue: 0,0:07:45.57,0:07:47.57,Default,Nishida,0,0,0,,Ka vetëm katër xhepa.
Dialogue: 0,0:07:47.57,0:07:49.69,Default,Dealer,0,0,0,,Kur heq kapakun,
Dialogue: 0,0:07:49.69,0:07:53.40,Default,Dealer,0,0,0,,shihni vrimat e etiketuara një deri në katër.
Dialogue: 0,0:07:53.70,0:07:56.06,Default,Dealer,0,0,0,,Për të treguar si funksionon,\Ndo të hedh një top.
Dialogue: 0,0:07:59.17,0:08:01.42,Default,Dealer,0,0,0,,E dini në cilën vrimë shkoi?
Dialogue: 0,0:08:01.42,0:08:03.19,Default,Nishida,0,0,0,,Jo, as ide.
Dialogue: 0,0:08:03.19,0:08:09.17,Default,Dealer,0,0,0,,Në të vërtetë, është projektuar ta fshehë\Natë për sa kohë je i kujdesshëm.
Dialogue: 0,0:08:09.51,0:08:11.12,Default,Dealer,0,0,0,,Përgjigja është...
Dialogue: 0,0:08:12.03,0:08:13.18,Default,Dealer,0,0,0,,Katër.
Dialogue: 0,0:08:13.60,0:08:18.53,Default,Dealer,0,0,0,,Kur shtyp kapakun, topi do të\Ndalë në xhepin përkatës.
Dialogue: 0,0:08:19.34,0:08:21.61,Default,Dealer,0,0,0,,Kjo është tavolina e ruletës.
Dialogue: 0,0:08:21.94,0:08:25.63,Default,Dealer,0,0,0,,Loja luhet saktësisht\Nsi ruleta e zakonshme.
Dialogue: 0,0:08:26.25,0:08:31.37,Default,Dealer,0,0,0,,Në ruletën e vërtetë, shpërndarësi hedh\Nnjë top në një rrotë që rrotullohet,
Dialogue: 0,0:08:31.37,0:08:35.95,Default,Dealer,0,0,0,,dhe lojtarët vënë bast se në cilin xhep\Nmendojnë se do të bjerë topi.
Dialogue: 0,0:08:35.95,0:08:40.23,Default,Dealer,0,0,0,,Në thelb, kjo luhet në të njëjtën mënyrë.
Dialogue: 0,0:08:40.23,0:08:45.13,Default,Dealer,0,0,0,,Ajo që ndryshon është se kjo lojë\Nështë lojtar kundër lojtari.
Dialogue: 0,0:08:45.13,0:08:50.58,Default,Dealer,0,0,0,,Një lojtar hedh topin,\Ndhe tjetri hamendëson ku shkon.
Dialogue: 0,0:08:50.84,0:08:52.96,Default,Nishida,0,0,0,,Nuk jam i sigurt se po e ndjek.
Dialogue: 0,0:08:53.42,0:08:55.90,Default,Dealer,0,0,0,,Le ta rishikojmë me një provë.
Dialogue: 0,0:08:56.41,0:08:58.60,Default,Kosaka,0,0,0,,Nishida, ti.
Dialogue: 0,0:08:58.60,0:09:00.01,Default,Nishida,0,0,0,,M-Mua?!
Dialogue: 0,0:09:00.25,0:09:02.07,Default,Akiyama,0,0,0,,Do të përfaqësoj Ushtrinë e Lindjes.
Dialogue: 0,0:09:03.21,0:09:06.25,Default,Dealer,0,0,0,,Lojtarët ndahen në shpërndarës dhe hamendësues.
Dialogue: 0,0:09:06.25,0:09:09.02,Default,Dealer,0,0,0,,Shpërndarësi hedh topin në rrotë.
Dialogue: 0,0:09:09.06,0:09:13.63,Default,sign,0,0,0,,{\fad(230,1290)\fnArial Black\b1\shad0l\fs18\3c&H8053BC&\pos(63.831,98.699)}Lindja
Dialogue: 0,0:09:09.06,0:09:13.63,Default,sign,0,0,0,,{\fad(230,1290)\fnArial Black\b1\shad0l\fs18\3c&HB8AE65&\pos(64.307,236.436)}Perëndimi
Dialogue: 0,0:09:09.52,0:09:17.03,Default,sign,0,0,0,,{\fad(150,1)\bord3\fnArial Black\b1\shad0l\fs28\3c&H2701B5&\an8}Shpërndarësi
Dialogue: 0,0:09:09.36,0:09:12.57,Default,Dealer,0,0,0,,Rolet e shpërndarësit dhe hamendësuesit\Nndërrohen çdo raund.
Dialogue: 0,0:09:12.99,0:09:16.73,Default,Dealer,0,0,0,,Ka dhjetë raunde gjithsej, ku secili\Nlojtar shërben si shpërndarës pesë herë.
Dialogue: 0,0:09:17.03,0:09:22.77,Default,Dealer,0,0,0,,Si ekipi aktualisht humbës, Ushtria e\NPerëndimit do të vendosë kush shpërndan i pari.
Dialogue: 0,0:09:22.77,0:09:24.66,Default,Dealer,0,0,0,,Çfarë thoni, Nishida-san?
Dialogue: 0,0:09:27.49,0:09:30.03,Default,Nishida,0,0,0,,Atëherë, unë shpërndaj i pari.
Dialogue: 0,0:09:30.46,0:09:33.82,Default,Dealer,0,0,0,,Shpërndarës, hidhe topin\Nnë vrimën që preferon.
Dialogue: 0,0:09:34.35,0:09:36.98,Default,Dealer,0,0,0,,Tani shpërndarësi do të vëjë bast.
Dialogue: 0,0:09:37.60,0:09:40.67,Default,Nishida,0,0,0,,{\i1}Unë{\i0} po vë bast?! \NPor e di në cilin numër është!
Dialogue: 0,0:09:40.67,0:09:46.43,Default,Dealer,0,0,0,,Që do të thotë se duhet të vësh bast në mënyrë që\Nkundërshtari të mos e kuptojë.
Dialogue: 0,0:09:46.78,0:09:48.47,Default,Dealer,0,0,0,,Nëse e vendos topin
Dialogue: 0,0:09:48.47,0:09:51.92,Default,Dealer,0,0,0,,në vrimën numër një dhe\Npastaj vë njëqind çipa numrit një,
Dialogue: 0,0:09:51.92,0:09:54.71,Default,Dealer,0,0,0,,do të jetë e qartë për hamendësuesin\Nse topi është në një.
Dialogue: 0,0:09:55.37,0:09:59.53,Default,Dealer,0,0,0,,Por çfarë nëse vë çipa\Nnë të katër numrat?
Dialogue: 0,0:09:59.53,0:10:02.69,Default,Dealer,0,0,0,,Përgjigja e saktë bëhet e errët.
Dialogue: 0,0:10:02.69,0:10:05.58,Default,Nishida,0,0,0,,Mund të vësh bast në të katër vendet?
Dialogue: 0,0:10:05.58,0:10:10.09,Default,Dealer,0,0,0,,Po. Shpërndarësi mund të vëjë bast kudo.
Dialogue: 0,0:10:10.09,0:10:11.60,Default,Nishida,0,0,0,,Sa çipa?
Dialogue: 0,0:10:11.81,0:10:15.69,Default,Dealer,0,0,0,,Mund të vësh bast çdo numër\Nçipash që zotëron.
Dialogue: 0,0:10:15.69,0:10:17.53,Default,Dealer,0,0,0,,Madje mund t'i vësh të gjithë.
Dialogue: 0,0:10:17.91,0:10:20.60,Default,Dealer,0,0,0,,Tani, Nishida-san, të lutem vër bastin.
Dialogue: 0,0:10:21.94,0:10:23.43,Default,Nishida,0,0,0,,Në rregull...
Dialogue: 0,0:10:23.43,0:10:27.79,Default,Nishida,0,0,0,,Dhjetë mbi katër, dhjetë mbi dy, dhjetë mbi tre.
Dialogue: 0,0:10:28.11,0:10:30.35,Default,Dealer,0,0,0,,Hamendësuesi tani do të vëjë bast.
Dialogue: 0,0:10:30.35,0:10:33.37,Default,Dealer,0,0,0,,Ka dy gjëra\Nqë duhet të mbani mend.
Dialogue: 0,0:10:33.37,0:10:37.10,Default,Dealer,0,0,0,,Së pari, hamendësuesi mund\Ntë vëjë bast vetëm në dy vende.
Dialogue: 0,0:10:37.36,0:10:43.87,Default,Dealer,0,0,0,,Së dyti, hamendësuesi duhet të vëjë\Ntë paktën të njëjtën shumë si shpërndarësi.
Dialogue: 0,0:10:43.87,0:10:48.04,Default,Dealer,0,0,0,,Megjithatë, nëse bilanci yt total i çipave\Nështë më i vogël se sa ka vënë shpërndarësi,
Dialogue: 0,0:10:48.04,0:10:50.33,Default,Dealer,0,0,0,,mund të vësh bast gjithsesi duke shkuar all in.
Dialogue: 0,0:10:50.71,0:10:51.88,Default,Akiyama,0,0,0,,E kuptoj.
Dialogue: 0,0:10:52.11,0:10:55.88,Default,Dealer,0,0,0,,Tani, meqë shpërndarësi ka\Nvënë gjithsej tridhjetë,
Dialogue: 0,0:10:55.88,0:10:59.80,Default,Dealer,0,0,0,,duhet të vësh të paktën tridhjetë\Nçipa, Akiyama-san.
Dialogue: 0,0:11:00.65,0:11:01.64,Default,Akiyama,0,0,0,,Atëherë...
Dialogue: 0,0:11:02.09,0:11:04.60,Default,Akiyama,0,0,0,,Pesëmbëdhjetë mbi dy, pesëmbëdhjetë mbi tre.
Dialogue: 0,0:11:05.38,0:11:07.90,Default,Dealer,0,0,0,,Të dyja palët kanë vënë bastet.
Dialogue: 0,0:11:07.90,0:11:09.51,Default,Dealer,0,0,0,,Le të luajmë tani.
Dialogue: 0,0:11:13.47,0:11:16.64,Default,Dealer,0,0,0,,Dy. Të dy lojtarët fitojnë.
Dialogue: 0,0:11:16.64,0:11:21.28,Default,Dealer,0,0,0,,Sa për pagesën, çipat humbës\Nndahen
Dialogue: 0,0:11:21.28,0:11:24.65,Default,Dealer,0,0,0,,në një raport të përcaktuar nga\Nçipat fitues të vënë.
Dialogue: 0,0:11:24.65,0:11:28.00,Default,Dealer,0,0,0,,Në këtë rast, numri fitues ishte dy,
Dialogue: 1,0:11:28.00,0:11:31.34,Default,Dealer,0,0,0,,ku Nishida-san vuri dhjetë\Ndhe Akiyama-san vuri pesëmbëdhjetë.
Dialogue: 1,0:11:31.34,0:11:35.01,Default,Dealer,0,0,0,,Kështu, 35 çipat humbës do të\Nndahen në atë raport.
Dialogue: 0,0:11:27.74,0:11:36.19,Default,sign,0,0,0,,{\fad(440,460)\fnArial Black\shad0\fs12\3c&H57513B&\move(363.334,221.334,512.667,58.667,2950,3860)\t(2950,3860,\fs18)}Nishida
Dialogue: 0,0:11:27.74,0:11:30.87,Default,sign,0,0,0,,{\fad(440,180)\fnArial Black\shad0\fs12\3c&H57513B&\pos(282.667,230.001)}Nishida
Dialogue: 0,0:11:27.74,0:11:30.87,Default,sign,0,0,0,,{\fad(440,180)\fnArial Black\shad0\fs12\3c&H57513B&\pos(370,66.668)}Nishida
Dialogue: 0,0:11:29.20,0:11:30.87,Default,sign,0,0,0,,{\fad(440,180)\fnArial Black\shad0\fs12\3c&H2D1B63&\pos(355.333,146.001)}Akiyama
Dialogue: 0,0:11:29.20,0:11:36.19,Default,sign,0,0,0,,{\fad(440,460)\fnArial Black\shad0\fs12\3c&H2D1B63&\move(361.333,293.334,510.666,240.667,1490,2440)\t(1490,2440,\fs18)}Akiyama
Dialogue: 0,0:11:35.01,0:11:36.60,Default,Dealer,0,0,0,,Ky është rezultati.
Dialogue: 0,0:11:36.21,0:11:45.18,Default,sign,0,0,0,,{\an1\bord3\fad(480,1)\fnArial Black\shad0\pos(212,68)}Totali
Dialogue: 0,0:11:36.21,0:11:45.18,Default,sign,0,0,0,,{\an3\bord3\fad(480,1)\fnArial Black\shad0\pos(450.667,68)}i çipave
Dialogue: 0,0:11:36.21,0:11:45.18,Default,sign,0,0,0,,{\an1\bord3\fad(480,1)\fnArial Black\shad0\pos(212,245.333)}Totali
Dialogue: 0,0:11:36.21,0:11:45.18,Default,sign,0,0,0,,{\an3\bord3\fad(480,1)\fnArial Black\shad0\pos(450.667,245.333)}i çipave
Dialogue: 0,0:11:37.17,0:11:41.14,Default,Nao,0,0,0,,Akiyama-san vuri tridhjetë çipa atje,
Dialogue: 0,0:11:41.14,0:11:43.46,Default,Nao,0,0,0,,ndaj doli gjashtë përpara, apo jo?
Dialogue: 0,0:11:43.46,0:11:44.88,Default,Dealer,0,0,0,,Saktë.
Dialogue: 0,0:11:45.46,0:11:47.73,Default,Dealer,0,0,0,,Më pas, Akiyama-san do të shërbejë si shpërndarës.
Dialogue: 0,0:11:47.73,0:11:49.75,Default,Dealer,0,0,0,,Vendose topin në rrotë.
Dialogue: 0,0:11:51.98,0:11:54.41,Default,Dealer,0,0,0,,Tani, vër bastin.
Dialogue: 0,0:11:55.04,0:11:55.95,Default,Akiyama,0,0,0,,Atëherë...
Dialogue: 0,0:11:56.66,0:11:59.19,Default,Akiyama,0,0,0,,Do të vë 150 secilin mbi dy dhe tre.
Dialogue: 0,0:11:59.19,0:12:01.58,Default,Nishida,0,0,0,,T-Tha 150?!
Dialogue: 0,0:12:01.87,0:12:03.92,Default,Dealer,0,0,0,,Nishida-san, ju lutem.
Dialogue: 0,0:12:05.63,0:12:09.55,Default,Nishida,0,0,0,,Atëherë edhe unë do të vë 150\Nsecilin mbi dy dhe tre.
Dialogue: 0,0:12:09.55,0:12:10.63,Default,Dealer,0,0,0,,Nuk mund ta bësh këtë.
Dialogue: 0,0:12:11.67,0:12:15.58,Default,Dealer,0,0,0,,Ushtria e Perëndimit ka vetëm 292 çipa.
Dialogue: 0,0:12:15.58,0:12:16.97,Default,Nishida,0,0,0,,Seriozisht?
Dialogue: 0,0:12:19.49,0:12:23.09,Default,Nishida,0,0,0,,Atëherë... 146 secilin mbi dy dhe tre.
Dialogue: 0,0:12:23.45,0:12:25.72,Default,Dealer,0,0,0,,Të dyja palët kanë vënë bastet.
Dialogue: 0,0:12:25.72,0:12:27.10,Default,Dealer,0,0,0,,Le të luajmë!
Dialogue: 0,0:12:30.07,0:12:31.21,Default,Kikuchi,0,0,0,,Katër?
Dialogue: 0,0:12:31.21,0:12:32.34,Default,Nishida,0,0,0,,Katër do të thotë...
Dialogue: 0,0:12:32.75,0:12:34.85,Default,Nishida,0,0,0,,Asnjëri prej nesh nuk vuri bast për atë!
Dialogue: 0,0:12:35.07,0:12:39.40,Default,Dealer,0,0,0,,Në këtë raund, të gjithë çipat\Ne vënë shkojnë te shpërndarësi.
Dialogue: 0,0:12:41.10,0:12:44.08,Default,Akiyama,0,0,0,,Ushtria e Perëndimit tani është e shkatërruar.
Dialogue: 0,0:12:44.08,0:12:45.86,Default,Akiyama,0,0,0,,Çfarë ndodh këtu?
Dialogue: 0,0:12:46.18,0:12:50.40,Default,Dealer,0,0,0,,Nëse njëra palë mbaron çipat,\Nnuk mund të vazhdojë.
Dialogue: 0,0:12:50.40,0:12:52.62,Default,Dealer,0,0,0,,Në atë pikë, loja mbaron.
Dialogue: 0,0:12:52.62,0:12:55.04,Default,Dealer,0,0,0,,Sikur kjo të ishte e vërteta,\NUshtria e Perëndimit do të humbiste,
Dialogue: 0,0:12:55.04,0:12:58.60,Default,Dealer,0,0,0,,dhe Ushtria e Lindjes do të\Nkalonte në lojën e raundit të katërt.
Dialogue: 0,0:12:59.16,0:13:02.08,Default,Akiyama,0,0,0,,Pra kjo është një mënyrë tjetër për të vënë bast.
Dialogue: 0,0:13:05.46,0:13:06.80,Default,Solario,0,0,0,,Shkëlqyeshëm.
Dialogue: 0,0:13:06.80,0:13:10.64,Default,Solario,0,0,0,,Sapo vendosi shumë presion\Nmbi Ushtrinë e Perëndimit.
Dialogue: 0,0:13:10.92,0:13:16.01,Default,Solario,0,0,0,,Ushtria e Lindjes mban një epërsi\Ntë gjerë mbi Ushtrinë e Perëndimit.
Dialogue: 0,0:13:16.01,0:13:19.69,Default,Solario,0,0,0,,"Mund t'ju vras kur të dua."
Dialogue: 0,0:13:19.69,0:13:23.30,Default,Solario,0,0,0,,Ky lloj presioni do\Nt'i trembë Ushtrinë e Perëndimit
Dialogue: 0,0:13:23.30,0:13:26.47,Default,Solario,0,0,0,,dhe do t'ia vështirësojë\Nformulimin e një plani të duhur.
Dialogue: 0,0:13:27.62,0:13:32.12,Narration,Nao,0,0,0,,Por ishte gjithashtu një reflektim\Ni frikërave të Akiyama-san.
Dialogue: 0,0:13:33.36,0:13:36.44,Main - Italics,Akiyama,0,0,0,,Kjo duhet t'i bëjë të vrapojnë të trembur.
Dialogue: 0,0:13:36.44,0:13:39.00,Main - Italics,Akiyama,0,0,0,,Shpresoj t'i bëjë të ndrojtur...
Dialogue: 0,0:13:39.63,0:13:43.64,Main - Italics,Akiyama,0,0,0,,Por Nao Kanzaki tenton të tregojë\Nkur është e shqetësuar,
Dialogue: 0,0:13:43.64,0:13:46.00,Main - Italics,Akiyama,0,0,0,,dhe është e tmerrshme në gënjeshtra.
Dialogue: 0,0:13:46.61,0:13:50.14,Main - Italics,Akiyama,0,0,0,,Në një ndeshje të drejtë, do të humbasim me siguri.
Dialogue: 0,0:13:51.84,0:13:53.54,Narration,Nao,0,0,0,,Një lojtare tjetër kishte mendimet e saj.
Dialogue: 0,0:13:54.83,0:13:58.66,Main - Italics,Fukunaga,0,0,0,,Duhet të mendoj\Nsi t'i qasem kësaj.
Dialogue: 0,0:14:01.82,0:14:05.22,Narration,Nao,0,0,0,,Luajtëm edhe gjashtë raunde\Ntë provës.
Dialogue: 0,0:14:05.22,0:14:07.19,Narration,Nao,0,0,0,,Akiyama-san dominoi.
Dialogue: 0,0:14:07.84,0:14:09.64,Main - Italics,Solario,0,0,0,,Në Ndeshjen e Gjeneralit,
Dialogue: 0,0:14:09.64,0:14:13.53,Main - Italics,Solario,0,0,0,,nëse Ushtria e Perëndimit fiton,\Nekipet do të barazohen.
Dialogue: 0,0:14:13.53,0:14:17.03,Main - Italics,Solario,0,0,0,,Fituesi pastaj do të përcaktohet\Nnga totalet e çipave.
Dialogue: 0,0:14:17.28,0:14:21.29,Main - Italics,Solario,0,0,0,,Me fjalë të tjera, Ushtria e Perëndimit\Njo vetëm duhet të fitojë Ndeshjen e Gjeneralit,
Dialogue: 0,0:14:21.29,0:14:26.19,Main - Italics,Solario,0,0,0,,por edhe të sigurojë më shumë çipa\Nse Ushtria e Lindjes.
Dialogue: 0,0:14:30.34,0:14:31.80,Default,Nao,0,0,0,,Akiyama-san.
Dialogue: 0,0:14:31.80,0:14:34.30,Default,Nao,0,0,0,,A mendon se mund të fitoj?
Dialogue: 0,0:14:35.65,0:14:40.71,Default,Akiyama,0,0,0,,Çelësi i kësaj loje është të\Nshënosh kur je shpërndarës.
Dialogue: 0,0:14:42.40,0:14:44.91,Default,Akiyama,0,0,0,,Kjo lojë ka të bëjë me hamendësuesin\Nqë përcakton saktë
Dialogue: 0,0:14:44.91,0:14:47.17,Default,Akiyama,0,0,0,,se në cilën vrimë shpërndarësi\Ne vendosi topin.
Dialogue: 0,0:14:47.17,0:14:48.84,Default,Akiyama,0,0,0,,Ka katër vende.
Dialogue: 0,0:14:48.84,0:14:51.25,Default,Akiyama,0,0,0,,Hamendësuesi mund të vëjë bast në dy.
Dialogue: 0,0:14:51.25,0:14:54.19,Default,Akiyama,0,0,0,,Që do të thotë se kanë pesëdhjetë-pesëdhjetë shans.
Dialogue: 0,0:14:54.51,0:14:58.08,Default,Nao,0,0,0,,Pra shpërndarësi dhe hamendësuesi kanë\Ntë njëjtat gjasa, apo jo?
Dialogue: 0,0:14:58.08,0:15:02.75,Default,Akiyama,0,0,0,,Po. Por është shumë më mirë\Ntë fitosh si shpërndarës.
Dialogue: 0,0:15:02.75,0:15:03.92,Default,Nao,0,0,0,,Pse?
Dialogue: 0,0:15:04.66,0:15:07.85,Default,Akiyama,0,0,0,,Imagjino një skenar ku shpërndarësi\Nvë dhjetë çipa në çdo vend.
Dialogue: 0,0:15:07.85,0:15:12.23,Default,Akiyama,0,0,0,,Hamendësuesi pastaj vë njëzet\Nçipa në dy vende.
Dialogue: 1,0:15:12.23,0:15:18.23,Default,Akiyama,0,0,0,,Nëse hamendësuesi ka të drejtë, pesëdhjetë çipat\Ne humbur ndahen në një raport dy me një.
Dialogue: 1,0:15:18.23,0:15:21.05,Default,Akiyama,0,0,0,,Hamendësuesi fiton 33 çipa.
Dialogue: 0,0:15:15.31,0:15:24.36,Default,sign,0,0,0,,{\fad(220,1)\shad0\an8\fnArial Black\fs18\pos(178,45.333)}Shpërndarësi
Dialogue: 0,0:15:15.31,0:15:24.36,Default,sign,0,0,0,,{\fad(220,1)\shad0\an8\fnArial Black\fs18\pos(458.667,45.333)}Hamendësuesi
Dialogue: 0,0:15:17.72,0:15:24.36,Default,sign,0,0,0,,{\shad0\bord0\fnArial Black\fs18\c&H121212&\pos(287.333,279.999)}çipa
Dialogue: 0,0:15:17.72,0:15:24.36,Default,sign,0,0,0,,{\shad0\bord0\fnArial Black\fs18\c&H121212&\pos(578,279.999)}çipa
Dialogue: 1,0:15:21.05,0:15:24.35,Default,Akiyama,0,0,0,,Njëzet prej tyre i përkisnin\Natyre që në fillim, ndaj...
Dialogue: 0,0:15:24.35,0:15:27.48,Default,Nao,0,0,0,,Ata vërtet fitojnë trembëdhjetë, apo jo?
Dialogue: 0,0:15:27.48,0:15:28.51,Default,Akiyama,0,0,0,,Saktë.
Dialogue: 0,0:15:28.51,0:15:30.89,Default,Akiyama,0,0,0,,Ndërkohë, nëse hamendësuesi gabon,
Dialogue: 0,0:15:30.89,0:15:34.22,Default,Akiyama,0,0,0,,të gjithë shtatëdhjetë çipat e humbur shkojnë te shpërndarësi.
Dialogue: 0,0:15:34.93,0:15:37.39,Default,Sign,0,0,0,,{\fad(220,1)\shad0\an8\fnArial Black\fs18\pos(178,45.333)}Shpërndarësi
Dialogue: 0,0:15:34.93,0:15:37.39,Default,Sign,0,0,0,,{\fad(220,1)\shad0\an8\fnArial Black\fs18\pos(458.667,45.333)}Hamendësuesi
Dialogue: 0,0:15:35.05,0:15:37.39,Default,Sign,0,0,0,,{\shad0\bord2\fnArial Black\fs18\c&H121212&\3c&HEEEEEE&\pos(274.761,277.142)}çipa
Dialogue: 0,0:15:35.05,0:15:37.39,Default,Sign,0,0,0,,{\shad0\bord2\fnArial Black\fs18\c&H121212&\3c&HF4F4F4&\pos(560.286,273.142)}çipa
Dialogue: 1,0:15:34.83,0:15:37.36,Default,Akiyama,0,0,0,,Tridhjetë i përkisnin shpërndarësit, ndaj...
Dialogue: 0,0:15:37.36,0:15:39.77,Default,Nao,0,0,0,,Ata fitojnë dyzet çipa!
Dialogue: 0,0:15:39.77,0:15:43.96,Default,Nao,0,0,0,,Shpërndarësi fiton tre herë\Natë që do të fitonte hamendësuesi!
Dialogue: 0,0:15:43.96,0:15:45.12,Default,Akiyama,0,0,0,,Saktë.
Dialogue: 0,0:15:45.49,0:15:46.87,Default,Nao,0,0,0,,E kuptoj.
Dialogue: 0,0:15:47.55,0:15:50.37,Default,Nao,0,0,0,,Cili është çelësi për të fituar si shpërndarës?
Dialogue: 0,0:15:51.16,0:15:53.85,Default,Akiyama,0,0,0,,Mund të mendoj një mënyrë të sigurt e efikase.
Dialogue: 0,0:15:55.40,0:15:56.72,Default,Akiyama,0,0,0,,Kërcënoji.
Dialogue: 0,0:15:57.29,0:15:59.77,Default,Nao,0,0,0,,Kërcënoji?
Dialogue: 0,0:16:00.06,0:16:09.07,Default,sign,0,0,0,,{\fnArial Black\shad0\c&HEDEBEB&\3c&H57513B&\move(204.667,109.334,98.667,109.334)}Ushtria e Perëndimit
Dialogue: 0,0:16:00.06,0:16:09.07,Default,sign,0,0,0,,{\fnArial Black\shad0\c&HEDEBEB&\3c&H2D1B63&\move(553.333,109.334,446.333,109.334)}Ushtria e Lindjes
Dialogue: 0,0:16:00.06,0:16:01.97,Default,Akiyama,0,0,0,,Totalet tona aktuale të çipave
Dialogue: 0,0:16:01.97,0:16:05.01,Default,Akiyama,0,0,0,,janë 530 me 298.
Dialogue: 0,0:16:05.60,0:16:09.07,Default,Akiyama,0,0,0,,Shpërndarësi mund të vëjë çipa\Nnë katër vende, por...
Dialogue: 0,0:16:09.33,0:16:12.05,Default,Akiyama,0,0,0,,Le të themi se vë një shumë\Ntë madhe në të njëjtin vend.
Dialogue: 0,0:16:12.41,0:16:15.58,Default,Akiyama,0,0,0,,Për shembull, 300 mbi një.
Dialogue: 0,0:16:15.58,0:16:17.48,Default,Nao,0,0,0,,Drejt në 300?!
Dialogue: 0,0:16:17.48,0:16:19.96,Default,Akiyama,0,0,0,,Natyrisht, do ta vendosësh topin mbi një.
Dialogue: 0,0:16:19.96,0:16:24.81,Default,Akiyama,0,0,0,,Ata kanë vetëm 298 çipa, ndaj do të\Nduhet pashmangshmërisht të vënë gjithçka.
Dialogue: 0,0:16:25.32,0:16:28.52,Default,Akiyama,0,0,0,,Atëherë i kërcënon.
Dialogue: 0,0:16:29.18,0:16:30.97,Default,Akiyama,0,0,0,,Thuaj diçka si...
Dialogue: 0,0:16:31.63,0:16:33.35,Default,Akiyama,0,0,0,,Le ta mbarojmë këtë me një lëvizje.
Dialogue: 0,0:16:34.82,0:16:37.73,Default,Akiyama,0,0,0,,Ata do të përfundojnë duke menduar...
Dialogue: 0,0:16:38.45,0:16:44.12,Main - Italics,Kosaka,0,0,0,,A po përpiqen ta mbarojnë lojën menjëherë\Nduke bërë që të dyja palët të gabojnë?
Dialogue: 0,0:16:44.12,0:16:45.49,Default,Nao,0,0,0,,E kuptoj...
Dialogue: 0,0:16:45.49,0:16:48.00,Default,Nao,0,0,0,,Kjo është strategjia që\Npërdore në provë!
Dialogue: 0,0:16:48.00,0:16:50.94,Default,Akiyama,0,0,0,,Mund t'i rrëzojmë të gjithë me një lëvizje.
Dialogue: 0,0:16:50.94,0:16:54.52,Default,Akiyama,0,0,0,,Ata ende e kanë atë\Ntë djegur në trurin e tyre.
Dialogue: 0,0:16:55.21,0:16:59.78,Default,Akiyama,0,0,0,,Nëse nuk kafshojnë dhe shkojnë all in\Nmbi një, nuk është problem.
Dialogue: 0,0:17:00.55,0:17:05.49,Default,Akiyama,0,0,0,,Të dyja palët fitojnë, dhe 300\Nqë vure kthehen te ti.
Dialogue: 0,0:17:05.86,0:17:08.88,Default,Akiyama,0,0,0,,Por ka një mundësi tjetër...
Dialogue: 0,0:17:09.56,0:17:14.16,Default,Akiyama,0,0,0,,Nga 298 e tyre, ata vënë 280 mbi një,
Dialogue: 0,0:17:14.16,0:17:17.73,Default,Akiyama,0,0,0,,pastaj vënë tetëmbëdhjetë mbi dy, tre, ose katër.
Dialogue: 0,0:17:18.25,0:17:20.68,Default,Nao,0,0,0,,Atëherë do të merrnim çipa!
Dialogue: 0,0:17:20.68,0:17:21.78,Default,Akiyama,0,0,0,,Saktë.
Dialogue: 0,0:17:21.78,0:17:23.78,Default,Akiyama,0,0,0,,Nga tetëmbëdhjetë çipat e humbur,
Dialogue: 0,0:17:23.78,0:17:26.25,Default,Akiyama,0,0,0,,dhjetë do të shkonin te ekipi ynë.
Dialogue: 0,0:17:26.25,0:17:29.96,Default,Akiyama,0,0,0,,Përfitimi i këtij plani është se,\N sido që të bëjnë,
Dialogue: 0,0:17:29.96,0:17:33.05,Default,Akiyama,0,0,0,,gjithmonë do të marrim 300 çipa mbrapsht.
Dialogue: 0,0:17:33.44,0:17:35.20,Default,Akiyama,0,0,0,,Me fjalë të tjera, nuk ka rrezik.
Dialogue: 0,0:17:35.52,0:17:41.02,Default,Akiyama,0,0,0,,Zgjero epërsinë në raundet e hershme dhe\N kaloje pjesën tjetër me këtë plan pa rrezik.
Dialogue: 0,0:17:41.37,0:17:44.22,Default,Akiyama,0,0,0,,Është strategjia më realiste, do të thosha.
Dialogue: 0,0:17:44.22,0:17:46.13,Default,Nao,0,0,0,,Po, do të bëj çmos.
Dialogue: 0,0:17:46.13,0:17:48.91,Main - Italics,Solario,0,0,0,,Tani do të fillojmë Ndeshjen e Gjeneralit.
Dialogue: 0,0:17:49.20,0:17:52.58,Main - Italics,Solario,0,0,0,,Të dyja ushtritë, ju lutem hyni në dhomën e lojës.
Dialogue: 0,0:17:53.81,0:17:57.56,Default,Dealer,0,0,0,,Për raundin e parë, Ushtria\Ne Perëndimit do të shërbejë si shpërndarës.
Dialogue: 0,0:18:01.46,0:18:03.93,Default,Dealer,0,0,0,,Ju lutem vëni bastin.
Dialogue: 0,0:18:09.24,0:18:13.34,Main - Italics,Nao,0,0,0,,Po fillon me 40 çipa,\Ndhjetë secilin në katër vende...
Dialogue: 0,0:18:14.01,0:18:17.33,Main - Italics,Nao,0,0,0,,E di! Le të provojmë edhe një herë!
Dialogue: 0,0:18:17.68,0:18:20.60,Default,Dealer,0,0,0,,Më pas, basti i Kanzaki-san.
Dialogue: 0,0:18:21.22,0:18:23.11,Default,Nao,0,0,0,,Ehm, Kosaka-san.
Dialogue: 0,0:18:24.26,0:18:26.35,Default,Nao,0,0,0,,A mund ta anulojmë këtë lojë, të lutem?
Dialogue: 0,0:18:29.40,0:18:32.17,Default,Nao,0,0,0,,Edhe nëse kaloj në\Nlojën e raundit të katërt,
Dialogue: 0,0:18:32.17,0:18:35.09,Default,Nao,0,0,0,,nuk dua të fitoj duke\Nlënduar njerëz të tjerë.
Dialogue: 0,0:18:35.68,0:18:38.46,Default,Nao,0,0,0,,Dua t'ju shpëtoj të gjithëve.
Dialogue: 0,0:18:42.78,0:18:44.07,Default,Kosaka,0,0,0,,Dëgjo...
Dialogue: 0,0:18:46.12,0:18:47.72,Default,Kosaka,0,0,0,,A mund të kem besim te ti?
Dialogue: 0,0:18:47.97,0:18:49.33,Default,Nao,0,0,0,,Kosaka-san!
Dialogue: 0,0:18:50.42,0:18:52.48,Default,Kosaka,0,0,0,,Të jem e sinqertë, po mundohem me këtë.
Dialogue: 0,0:18:52.78,0:18:57.23,Default,Kosaka,0,0,0,,Jam thjesht e tmerrshme në këto\Nlojëra mashtrimi.
Dialogue: 0,0:18:57.23,0:19:00.24,Default,Nao,0,0,0,,E kuptoj! Edhe unë jam e tmerrshme!
Dialogue: 0,0:19:00.49,0:19:02.37,Default,Kosaka,0,0,0,,Vërtet mund të kem besim te ti?
Dialogue: 0,0:19:02.37,0:19:04.75,Default,Kosaka,0,0,0,,Vërtet do të na shpëtosh?!
Dialogue: 0,0:19:04.98,0:19:07.07,Default,Nao,0,0,0,,Po! Premtoj se do t'ju shpëtoj!
Dialogue: 0,0:19:09.31,0:19:12.74,Default,Kosaka,0,0,0,,Topi është mbi një. Do të të lë të fitosh.
Dialogue: 0,0:19:12.74,0:19:16.25,Default,Kosaka,0,0,0,,Në këmbim... të lutem na shpëto.
Dialogue: 0,0:19:16.25,0:19:19.25,Default,Nao,0,0,0,,Po, do t'ju shpëtoj! Premtoj!
Dialogue: 0,0:19:21.97,0:19:24.31,Default,Dealer,0,0,0,,Të dyja palët kanë vënë bastet.
Dialogue: 0,0:19:24.69,0:19:26.78,Default,Dealer,0,0,0,,Tani, le të luajmë.
Dialogue: 0,0:19:30.48,0:19:32.31,Main - Italics,Solario,0,0,0,,Përgjigja e saktë ishte katër.
Dialogue: 0,0:19:32.31,0:19:34.85,Main - Italics,Solario,0,0,0,,Ushtria e Perëndimit fiton.
Dialogue: 0,0:19:36.26,0:19:40.61,Default,Kosaka,0,0,0,,Je kaq budallaqe! Nuk mund të besoj\Nse vërtet vure bast mbi një!
Dialogue: 0,0:19:40.86,0:19:42.33,Default,Nao,0,0,0,,Kosaka-san?
Dialogue: 0,0:19:42.33,0:19:44.61,Default,Kosaka,0,0,0,,Thua se do të na shpëtosh?
Dialogue: 0,0:19:44.86,0:19:49.49,Default,Kosaka,0,0,0,,Thjesht po përpiqesh të na vjedhësh\Nçipat me atë premtim.
Dialogue: 0,0:19:49.85,0:19:53.26,Default,Kosaka,0,0,0,,Mendon se do të bija në\Nnjë truk kaq fëminor?
Dialogue: 0,0:19:53.85,0:19:56.26,Default,Nao,0,0,0,,Nuk po përpiqesha të të mashtroja...
Dialogue: 0,0:19:56.72,0:19:59.48,Narration,Nao,0,0,0,,Ishte e pamundur ta bindje Kosaka-san.
Dialogue: 0,0:20:00.59,0:20:03.43,Narration,Nao,0,0,0,,Kisha humbur 40 çipa.
Dialogue: 0,0:20:04.40,0:20:05.81,Main - Italics,Nao,0,0,0,,Është në rregull.
Dialogue: 0,0:20:05.81,0:20:09.07,Main - Italics,Nao,0,0,0,,Mund t'i marr të gjitha mbrapsht\Nkur luaj si shpërndarës.
Dialogue: 0,0:20:09.42,0:20:10.86,Default,Dealer,0,0,0,,Ky është raundi i dytë.
Dialogue: 0,0:20:10.86,0:20:14.40,Default,Dealer,0,0,0,,Kanzaki-san e Ushtrisë së Lindjes,\Nvendose topin në rrotë.
Dialogue: 0,0:20:15.05,0:20:16.02,Default,Nao,0,0,0,,Në rregull.
Dialogue: 0,0:20:19.60,0:20:21.77,Default,Dealer,0,0,0,,Tani, vër bastin.
Dialogue: 0,0:20:22.43,0:20:24.42,Main - Italics,Nao,0,0,0,,Shpërndarësi fiton më shumë se hamendësuesi.
Dialogue: 0,0:20:24.42,0:20:27.99,Main - Italics,Nao,0,0,0,,Që do të thotë se duhet të vë bast\Nmadh kur jam shpërndarës.
Dialogue: 0,0:20:30.16,0:20:33.64,Main - Italics,Kosaka,0,0,0,,Ajo vuri 25 çipa në të katër\Nvendet... pra 100 gjithsej?!
Dialogue: 0,0:20:34.13,0:20:36.64,Default,Dealer,0,0,0,,Kosaka-san, basti juaj, të lutem.
Dialogue: 0,0:20:37.53,0:20:39.91,Default,Kosaka,0,0,0,,Ky është një bast i madh, apo jo?
Dialogue: 0,0:20:41.20,0:20:43.52,Default,Kosaka,0,0,0,,Pyes veten ku e vure topin...
Dialogue: 0,0:20:44.69,0:20:45.93,Default,Kosaka,0,0,0,,Një?
Dialogue: 0,0:20:46.46,0:20:47.64,Default,Nao,0,0,0,,Jo.
Dialogue: 0,0:20:48.22,0:20:49.31,Default,Kosaka,0,0,0,,Dy?
Dialogue: 0,0:20:49.79,0:20:51.18,Default,Nao,0,0,0,,Jo.
Dialogue: 0,0:20:52.29,0:20:53.93,Default,Kosaka,0,0,0,,Është tre, atëherë?
Dialogue: 0,0:20:54.28,0:20:56.81,Default,Nao,0,0,0,,A-As atje jo.
Dialogue: 0,0:20:57.23,0:20:59.19,Default,Kosaka,0,0,0,,Katër, atëherë?
Dialogue: 0,0:20:59.65,0:21:02.07,Default,Nao,0,0,0,,Po të them jo!
Dialogue: 0,0:21:07.16,0:21:08.07,Default,Kosaka,0,0,0,,Në atë rast...
Dialogue: 0,0:21:08.46,0:21:09.71,Default,Kosaka,0,0,0,,100 çipa mbi tre.
Dialogue: 0,0:21:13.23,0:21:14.75,Default,Nao,0,0,0,,Të gjitha në një vend?
Dialogue: 0,0:21:14.75,0:21:16.31,Default,Nao,0,0,0,,Mund të vësh bast në dy vende!
Dialogue: 0,0:21:16.31,0:21:19.05,Default,Kosaka,0,0,0,,Është në rregull. Gjithsesi është e rastësishme.
Dialogue: 0,0:21:19.62,0:21:22.04,Default,Dealer,0,0,0,,Të dyja palët kanë vënë bastet.
Dialogue: 0,0:21:22.36,0:21:24.33,Default,Dealer,0,0,0,,Tani, le të luajmë.
Dialogue: 0,0:21:25.93,0:21:27.80,Main - Italics,Solario,0,0,0,,Përgjigja e saktë ishte tre.
Dialogue: 0,0:21:27.80,0:21:29.76,Main - Italics,Solario,0,0,0,,Të dyja palët fitojnë.
Dialogue: 0,0:21:30.30,0:21:31.46,Default,Kosaka,0,0,0,,Po!
Dialogue: 0,0:21:31.46,0:21:35.44,Main - Italics,Solario,0,0,0,,Ushtria e Lindjes vuri 25 mbi tre,\Ndhe Ushtria e Perëndimit vuri 100.
Dialogue: 0,0:21:35.76,0:21:39.32,Main - Italics,Solario,0,0,0,,Nga 75 çipat e humbur,\N 15 shkojnë te Ushtria e Lindjes,
Dialogue: 0,0:21:39.32,0:21:42.31,Main - Italics,Solario,0,0,0,,dhe 60 shkojnë te Ushtria e Perëndimit.
Dialogue: 0,0:21:42.31,0:21:44.34,Default,Nishida,0,0,0,,Gjashtëdhjetë çipa, tha!
Dialogue: 0,0:21:44.34,0:21:48.00,Default,Nishida,0,0,0,,Ajo tashmë ka marrë 100 çipa\Nvetëm në dy raundet e para!
Dialogue: 0,0:21:48.00,0:21:49.70,Default,Kikuchi,0,0,0,,Diferenca e çipave tani është...
Dialogue: 0,0:21:51.27,0:21:54.20,Default,Kikuchi,0,0,0,,Tridhjetë e dy! Pothuajse të barabartë!
Dialogue: 0,0:21:49.70,0:21:54.20,Default,sign,0,0,0,,{\fnArial Black\fay-.17\shad0\pos(279.333,73.334)\c&HD0E2E0&\3c&H363D42&}Numri i Çipave
Dialogue: 0,0:21:49.70,0:21:54.20,Default,sign,0,0,0,,{\fnArial Black\fay-.13\fs20\shad0\c&HEDEBEB&\3c&H57513B&\pos(164,154.667)}Ushtria e Perëndimit
Dialogue: 0,0:21:49.70,0:21:54.20,Default,sign,0,0,0,,{\fnArial Black\fay-.13\fs20\shad0\c&HEDEBEB&\3c&H2D1B63&\pos(419.333,119.334)}Ushtria e Lindjes
Dialogue: 0,0:21:54.20,0:21:57.67,Default,Nishida,0,0,0,,Mund të fitojmë! Mund ta fitojmë këtë lojë!
Dialogue: 0,0:21:59.26,0:22:04.38,Narration,Nao,0,0,0,,Basti i Kosaka-san mbi\Ntre nuk ishte fat.
Dialogue: 0,0:22:05.18,0:22:09.06,Narration,Nao,0,0,0,,Ishte diçka që Fukunaga-san\Ni kishte futur në kokë.
Dialogue: 0,0:22:11.15,0:22:13.21,Main - Italics,Fukunaga,0,0,0,,Po shkon në mënyrë të përsosur.
Dialogue: 0,0:23:45.11,0:23:50.10,Default,sign,0,0,0,,{\fnTimes New Roman\fs16\pos(320,85)\shad0\bord0\c&HA8C3C3&}Herën Tjetër
Dialogue: 0,0:23:45.11,0:23:50.10,Default,sign,0,0,0,,{\fnTimes New Roman\an8\b1\shad0\bord0\pos(320,185)}Vendosmëria

