{
  "manifest_version": 3,
  "name": "Animekinoteka — Albanian subtitles for Anikoto",
  "version": "0.1.0",
  "description": "Overlays Albanian subtitles on the Anikoto player, matched automatically to the series and episode you are watching.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://*.github.io/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [
    {
      "matches": ["https://anikototv.to/*", "https://*.anikototv.to/*"],
      "js": ["content/anikoto.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://megaplay.buzz/*", "https://*.megaplay.buzz/*"],
      "js": ["content/embed.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://megaplay.buzz/*", "https://*.megaplay.buzz/*"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "options_page": "options.html"
}
